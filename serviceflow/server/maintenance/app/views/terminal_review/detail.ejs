<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0 fw-bold">
    <i class="bi bi-grid-3x3 me-1"></i>مراجعة الترمنالات — بوكس <bdi dir="ltr"><%= t.box_number %></bdi>
  </h5>
  <a href="/terminal-review" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> القائمة</a>
</div>

<div class="card mb-3">
  <div class="card-body py-2 small text-muted">
    <i class="bi bi-building me-1"></i><%= t.exchange_name %>
    &nbsp;·&nbsp; كابينة <bdi dir="ltr"><%= t.cabinet_number %></bdi>
    <% if (capacity && capSource === 'inventory') { %>&nbsp;·&nbsp; السعة <strong><%= capacity %></strong><% } %>
  </div>
</div>

<form method="post" action="/terminal-review/<%= t.task_id %>">
  <% if (capSource !== 'inventory') { %>
  <div class="card mb-3">
    <div class="card-body">
      <label class="form-label fw-semibold small">سعة البكس مش متسجّلة — اختار السعة:</label>
      <div class="d-flex gap-3">
        <% [10, 20].forEach(c => { %>
        <label class="form-check">
          <input class="form-check-input" type="radio" name="capacity" value="<%= c %>" <%= capacity === c ? 'checked' : '' %>
                 onchange="this.form.querySelector('[name=action]').value='save'; this.form.submit()">
          <span class="form-check-label"><%= c %> ترمنال</span>
        </label>
        <% }) %>
      </div>
      <% if (!capacity) { %><div class="small text-muted mt-1">بعد ما تختار، الجدول هيظهر.</div><% } %>
    </div>
  </div>
  <% } %>

  <% if (capacity) { %>
  <div class="card mb-3">
    <div class="card-header py-2 fw-semibold"><i class="bi bi-list-ol me-1"></i>حالة كل ترمنال</div>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th style="width:5rem">الترمنال</th><th>الحالة</th></tr></thead>
        <tbody>
          <% for (let n = 1; n <= capacity; n++) { %>
          <tr>
            <td class="fw-bold text-center"><%= n %></td>
            <td>
              <select name="t<%= n %>" class="form-select form-select-sm" aria-label="حالة الترمنال <%= n %>">
                <option value="">— اختار —</option>
                <% STATES.forEach(s => { %>
                <option value="<%= s %>" <%= states[n] === s ? 'selected' : '' %>><%= STATE_LABEL[s] %></option>
                <% }) %>
              </select>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <input type="hidden" name="action" value="save">
  <div class="d-flex flex-wrap gap-2 mb-5">
    <button class="btn btn-outline-primary" type="submit" onclick="this.form.querySelector('[name=action]').value='save'">
      <i class="bi bi-save me-1"></i>حفظ وكمّل بعدين
    </button>
    <% if (capacity) { %>
    <button class="btn btn-success" type="submit"
            onclick="this.form.querySelector('[name=action]').value='done'; return confirm('تأكيد: تم الانتهاء من مراجعة البيانات؟')">
      <i class="bi bi-check2-all me-1"></i>تم الانتهاء من مراجعة البيانات
    </button>
    <% } %>
  </div>
</form>
<%- include('../partials/footer') %>
