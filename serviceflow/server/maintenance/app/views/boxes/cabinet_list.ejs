<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-grid me-2"></i><%= title %></h4>
  <div class="d-flex gap-2">
    <% if (user.role === 'admin') { %>
    <a href="/boxes/cabinets/duplicates" class="btn btn-outline-danger btn-sm"
       title="«2/1» و«2-1» كابينة واحدة — الصفحة دى بتلمّ المكرّر وتدمجه">
      <i class="bi bi-diagram-2"></i> كباين مكرّرة
    </a>
    <% } %>
    <a href="/boxes/exchanges" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> السنترالات</a>
  </div>
</div>

<% if (user.role === 'admin') { %>
<div class="card mb-3">
  <div class="card-body py-2">
    <form method="post" action="/boxes/exchanges/<%= exchange.id %>/cabinets/create" class="d-flex gap-2 align-items-end">
      <div>
        <label class="form-label fw-semibold mb-1">إضافة كابينة جديدة</label>
        <input type="text" name="number" class="form-control form-control-sm" placeholder="رقم الكابينة" required>
      </div>
      <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> إضافة</button>
    </form>
  </div>
</div>
<% } %>

<div class="row g-3">
  <% cabinets.forEach(cab => { %>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <h6 class="card-title"><i class="bi bi-server me-1 text-secondary"></i> كابينة <span class="n"><%= cab.number %></span></h6>
        <p class="text-muted"><i class="bi bi-box2 me-1"></i> <%= cab.box_count %> بوكس</p>
        <div class="d-flex gap-2 flex-wrap">
          <% if (user.role === 'admin' || user.role === 'inspector') { %>
          <a href="/boxes/cabinets/<%= cab.id %>/create" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg"></i> إضافة بوكس
          </a>
          <% } %>
          <% if (user.role === 'admin') { %>
          <form method="post" action="/boxes/cabinets/<%= cab.id %>/delete">
            <button class="btn btn-outline-danger btn-sm" onclick="return confirm('حذف هذه الكابينة؟')">
              <i class="bi bi-trash"></i>
            </button>
          </form>
          <% } %>
          <a href="/boxes?exchange_id=<%= exchange.id %>" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-eye"></i> البوكسات
          </a>
        </div>
        <% if (user.role === 'admin' && cabinets.length > 1) { %>
        <form method="post" action="/boxes/cabinets/<%= cab.id %>/merge-into" class="d-flex gap-1 mt-2"
              onsubmit="var s=this.target_id; return s.value && confirm('دمج كابينة «<%= cab.number %>» (<%= cab.box_count %> بوكس) فى «' + s.options[s.selectedIndex].text + '»؟\nالبوكسات والفحوصات والصور كلها بتتنقل، والطلبات الجاية بالاسم ده هتروح للكابينة المختارة.');">
          <select name="target_id" class="form-select form-select-sm" required>
            <option value="">دمج فى كابينة…</option>
            <% cabinets.filter(o => o.id !== cab.id).forEach(o => { %>
            <option value="<%= o.id %>"><%= o.number %> (<%= o.box_count %> بوكس)</option>
            <% }) %>
          </select>
          <button class="btn btn-outline-warning btn-sm text-nowrap"><i class="bi bi-intersect"></i> دمج</button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!cabinets.length) { %><div class="col-12"><div class="alert alert-info">لا توجد كباين في هذا السنترال.</div></div><% } %>
</div>
<%- include('../partials/footer') %>
