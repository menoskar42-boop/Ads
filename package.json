{
  "name": "oscardevs-ads",
  "version": "1.0.0",
  "description": "Oscardevs Ads - Multi-tenant SaaS advertising platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node src/db/schema.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:crm": "node src/db/seed_crm.js",
    "ads:backup": "node scripts/ads-backup.js backup",
    "ads:backup:list": "node scripts/ads-backup.js list",
    "ads:backup:verify": "node scripts/ads-backup.js verify",
    "ads:backup:compare": "node scripts/ads-backup.js compare",
    "ads:backup:restore-help": "node scripts/ads-backup.js restore-help",
    "mybible:migration:verify-group": "node scripts/validate-mybible-group-migration.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o public/css/tw.css --minify",
    "deals:sync:amazon": "node scripts/sync-deals-amazon.js",
    "deals:seed:amazon": "node scripts/seed-deals-amazon.js",
    "test:mykid:videos": "node --test mykid/tests/video-links.test.mjs",
    "check:mykid:video-links": "node mykid/scripts/check-video-links.mjs",
    "test:mykid:writing": "node --test mykid/tests/board.test.mjs mykid/tests/stroke-judge.test.mjs mykid/tests/writing-board.test.mjs mykid/tests/workbook-plan.test.mjs mykid/tests/workbook.test.mjs mykid/tests/letterbook-plan.test.mjs mykid/tests/letterbook.test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@replit/vite-plugin-cartographer": "^0.4.4",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.23.24",
    "mdb-reader": "^3.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "vite": "^7.3.6",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.1.18"
  },
  "optionalDependencies": {
    "@replit/object-storage": "^1.0.0",
    "node-unrar-js": "^2.0.2",
    "playwright": "^1.61.1"
  }
}
