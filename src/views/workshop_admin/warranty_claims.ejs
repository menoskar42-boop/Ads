<%- include('head') %>
<%
  var labels = {open:'مفتوحة', approved:'معتمدة', rejected:'مرفوضة', resolved:'تم الحل'};
%>
<div class="flex items-end justify-between gap-3 flex-wrap mb-5">
  <div><h1 class="font-black text-xl">مطالبات الضمان وعودة السيارة</h1>
    <p class="text-sm text-slate-500 mt-1">اربط العودة بأمر الشغل الأصلي، ثم سجّل القرار والإصلاح بدل ضياع السبب في الملاحظات.</p></div>
</div>
<section class="bg-white rounded-2xl border border-slate-200 p-4 mb-5">
  <h2 class="font-black mb-3">فتح مطالبة جديدة</h2>
  <form method="post" action="/workshop/warranty-claims" class="grid sm:grid-cols-3 gap-2 text-sm">
    <select name="original_job_id" required class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-1"><option value="">أمر الشغل الأصلي</option><% jobs.forEach(function(j){ %><option value="<%= j.id %>">#<%= j.id %> · <%= j.plate || '—' %> · <%= j.customer_name || '—' %></option><% }) %></select>
    <textarea name="complaint" required rows="2" placeholder="ما المشكلة التي عادت بها السيارة؟" class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-2"></textarea>
    <button class="bg-brand-600 text-white rounded-xl px-4 py-2 font-bold sm:col-span-3">فتح المطالبة</button>
  </form>
</section>
<section class="space-y-3">
  <% if (!claims.length) { %><div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-sm text-slate-400">لا توجد مطالبات ضمان.</div><% } %>
  <% claims.forEach(function(c){ %>
    <form method="post" action="/workshop/warranty-claims/<%= c.id %>" class="bg-white rounded-2xl border border-slate-200 p-4">
      <div class="flex items-start justify-between gap-3 flex-wrap"><div><a class="font-bold text-brand-700" href="/workshop/jobs/<%= c.original_job_id %>">أمر #<%= c.original_job_id || '—' %></a> · <%= c.plate || '—' %> · <%= c.customer_name || '—' %><div class="text-sm mt-1"><%= c.complaint %></div></div><span class="text-xs rounded-full px-2 py-1 font-bold bg-slate-100"><%= labels[c.status] || c.status %></span></div>
      <div class="grid sm:grid-cols-4 gap-2 mt-3 text-sm">
        <select name="status" class="border border-slate-200 rounded-xl px-3 py-2"><% Object.keys(labels).forEach(function(s){ %><option value="<%= s %>" <%= c.status===s?'selected':'' %>><%= labels[s] %></option><% }) %></select>
        <select name="return_job_id" class="border border-slate-200 rounded-xl px-3 py-2">
          <option value="">أمر العودة (اختياري)</option>
          <% (returnJobs || []).forEach(function(j){ %>
            <option value="<%= j.id %>" <%= Number(c.return_job_id) === Number(j.id) ? 'selected' : '' %>>#<%= j.id %> · <%= j.plate || '—' %> · <%= j.status %></option>
          <% }) %>
        </select>
        <input name="decision" value="<%= c.decision || '' %>" placeholder="قرار الضمان" class="border border-slate-200 rounded-xl px-3 py-2">
        <button class="bg-brand-600 text-white rounded-xl px-4 py-2 font-bold">حفظ الحالة</button>
        <textarea name="diagnosis" rows="2" placeholder="التشخيص" class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-2"><%= c.diagnosis || '' %></textarea>
        <textarea name="resolution" rows="2" placeholder="الإصلاح / الحل" class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-2"><%= c.resolution || '' %></textarea>
      </div>
      <% if (!c.return_job_id && c.status !== 'rejected' && c.status !== 'resolved') { %>
        <button type="submit" formaction="/workshop/warranty-claims/<%= c.id %>/return-job" class="mt-3 text-sm border border-brand-200 text-brand-700 rounded-lg px-3 py-1.5 font-bold">فتح أمر عودة لهذه السيارة</button>
      <% } else if (c.return_job_id) { %>
        <a href="/workshop/jobs/<%= c.return_job_id %>" class="inline-block mt-3 text-sm text-brand-700 font-bold">فتح أمر العودة #<%= c.return_job_id %> ↗</a>
      <% } %>
    </form>
  <% }) %>
</section>
<%- include('foot') %>