<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  function d(v){ try { return new Date(v).toLocaleDateString(LOC, {day:'numeric',month:'short'}); } catch(e){ return ''; } }
  var cards = [
    ['🧾', t('wsh.dash.open_jobs'),     stats.open,     '/workshop/jobs',      'text-brand-700'],
    ['⏳', t('wsh.dash.awaiting'),      stats.awaiting, '/workshop/jobs?status=quoted', 'text-amber-600'],
    ['📅', t('wsh.dash.due_today'),     stats.promised, '/workshop/jobs',      'text-rose-600'],
    ['⏰', t('wsh.dash.due_reminders'), stats.dueRem,   '/workshop/reminders', 'text-emerald-700'],
  ];
%>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
  <% cards.forEach(function(c){ %>
    <a href="<%= c[3] %>" class="bg-white rounded-2xl border border-slate-200 p-4 hover:border-brand-300 transition">
      <div class="text-xl"><%= c[0] %></div>
      <div class="text-2xl font-black <%= c[4] %> mt-1"><%= c[2] %></div>
      <div class="text-xs text-slate-500 font-semibold mt-0.5"><%= c[1] %></div>
    </a>
  <% }) %>
</div>

<div class="grid sm:grid-cols-3 gap-3 mb-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-4">
    <div class="text-xs text-slate-500 font-semibold"><%= t('wsh.dash.month_revenue') %></div>
    <div class="text-xl font-black text-emerald-700 mt-1"><bdi><%= money(stats.month) %></bdi></div>
  </div>
  <div class="bg-white rounded-2xl border border-slate-200 p-4">
    <div class="text-xs text-slate-500 font-semibold"><%= t('wsh.dash.unpaid') %></div>
    <div class="text-xl font-black text-rose-600 mt-1"><bdi><%= money(stats.unpaid) %></bdi></div>
  </div>
  <a href="/workshop/parts" class="bg-white rounded-2xl border border-slate-200 p-4 hover:border-brand-300 transition">
    <div class="text-xs text-slate-500 font-semibold"><%= t('wsh.dash.low_parts') %></div>
    <div class="text-xl font-black <%= stats.low ? 'text-amber-600' : 'text-slate-400' %> mt-1"><%= stats.low %></div>
  </a>
</div>

<div class="flex items-center justify-between mb-3">
  <h2 class="font-black text-lg"><%= t('wsh.dash.recent') %></h2>
  <a href="/workshop/jobs" class="text-sm text-brand-700 font-bold">+ <%= t('wsh.dash.new_job') %></a>
</div>

<% if (!recent.length) { %>
  <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center">
    <div class="text-3xl mb-2">🔧</div>
    <p class="text-slate-500 mb-4"><%= t('wsh.dash.none') %></p>
    <a href="/workshop/jobs" class="inline-block bg-brand-600 text-white font-bold rounded-xl px-5 py-2.5"><%= t('wsh.dash.new_job') %></a>
  </div>
<% } else { %>
  <table class="rt w-full bg-white sm:rounded-2xl sm:border border-slate-200 text-sm">
    <thead class="bg-slate-50 text-slate-500 text-xs">
      <tr>
        <th class="text-start px-4 py-2"><%= t('wsh.job.code') %></th>
        <th class="text-start px-4 py-2"><%= t('wsh.veh.plate') %></th>
        <th class="text-start px-4 py-2"><%= t('wsh.job.customer') %></th>
        <th class="text-start px-4 py-2"><%= t('wsh.job.status') %></th>
        <th class="text-start px-4 py-2"><%= t('wsh.job.received') %></th>
      </tr>
    </thead>
    <tbody>
      <% recent.forEach(function(j){ %>
        <tr class="border-t border-slate-100">
          <td class="px-4 py-2" data-l="<%= t('wsh.job.code') %>">
            <a href="/workshop/jobs/<%= j.id %>" class="font-bold text-brand-700"><%= J.jobCode(j.id) %></a>
          </td>
          <td class="px-4 py-2 font-semibold" data-l="<%= t('wsh.veh.plate') %>"><%= j.plate || '—' %></td>
          <td class="px-4 py-2" data-l="<%= t('wsh.job.customer') %>"><%= j.customer_name || '—' %></td>
          <td class="px-4 py-2" data-l="<%= t('wsh.job.status') %>">
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-100"><%= t('wsh.st.' + j.status) %></span>
          </td>
          <td class="px-4 py-2 text-slate-500" data-l="<%= t('wsh.job.received') %>"><%= d(j.received_at) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('foot') %>
