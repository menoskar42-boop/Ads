<%- include('head') %>
<% function money(v){ return Number(v||0).toLocaleString(LOC,{maximumFractionDigits:2}); } %>
<div class="flex items-start justify-between gap-3 flex-wrap mb-5">
  <div>
    <a href="/workshop/invoices" class="text-sm text-slate-500 hover:text-brand-700 no-print">← العودة للفواتير</a>
    <h1 class="font-black text-2xl mt-2">كشف حساب العميل</h1>
    <div class="text-sm text-slate-600 mt-1"><%= customer.name %><% if (customer.phone) { %> · <span dir="ltr"><%= customer.phone %></span><% } %></div>
  </div>
  <div class="flex gap-2 no-print">
    <a href="/workshop/customers/<%= customer.id %>/statement?print=1" class="border border-slate-200 bg-white rounded-xl px-3 py-2 text-sm font-bold">طباعة الكشف</a>
    <button onclick="window.print()" class="border border-slate-200 bg-white rounded-xl px-3 py-2 text-sm font-bold">طباعة</button>
  </div>
</div>
<% if (print) { %><script>window.addEventListener('load', function () { window.print(); });</script><% } %>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
  <div class="bg-white rounded-2xl border border-slate-200 p-4"><div class="text-xs text-slate-500">إجمالي الخدمات</div><div class="font-black text-lg mt-1"><bdi><%= money(total) %></bdi> ج.م</div></div>
  <div class="bg-white rounded-2xl border border-slate-200 p-4"><div class="text-xs text-slate-500">إجمالي المدفوع</div><div class="font-black text-lg text-emerald-700 mt-1"><bdi><%= money(paid) %></bdi> ج.م</div></div>
  <div class="bg-white rounded-2xl border border-slate-200 p-4"><div class="text-xs text-slate-500">الرصيد المتبقي</div><div class="font-black text-lg <%= due ? 'text-rose-600' : 'text-emerald-700' %> mt-1"><bdi><%= money(due) %></bdi> ج.م</div></div>
</div>
<div class="grid lg:grid-cols-2 gap-5">
  <section class="bg-white rounded-2xl border border-slate-200 p-5">
    <h2 class="font-black mb-3">أوامر الشغل</h2>
    <% if (!jobs.length) { %><p class="text-sm text-slate-400">لا توجد أوامر مرتبطة بهذا العميل.</p><% } %>
    <div class="space-y-2">
      <% jobs.forEach(function(job){ %>
        <a href="/workshop/jobs/<%= job.id %>" class="block border-b border-slate-100 pb-2 hover:text-brand-700">
          <div class="flex justify-between gap-2 text-sm"><b><%= job.id ? 'أمر ' + job.id : '' %> · <%= job.customer_name %></b><span><bdi><%= money(job.totals.total) %></bdi></span></div>
          <div class="text-xs text-slate-500 mt-1"><%= t('wsh.st.' + job.status) %> · مدفوع <bdi><%= money(job.totals.paid) %></bdi> · متبقي <bdi><%= money(job.totals.due) %></bdi></div>
        </a>
      <% }) %>
    </div>
  </section>
  <section class="bg-white rounded-2xl border border-slate-200 p-5">
    <h2 class="font-black mb-3">المدفوعات</h2>
    <% if (!payments.length) { %><p class="text-sm text-slate-400">لا توجد مدفوعات مسجلة.</p><% } %>
    <div class="space-y-2">
      <% payments.forEach(function(payment){ %>
        <div class="flex justify-between gap-3 border-b border-slate-100 pb-2 text-sm"><span><%= new Date(payment.paid_at).toLocaleDateString(LOC) %> · <%= payment.method %></span><b class="text-emerald-700"><bdi><%= money(payment.amount) %></bdi></b></div>
      <% }) %>
    </div>
  </section>
</div>
<%- include('foot') %>