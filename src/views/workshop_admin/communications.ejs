<%- include('head') %>
<%
  function dt(v){ try { return v ? new Date(v).toLocaleString(LOC,{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; } catch(e){ return '—'; } }
  function digits(v){ return String(v||'').replace(/[^\d]/g,''); }
%>
<div class="flex items-end justify-between gap-3 flex-wrap mb-5">
  <div><h1 class="font-black text-xl">رسائل العملاء</h1>
    <p class="text-sm text-slate-500 mt-1">النظام يجهز الرسالة ويسجلها. الإرسال يتم عبر WhatsApp أو SMS الذي تختاره، دون تخزين أي سر مزود خارجي.</p></div>
</div>
<section class="bg-white rounded-2xl border border-slate-200 p-4 mb-5">
  <h2 class="font-black mb-3">تجهيز رسالة</h2>
  <form method="post" action="/workshop/communications/prepare" class="grid sm:grid-cols-4 gap-2 text-sm">
    <select name="job_id" required class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-2"><option value="">اختر أمر الشغل</option><% jobs.forEach(function(j){ %><option value="<%= j.id %>">#<%= j.id %> · <%= j.plate || '—' %> · <%= j.customer_name || '—' %></option><% }) %></select>
    <select name="event_key" class="border border-slate-200 rounded-xl px-3 py-2"><option value="received">استلام السيارة</option><option value="quoted">عرض السعر</option><option value="in_progress">بدء العمل</option><option value="done">جاهزة</option><option value="delivered">تم التسليم</option></select>
    <select name="channel" class="border border-slate-200 rounded-xl px-3 py-2"><option value="whatsapp">WhatsApp</option><option value="sms">SMS</option></select>
    <textarea name="body" rows="2" placeholder="اتركها فارغة لاستخدام القالب الجاهز" class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-3"></textarea>
    <button class="bg-brand-600 text-white rounded-xl px-4 py-2 font-bold">تجهيز الرسالة</button>
  </form>
</section>
<section class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
  <div class="p-4 border-b border-slate-100"><h2 class="font-black">السجل</h2></div>
  <% if (!messages.length) { %><p class="p-8 text-center text-sm text-slate-400">لم تُجهّز رسائل بعد.</p><% } else { %>
  <div class="divide-y divide-slate-100">
    <% messages.forEach(function(m){ var to=digits(m.recipient); var href=m.channel==='sms' ? 'sms:'+m.recipient+'?body='+encodeURIComponent(m.body) : 'https://wa.me/'+to+'?text='+encodeURIComponent(m.body); %>
      <div class="p-4">
        <div class="flex items-start justify-between gap-3 flex-wrap"><div><a class="font-bold text-brand-700" href="/workshop/jobs/<%= m.job_id %>">أمر #<%= m.job_id || '—' %></a> · <%= m.customer_name || '—' %> <span dir="ltr" class="text-xs text-slate-500"><%= m.recipient || 'بدون رقم' %></span></div><span class="text-xs rounded-full px-2 py-1 font-bold <%= m.status==='sent'?'bg-emerald-50 text-emerald-700':'bg-amber-50 text-amber-700' %>"><%= m.status==='sent'?'تم الإرسال':'مجهزة للإرسال' %></span></div>
        <p class="text-sm whitespace-pre-line bg-slate-50 rounded-xl p-3 mt-2"><%= m.body %></p>
        <div class="flex items-center gap-2 mt-2 text-xs"><span class="text-slate-400"><%= dt(m.created_at) %></span><% if (to) { %><a target="_blank" rel="noopener" href="<%= href %>" class="bg-emerald-600 text-white rounded-lg px-3 py-1.5 font-bold">فتح <%= m.channel==='sms'?'SMS':'WhatsApp' %></a><% } %><% if (m.status !== 'sent') { %><form method="post" action="/workshop/communications/<%= m.id %>/sent"><button class="border border-slate-200 rounded-lg px-3 py-1.5 font-bold">تسجيل كمرسلة</button></form><% } %></div>
      </div>
    <% }) %>
  </div>
  <% } %>
</section>
<%- include('foot') %>