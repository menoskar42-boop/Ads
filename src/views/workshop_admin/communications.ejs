<%- include('head') %>
<%
  function dt(v){ try { return v ? new Date(v).toLocaleString(LOC,{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; } catch(e){ return '—'; } }
  function digits(v){ return String(v||'').replace(/[^\d]/g,''); }
%>
<div class="flex items-end justify-between gap-3 flex-wrap mb-5">
  <div><h1 class="font-black text-xl">رسائل العملاء</h1>
    <p class="text-sm text-slate-500 mt-1">كل ورشة تستخدم حسابها الخاص. الإرسال الفعلي يسجل نتيجة المزود، والروابط اليدوية تظل متاحة كخطة بديلة.</p></div>
  <a href="/workshop/settings#messaging" class="text-sm font-bold text-brand-700">إعدادات الإرسال ←</a>
</div>
<% if (messaging && messaging.active && (messaging.sms_provider !== 'none' || messaging.whatsapp_provider !== 'none')) { %>
  <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 px-4 py-3 text-sm font-semibold">الإرسال الفعلي مفعّل: <%= messaging.sms_provider !== 'none' ? 'SMS' : '' %><%= messaging.sms_provider !== 'none' && messaging.whatsapp_provider !== 'none' ? ' و' : '' %><%= messaging.whatsapp_provider !== 'none' ? 'WhatsApp' : '' %></div>
<% } else { %>
  <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 px-4 py-3 text-sm font-semibold">لم يتم تفعيل مزود إرسال لهذه الورشة؛ ستظل الرسائل مجهزة مع روابط WhatsApp وSMS اليدوية.</div>
<% } %>
<% if (typeof sent !== 'undefined' && sent) { %><div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 px-4 py-3 text-sm font-semibold">تم قبول الرسالة بواسطة مزود الإرسال.</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-semibold">تعذر إرسال الرسالة أو إعادة المحاولة. راجع السبب في السجل.</div><% } %>
<section class="bg-white rounded-2xl border border-slate-200 p-4 mb-5">
  <h2 class="font-black mb-3">تجهيز رسالة</h2>
  <% if (canWorkshop('prepare_communications')) { %><form method="post" action="/workshop/communications/prepare" class="grid sm:grid-cols-4 gap-2 text-sm">
    <select name="job_id" required class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-2"><option value="">اختر أمر الشغل</option><% jobs.forEach(function(j){ %><option value="<%= j.id %>">#<%= j.id %> · <%= j.plate || '—' %> · <%= j.customer_name || '—' %></option><% }) %></select>
    <select name="event_key" class="border border-slate-200 rounded-xl px-3 py-2"><option value="received">استلام السيارة</option><option value="quoted">عرض السعر</option><option value="in_progress">بدء العمل</option><option value="done">جاهزة</option><option value="delivered">تم التسليم</option></select>
    <select name="channel" class="border border-slate-200 rounded-xl px-3 py-2"><option value="whatsapp">WhatsApp</option><option value="sms">SMS</option></select>
    <textarea name="body" rows="2" placeholder="اتركها فارغة لاستخدام القالب الجاهز" class="border border-slate-200 rounded-xl px-3 py-2 sm:col-span-3"></textarea>
    <label class="flex items-center gap-2 sm:col-span-3"><input type="checkbox" name="send_now" value="1" /> <span>أرسلها فورًا إذا كان المزود مفعّلًا</span></label>
    <button class="bg-brand-600 text-white rounded-xl px-4 py-2 font-bold">تجهيز الرسالة</button>
  </form><% } else { %><p class="text-sm text-slate-500">تجهيز الرسائل متاح للاستقبال وإدارة الورشة فقط.</p><% } %>
</section>
<section class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
  <div class="p-4 border-b border-slate-100"><h2 class="font-black">السجل</h2></div>
  <% if (!messages.length) { %><p class="p-8 text-center text-sm text-slate-400">لم تُجهّز رسائل بعد.</p><% } else { %>
  <div class="divide-y divide-slate-100">
    <% messages.forEach(function(m){ var to=digits(m.recipient); var href=m.channel==='sms' ? 'sms:'+m.recipient+'?body='+encodeURIComponent(m.body) : 'https://wa.me/'+to+'?text='+encodeURIComponent(m.body); %>
      <div class="p-4">
        <div class="flex items-start justify-between gap-3 flex-wrap"><div><a class="font-bold text-brand-700" href="/workshop/jobs/<%= m.job_id %>">أمر #<%= m.job_id || '—' %></a> · <%= m.customer_name || '—' %> <span dir="ltr" class="text-xs text-slate-500"><%= m.recipient || 'بدون رقم' %></span></div><span class="text-xs rounded-full px-2 py-1 font-bold <%= m.status==='sent'?'bg-emerald-50 text-emerald-700':m.status==='failed'?'bg-rose-50 text-rose-700':m.status==='queued'?'bg-blue-50 text-blue-700':'bg-amber-50 text-amber-700' %>"><%= m.status==='sent'?'تم الإرسال':m.status==='failed'?'فشل الإرسال':m.status==='queued'?'جارٍ الإرسال':'مجهزة للإرسال' %></span></div>
        <p class="text-sm whitespace-pre-line bg-slate-50 rounded-xl p-3 mt-2"><%= m.body %></p>
        <% if (m.error) { %><p class="text-xs text-rose-700 mt-2">السبب: <%= m.error %></p><% } %>
        <div class="flex items-center gap-2 mt-2 text-xs flex-wrap"><span class="text-slate-400"><%= dt(m.created_at) %> · محاولات: <%= m.attempt_count || 0 %></span><% if (to) { %><a target="_blank" rel="noopener" href="<%= href %>" class="bg-emerald-600 text-white rounded-lg px-3 py-1.5 font-bold">فتح <%= m.channel==='sms'?'SMS':'WhatsApp' %></a><% } %><% if (canWorkshop('send_communications') && (m.status === 'prepared' || m.status === 'failed')) { %><form method="post" action="/workshop/communications/<%= m.id %>/send"><button class="border border-brand-200 text-brand-700 rounded-lg px-3 py-1.5 font-bold">إرسال الآن</button></form><% } %><% if (canWorkshop('send_communications') && m.status === 'failed' && (m.attempt_count || 0) < 5) { %><form method="post" action="/workshop/communications/<%= m.id %>/retry"><button class="border border-amber-300 text-amber-800 rounded-lg px-3 py-1.5 font-bold">إعادة المحاولة</button></form><% } %></div>
      </div>
    <% }) %>
  </div>
  <% } %>
</section>
<%- include('foot') %>