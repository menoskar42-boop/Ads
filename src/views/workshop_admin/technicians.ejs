<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  var errorLabels = { linked: t('wsh.people.linked'), invalid: t('wsh.people.invalid'), failed: t('wsh.people.delete_failed'), not_found: t('wsh.people.not_found') };
%>
<div class="flex items-start justify-between gap-4 flex-wrap mb-5">
  <div>
    <h1 class="font-black text-xl"><%= t('wsh.tech.title') %></h1>
    <p class="text-sm text-slate-500 mt-1"><%= t('wsh.people.tech_sub') %></p>
  </div>
</div>
<% if (errorLabels[error]) { %><div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-semibold"><%= errorLabels[error] %></div><% } %>

<div class="space-y-3">
<% if (!technicians.length) { %>
  <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-500"><%= t('wsh.tech.empty') %></div>
<% } %>
<% technicians.forEach(function(tech){ %>
  <details class="bg-white rounded-2xl border <%= tech.is_active ? 'border-slate-200' : 'border-amber-200 bg-amber-50/30' %> overflow-hidden">
    <summary class="cursor-pointer list-none px-4 py-3 flex flex-wrap items-center gap-3">
      <span class="font-bold flex-1 min-w-[180px]"><%= tech.name %></span>
      <span class="text-sm text-slate-500"><%= tech.speciality || '—' %></span>
      <span class="text-xs text-slate-500"><%= tech.jobs_count %> <%= t('wsh.people.jobs') %></span>
      <span class="text-xs font-bold rounded-full px-2 py-1 <%= tech.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= tech.is_active ? t('wsh.people.active') : t('wsh.people.inactive') %></span>
    </summary>
    <div class="border-t border-slate-100 p-4 grid lg:grid-cols-[1fr_auto] gap-4">
      <form method="post" action="/workshop/technicians/<%= tech.id %>" class="grid sm:grid-cols-2 gap-2 text-sm">
        <input name="name" required value="<%= tech.name %>" placeholder="<%= t('wsh.cust.name') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
        <input name="speciality" value="<%= tech.speciality || '' %>" placeholder="<%= t('wsh.tech.speciality') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
        <input name="phone" value="<%= tech.phone || '' %>" dir="ltr" placeholder="<%= t('wsh.cust.phone') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
        <select name="pay_type" class="border border-slate-200 rounded-xl px-3 py-2">
          <option value="daily" <%= tech.pay_type === 'daily' ? 'selected' : '' %>><%= t('wsh.tech.daily') %></option>
          <option value="job" <%= tech.pay_type === 'job' ? 'selected' : '' %>><%= t('wsh.tech.job') %></option>
        </select>
        <input name="pay_rate" type="number" step="0.01" min="0" value="<%= tech.pay_rate || 0 %>" dir="ltr" placeholder="<%= t('wsh.tech.rate') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
        <input name="commission_pct" type="number" step="0.01" min="0" max="100" value="<%= tech.commission_pct || 0 %>" dir="ltr" placeholder="<%= t('wsh.tech.commission') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
        <button class="sm:col-span-2 bg-brand-600 text-white font-bold rounded-xl px-4 py-2"><%= t('wsh.common.save') %></button>
      </form>
      <div class="flex lg:flex-col gap-2">
        <form method="post" action="/workshop/technicians/<%= tech.id %>/toggle"><button class="w-full border border-amber-300 text-amber-800 font-bold rounded-xl px-4 py-2 text-sm"><%= tech.is_active ? t('wsh.people.disable') : t('wsh.people.enable') %></button></form>
        <form method="post" action="/workshop/technicians/<%= tech.id %>/delete" onsubmit="return confirm('<%= t('wsh.people.delete_confirm') %>')"><button class="w-full border border-rose-200 text-rose-700 font-bold rounded-xl px-4 py-2 text-sm"><%= t('wsh.common.delete') %></button></form>
      </div>
    </div>
  </details>
<% }) %>
</div>

<h2 class="font-black text-lg mt-8 mb-3"><%= t('wsh.tech.new') %></h2>
<form method="post" action="/workshop/technicians" class="bg-white rounded-2xl border border-slate-200 p-5 grid sm:grid-cols-3 gap-3 text-sm">
  <input name="name" required placeholder="<%= t('wsh.cust.name') %> *" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="speciality" placeholder="<%= t('wsh.tech.speciality') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="phone" dir="ltr" placeholder="<%= t('wsh.cust.phone') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <select name="pay_type" class="border border-slate-200 rounded-xl px-3 py-2">
    <option value="daily"><%= t('wsh.tech.daily') %></option>
    <option value="job"><%= t('wsh.tech.job') %></option>
  </select>
  <input name="pay_rate" type="number" step="0.01" min="0" dir="ltr" placeholder="<%= t('wsh.tech.rate') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="commission_pct" type="number" step="0.01" min="0" max="100" dir="ltr" placeholder="<%= t('wsh.tech.commission') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <div class="sm:col-span-3"><button class="bg-brand-600 text-white font-bold rounded-xl px-6 py-2.5"><%= t('wsh.common.save') %></button></div>
</form>
<%- include('foot') %>
