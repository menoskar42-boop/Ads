<%- include('head') %>
<h1 class="font-black text-xl mb-4"><%= t('wsh.tech.title') %></h1>
<%- include('_table', { empty: t('wsh.tech.empty'), rows: technicians, cols: [
  { label: t('wsh.cust.name'), key: 'name', cls: 'font-semibold' },
  { label: t('wsh.tech.speciality'), key: 'speciality' },
  { label: t('wsh.cust.phone'), key: 'phone' },
  { label: t('wsh.tech.pay_type'), get: function(r){ return t(r.pay_type === 'job' ? 'wsh.tech.job' : 'wsh.tech.daily'); }, badge: true },
  { label: t('wsh.tech.rate'), key: 'pay_rate', money: true },
  { label: t('wsh.inv.labour_revenue'), key: 'month_labour', money: true }
] }) %>
<h2 class="font-black text-lg mt-8 mb-3"><%= t('wsh.tech.new') %></h2>
<form method="post" action="/workshop/technicians" class="bg-white rounded-2xl border border-slate-200 p-5 grid sm:grid-cols-3 gap-3 text-sm">
  <input name="name" required placeholder="<%= t('wsh.cust.name') %> *" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="speciality" placeholder="<%= t('wsh.tech.speciality') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="phone" dir="ltr" placeholder="<%= t('wsh.cust.phone') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <select name="pay_type" class="border border-slate-200 rounded-xl px-3 py-2">
    <option value="daily"><%= t('wsh.tech.daily') %></option>
    <option value="job"><%= t('wsh.tech.job') %></option>
  </select>
  <input name="pay_rate" type="number" step="0.01" min="0" dir="ltr" placeholder="<%= t('wsh.tech.rate') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <input name="commission_pct" type="number" step="0.01" min="0" max="100" dir="ltr" placeholder="<%= t('wsh.tech.commission') %>" class="border border-slate-200 rounded-xl px-3 py-2" />
  <div class="sm:col-span-3"><button class="bg-brand-600 text-white font-bold rounded-xl px-6 py-2.5"><%= t('wsh.common.save') %></button></div>
</form>
<%- include('foot') %>
