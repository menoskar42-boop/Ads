<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('partials/ads_loader') %>
  <% var displayName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <% var displayDesc = pickContent(company, 'description', company.content_i18n) || company.description || ''; %>
  <% var cur = company.currency || 'EGP'; %>
  <% var catIcons = ['📱','👕','🏠','💄','⚽','🎮','📚','🍔','🚗','👶','🎧','⌚']; %>
  <% var isDelta = company.slug === 'delta'; %>
  <% var defaultPromos = ['🚀 شحن سريع لكل المحافظات','💳 الدفع عند الاستلام متاح','🎁 عروض وخصومات مستمرة','⚡ تسوّق آمن 100%']; %>
  <% var promoItems = (company.promo_text && company.promo_text.trim()) ? company.promo_text.split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean) : defaultPromos; %>
  <% var heroHeadline = company.hero_headline || 'كل اللي محتاجه في مكان واحد'; %>
  <% var heroSub = company.hero_subtext || displayDesc || 'منتجات مختارة بعناية، أسعار مناسبة، وتوصيل سريع وآمن.'; %>
  <% var heroCta = company.hero_cta_text || 'تسوّق الآن'; %>
  <% var heroBanners1 = (banners || []).filter(function(b){ return b.slot === 'hero1'; }); %>
  <% var heroBanners2 = (banners || []).filter(function(b){ return b.slot === 'hero2'; }); %>
  <% var sectionBanners = (banners || []).filter(function(b){ return !b.slot || b.slot === 'section'; }); %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
  <title><%= displayName %></title>
  <meta name="description" content="<%= (displayDesc || displayName).slice(0, 160) %>" />
  <%- include('partials/seo_meta', {
    title: displayName,
    description: (displayDesc || displayName).slice(0, 160),
    canonical: canonicalCompanyUrl(company.slug),
    ogImage: company.logo_url || (siteOrigin + '/og-default.png'),
    siteLogo: company.logo_url || '',
    siteManifest: '/manifest.webmanifest',
    siteAppName: displayName
  }) %>
  <%- include('partials/company_jsonld', { company: company }) %>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/shop.css" />
  <style>
    :root {
      --primary: <%= company.theme_color %>;
      --primary-d: color-mix(in srgb, <%= company.theme_color %> 78%, #000);
      --primary-l: color-mix(in srgb, <%= company.theme_color %> 12%, #fff);
      <% if (company.color_accent) { %>--accent: <%= company.color_accent %>; --accent-d: color-mix(in srgb, <%= company.color_accent %> 80%, #000);<% } %>
    }
    <% if (company.hero_card1_color) { %>.hero-card-1 { background: linear-gradient(135deg, <%= company.hero_card1_color %>, color-mix(in srgb, <%= company.hero_card1_color %> 68%, #000)); }<% } %>
    <% if (company.hero_card2_color) { %>.hero-card-2 { background: linear-gradient(135deg, <%= company.hero_card2_color %>, color-mix(in srgb, <%= company.hero_card2_color %> 68%, #000)); }<% } %>
    <% if (company.hero_text_color) { %>.hero-main, .hero-main h1, .hero-main p, .hero-main .hero-tag { color: <%= company.hero_text_color %>; }<% } %>
    <% if (company.hero_btn_bg) { %>.hero-main .btn-light { background: <%= company.hero_btn_bg %>; }<% } %>
    <% if (company.hero_btn_text) { %>.hero-main .btn-light, .hero-main .btn-light span { color: <%= company.hero_btn_text %>; }<% } %>
  </style>
</head>
<body>
<script>window.SHOP_SLUG = <%- jsonLd(company.slug) %>;</script>
<% var __on = function(k){ return typeof feat === 'undefined' || feat[k] !== false; }; %>
<%# Merchant marketing pixels (phase 24) — the store owner's own tracking IDs %>
<% if (company.fb_pixel_id) { %>
<script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= company.fb_pixel_id %>');fbq('track','PageView');</script>
<% } %>
<% if (company.tiktok_pixel_id) { %>
<script>!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.load=function(e){var n="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=n;ttq._t=ttq._t||{};ttq._t[e]=+new Date;var o=d.createElement("script");o.type="text/javascript";o.async=!0;o.src=n+"?sdkid="+e;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};ttq.load('<%= company.tiktok_pixel_id %>');ttq.page()}(window,document,'ttq');</script>
<% } %>
<% if (company.ga4_id) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= company.ga4_id %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= company.ga4_id %>');</script>
<% } %>

<!-- Promo marquee -->
<% if (company.show_promo_bar !== false) { %>
<div class="top-bar">
  <div class="top-bar-track">
    <% for (var rep = 0; rep < 2; rep++) { %>
      <% promoItems.forEach(function(msg, i){ %>
        <span><%= msg %></span><% if (!(rep === 1 && i === promoItems.length - 1)) { %><span class="dot">●</span><% } %>
      <% }) %>
    <% } %>
  </div>
</div>
<% } %>

<!-- Nav -->
<nav>
  <a href="<%= canonicalCompanyUrl(company.slug) %>" class="logo">
    <div class="logo-mark">
      <% if (company.logo_url) { %>
        <img src="<%= company.logo_url %>" alt="<%= displayName %>" />
      <% } else { %><%= (displayName || ' ').charAt(0) %><% } %>
    </div>
    <span><%= displayName %></span>
  </a>
  <form class="search-wrap" id="shopSearchForm" method="GET" action="<%= canonicalCompanyUrl(company.slug) %>" style="position:relative;" autocomplete="off">
    <input type="text" id="shopSearchInput" name="q" value="<%= currentSearch || '' %>" placeholder="<%= t('public.search_products') %>" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="searchSuggest" />
    <% if (currentCategory) { %><input type="hidden" name="category" value="<%= currentCategory %>" /><% } %>
    <button class="search-btn" type="submit" aria-label="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
    <% if (__on('search')) { %><div id="searchSuggest" role="listbox" hidden style="position:absolute;top:calc(100% + 6px);inset-inline:0;background:#fff;border:1px solid #e5e7eb;border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.12);z-index:60;overflow:hidden;max-height:70vh;overflow-y:auto;"></div><% } %>
  </form>
  <div class="nav-actions">
    <% if (__on('wishlist')) { %>
    <a href="/customer/wishlist" class="nav-icon" id="wishlistBtn" aria-label="wishlist" style="position:relative">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
      <span class="badge" id="wishBadge" style="display:none">0</span>
    </a>
    <% } %>
    <a href="/customer/login" class="nav-icon" aria-label="account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </a>
    <a href="/shop/<%= company.slug %>/cart" class="nav-icon" id="cartBtn" aria-label="cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="badge" id="cartBadge" style="<%= cartCount > 0 ? '' : 'display:none' %>"><%= cartCount %></span>
    </a>
  </div>
</nav>

<% var __curFeatOn = (typeof feat === 'undefined' || feat.multi_currency !== false); %>
<% if (__curFeatOn && typeof storeCurrencies !== 'undefined' && storeCurrencies.length) { %>
<!-- Multi-currency display switcher (phase 33) -->
<div style="display:flex;justify-content:flex-end;max-width:1100px;margin:8px auto 0;padding:0 16px">
  <select id="odvCurSel" aria-label="العملة" style="border:1px solid #e5e7eb;border-radius:10px;padding:5px 10px;font-size:13px;background:#fff;color:#374151">
    <option value="__base" data-rate="1" data-sym="<%= cur %>"><%= cur %> (الأساسية)</option>
    <% storeCurrencies.forEach(function(c){ %>
      <option value="<%= c.code %>" data-rate="<%= Number(c.rate) %>" data-sym="<%= c.symbol %>"><%= c.code %> (<%= c.symbol %>)</option>
    <% }); %>
  </select>
</div>
<script>
(function(){
  var sel = document.getElementById('odvCurSel'); if (!sel) return;
  var KEY = 'odv_cur_' + <%- jsonLd(company.slug) %>;
  function apply(){
    var o = sel.options[sel.selectedIndex];
    var rate = parseFloat(o.getAttribute('data-rate')) || 1;
    var sym = o.getAttribute('data-sym') || '';
    document.querySelectorAll('.odv-price[data-odv-base]').forEach(function(el){
      var base = parseFloat(el.getAttribute('data-odv-base')); if (isNaN(base)) return;
      el.textContent = (Math.round(base * rate * 100) / 100).toFixed(2);
    });
    document.querySelectorAll('.odv-cur').forEach(function(el){ el.textContent = sym; });
    try { localStorage.setItem(KEY, sel.value); } catch(e){}
  }
  try { var saved = localStorage.getItem(KEY); if (saved){ for (var i=0;i<sel.options.length;i++){ if(sel.options[i].value===saved){ sel.selectedIndex=i; break; } } } } catch(e){}
  sel.addEventListener('change', apply);
  apply();
})();
</script>
<% } %>

<!-- Category strip -->
<% if (categories && categories.length) { %>
<div class="cat-strip">
  <div class="cat-strip-inner">
    <a class="cat-pill <%= !currentCategory ? 'active' : '' %>" href="<%= canonicalCompanyUrl(company.slug) %><%= currentSearch ? '?q=' + encodeURIComponent(currentSearch) : '' %>"><%= t('public.all_categories') %></a>
    <% categories.forEach(c => { %>
      <a class="cat-pill <%= String(currentCategory) === String(c.id) ? 'active' : '' %>" href="<%= canonicalCompanyUrl(company.slug) %>?category=<%= c.id %><%= currentSearch ? '&q=' + encodeURIComponent(currentSearch) : '' %>"><%= pickContent(c, 'name', company.content_i18n) || c.name %></a>
    <% }) %>
  </div>
</div>
<% } %>

<div style="padding:12px 32px;background:#fff;border-bottom:1px solid var(--line)"><%- include('partials/ad_unit', { slot: ads.slots.shopTop }) %></div>

<!-- Hero -->
<section class="hero">
  <div class="hero-main reveal">
    <% if (company.show_banners !== false && sectionBanners && sectionBanners.length) { %>
    <div class="hero-bg-slides"<%- sectionBanners.length > 1 ? ' data-slides' : '' %>>
      <% sectionBanners.forEach(function(b, i){ %>
        <div class="hero-bg-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')"></div>
      <% }) %>
    </div>
    <% } %>
    <div class="hero-content">
      <div class="hero-tag"><span class="pulse"></span> أهلاً بك في متجر <%= displayName %></div>
      <h1><%= heroHeadline %></h1>
      <p><%= heroSub %></p>
      <div class="hero-cta-row">
        <a href="#products"><button class="btn-light"><%= heroCta %> <span>←</span></button></a>
        <a href="/shop/<%= company.slug %>/cart"><button class="btn-outline"><%= t('public.cart') %></button></a>
      </div>
    </div>
  </div>
  <% if (company.show_hero_cards !== false) { %>
  <div class="hero-side">
    <div class="hero-card hero-card-1 reveal">
      <% if (heroBanners1.length) { %>
        <div class="hero-slides"<%= heroBanners1.length > 1 ? ' data-slides' : '' %>>
          <% heroBanners1.forEach(function(b, i){ %>
            <a class="hero-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')" href="<%= safeUrl(b.target_url) %>" <%- b.target_url ? 'target="_blank" rel="noopener"' : '' %>>
              <% if (b.caption) { %><span class="hero-slide-cap"><%= b.caption %></span><% } %>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="label">تشكيلة مميزة</div>
        <h2>منتجات<br>وصلت حديثاً</h2>
        <span class="price-strip">تصفّح الجديد</span>
        <div class="arrow">←</div>
      <% } %>
    </div>
    <div class="hero-card hero-card-2 reveal">
      <% if (heroBanners2.length) { %>
        <div class="hero-slides"<%= heroBanners2.length > 1 ? ' data-slides' : '' %>>
          <% heroBanners2.forEach(function(b, i){ %>
            <a class="hero-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')" href="<%= safeUrl(b.target_url) %>" <%- b.target_url ? 'target="_blank" rel="noopener"' : '' %>>
              <% if (b.caption) { %><span class="hero-slide-cap"><%= b.caption %></span><% } %>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="label">دفع آمن</div>
        <h2>الدفع عند<br>الاستلام</h2>
        <span class="price-strip">+ شحن سريع</span>
        <div class="arrow">←</div>
      <% } %>
    </div>
  </div>
  <% } %>
</section>

<!-- (Section banners now render in the hero main area above) -->

<!-- Products -->
<section class="flash" id="products">
  <div class="flash-head">
    <div class="flash-title-wrap">
      <div class="flash-bolt">⚡</div>
      <div>
        <div class="flash-title">
          <% if (currentSearch) { %>نتائج: "<%= currentSearch %>"<% } else { %>كل المنتجات<% } %>
        </div>
        <div class="flash-sub">اكتشف تشكيلتنا واطلب بسهولة</div>
      </div>
    </div>
    <div class="countdown">
      <span>عروض تنتهي خلال</span>
      <div class="countdown-box" id="cd-h">12</div><span>:</span>
      <div class="countdown-box" id="cd-m">34</div><span>:</span>
      <div class="countdown-box" id="cd-s">56</div>
    </div>
  </div>

  <% if (__on('filters') && typeof shopFilters !== 'undefined') { var _hasFilter = (shopFilters.sort || shopFilters.min !== '' || shopFilters.max !== '' || shopFilters.instock || currentCategory || currentSearch); %>
  <form class="shop-filters" method="GET" action="<%= canonicalCompanyUrl(company.slug) %>" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 0;padding:10px 12px;background:#fff;border:1px solid #eef0f2;border-radius:14px">
    <% if (currentSearch) { %><input type="hidden" name="q" value="<%= currentSearch %>" /><% } %>
    <% if (currentCategory) { %><input type="hidden" name="category" value="<%= currentCategory %>" /><% } %>
    <label style="font-size:13px;font-weight:700;color:#374151">ترتيب</label>
    <select name="sort" onchange="this.form.submit()" style="border:1px solid #e5e7eb;border-radius:10px;padding:6px 10px;font-size:13px;background:#fff">
      <option value="">الأحدث</option>
      <option value="price_asc" <%= shopFilters.sort==='price_asc'?'selected':'' %>>الأرخص</option>
      <option value="price_desc" <%= shopFilters.sort==='price_desc'?'selected':'' %>>الأغلى</option>
      <option value="best" <%= shopFilters.sort==='best'?'selected':'' %>>الأكثر مبيعاً</option>
    </select>
    <span style="width:1px;height:22px;background:#eef0f2"></span>
    <label style="font-size:13px;font-weight:700;color:#374151">السعر</label>
    <input type="number" name="min" value="<%= shopFilters.min %>" placeholder="من<%= shopPriceRange.max ? (' ' + shopPriceRange.min) : '' %>" min="0" inputmode="numeric" style="width:78px;border:1px solid #e5e7eb;border-radius:10px;padding:6px 8px;font-size:13px" />
    <input type="number" name="max" value="<%= shopFilters.max %>" placeholder="إلى<%= shopPriceRange.max ? (' ' + shopPriceRange.max) : '' %>" min="0" inputmode="numeric" style="width:78px;border:1px solid #e5e7eb;border-radius:10px;padding:6px 8px;font-size:13px" />
    <label style="display:flex;align-items:center;gap:5px;font-size:13px;color:#374151;font-weight:600;cursor:pointer"><input type="checkbox" name="instock" value="1" onchange="this.form.submit()" <%= shopFilters.instock?'checked':'' %> /> متوفر فقط</label>
    <button type="submit" style="background:var(--brand,#4f46e5);color:#fff;border:none;border-radius:10px;padding:6px 14px;font-size:13px;font-weight:700;cursor:pointer">تطبيق</button>
    <% if (_hasFilter) { %><a href="<%= canonicalCompanyUrl(company.slug) %>" style="font-size:13px;color:#6b7280;text-decoration:underline">مسح الكل</a><% } %>
  </form>
  <% } %>

  <% if (!products.length) { %>
    <div class="empty-state">
      <p style="font-weight:700;font-size:1.05rem;color:var(--ink-2)"><%= t('public.no_products') %></p>
      <% if (currentSearch || currentCategory) { %>
        <p style="margin-top:8px"><a href="<%= canonicalCompanyUrl(company.slug) %>"><%= t('public.clear_filters') %></a></p>
      <% } %>
    </div>
  <% } else { %>
    <% var adMid = (ads.slots.shopInGrid && products.length >= 4) ? Math.floor(products.length / 2) : -1; %>
    <div class="grid">
      <% products.forEach((p, idx) => { %>
        <% var pName = pickContent(p, 'name', company.content_i18n) || p.name; %>
        <% var pCat = (categories.find(c => String(c.id) === String(p.category_id)) || {}); %>
        <% var pCatName = pCat.id ? (pickContent(pCat, 'name', company.content_i18n) || pCat.name) : ''; %>
        <%
          var disc = 0, oldPrice = 0, stars = '', reviews = 0, dealEnds = null, showPrice = Number(p.price);
          var __deal = (typeof deals !== 'undefined' && deals && deals[p.id]) ? deals[p.id] : null;
          if (typeof __on === 'function' && __on('deals') && __deal) {
            disc = __deal.discount_pct; oldPrice = Number(p.price);
            showPrice = oldPrice * (1 - disc / 100); dealEnds = __deal.ends_at;
          } else if (isDelta) {
            var discs = [10, 15, 20, 25, 30, 40];
            disc = discs[p.id % discs.length];
            oldPrice = Number(p.price) / (1 - disc / 100);
            stars = (p.id % 4 === 0) ? '★★★★☆' : '★★★★★';
            reviews = ((p.id * 137) % 4800) + 200;
          }
        %>
        <div class="product-card reveal">
          <a class="pc-img-wrap" href="/shop/<%= company.slug %>/product/<%= p.id %>">
            <div class="pc-img" style="background-image:url('<%= p.image_url || '' %>'); background-color: var(--line-soft);"></div>
            <% if (p.stock <= 0) { %><div class="pc-badge out"><%= t('public.out_of_stock') %></div>
            <% } else if (disc > 0) { %><div class="pc-badge">-<%= disc %>%</div><% } %>
            <% if (dealEnds) { %><div class="pc-badge" style="inset-inline-start:8px;inset-inline-end:auto;background:#111827;" data-deal-ends="<%= new Date(dealEnds).toISOString() %>">⏳ <span class="deal-cd">عرض</span></div><% } %>
          </a>
          <% if (__on('wishlist')) { %>
          <button class="pc-fav" type="button" aria-label="favorite" data-fav="<%= p.id %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          </button>
          <% } %>
          <% if (__on('compare')) { %>
          <label class="pc-compare" style="position:absolute;top:8px;inset-inline-start:8px;display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.9);border-radius:8px;padding:3px 7px;font-size:11px;font-weight:700;color:#374151;cursor:pointer;z-index:5;">
            <input type="checkbox" class="cmp-box" data-cmp="<%= p.id %>" data-name="<%= (p.name_ar||p.name) %>" style="width:14px;height:14px;" /> قارن
          </label>
          <% } %>
          <div class="pc-info">
            <% if (pCatName) { %><div class="pc-cat"><%= pCatName %></div><% } %>
            <a href="/shop/<%= company.slug %>/product/<%= p.id %>"><div class="pc-name"><%= pName %></div></a>
            <% if (isDelta) { %><div class="pc-rating"><span class="pc-stars"><%= stars %></span><span>(<%= reviews.toLocaleString('en-US') %>)</span></div><% } %>
            <div class="pc-price-row">
              <span class="pc-price"><% if (disc > 0) { %><span class="pc-old odv-price" data-odv-base="<%= oldPrice.toFixed(2) %>"><%= oldPrice.toFixed(2) %></span><% } %><span class="odv-price" data-odv-base="<%= showPrice.toFixed(2) %>"><%= showPrice.toFixed(2) %></span> <span class="odv-cur"><%= cur %></span></span>
              <% if (p.stock > 0) { %>
                <button class="pc-add" type="button" data-product="<%= p.id %>" data-name="<%= pName %>" aria-label="<%= t('public.add_to_cart') %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
