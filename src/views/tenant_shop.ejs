<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3132188303904900" crossorigin="anonymous"></script>
  <% var displayName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <% var displayDesc = pickContent(company, 'description', company.content_i18n) || company.description || ''; %>
  <% var cur = company.currency || 'EGP'; %>
  <% var catIcons = ['📱','👕','🏠','💄','⚽','🎮','📚','🍔','🚗','👶','🎧','⌚']; %>
  <% var isDelta = company.slug === 'delta'; %>
  <% var defaultPromos = ['🚀 شحن سريع لكل المحافظات','💳 الدفع عند الاستلام متاح','🎁 عروض وخصومات مستمرة','⚡ تسوّق آمن 100%']; %>
  <% var promoItems = (company.promo_text && company.promo_text.trim()) ? company.promo_text.split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean) : defaultPromos; %>
  <% var heroHeadline = company.hero_headline || 'كل اللي محتاجه في مكان واحد'; %>
  <% var heroSub = company.hero_subtext || displayDesc || 'منتجات مختارة بعناية، أسعار مناسبة، وتوصيل سريع وآمن.'; %>
  <% var heroCta = company.hero_cta_text || 'تسوّق الآن'; %>
  <% var heroBanners1 = (banners || []).filter(function(b){ return b.slot === 'hero1'; }); %>
  <% var heroBanners2 = (banners || []).filter(function(b){ return b.slot === 'hero2'; }); %>
  <% var sectionBanners = (banners || []).filter(function(b){ return !b.slot || b.slot === 'section'; }); %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= displayName %></title>
  <meta name="description" content="<%= displayDesc || displayName %>" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/shop.css" />
  <style>
    :root {
      --primary: <%= company.theme_color %>;
      --primary-d: color-mix(in srgb, <%= company.theme_color %> 78%, #000);
      --primary-l: color-mix(in srgb, <%= company.theme_color %> 12%, #fff);
      <% if (company.color_accent) { %>--accent: <%= company.color_accent %>; --accent-d: color-mix(in srgb, <%= company.color_accent %> 80%, #000);<% } %>
    }
    <% if (company.hero_card1_color) { %>.hero-card-1 { background: linear-gradient(135deg, <%= company.hero_card1_color %>, color-mix(in srgb, <%= company.hero_card1_color %> 68%, #000)); }<% } %>
    <% if (company.hero_card2_color) { %>.hero-card-2 { background: linear-gradient(135deg, <%= company.hero_card2_color %>, color-mix(in srgb, <%= company.hero_card2_color %> 68%, #000)); }<% } %>
    <% if (company.hero_text_color) { %>.hero-main, .hero-main h1, .hero-main p, .hero-main .hero-tag { color: <%= company.hero_text_color %>; }<% } %>
    <% if (company.hero_btn_bg) { %>.hero-main .btn-light { background: <%= company.hero_btn_bg %>; }<% } %>
    <% if (company.hero_btn_text) { %>.hero-main .btn-light, .hero-main .btn-light span { color: <%= company.hero_btn_text %>; }<% } %>
  </style>
</head>
<body>
<script>window.SHOP_SLUG = <%- JSON.stringify(company.slug) %>;</script>

<!-- Promo marquee -->
<% if (company.show_promo_bar !== false) { %>
<div class="top-bar">
  <div class="top-bar-track">
    <% for (var rep = 0; rep < 2; rep++) { %>
      <% promoItems.forEach(function(msg, i){ %>
        <span><%= msg %></span><% if (!(rep === 1 && i === promoItems.length - 1)) { %><span class="dot">●</span><% } %>
      <% }) %>
    <% } %>
  </div>
</div>
<% } %>

<!-- Nav -->
<nav>
  <a href="<%= canonicalCompanyUrl(company.slug) %>" class="logo">
    <div class="logo-mark">
      <% if (company.logo_url) { %>
        <img src="<%= company.logo_url %>" alt="<%= displayName %>" />
      <% } else { %><%= (displayName || ' ').charAt(0) %><% } %>
    </div>
    <span><%= displayName %></span>
  </a>
  <form class="search-wrap" method="GET" action="<%= canonicalCompanyUrl(company.slug) %>">
    <input type="text" name="q" value="<%= currentSearch || '' %>" placeholder="<%= t('public.search_products') %>" />
    <% if (currentCategory) { %><input type="hidden" name="category" value="<%= currentCategory %>" /><% } %>
    <button class="search-btn" type="submit" aria-label="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
  </form>
  <div class="nav-actions">
    <a href="/customer/login" class="nav-icon" aria-label="account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </a>
    <a href="/shop/<%= company.slug %>/cart" class="nav-icon" id="cartBtn" aria-label="cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="badge" id="cartBadge" style="<%= cartCount > 0 ? '' : 'display:none' %>"><%= cartCount %></span>
    </a>
  </div>
</nav>

<!-- Category strip -->
<% if (categories && categories.length) { %>
<div class="cat-strip">
  <div class="cat-strip-inner">
    <a class="cat-pill <%= !currentCategory ? 'active' : '' %>" href="<%= canonicalCompanyUrl(company.slug) %><%= currentSearch ? '?q=' + encodeURIComponent(currentSearch) : '' %>"><%= t('public.all_categories') %></a>
    <% categories.forEach(c => { %>
      <a class="cat-pill <%= String(currentCategory) === String(c.id) ? 'active' : '' %>" href="<%= canonicalCompanyUrl(company.slug) %>?category=<%= c.id %><%= currentSearch ? '&q=' + encodeURIComponent(currentSearch) : '' %>"><%= pickContent(c, 'name', company.content_i18n) || c.name %></a>
    <% }) %>
  </div>
</div>
<% } %>

<% if (company.adsense_top) { %><div style="padding:12px 32px;background:#fff;border-bottom:1px solid var(--line)"><%- company.adsense_top %></div><% } %>

<!-- Hero -->
<section class="hero">
  <div class="hero-main reveal">
    <% if (company.show_banners !== false && sectionBanners && sectionBanners.length) { %>
    <div class="hero-bg-slides"<%- sectionBanners.length > 1 ? ' data-slides' : '' %>>
      <% sectionBanners.forEach(function(b, i){ %>
        <div class="hero-bg-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')"></div>
      <% }) %>
    </div>
    <% } %>
    <div class="hero-content">
      <div class="hero-tag"><span class="pulse"></span> أهلاً بك في متجر <%= displayName %></div>
      <h1><%= heroHeadline %></h1>
      <p><%= heroSub %></p>
      <div class="hero-cta-row">
        <a href="#products"><button class="btn-light"><%= heroCta %> <span>←</span></button></a>
        <a href="/shop/<%= company.slug %>/cart"><button class="btn-outline"><%= t('public.cart') %></button></a>
      </div>
    </div>
  </div>
  <% if (company.show_hero_cards !== false) { %>
  <div class="hero-side">
    <div class="hero-card hero-card-1 reveal">
      <% if (heroBanners1.length) { %>
        <div class="hero-slides"<%= heroBanners1.length > 1 ? ' data-slides' : '' %>>
          <% heroBanners1.forEach(function(b, i){ %>
            <a class="hero-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')" href="<%= b.target_url || '#' %>" <%- b.target_url ? 'target="_blank" rel="noopener"' : '' %>>
              <% if (b.caption) { %><span class="hero-slide-cap"><%= b.caption %></span><% } %>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="label">تشكيلة مميزة</div>
        <h3>منتجات<br>وصلت حديثاً</h3>
        <span class="price-strip">تصفّح الجديد</span>
        <div class="arrow">←</div>
      <% } %>
    </div>
    <div class="hero-card hero-card-2 reveal">
      <% if (heroBanners2.length) { %>
        <div class="hero-slides"<%= heroBanners2.length > 1 ? ' data-slides' : '' %>>
          <% heroBanners2.forEach(function(b, i){ %>
            <a class="hero-slide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= b.image_url %>')" href="<%= b.target_url || '#' %>" <%- b.target_url ? 'target="_blank" rel="noopener"' : '' %>>
              <% if (b.caption) { %><span class="hero-slide-cap"><%= b.caption %></span><% } %>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="label">دفع آمن</div>
        <h3>الدفع عند<br>الاستلام</h3>
        <span class="price-strip">+ شحن سريع</span>
        <div class="arrow">←</div>
      <% } %>
    </div>
  </div>
  <% } %>
</section>

<!-- (Section banners now render in the hero main area above) -->

<!-- Products -->
<section class="flash" id="products">
  <div class="flash-head">
    <div class="flash-title-wrap">
      <div class="flash-bolt">⚡</div>
      <div>
        <div class="flash-title">
          <% if (currentSearch) { %>نتائج: "<%= currentSearch %>"<% } else { %>كل المنتجات<% } %>
        </div>
        <div class="flash-sub">اكتشف تشكيلتنا واطلب بسهولة</div>
      </div>
    </div>
    <div class="countdown">
      <span>عروض تنتهي خلال</span>
      <div class="countdown-box" id="cd-h">12</div><span>:</span>
      <div class="countdown-box" id="cd-m">34</div><span>:</span>
      <div class="countdown-box" id="cd-s">56</div>
    </div>
  </div>

  <% if (!products.length) { %>
    <div class="empty-state">
      <p style="font-weight:700;font-size:1.05rem;color:var(--ink-2)"><%= t('public.no_products') %></p>
      <% if (currentSearch || currentCategory) { %>
        <p style="margin-top:8px"><a href="<%= canonicalCompanyUrl(company.slug) %>"><%= t('public.clear_filters') %></a></p>
      <% } %>
    </div>
  <% } else { %>
    <% var adMid = company.adsense_sidebar ? Math.floor(products.length / 2) : -1; %>
    <div class="grid">
      <% products.forEach((p, idx) => { %>
        <% var pName = pickContent(p, 'name', company.content_i18n) || p.name; %>
        <% var pCat = (categories.find(c => String(c.id) === String(p.category_id)) || {}); %>
        <% var pCatName = pCat.id ? (pickContent(pCat, 'name', company.content_i18n) || pCat.name) : ''; %>
        <%
          var disc = 0, oldPrice = 0, stars = '', reviews = 0;
          if (isDelta) {
            var discs = [10, 15, 20, 25, 30, 40];
            disc = discs[p.id % discs.length];
            oldPrice = Number(p.price) / (1 - disc / 100);
            stars = (p.id % 4 === 0) ? '★★★★☆' : '★★★★★';
            reviews = ((p.id * 137) % 4800) + 200;
          }
        %>
        <div class="product-card reveal">
          <a class="pc-img-wrap" href="/shop/<%= company.slug %>/product/<%= p.id %>">
            <div class="pc-img" style="background-image:url('<%= p.image_url || '' %>'); background-color: var(--line-soft);"></div>
            <% if (p.stock <= 0) { %><div class="pc-badge out"><%= t('public.out_of_stock') %></div>
            <% } else if (isDelta) { %><div class="pc-badge">-<%= disc %>%</div><% } %>
          </a>
          <button class="pc-fav" type="button" aria-label="favorite">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          </button>
          <div class="pc-info">
            <% if (pCatName) { %><div class="pc-cat"><%= pCatName %></div><% } %>
            <a href="/shop/<%= company.slug %>/product/<%= p.id %>"><div class="pc-name"><%= pName %></div></a>
            <% if (isDelta) { %><div class="pc-rating"><span class="pc-stars"><%= stars %></span><span>(<%= reviews.toLocaleString('en-US') %>)</span></div><% } %>
            <div class="pc-price-row">
              <span class="pc-price"><% if (isDelta) { %><span class="pc-old"><%= oldPrice.toFixed(2) %></span><% } %><%= Number(p.price).toFixed(2) %> <%= cur %></span>
              <% if (p.stock > 0) { %>
                <button class="pc-add" type="button" data-product="<%= p.id %>" data-name="<%= pName %>" aria-label="<%= t('public.add_to_cart') %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </button>
              <% } else { %>
                <button class="pc-add" type="button" disabled aria-label="out of stock">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/></svg>
                </button>
              <% } %>
            </div>
          </div>
        </div>
        <% if (idx === adMid) { %>
          <div class="shop-ad-banner"><%- company.adsense_sidebar %></div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- Shop by category -->
<% if (company.show_categories !== false && categories && categories.length) { %>
<section class="cats">
  <div class="section-head">
    <div>
      <h2 class="section-title">تسوّق حسب التصنيف</h2>
      <div class="section-sub">اكتشف منتجاتنا في كل قسم</div>
    </div>
    <a href="<%= canonicalCompanyUrl(company.slug) %>" class="view-all"><%= t('public.all_categories') %> ←</a>
  </div>
  <div class="cats-grid">
    <% categories.forEach((c, i) => { %>
      <a class="cat-tile reveal" href="<%= canonicalCompanyUrl(company.slug) %>?category=<%= c.id %>">
        <div class="cat-tile-icon"><%= catIcons[i % catIcons.length] %></div>
        <div class="cat-tile-name"><%= pickContent(c, 'name', company.content_i18n) || c.name %></div>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Trust bar -->
<% if (company.show_trust_bar !== false) { %>
<section class="trust-bar">
  <div class="trust-item">
    <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 18a3 3 0 1 0 6 0M13 18a3 3 0 1 0 6 0M16 18V6h-3l-3 4H7v8M16 18H7"/></svg></div>
    <div class="trust-text"><h4>شحن سريع</h4><p>توصيل لكل المحافظات</p></div>
  </div>
  <div class="trust-item">
    <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg></div>
    <div class="trust-text"><h4>إرجاع سهل</h4><p>استبدال خلال أيام</p></div>
  </div>
  <div class="trust-item">
    <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
    <div class="trust-text"><h4>دفع آمن</h4><p>الدفع عند الاستلام</p></div>
  </div>
  <div class="trust-item">
    <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
    <div class="trust-text"><h4>دعم متواصل</h4><p>في خدمتك دائماً</p></div>
  </div>
</section>
<% } %>

<% if (isDelta) { %>
<!-- Demo: app download (Delta showcase only) -->
<section class="app-cta">
  <div class="app-cta-content">
    <h2>حمّل تطبيق <%= displayName %><br>واحصل على <span class="accent">15%</span> خصم</h2>
    <p>تسوّق أسرع، تتبع طلباتك، واستلم إشعارات عروض حصرية مباشرة على جوالك.</p>
    <div class="app-stores">
      <a href="#" class="app-badge"><img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" /></a>
      <a href="#" class="app-badge"><img src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png" alt="Get it on Google Play" /></a>
    </div>
  </div>
  <div class="phone-mockup">
    <div class="phone">
      <div class="phone-screen">
        <div class="phone-top">صباح الخير ☀</div>
        <div class="phone-mid">15%<br>خصم<br>اليوم!</div>
        <div class="phone-bottom">
          <div class="phone-icon">🛍</div>
          <div><div style="font-size:0.75rem;opacity:0.8">سلتك جاهزة</div><div style="font-weight:700;font-size:0.95rem">184.50 <%= cur %></div></div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (company.adsense_bottom) { %><div style="padding:24px 32px"><%- company.adsense_bottom %></div><% } %>

<!-- Contact -->
<% if (company.show_contact !== false) { %>
<section class="shop-contact" id="contact">
  <h2 class="section-title">تواصل معنا</h2>
  <% if (company.contact_phone || company.contact_whatsapp || company.contact_email || company.contact_address) { %>
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:18px;">
      <% if (company.contact_whatsapp) { %><a href="https://wa.me/<%= company.contact_whatsapp.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;background:#DCFFE4;color:#00794F;font-weight:700;font-size:0.85rem;padding:10px 18px;border-radius:100px;">💬 واتساب</a><% } %>
      <% if (company.contact_phone) { %><a href="tel:<%= company.contact_phone.replace(/[^0-9+]/g,'') %>" style="display:inline-flex;align-items:center;gap:8px;background:var(--primary-l);color:var(--primary);font-weight:700;font-size:0.85rem;padding:10px 18px;border-radius:100px;">📞 <%= company.contact_phone %></a><% } %>
      <% if (company.contact_email) { %><a href="mailto:<%= company.contact_email %>" style="display:inline-flex;align-items:center;gap:8px;background:var(--line-soft);color:var(--ink-2);font-weight:700;font-size:0.85rem;padding:10px 18px;border-radius:100px;">✉️ <%= company.contact_email %></a><% } %>
      <% if (company.contact_address) { %><span style="display:inline-flex;align-items:center;gap:8px;background:var(--line-soft);color:var(--ink-2);font-weight:700;font-size:0.85rem;padding:10px 18px;border-radius:100px;">📍 <%= company.contact_address %></span><% } %>
    </div>
  <% } %>
  <div class="shop-contact-card">
    <% if (typeof sent !== 'undefined' && sent) { %><div class="form-note ok">✓ تم إرسال رسالتك بنجاح</div><% } %>
    <% if (typeof contactError !== 'undefined' && contactError) { %><div class="form-note err"><%= contactError %></div><% } %>
    <form method="POST" action="/contact/<%= company.slug %>">
      <div class="row2">
        <input type="text" name="sender_name" placeholder="<%= t('common.name') %>" required />
        <input type="email" name="sender_email" placeholder="<%= t('common.email') || 'البريد الإلكتروني' %>" />
      </div>
      <input type="tel" name="sender_phone" placeholder="رقم الهاتف (اختياري)" maxlength="30" />
      <textarea name="message" rows="4" placeholder="رسالتك..." required maxlength="5000"></textarea>
      <button type="submit">إرسال الرسالة</button>
    </form>
  </div>
</section>
<% } %>

<!-- Footer -->
<footer>
  <div class="footer-grid">
    <div>
      <div class="footer-brand">
        <div class="logo-mark"><% if (company.logo_url) { %><img src="<%= company.logo_url %>" alt="" /><% } else { %><%= (displayName||' ').charAt(0) %><% } %></div>
        <span><%= displayName %></span>
      </div>
      <% if (displayDesc) { %><p class="footer-tag"><%= displayDesc %></p><% } else { %><p class="footer-tag">متجرك الموثوق لكل ما تحتاجه — منتجات مختارة وتوصيل سريع.</p><% } %>
    </div>
    <div class="footer-col">
      <h4>التسوّق</h4>
      <ul>
        <li><a href="<%= canonicalCompanyUrl(company.slug) %>">كل المنتجات</a></li>
        <li><a href="#products">المنتجات</a></li>
        <li><a href="/shop/<%= company.slug %>/cart"><%= t('public.cart') %></a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>حسابي</h4>
      <ul>
        <li><a href="/customer/login"><%= t('common.login') || 'تسجيل الدخول' %></a></li>
        <li><a href="/customer/orders"><%= t('customer.my_orders') || 'طلباتي' %></a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>المساعدة</h4>
      <ul>
        <li><a href="#contact">تواصل معنا</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div>© <%= new Date().getFullYear() %> <%= company.company_name %>. جميع الحقوق محفوظة.</div>
    <div>صُنع بواسطة OscarDevs</div>
  </div>
</footer>

<!-- Toast -->
<div class="toast" id="toast">
  <div class="toast-icon">✓</div>
  <div id="toastMsg">تمت الإضافة للسلة</div>
