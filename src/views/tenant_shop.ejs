<script>
// Live product search (Amazon roadmap phase 1) — debounced autocomplete dropdown.
(function () {
  var input = document.getElementById('shopSearchInput');
  var box = document.getElementById('searchSuggest');
  if (!input || !box) return;
  var slug = window.SHOP_SLUG || '';
  var t = null, lastQ = '', activeIdx = -1, items = [];
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function money(v) { try { return Number(v).toLocaleString('ar-EG'); } catch (e) { return v; } }
  function hide() { box.hidden = true; box.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); activeIdx = -1; }
  function render(list) {
    items = list;
    if (!list.length) { box.innerHTML = '<div style="padding:14px;color:#6b7280;font-size:14px">مفيش منتجات بالاسم ده — جرّب كلمة أقصر</div>'; box.hidden = false; input.setAttribute('aria-expanded', 'true'); return; }
    box.innerHTML = list.map(function (it, i) {
      var img = it.image ? '<img src="' + esc(it.image) + '" alt="" loading="lazy" style="width:44px;height:44px;object-fit:cover;border-radius:8px;flex:0 0 auto">' : '<div style="width:44px;height:44px;border-radius:8px;background:#f3f4f6;flex:0 0 auto"></div>';
      return '<a href="/shop/' + encodeURIComponent(slug) + '/product/' + it.id + '" role="option" data-i="' + i + '" style="display:flex;gap:10px;align-items:center;padding:9px 12px;text-decoration:none;color:#111827;border-bottom:1px solid #f3f4f6">' + img + '<span style="flex:1;font-size:14px;font-weight:600">' + esc(it.name) + '</span><span style="color:#059669;font-weight:700;font-size:13px;white-space:nowrap">' + money(it.price) + ' ج</span></a>';
    }).join('');
    box.hidden = false; input.setAttribute('aria-expanded', 'true');
  }
  function fetchSuggest(q) {
    fetch('/api/search?q=' + encodeURIComponent(q)).then(function (r) { return r.json(); }).then(function (d) {
      if (input.value.trim() !== q) return; // stale response
      render((d && d.items) || []);
    }).catch(function () { hide(); });
  }
  input.addEventListener('input', function () {
    var q = input.value.trim();
    if (t) clearTimeout(t);
    if (q.length < 1) { hide(); return; }
    if (q === lastQ) return;
    t = setTimeout(function () { lastQ = q; fetchSuggest(q); }, 300);
  });
  input.addEventListener('keydown', function (e) {
    if (box.hidden) return;
    var opts = box.querySelectorAll('[role=option]');
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, opts.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
    else if (e.key === 'Enter') { if (activeIdx >= 0 && opts[activeIdx]) { e.preventDefault(); window.location.href = opts[activeIdx].href; } return; }
    else if (e.key === 'Escape') { hide(); return; }
    else return;
    for (var i = 0; i < opts.length; i++) opts[i].style.background = i === activeIdx ? '#f3f4f6' : '#fff';
    if (opts[activeIdx]) opts[activeIdx].scrollIntoView({ block: 'nearest' });
  });
  document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== input) hide(); });
})();
</script>
<% if (__on('compare')) { %>
<a href="#" id="cmpBar" style="display:none;position:fixed;inset-inline:0;bottom:0;z-index:70;background:#111827;color:#fff;text-align:center;padding:12px;font-weight:800;text-decoration:none;">قارن (<span id="cmpN">0</span>) ←</a>
<script>
// Product compare (phase 9): persist selection in localStorage, show a bar at 2+.
(function () {
  var KEY = 'odv_compare_<%= company.slug %>', slug = window.SHOP_SLUG || '';
  var bar = document.getElementById('cmpBar'), nEl = document.getElementById('cmpN');
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
  function save(a) { localStorage.setItem(KEY, JSON.stringify(a.slice(0, 4))); }
  function refresh() {
    var ids = load();
    document.querySelectorAll('.cmp-box').forEach(function (b) { b.checked = ids.indexOf(+b.dataset.cmp) >= 0; });
    if (nEl) nEl.textContent = ids.length;
    if (bar) { bar.style.display = ids.length >= 2 ? 'block' : 'none'; bar.href = '/compare?ids=' + ids.join(','); }
  }
  document.querySelectorAll('.cmp-box').forEach(function (b) {
    b.addEventListener('change', function () {
      var ids = load(), id = +b.dataset.cmp, i = ids.indexOf(id);
      if (b.checked) { if (i < 0) { if (ids.length >= 4) { b.checked = false; alert('أقصى 4 منتجات للمقارنة'); return; } ids.push(id); } }
      else if (i >= 0) ids.splice(i, 1);
      save(ids); refresh();
    });
  });
  refresh();
})();
</script>
<% } %>
<% if (__on('wishlist')) { %>
<script>
// Wishlist (phase 6): paint hearts from the customer's saved set, toggle on click.
(function () {
  var badge = document.getElementById('wishBadge');
  function setBadge(n) { if (!badge) return; badge.textContent = n; badge.style.display = n > 0 ? '' : 'none'; }
  function paint(ids) {
    var set = {}; (ids || []).forEach(function (i) { set[i] = 1; });
    document.querySelectorAll('.pc-fav[data-fav]').forEach(function (b) { b.classList.toggle('is-fav', !!set[b.dataset.fav]); });
    setBadge((ids || []).length);
  }
  // Load the current wishlist (only returns data when a customer is logged in).
  fetch('/customer/wishlist/ids').then(function (r) { return r.json(); }).then(function (d) { paint(d.ids || []); }).catch(function () {});
  document.querySelectorAll('.pc-fav[data-fav]').forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      fetch('/customer/wishlist/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ product_id: +b.dataset.fav }) })
        .then(function (r) { if (r.status === 401) { window.location.href = '/customer/login'; return null; } return r.json(); })
        .then(function (d) { if (!d || !d.ok) return; b.classList.toggle('is-fav', d.added); setBadge(d.count); })
        .catch(function () {});
    });
  });
})();
</script>
<style>.pc-fav.is-fav svg{ fill:#ef4444; stroke:#ef4444; }</style>
<% } %>
<script src="/js/shop.js" defer></script>
