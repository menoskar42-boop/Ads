<%
  /* قالب واحد لتلات خدمات — والكلام بتاع كل خدمة من `src/lib/services.js`.
     نفس مبدأ `sector.ejs`: صفحة بتقول نفس الكلام عن CRM وعن SaaS هي
     doorway page، وهي الغلطة رقم ٧ في docs/SEO_MISTAKES_LOG.md.

     ⛔ ومفيش `offers` في السكيمة هنا: المشروع المخصّص مالوش سعر ثابت،
     وكتابة رقم في السكيمة كان هيبقى ادعاء سعر — نفس نوع الغلطة اللي
     اتعملت قبل كده في صفحة الورشة. `Service` من غير `offers` صالحة. */
  var v = service;
%>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<%- include('../partials/ads_loader') %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= v.title %></title>
<meta name="description" content="<%= v.desc %>" />
<%- include('../partials/seo_meta', { title: v.title, description: v.desc }) %>
<script type="application/ld+json">
<%- jsonLd({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": v.title.split('—')[0].trim(),
  "serviceType": v.serviceType,
  "description": v.desc,
  "url": siteOrigin + "/" + v.slug,
  "inLanguage": "ar",
  "provider": { "@id": siteOrigin + "#organization" },
  "areaServed": { "@type": "Country", "name": "مصر" },
}) %>
</script>
<script type="application/ld+json">
<%- jsonLd({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": v.faq.map(function (q) {
    return {
      "@type": "Question",
      "name": q[0],
      "acceptedAnswer": { "@type": "Answer", "text": String(q[1]).replace(/<[^>]+>/g, '') },
    };
  }),
}) %>
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"الرئيسية","item":"<%= siteOrigin %>/"},{"@type":"ListItem","position":2,"name":"<%= v.title.split('—')[0].trim() %>","item":"<%= siteOrigin %>/<%= v.slug %>"}]}</script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>
  *{box-sizing:border-box;font-family:'Cairo',sans-serif}
  body{margin:0;background:#0f172a;color:#e2e8f0;line-height:1.9}
  .wrap{max-width:1000px;margin:0 auto;padding:0 20px}
  a{color:#38bdf8}
  .hero{background:linear-gradient(160deg,#0f172a,#1e293b 60%,#312e81);padding:64px 0 56px;text-align:center}
  .hero h1{font-size:clamp(1.7rem,4.5vw,2.7rem);margin:0 0 14px;color:#fff;line-height:1.4}
  .hero p{font-size:1.05rem;color:#cbd5e1;max-width:62ch;margin:0 auto 26px}
  .who{color:#94a3b8;font-size:.95rem;margin:0 auto 24px;max-width:60ch}
  .cta{display:inline-block;background:#f59e0b;color:#0f172a;font-weight:800;text-decoration:none;padding:14px 30px;border-radius:14px}
  .cta.ghost{background:transparent;color:#e2e8f0;border:1.5px solid #475569;margin-inline-start:10px}
  section{padding:52px 0;border-top:1px solid #1e293b}
  h2{font-size:clamp(1.3rem,3.2vw,1.9rem);color:#fff;margin:0 0 10px}
  .lead{color:#94a3b8;margin:0 0 28px;max-width:65ch}
  .grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
  .card{background:#111c30;border:1px solid #1e293b;border-radius:18px;padding:22px}
  .card h3{margin:0 0 8px;color:#fff;font-size:1.05rem}
  .card p{margin:0;color:#94a3b8;font-size:.95rem}
  .pain{background:#111c30;border-inline-start:4px solid #818cf8;border-radius:14px;padding:18px 22px;margin-bottom:16px}
  .pain b{color:#fff;display:block;margin-bottom:4px}
  .pain span{color:#94a3b8;font-size:.95rem}
  .qa{border-top:1px solid #1e293b;padding:16px 0}
  .qa b{color:#fff;display:block;margin-bottom:4px}
  .qa span{color:#94a3b8;font-size:.95rem}
  .note{background:#111c30;border:1px solid #334155;border-radius:16px;padding:20px 24px;color:#cbd5e1}
  .note b{color:#fff}
  .foot{padding:40px 0 60px;text-align:center;color:#64748b;font-size:.9rem}
  ol{color:#94a3b8;padding-inline-start:22px}
  ol li{margin-bottom:10px}
  .other{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
  .other a{background:#111c30;border:1px solid #1e293b;border-radius:999px;padding:8px 16px;text-decoration:none;font-size:.9rem}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <h1><%= v.h1 %></h1>
    <p><%- v.lead %></p>
    <p class="who"><b>لمين؟</b> <%= v.forWho %></p>
    <a href="/ar/contact" class="cta">احجز جلسة تحديد النطاق</a>
    <a href="/ar/our-work" class="cta ghost">شوف شغلنا</a>
  </div>
</header>

<main>
  <section>
    <div class="wrap">
      <h2>المشاكل اللي الخدمة دي مبنية حواليها</h2>
      <p class="lead">مش قايمة مميزات — دي اللي بتوقّع المشاريع فعلاً.</p>
      <% v.pains.forEach(function (p) { %>
      <div class="pain"><b><%= p[0] %></b><span><%- p[1] %></span></div>
      <% }); %>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>إيه اللي داخل في الخدمة</h2>
      <div class="grid">
        <% v.features.forEach(function (f) { %>
        <div class="card"><h3><%= f[0] %></h3><p><%- f[1] %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>بيمشي إزاي</h2>
      <ol>
        <% v.steps.forEach(function (st) { %><li><%- st %></li><% }); %>
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>التسعير</h2>
      <div class="note">
        <p style="margin:0 0 12px"><b>مفيش سعر ثابت للمشروع المخصّص — وده مقصود.</b>
        سعر المشروع نتيجة نطاقه، والنطاق مايتعرفش قبل ما نقعد على شغلك.
        فبدل رقم بيتغيّر بعد ما تكون بدأت، بنقول لك <b>إزاي بنسعّر</b>:</p>
        <ol style="margin:0">
          <li>جلسة تحديد نطاق — <b>من غير مقابل</b> — بنطلع منها بوثيقة مكتوبة.</li>
          <li>النطاق بيتقسّم مراحل، وكل مرحلة بتتسعّر <b>بسعر ثابت</b> قبل ما تبدأ.</li>
          <li>أي طلب بره النطاق بيتسعّر لوحده قبل التنفيذ — مش بيتحط في فاتورة الآخر.</li>
        </ol>
      </div>
      <p class="lead" style="margin-top:22px">
        <b>ولو نشاطك ليه نظام جاهز عندنا، قول لنا.</b>
        عندنا <%= readySystemsAr %> نظام جاهز بسعر ثابت وتشغيل فوري
        (<a href="/ar">شوفهم كلهم</a>) — وده أرخص وأسرع من التطوير المخصّص بكتير.
        بننصح بيه لما يكون هو المناسب، وبنقولها بصراحة في جلسة النطاق.
      </p>
      <a href="/ar/contact" class="cta">احجز جلسة تحديد النطاق</a>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>أسئلة شائعة</h2>
      <% v.faq.forEach(function (q) { %>
      <div class="qa"><b><%= q[0] %></b><span><%- q[1] %></span></div>
      <% }); %>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>خدمات تانية</h2>
      <div class="other">
        <% others.forEach(function (o) { %><a href="/ar/<%= o.slug %>"><%= o.label %></a><% }); %>
        <a href="/ar">الأنظمة الجاهزة</a>
        <a href="/ar/our-work">شغلنا</a>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    <a href="/ar">OscarDevs</a> · <a href="/ar/contact">احجز جلسة</a> ·
    <a href="/ar/company-facts">حقائق عننا</a> · <a href="/ar">الأنظمة الجاهزة</a>
  </div>
</footer>

</body>
</html>
