<% pageTitle = 'مراجعة طلب'; activePage = 'applications'; %>
<%- include('../_layout_top') %>

<div class="space-y-5">
  <a href="/admin/applications" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800">← العودة للقائمة</a>

  <% if (flash) { %>
    <div class="<%= flash.type==='success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %> border rounded-xl px-4 py-3 text-sm"><%= flash.message %></div>
  <% } %>

  <div class="bg-white rounded-2xl shadow-sm p-6 space-y-1">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <h2 class="text-xl font-bold text-gray-800"><%= app.business_name %></h2>
        <p class="text-gray-400 text-sm">تقدّم بتاريخ <%= new Date(app.created_at).toLocaleString('ar-EG') %></p>
      </div>
      <span class="text-xs font-bold px-3 py-1.5 rounded-full
        <%= app.status==='pending' ? 'bg-orange-50 text-orange-700' : app.status==='approved' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
        <%= app.status==='pending' ? 'معلّق' : app.status==='approved' ? 'مقبول' : 'مرفوض' %>
      </span>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-6 space-y-4">
      <h3 class="font-bold text-gray-700 mb-1">بيانات مقدّم الطلب</h3>
      <% function row(label, val) { %><% } %>
      <% var R = function(label, val, mono){ %>
        <div class="flex items-start justify-between gap-3 py-2 border-b border-gray-50 last:border-0">
          <span class="text-xs text-gray-400 font-semibold shrink-0"><%= label %></span>
          <span class="text-sm <%= mono ? 'font-mono' : 'font-semibold' %> text-gray-800 text-left ltr break-all min-w-0"><%= val || '—' %></span>
        </div>
      <% }; %>
      <%- R('الاسم الكامل', app.full_name) %>
      <%- R('البريد الإلكتروني', app.email, true) %>
      <%- R('الهاتف', app.phone, true) %>
      <%- R('الدولة', app.country) %>
      <%- R('اسم النشاط', app.business_name) %>
      <%- R('نوع الموقع', app.business_type === 'shop' ? 'متجر إلكتروني' : 'بورتفوليو') %>
      <%- R('الـslug المقترح', '/view/' + app.preferred_slug, true) %>
      <div class="pt-3">
        <div class="text-xs text-gray-400 font-semibold mb-1">وصف النشاط</div>
        <p class="text-sm text-gray-700 leading-relaxed bg-gray-50 rounded-xl p-3 whitespace-pre-wrap"><%= app.description || '—' %></p>
      </div>
    </div>

    <div class="space-y-4">
      <div class="bg-white rounded-2xl shadow-sm p-6">
        <h3 class="font-bold text-gray-700 mb-3">إثبات الموافقة على الشروط</h3>
        <div class="text-xs text-gray-500 space-y-1.5">
          <div>إصدار الشروط: <strong class="text-gray-700"><%= app.accepted_terms_version %></strong></div>
          <div>تاريخ الموافقة: <strong class="text-gray-700"><%= new Date(app.accepted_at).toLocaleString('ar-EG') %></strong></div>
          <div>عنوان IP: <strong class="text-gray-700 font-mono"><%= app.accepted_ip || '—' %></strong></div>
          <div class="break-all">المتصفّح: <span class="text-gray-600"><%= app.user_agent || '—' %></span></div>
        </div>
      </div>

      <% if (app.status === 'pending') { %>
        <div class="bg-white rounded-2xl shadow-sm p-6 space-y-3">
          <h3 class="font-bold text-gray-700">القرار</h3>
          <form method="POST" action="/admin/applications/<%= app.id %>/approve" class="space-y-3" onsubmit="return confirm('تأكيد الموافقة وإنشاء الشركة والمستخدم؟');">
            <textarea name="notes" rows="2" placeholder="ملاحظات إدارية (اختياري)" maxlength="1000"
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-200 resize-none"></textarea>
            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 rounded-xl">✓ موافقة وإنشاء</button>
          </form>
          <form method="POST" action="/admin/applications/<%= app.id %>/reject" class="space-y-3 pt-3 border-t border-gray-100" onsubmit="return confirm('تأكيد رفض الطلب؟');">
            <textarea name="notes" rows="2" placeholder="سبب الرفض (اختياري — يساعد للمراجعة الداخلية)" maxlength="1000"
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-200 resize-none"></textarea>
            <button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-700 font-bold py-2.5 rounded-xl">✗ رفض</button>
          </form>
        </div>
      <% } else { %>
        <div class="bg-white rounded-2xl shadow-sm p-6 space-y-2 text-sm">
          <h3 class="font-bold text-gray-700 mb-2">سجل القرار</h3>
          <div class="text-xs text-gray-500">تاريخ المراجعة: <strong class="text-gray-700"><%= app.reviewed_at ? new Date(app.reviewed_at).toLocaleString('ar-EG') : '—' %></strong></div>
          <% if (app.approved_company_id) { %>
            <div class="text-xs text-gray-500">معرّف الشركة المنشأة: <strong class="text-gray-700">#<%= app.approved_company_id %></strong></div>
          <% } %>
          <% if (app.admin_notes) { %>
            <div class="text-xs text-gray-500 mt-2">ملاحظات: </div>
            <p class="text-sm text-gray-700 bg-gray-50 rounded-xl p-3 whitespace-pre-wrap"><%= app.admin_notes %></p>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../_layout_bottom') %>
