<%
  pageTitle = 'أمن تنبيهات الورش';
  activePage = 'security';
%>
<%- include('_layout_top') %>

<section class="bg-white rounded-2xl shadow-sm p-6" dir="rtl">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-xl font-black text-gray-800 mb-1">محاولات الوصول المرفوضة لسجل بريد التنبيهات</h1>
      <p class="text-sm text-gray-500">
        مراجعة أمنية للإدارة فقط. السجل لا يحتوي عناوين البريد أو محتوى الرسائل أو قيمة الشركة المطلوبة من الرابط.
      </p>
    </div>
    <span class="bg-amber-50 text-amber-800 border border-amber-200 rounded-full px-3 py-1 text-xs font-bold">
      <%= rows.length %> حدثًا في الصفحة
    </span>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <h2 class="font-black text-gray-800">آخر تنبيه أمني</h2>
      <% if (latestAlert) { %>
        <div class="mt-3 grid gap-2 text-sm text-gray-600">
          <div>الشركة: <bdi class="font-bold"><%= latestAlert.company_id %></bdi></div>
          <div>الحساب: <bdi class="font-bold"><%= latestAlert.actor_id %></bdi> (<%= latestAlert.actor_kind %>)</div>
          <div>عدد الرفضات: <bdi class="font-bold"><%= latestAlert.rejection_count %></bdi></div>
          <div>الحالة:
            <span class="font-bold <%= latestAlert.alert_status === 'sent' ? 'text-emerald-700' : latestAlert.alert_status === 'pending' ? 'text-amber-700' : 'text-rose-700' %>">
              <%= latestAlert.alert_status === 'sent' ? 'تم الإرسال' : latestAlert.alert_status === 'error' ? 'فشل الإرسال' : latestAlert.alert_status === 'pending' ? 'قيد المعالجة' : 'نتيجة الإرسال غير متاحة' %>
            </span>
          </div>
          <div class="text-xs text-gray-500">
            القناة: <%= latestAlert.alert_channel || 'غير محددة' %>
            · وقت التنبيه: <%= new Date(latestAlert.alerted_at).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' }) %>
          </div>
        </div>
      <% } else { %>
        <p class="mt-3 text-sm text-gray-500">لم يُرسل تنبيه أمني بعد.</p>
      <% } %>
    </div>
    <form method="post" action="/admin/security/workshop-alert-email/policy" class="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <h2 class="font-black text-gray-800">سياسة التكرار</h2>
      <p class="mt-1 text-xs text-gray-500">الحدود تمنع تعطيل التنبيه أو إغراق البريد.</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-bold text-gray-700">عدد الرفضات
          <input type="number" name="threshold" min="3" max="50" required value="<%= policy.threshold %>" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
        </label>
        <label class="text-sm font-bold text-gray-700">النافذة بالدقائق
          <input type="number" name="window_minutes" min="5" max="1440" required value="<%= policy.windowMinutes %>" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
        </label>
      </div>
      <button class="mt-3 brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold">حفظ السياسة</button>
      <% if (policyError === 'saved') { %><span class="mr-2 text-sm text-emerald-700 font-bold">تم الحفظ</span><% } %>
      <% if (policyError === 'invalid') { %><span class="mr-2 text-sm text-rose-700 font-bold">القيم غير صحيحة</span><% } %>
    </form>
  </div>

  <form method="get" action="/admin/security/workshop-alert-email" class="mt-6 grid gap-3 sm:grid-cols-4 items-end">
    <label class="text-sm font-bold text-gray-700">
      رقم الشركة الفعلية
      <input type="number" name="company_id" min="1" max="2147483647" inputmode="numeric"
        value="<%= filters.companyId || '' %>" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <label class="text-sm font-bold text-gray-700">
      من تاريخ
      <input type="date" name="from" value="<%= filters.from || '' %>"
        class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <label class="text-sm font-bold text-gray-700">
      إلى تاريخ
      <input type="date" name="to" value="<%= filters.to || '' %>"
        class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <div class="flex gap-2">
      <button class="brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold">تطبيق</button>
      <a href="/admin/security/workshop-alert-email" class="border border-gray-200 text-gray-600 rounded-lg px-4 py-2 text-sm font-bold">مسح</a>
    </div>
  </form>
  <% if (filterError === 'invalid') { %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-bold">
      الفلاتر غير صحيحة. اختر تاريخًا حقيقيًا ضمن فترة لا تتجاوز سنة ورقم شركة موجبًا.
    </div>
  <% } else if (filterError === 'load') { %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-bold">
      تعذر تحميل سجل الأمن الآن.
    </div>
  <% } %>

  <% if (!rows.length) { %>
    <div class="mt-6 rounded-xl border border-gray-100 bg-gray-50 px-4 py-8 text-center text-sm text-gray-500">
      لا توجد محاولات مرفوضة مسجلة.
    </div>
  <% } else { %>
    <div class="mt-5 flex items-center justify-between gap-3 flex-wrap text-sm">
      <span class="text-gray-500">الترتيب: الأحدث أولًا · حتى <%= pagination.pageSize %> حدثًا في الصفحة</span>
      <nav class="flex gap-2" aria-label="التنقل بين صفحات سجل الأمن">
        <% if (pagination.hasNewer) { %>
          <a href="<%= pagination.newerUrl %>" rel="prev"
             class="border border-gray-200 text-gray-700 rounded-lg px-4 py-2 font-bold">الأحداث الأحدث</a>
        <% } else { %>
          <span class="border border-gray-100 text-gray-300 rounded-lg px-4 py-2 font-bold" aria-disabled="true">الأحداث الأحدث</span>
        <% } %>
        <% if (pagination.hasOlder) { %>
          <a href="<%= pagination.olderUrl %>" rel="next"
             class="brand-bg text-white rounded-lg px-4 py-2 font-bold">الأحداث الأقدم</a>
        <% } else { %>
          <span class="border border-gray-100 text-gray-300 rounded-lg px-4 py-2 font-bold" aria-disabled="true">الأحداث الأقدم</span>
        <% } %>
      </nav>
    </div>
    <div class="overflow-x-auto mt-6">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs">
          <tr>
            <th class="px-3 py-3 text-right">الشركة الفعلية</th>
            <th class="px-3 py-3 text-right">الحساب</th>
            <th class="px-3 py-3 text-right">السبب</th>
            <th class="px-3 py-3 text-right">الطلب</th>
            <th class="px-3 py-3 text-right">الوقت</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% rows.forEach(function(row){ var meta = row.meta || {}; %>
            <tr>
              <td class="px-3 py-3 font-bold"><%= row.company_id || '—' %></td>
              <td class="px-3 py-3"><%= row.actor_id || 'جلسة عرض' %></td>
              <td class="px-3 py-3"><%= meta.reason || 'permission_denied' %></td>
              <td class="px-3 py-3" dir="ltr"><%= meta.method || '—' %> <%= meta.path || '—' %></td>
              <td class="px-3 py-3 text-xs text-gray-500"><%= new Date(row.created_at).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="mt-4 flex justify-end gap-2" aria-label="التنقل بين صفحات سجل الأمن">
      <% if (pagination.hasNewer) { %>
        <a href="<%= pagination.newerUrl %>" rel="prev" class="border border-gray-200 text-gray-700 rounded-lg px-4 py-2 text-sm font-bold">الأحداث الأحدث</a>
      <% } %>
      <% if (pagination.hasOlder) { %>
        <a href="<%= pagination.olderUrl %>" rel="next" class="brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold">الأحداث الأقدم</a>
      <% } %>
    </div>
  <% } %>
</section>

<%- include('_layout_bottom') %>