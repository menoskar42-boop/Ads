<%
  pageTitle = 'أمن تنبيهات الورش';
  activePage = 'security';
%>
<%- include('_layout_top') %>

<section class="bg-white rounded-2xl shadow-sm p-6" dir="rtl">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-xl font-black text-gray-800 mb-1">محاولات الوصول المرفوضة لسجل بريد التنبيهات</h1>
      <p class="text-sm text-gray-500">
        مراجعة أمنية للإدارة فقط. السجل لا يحتوي عناوين البريد أو محتوى الرسائل أو قيمة الشركة المطلوبة من الرابط.
      </p>
    </div>
    <span class="bg-amber-50 text-amber-800 border border-amber-200 rounded-full px-3 py-1 text-xs font-bold">
      <%= rows.length %> حدثًا
    </span>
  </div>

  <form method="get" action="/admin/security/workshop-alert-email" class="mt-6 grid gap-3 sm:grid-cols-4 items-end">
    <label class="text-sm font-bold text-gray-700">
      رقم الشركة الفعلية
      <input type="number" name="company_id" min="1" max="2147483647" inputmode="numeric"
        value="<%= filters.companyId || '' %>" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <label class="text-sm font-bold text-gray-700">
      من تاريخ
      <input type="date" name="from" value="<%= filters.from || '' %>"
        class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <label class="text-sm font-bold text-gray-700">
      إلى تاريخ
      <input type="date" name="to" value="<%= filters.to || '' %>"
        class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal" />
    </label>
    <div class="flex gap-2">
      <button class="brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold">تطبيق</button>
      <a href="/admin/security/workshop-alert-email" class="border border-gray-200 text-gray-600 rounded-lg px-4 py-2 text-sm font-bold">مسح</a>
    </div>
  </form>
  <% if (filterError === 'invalid') { %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-bold">
      الفلاتر غير صحيحة. اختر تاريخًا حقيقيًا ضمن فترة لا تتجاوز سنة ورقم شركة موجبًا.
    </div>
  <% } else if (filterError === 'load') { %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 text-sm font-bold">
      تعذر تحميل سجل الأمن الآن.
    </div>
  <% } %>

  <% if (!rows.length) { %>
    <div class="mt-6 rounded-xl border border-gray-100 bg-gray-50 px-4 py-8 text-center text-sm text-gray-500">
      لا توجد محاولات مرفوضة مسجلة.
    </div>
  <% } else { %>
    <div class="overflow-x-auto mt-6">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs">
          <tr>
            <th class="px-3 py-3 text-right">الشركة الفعلية</th>
            <th class="px-3 py-3 text-right">الحساب</th>
            <th class="px-3 py-3 text-right">السبب</th>
            <th class="px-3 py-3 text-right">الطلب</th>
            <th class="px-3 py-3 text-right">الوقت</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% rows.forEach(function(row){ var meta = row.meta || {}; %>
            <tr>
              <td class="px-3 py-3 font-bold"><%= row.company_id || '—' %></td>
              <td class="px-3 py-3"><%= row.actor_id || 'جلسة عرض' %></td>
              <td class="px-3 py-3"><%= meta.reason || 'permission_denied' %></td>
              <td class="px-3 py-3" dir="ltr"><%= meta.method || '—' %> <%= meta.path || '—' %></td>
              <td class="px-3 py-3 text-xs text-gray-500"><%= new Date(row.created_at).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('_layout_bottom') %>