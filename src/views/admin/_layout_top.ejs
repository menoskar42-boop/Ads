<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3132188303904900" crossorigin="anonymous"></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> – Oscardevs Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: #4f46e5; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .nav-active { background-color: var(--brand); color: white; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">

<!-- Top bar -->
<header class="bg-white shadow-sm sticky top-0 z-20">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 brand-bg rounded-xl flex items-center justify-center text-white font-black text-lg">A</div>
      <div>
        <span class="font-bold text-gray-800 text-sm"><%= t('admin.dashboard') %></span>
        <span class="text-gray-400 text-xs block leading-none"><%= session.adminEmail %></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <form method="POST" action="/admin/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" class="inline">
        <button type="submit" class="text-xs font-bold text-gray-600 hover:brand-text border border-gray-200 rounded-lg px-2.5 py-1"><%= t('common.toggle_lang') %></button>
      </form>
      <form method="POST" action="/admin/logout">
        <button class="text-sm text-gray-500 hover:text-red-500 transition flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <%= t('common.logout') %>
        </button>
      </form>
    </div>
  </div>
</header>

<div class="max-w-7xl mx-auto px-4 py-6 flex flex-col lg:flex-row gap-6">

  <!-- Sidebar nav -->
  <aside class="lg:w-56 flex-shrink-0">
    <nav class="bg-white rounded-2xl shadow-sm p-3 space-y-1">
      <a href="/admin/dashboard"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='dashboard' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
        <%= t('admin.companies') %>
      </a>
      <a href="/admin/companies/add"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='add' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <%= t('admin.add_company') %>
      </a>
      <a href="/admin/applications"
        class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='applications' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          طلبات التسجيل
        </span>
        <% if (typeof pendingAppsCount !== 'undefined' && pendingAppsCount > 0) { %>
          <span class="bg-orange-500 text-white text-xs font-bold rounded-full px-2 py-0.5"><%= pendingAppsCount %></span>
        <% } %>
      </a>
      <a href="/admin/messages"
        class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='messages' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <%= t('company.messages') %>
        </span>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="bg-red-500 text-white text-xs font-bold rounded-full px-2 py-0.5"><%= unreadCount %></span>
        <% } %>
      </a>
      <hr class="my-2 border-gray-100" />
      <a href="/"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-500 hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Platform Home
      </a>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="flex-1">
