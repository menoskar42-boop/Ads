<%
  pageTitle = 'آراء العملاء';
  activePage = 'testimonials';
%>
<%- include('_layout_top') %>

  <div class="space-y-6" dir="rtl">

    <% if (flash) { %>
      <div class="<%= flash.type==='success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %> border rounded-xl px-4 py-3 text-sm"><%= flash.message %></div>
    <% } %>

    <div class="bg-white rounded-2xl shadow-sm p-6 space-y-2">
      <h2 class="text-xl font-bold text-gray-800">آراء العملاء — الصفحة الرئيسية</h2>
      <p class="text-gray-500 text-sm leading-relaxed">
        التاجر بيكتب رأيه من حسابه على <span dir="ltr" class="font-mono bg-gray-50 px-1.5 rounded">oscardevs.com/company/testimonial</span>
        — ابعتله اللينك ده. القسم بيظهر في الرئيسية لما يبقى فيه <strong><%= MIN_TO_SHOW %></strong> آراء معتمدة على الأقل
        (بيعرض أحدث <%= MAX_SHOWN %>).
      </p>
      <p class="text-sm font-semibold <%= approvedLive >= MIN_TO_SHOW ? 'text-green-700' : 'text-amber-700' %>">
        المعتمد دلوقتي: <%= approvedLive %> —
        <%= approvedLive >= MIN_TO_SHOW ? 'القسم ظاهر في الرئيسية.' : 'القسم مخفي لحد ما يوصل ' + MIN_TO_SHOW + '.' %>
      </p>
    </div>

    <% if (!rows.length) { %>
      <div class="bg-white rounded-2xl shadow-sm p-10 text-center text-gray-400">
        <p class="font-semibold">لسه مفيش آراء.</p>
      </div>
    <% } %>

    <% rows.forEach(function(r){ %>
      <div class="bg-white rounded-2xl shadow-sm p-5 space-y-3">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="font-bold text-gray-800"><%= r.author_name %><% if (r.author_role) { %> <span class="text-gray-400 font-normal">· <%= r.author_role %></span><% } %></p>
            <p class="text-sm text-gray-500">
              <%= r.company_name %> ·
              <a href="https://<%= r.slug %>.oscardevs.com" target="_blank" rel="noopener" dir="ltr" class="underline"><%= r.slug %>.oscardevs.com</a>
              <% if (!r.is_active) { %><span class="text-red-600">(الشركة موقوفة — مش هيظهر)</span><% } %>
            </p>
          </div>
          <span class="text-xs font-bold rounded-full px-3 py-1 <%= r.status==='approved' ? 'bg-green-50 text-green-700' : r.status==='rejected' ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700' %>">
            <%= r.status==='approved' ? 'معتمد' : r.status==='rejected' ? 'مرفوض' : 'بانتظار الموافقة' %>
          </span>
        </div>
        <p class="text-amber-500" aria-label="<%= r.rating %> من 5"><%= '★'.repeat(r.rating) %><span class="text-gray-300"><%= '★'.repeat(5 - r.rating) %></span></p>
        <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= r.body %></p>
        <p class="text-xs text-gray-400">وافق على النشر: <%= new Date(r.consent_at).toLocaleString('ar-EG', { timeZone: 'Africa/Cairo' }) %></p>
        <div class="flex gap-2 flex-wrap">
          <% if (r.status !== 'approved') { %>
            <form method="post" action="/admin/testimonials/<%= r.id %>/status"><input type="hidden" name="status" value="approved"><button class="bg-green-600 text-white text-sm font-bold rounded-xl px-4 py-2">✓ موافقة ونشر</button></form>
          <% } %>
          <% if (r.status !== 'rejected') { %>
            <form method="post" action="/admin/testimonials/<%= r.id %>/status"><input type="hidden" name="status" value="rejected"><button class="border border-red-200 text-red-700 text-sm font-bold rounded-xl px-4 py-2"><%= r.status === 'approved' ? 'إخفاء من الرئيسية' : 'رفض' %></button></form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

<%- include('_layout_bottom') %>
