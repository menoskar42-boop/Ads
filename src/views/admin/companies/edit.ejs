<%
  pageTitle = 'Edit Company';
  activePage = 'dashboard';
%>
<%- include('../_layout_top') %>

  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1">Edit Company</h2>
    <p class="text-gray-500 text-sm mb-6">Update <strong><%= company.company_name %></strong>.</p>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm">
      <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/admin/companies/<%= company.id %>/edit" class="space-y-5">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">Company Name *</label>
          <input type="text" name="company_name" required value="<%= company.company_name %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">Slug *</label>
          <input type="text" name="slug" required pattern="[a-z0-9-]+" value="<%= company.slug %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Description</label>
        <textarea name="description" rows="3"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300"><%= company.description || '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Theme Color</label>
        <input type="color" name="theme_color" value="<%= company.theme_color %>"
          class="h-12 w-24 border border-gray-200 rounded-xl cursor-pointer" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Page Type *</label>
        <select name="page_type" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300">
          <option value="portfolio" <%= (company.page_type || 'portfolio') === 'portfolio' ? 'selected' : '' %>>Portfolio — showcase your work</option>
          <option value="shop" <%= company.page_type === 'shop' ? 'selected' : '' %>>Shop — products + cart + cash on delivery</option>
        </select>
        <p class="text-xs text-gray-400 mt-1">Switching type keeps existing data but only shows the layout matching the chosen type.</p>
      </div>

      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="is_active" <%= company.is_active ? 'checked' : '' %>
          class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-300" />
        <span class="text-sm font-semibold text-gray-700">Company is active</span>
      </label>

      <div class="flex items-center gap-3 pt-4">
        <button type="submit" class="brand-bg text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow-md">Save Changes</button>
        <a href="/admin/dashboard" class="text-gray-500 hover:text-gray-700 text-sm">Cancel</a>
      </div>
    </form>
  </div>

<%- include('../_layout_bottom') %>
