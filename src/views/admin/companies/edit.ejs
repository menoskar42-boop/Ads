<%
  pageTitle = t('admin.edit_company');
  activePage = 'dashboard';
%>
<%- include('../_layout_top') %>

  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1"><%= t('admin.edit_company') %></h2>
    <p class="text-gray-500 text-sm mb-6"><strong><%= company.company_name %></strong></p>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm">
      <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/admin/companies/<%= company.id %>/edit" class="space-y-5">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('admin.company_name') %> *</label>
          <input type="text" name="company_name" required value="<%= company.company_name %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('admin.slug') %> *</label>
          <input type="text" name="slug" required pattern="[a-z0-9-]+" value="<%= company.slug %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.description') %></label>
        <textarea name="description" rows="3"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300"><%= company.description || '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('admin.theme_color') %></label>
        <input type="color" name="theme_color" value="<%= company.theme_color %>"
          class="h-12 w-24 border border-gray-200 rounded-xl cursor-pointer" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('admin.page_type') %> *</label>
        <select name="page_type" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300">
          <option value="portfolio" <%= (company.page_type || 'portfolio') === 'portfolio' ? 'selected' : '' %>><%= t('admin.page_type_portfolio') %></option>
          <option value="shop" <%= company.page_type === 'shop' ? 'selected' : '' %>><%= t('admin.page_type_shop') %></option>
          <option value="pharmacy" <%= company.page_type === 'pharmacy' ? 'selected' : '' %>><%= t('admin.page_type_pharmacy') %></option>
          <option value="orders" <%= company.page_type === 'orders' ? 'selected' : '' %>><%= t('admin.page_type_orders') %></option>
          <option value="clinic" <%= company.page_type === 'clinic' ? 'selected' : '' %>>عيادة / إدارة عيادات</option>
          <option value="gym" <%= company.page_type === 'gym' ? 'selected' : '' %>>جيم / صالة رياضية</option>
          <option value="furniture" <%= company.page_type === 'furniture' ? 'selected' : '' %>>معرض / ورشة موبيليا</option>
          <option value="workshop" <%= company.page_type === 'workshop' ? 'selected' : '' %>>ورشة سيارات</option>
          <option value="nutrition" <%= company.page_type === 'nutrition' ? 'selected' : '' %>>عيادة تغذية</option>
        </select>
      </div>

      <% if (company.page_type === 'clinic') { %>
      <div class="bg-teal-50 border border-teal-200 rounded-xl px-4 py-3 flex items-center justify-between gap-3">
        <div>
          <div class="font-bold text-teal-800 text-sm">وحدات العيادة (Modules)</div>
          <div class="text-xs text-teal-600">فعّل أو أوقف الوحدات المتقدمة لهذه العيادة (مخزون، تأمين، فروع…).</div>
        </div>
        <a href="/admin/companies/<%= company.id %>/modules" class="bg-teal-600 text-white text-sm font-bold px-4 py-2 rounded-xl hover:bg-teal-700 whitespace-nowrap">إدارة الوحدات</a>
      </div>
      <% } %>

      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="is_active" <%= company.is_active ? 'checked' : '' %>
          class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-300" />
        <span class="text-sm font-semibold text-gray-700"><%= t('common.active') %></span>
      </label>

      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="content_i18n" <%= company.content_i18n ? 'checked' : '' %>
          class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-300" />
        <span class="text-sm font-semibold text-gray-700"><%= t('company.content_dual_label') %></span>
      </label>
      <p class="text-xs text-gray-400 -mt-2"><%= t('company.content_dual_help') %></p>

      <hr class="border-gray-100 my-4" />
      <div>
        <h3 class="font-bold text-gray-700 mb-1"><%= t('admin.adsense_section') %></h3>
        <p class="text-xs text-gray-400 mb-3"><%= t('admin.adsense_help') %></p>
        <div class="space-y-3">
          <div>
            <label class="block text-xs text-gray-500 mb-1"><%= t('admin.adsense_top') %></label>
            <textarea name="adsense_top" rows="3" placeholder="<script async src=&quot;https://pagead2...&quot;></script>..."
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"><%= company.adsense_top || '' %></textarea>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1"><%= t('admin.adsense_sidebar') %></label>
            <textarea name="adsense_sidebar" rows="3"
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"><%= company.adsense_sidebar || '' %></textarea>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1"><%= t('admin.adsense_bottom') %></label>
            <textarea name="adsense_bottom" rows="3"
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"><%= company.adsense_bottom || '' %></textarea>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <button type="submit" class="brand-bg text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow-md"><%= t('common.save') %></button>
        <a href="/admin/dashboard" class="text-gray-500 hover:text-gray-700 text-sm"><%= t('common.cancel') %></a>
      </div>
    </form>
  </div>

<%- include('../_layout_bottom') %>
