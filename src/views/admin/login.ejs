<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Super Admin Login – Oscardevs Ads</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gradient-to-br from-slate-900 to-indigo-900 min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">

    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-indigo-500 rounded-2xl flex items-center justify-center text-white font-black text-2xl mx-auto mb-3 shadow-lg">A</div>
      <h1 class="text-2xl font-bold text-white">Oscardevs Ads</h1>
      <p class="text-indigo-200 text-sm mt-1">Super Admin Portal</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-3xl shadow-2xl p-8">
      <h2 class="text-xl font-bold text-gray-800 mb-6 text-center"><%= t('common.login') %></h2>

      <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm flex items-center gap-2">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= error %>
      </div>
      <% } %>

      <form method="POST" action="/admin/login" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.email') %></label>
          <input type="email" name="email" required placeholder="admin@oscardevs.com"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-transparent transition" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.password') %></label>
          <input type="password" name="password" required placeholder="••••••••"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-transparent transition" />
        </div>
        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition shadow-md hover:shadow-lg">
          <%= t('common.login') %>
        </button>
      </form>
    </div>

    <p class="text-center text-sm text-indigo-200 mt-6">
      <a href="/" class="hover:text-white transition">← Back to Platform</a>
    </p>
  </div>
</body>
</html>
