<% pageTitle = 'CRM — العملاء المحتملين'; activePage = 'crm'; %>
<%- include('../_layout_top') %>
<%
  var STATUS_LABELS = { new:'جديد', contacted:'تم التواصل', interested:'مهتم', converted:'عميل ✅', lost:'غير مهتم' };
  var STATUS_BADGE = {
    new:'bg-gray-100 text-gray-700', contacted:'bg-blue-100 text-blue-700',
    interested:'bg-amber-100 text-amber-700', converted:'bg-green-100 text-green-700',
    lost:'bg-red-100 text-red-600'
  };
  var STATUSES = ['new','contacted','interested','converted','lost'];
  var PRIORITY_LABELS = { low:'منخفضة', normal:'عادية', high:'عالية 🔥' };
  var PRIORITY_BADGE = { low:'bg-gray-50 text-gray-400', normal:'bg-gray-100 text-gray-600', high:'bg-red-100 text-red-700' };
  var PRIORITIES = ['high','normal','low'];
  var ACT_LABELS = { note:'📝 ملاحظة', call:'📞 مكالمة', whatsapp:'💬 واتساب', reply:'↩️ ردّ العميل', meeting:'🤝 اجتماع', status:'🔄 حالة' };

  function fmtDate(d){ if(!d) return ''; try{ return new Date(d).toISOString().slice(0,10); }catch(e){ return ''; } }
  function fmtDateTime(d){ if(!d) return ''; try{ var x=new Date(d); return x.toISOString().slice(0,10)+' '+x.toTimeString().slice(0,5); }catch(e){ return ''; } }
  function extUrl(u){ if(!u) return ''; return /^https?:\/\//i.test(u) ? u : 'https://' + u; }
  // كام يوم فاتت/فاضلة على المتابعة.
  function dueInfo(d){
    if(!d) return null;
    var today = new Date(); today.setHours(0,0,0,0);
    var t = new Date(d); t.setHours(0,0,0,0);
    var diff = Math.round((t - today) / 86400000);
    if (diff < 0) return { cls:'bg-red-100 text-red-700', txt:'متأخرة ' + (-diff) + ' يوم' };
    if (diff === 0) return { cls:'bg-amber-100 text-amber-800', txt:'النهارده' };
    if (diff === 1) return { cls:'bg-blue-100 text-blue-700', txt:'بكره' };
    return { cls:'bg-gray-100 text-gray-500', txt:'بعد ' + diff + ' يوم' };
  }
  function sinceTxt(d){
    if(!d) return 'لم يتم';
    var diff = Math.round((Date.now() - new Date(d).getTime())/86400000);
    if (diff <= 0) return 'النهارده';
    if (diff === 1) return 'من إمبارح';
    return 'من ' + diff + ' يوم';
  }
  // رسالة عرض أولى مخصّصة لكل عميل — تتفتح جاهزة في واتساب، تضغط إرسال فقط.
  function outreachMsg(l){
    var biz = l.business_name || l.name || 'صفحتك';
    return 'أهلاً يا فندم 🌹 شُفت ' + biz + ' وعجبني شغلك.\n'
      + 'أنا من OscarDevs، بنساعد الأنشطة الصغيرة يكون ليها متجر إلكتروني خاص بدل ما الطلبات والأسعار تتلخبط في رسايل الواتساب والـDM.\n'
      + 'الفترة دي بنفعّل عدد محدود من الأنشطة مجاناً — ولو بدأتي دلوقتي مجانيتك تثبت مدى الحياة.\n'
      + 'تحبي أبعتلك مثال متجر حقيقي شغّال تشوفيه الأول؟';
  }

  // بناء روابط الفلاتر مع الحفاظ على باقي الفلاتر النشطة.
  var CUR = { status: currentFilter, category: currentCategory, priority: currentPriority, due: currentDue, sort: currentSort };
  function qs(over){
    var m = Object.assign({}, CUR, over||{});
    var parts = [];
    ['status','category','priority','due','sort'].forEach(function(k){
      if (m[k] && !(k==='sort' && m[k]==='followup')) parts.push(k+'='+encodeURIComponent(m[k]));
    });
    return '/admin/crm' + (parts.length ? '?'+parts.join('&') : '');
  }
%>

<div class="mb-4 flex items-center justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-2xl font-extrabold text-gray-900">CRM — العملاء المحتملين</h1>
    <p class="text-gray-500 text-sm">تابع كل عميل، سجّل تواصلك، ومتفوّتش أي متابعة.</p>
  </div>
  <a href="/admin/crm/export.csv" class="text-sm font-bold text-gray-600 border border-gray-200 rounded-lg px-3 py-2 hover:bg-gray-50">⬇️ تصدير CSV</a>
</div>

<!-- ===== لوحة المؤشرات (KPIs) ===== -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-5">
  <a href="<%= qs({status:'',category:'',priority:'',due:''}) %>" class="bg-white rounded-2xl shadow-sm p-3 text-center hover:shadow">
    <div class="text-2xl font-extrabold text-gray-900"><%= kpi.total %></div>
    <div class="text-xs text-gray-500 mt-0.5">إجمالي العملاء</div>
  </a>
  <div class="bg-white rounded-2xl shadow-sm p-3 text-center">
    <div class="text-2xl font-extrabold text-green-600"><%= kpi.conversion %>%</div>
    <div class="text-xs text-gray-500 mt-0.5">نسبة التحويل</div>
  </div>
  <a href="<%= qs({due:'today',status:'',priority:''}) %>" class="bg-white rounded-2xl shadow-sm p-3 text-center hover:shadow <%= currentDue==='today' ? 'ring-2 ring-amber-300' : '' %>">
    <div class="text-2xl font-extrabold text-amber-600"><%= kpi.due_today %></div>
    <div class="text-xs text-gray-500 mt-0.5">متابعات النهارده</div>
  </a>
  <a href="<%= qs({due:'overdue',status:'',priority:''}) %>" class="bg-white rounded-2xl shadow-sm p-3 text-center hover:shadow <%= currentDue==='overdue' ? 'ring-2 ring-red-300' : '' %>">
    <div class="text-2xl font-extrabold text-red-600"><%= kpi.overdue %></div>
    <div class="text-xs text-gray-500 mt-0.5">متابعات متأخرة</div>
  </a>
  <a href="<%= qs({priority:'high',status:'',due:''}) %>" class="bg-white rounded-2xl shadow-sm p-3 text-center hover:shadow <%= currentPriority==='high' ? 'ring-2 ring-red-300' : '' %>">
    <div class="text-2xl font-extrabold text-rose-600"><%= kpi.high_pri %></div>
    <div class="text-xs text-gray-500 mt-0.5">أولوية عالية</div>
  </a>
  <div class="bg-white rounded-2xl shadow-sm p-3 text-center">
    <div class="text-2xl font-extrabold text-indigo-600"><%= kpi.new_week %></div>
    <div class="text-xs text-gray-500 mt-0.5">جدد هذا الأسبوع</div>
  </div>
</div>

<!-- ===== Pipeline (شريط المراحل) ===== -->
<div class="bg-white rounded-2xl shadow-sm p-4 mb-5">
  <div class="flex items-center gap-1.5 flex-wrap text-xs">
    <% STATUSES.forEach(function(s, i){ %>
      <a href="<%= currentFilter===s ? qs({status:''}) : qs({status:s, due:''}) %>"
         class="flex-1 min-w-[90px] text-center rounded-lg px-2 py-2 font-bold transition <%= currentFilter===s ? STATUS_BADGE[s] + ' ring-2 ring-offset-1' : STATUS_BADGE[s] + ' opacity-80 hover:opacity-100' %>">
        <div class="text-base"><%= countMap[s] || 0 %></div>
        <div class="font-semibold"><%= STATUS_LABELS[s] %></div>
      </a>
      <% if (i < STATUSES.length-1) { %><span class="text-gray-300">›</span><% } %>
    <% }); %>
  </div>
</div>

<!-- ===== فلاتر مساعدة ===== -->
<div class="flex flex-wrap gap-2 mb-3 text-sm items-center">
  <a href="<%= qs({status:'',category:'',priority:'',due:''}) %>" class="px-3 py-1.5 rounded-full font-semibold <%= (!currentFilter && !currentCategory && !currentPriority && !currentDue) ? 'brand-bg text-white' : 'bg-white text-gray-600 border border-gray-200' %>">الكل</a>
  <a href="<%= qs({due:'due',status:'',priority:''}) %>" class="px-3 py-1.5 rounded-full font-semibold <%= currentDue==='due' ? 'brand-bg text-white' : 'bg-white text-gray-600 border border-gray-200' %>">🔔 المستحقّة</a>
  <% PRIORITIES.forEach(function(p){ %>
    <a href="<%= currentPriority===p ? qs({priority:''}) : qs({priority:p}) %>" class="px-3 py-1.5 rounded-full font-semibold <%= currentPriority===p ? 'bg-gray-800 text-white' : 'bg-white text-gray-600 border border-gray-200' %>">أولوية <%= PRIORITY_LABELS[p] %></a>
  <% }); %>
  <span class="text-gray-300">|</span>
  <span class="text-gray-400 text-xs">ترتيب:</span>
  <% var SORTS = { followup:'حسب المتابعة', priority:'حسب الأولوية', contacted:'آخر تواصل', created:'الأحدث' }; %>
  <% Object.keys(SORTS).forEach(function(sv){ %>
    <a href="<%= qs({sort:sv}) %>" class="px-2.5 py-1 rounded-full text-xs font-semibold <%= currentSort===sv ? 'bg-indigo-100 text-indigo-700' : 'bg-white text-gray-500 border border-gray-200' %>"><%= SORTS[sv] %></a>
  <% }); %>
</div>

<!-- فلتر التصنيف -->
<% if (categories && categories.length) { %>
<div class="flex flex-wrap gap-2 mb-3 text-sm items-center">
  <span class="text-gray-400 text-xs font-bold">التصنيف:</span>
  <a href="<%= qs({category:''}) %>" class="px-3 py-1 rounded-full font-semibold <%= currentCategory==='' ? 'bg-gray-800 text-white' : 'bg-white text-gray-600 border border-gray-200' %>">الكل</a>
  <% categories.forEach(function(c){ %>
    <a href="<%= currentCategory===c.category ? qs({category:''}) : qs({category:c.category}) %>" class="px-3 py-1 rounded-full font-semibold <%= currentCategory===c.category ? 'bg-gray-800 text-white' : 'bg-white text-gray-600 border border-gray-200' %>"><%= c.category %> (<%= c.n %>)</a>
  <% }); %>
</div>
<% } %>

<!-- بحث سريع -->
<div class="mb-4">
  <input id="leadSearch" type="search" placeholder="🔎 ابحث بالاسم / النشاط / الرقم..." class="w-full sm:max-w-md border border-gray-200 rounded-lg px-3 py-2 text-sm" />
</div>

<!-- ===== قائمة العملاء ===== -->
<% if (!leads.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-gray-400">مفيش عملاء مطابقين — جرّب تغيّر الفلتر أو ضيف عميل من الأدوات تحت.</div>
<% } else { %>
  <div id="leadList" class="space-y-3 mb-6">
  <% leads.forEach(function(l){ var di = dueInfo(l.next_followup); %>
    <div class="lead-card bg-white rounded-2xl shadow-sm p-4 <%= l.priority==='high' ? 'border-s-4 border-red-400' : '' %>" data-search="<%= ((l.name||'')+' '+(l.business_name||'')+' '+(l.phone||'')+' '+(l.category||'')).toLowerCase() %>">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div class="min-w-[210px]">
          <div class="font-bold text-gray-900 flex items-center gap-1.5 flex-wrap">
            <%= l.name || l.business_name || 'بدون اسم' %>
            <span class="text-xs font-semibold rounded-full px-2 py-0.5 <%= STATUS_BADGE[l.status] || STATUS_BADGE.new %>"><%= STATUS_LABELS[l.status] || l.status %></span>
            <% if (l.priority && l.priority !== 'normal') { %><span class="text-xs font-semibold rounded-full px-2 py-0.5 <%= PRIORITY_BADGE[l.priority] %>"><%= PRIORITY_LABELS[l.priority] %></span><% } %>
            <% if (di) { %><span class="text-xs font-semibold rounded-full px-2 py-0.5 <%= di.cls %>">⏰ <%= di.txt %></span><% } %>
          </div>
          <% if (l.business_name && l.name) { %><div class="text-sm text-gray-500"><%= l.business_name %></div><% } %>
          <div class="text-sm text-gray-600 mt-1">
            <%= l.phone || '—' %>
            <% if (l.category) { %> · <span class="bg-gray-100 text-gray-600 rounded px-1.5 py-0.5 text-xs"><%= l.category %></span><% } %>
            <% if (l.source) { %> · <span class="text-gray-400 text-xs"><%= l.source %></span><% } %>
          </div>
          <div class="text-xs text-gray-400 mt-1">آخر تواصل: <%= sinceTxt(l.last_contacted_at) %><% if (l.email) { %> · ✉️ <%= l.email %><% } %></div>
          <% if (l.link) { %><div class="text-xs mt-1"><a href="<%= extUrl(l.link) %>" target="_blank" rel="noopener" class="text-indigo-600 underline">صفحة العميل ↗</a></div><% } %>
          <% if (l.notes) { %><div class="text-xs text-gray-500 mt-1">📝 <%= l.notes %></div><% } %>
        </div>
        <div class="flex items-center gap-2">
          <% if (l.wa) { %>
            <a class="inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-lg px-3 py-2" href="https://wa.me/<%= l.wa %>?text=<%= encodeURIComponent(outreachMsg(l)) %>" target="_blank" rel="noopener" title="يفتح واتساب ورسالة العرض مكتوبة — اضغط إرسال فقط">📨 عرض</a>
            <a class="inline-flex items-center gap-1 bg-green-600 hover:bg-green-700 text-white text-sm font-bold rounded-lg px-3 py-2" href="https://wa.me/<%= l.wa %>" target="_blank" rel="noopener" title="افتح محادثة واتساب للرد مباشرة">💬 رد</a>
            <a class="wa-link inline-flex items-center gap-1 bg-green-500 hover:bg-green-600 text-white text-sm font-bold rounded-lg px-3 py-2" data-base="https://wa.me/<%= l.wa %>" href="https://wa.me/<%= l.wa %>" target="_blank" rel="noopener" title="ابعت التحديث الجماعي">📣 تحديث</a>
          <% } else { %>
            <span class="text-xs text-gray-400">لا يوجد رقم</span>
          <% } %>
          <form method="POST" action="/admin/crm/<%= l.id %>/delete" onsubmit="return confirm('حذف العميل ده؟');">
            <button class="text-gray-400 hover:text-red-500 text-sm px-2 py-2" title="حذف">🗑️</button>
          </form>
        </div>
      </div>

      <!-- تسجيل تفاعل سريع -->
      <div class="mt-3 flex items-center gap-1.5 flex-wrap border-t border-gray-100 pt-3">
        <span class="text-xs text-gray-400">سجّل:</span>
        <% [['call','📞 مكالمة'],['whatsapp','💬 واتساب'],['reply','↩️ ردّ'],['meeting','🤝 اجتماع']].forEach(function(a){ %>
          <form method="POST" action="/admin/crm/<%= l.id %>/activity" class="inline">
            <input type="hidden" name="type" value="<%= a[0] %>" />
            <button class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full px-2.5 py-1" title="سجّل <%= a[1] %>"><%= a[1] %></button>
          </form>
        <% }); %>
      </div>

      <!-- إضافة ملاحظة للسجل -->
      <form method="POST" action="/admin/crm/<%= l.id %>/activity" class="mt-2 flex gap-2">
        <input type="hidden" name="type" value="note" />
        <input name="body" placeholder="أضف ملاحظة للسجل..." class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm" />
        <button class="bg-gray-700 text-white rounded-lg px-3 py-1.5 text-xs font-bold">إضافة</button>
      </form>

      <!-- سجل التفاعلات (Timeline) -->
      <% if (l.activities && l.activities.length) { %>
      <details class="mt-2">
        <summary class="cursor-pointer text-xs text-indigo-600 font-semibold">📜 سجل التفاعلات (<%= l.activities.length %>)</summary>
        <ul class="mt-2 space-y-1.5 border-s-2 border-gray-100 ps-3">
          <% l.activities.forEach(function(a){ %>
          <li class="text-xs text-gray-600">
            <span class="font-semibold"><%= ACT_LABELS[a.type] || a.type %></span>
            <% if (a.body) { %>— <%= a.body %><% } %>
            <span class="text-gray-300 block"><%= fmtDateTime(a.created_at) %></span>
          </li>
          <% }); %>
        </ul>
      </details>
      <% } %>

      <!-- تعديل بيانات العميل -->
      <details class="mt-2">
        <summary class="cursor-pointer text-xs text-gray-500 font-semibold">⚙️ تعديل البيانات</summary>
        <form method="POST" action="/admin/crm/<%= l.id %>/update" class="mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 items-center">
          <select name="status" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm">
            <% STATUSES.forEach(function(s){ %><option value="<%= s %>" <%= l.status===s ? 'selected' : '' %>><%= STATUS_LABELS[s] %></option><% }); %>
          </select>
          <select name="priority" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm">
            <% PRIORITIES.forEach(function(p){ %><option value="<%= p %>" <%= (l.priority||'normal')===p ? 'selected' : '' %>>أولوية <%= PRIORITY_LABELS[p] %></option><% }); %>
          </select>
          <input type="date" name="next_followup" value="<%= fmtDate(l.next_followup) %>" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm" title="متابعة قادمة" />
          <input name="email" value="<%= l.email || '' %>" placeholder="الإيميل" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm" />
          <input name="notes" value="<%= l.notes || '' %>" placeholder="ملاحظات" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm sm:col-span-2 lg:col-span-1" />
          <button class="bg-gray-800 text-white font-bold rounded-lg px-3 py-1.5 text-sm">حفظ</button>
        </form>
      </details>
    </div>
  <% }); %>
  </div>
  <div id="noResults" class="hidden bg-white rounded-2xl shadow-sm p-6 text-center text-gray-400 mb-6">مفيش نتيجة مطابقة للبحث.</div>
<% } %>

<!-- ====== أدوات الإدارة (قابلة للطي) ====== -->
<h2 class="text-sm font-bold text-gray-400 mb-2 mt-8">⚙️ أدوات الإدارة</h2>

<!-- إضافة عميل -->
<details class="bg-white rounded-2xl shadow-sm mb-3">
  <summary class="cursor-pointer font-bold text-gray-800 px-5 py-4">➕ إضافة عميل محتمل</summary>
  <div class="px-5 pb-5">
    <form method="POST" action="/admin/crm/add" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <input name="name" placeholder="الاسم" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="phone" placeholder="رقم الواتساب (01xxxxxxxxx)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="business_name" placeholder="اسم النشاط" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="category" placeholder="التصنيف (ملابس/هاند ميد...)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="email" placeholder="الإيميل (اختياري)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <select name="priority" class="border border-gray-200 rounded-lg px-3 py-2 text-sm">
        <option value="normal">أولوية عادية</option>
        <option value="high">أولوية عالية 🔥</option>
        <option value="low">أولوية منخفضة</option>
      </select>
      <input name="link" placeholder="لينك الصفحة (فيسبوك/إنستجرام)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="source" placeholder="المصدر" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <input name="notes" placeholder="ملاحظات" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
      <button class="brand-bg text-white font-bold rounded-lg px-4 py-2 text-sm">إضافة</button>
    </form>
  </div>
</details>

<!-- استيراد جماعي -->
<details class="bg-white rounded-2xl shadow-sm mb-3">
  <summary class="cursor-pointer font-bold text-gray-800 px-5 py-4">📥 استيراد جماعي</summary>
  <div class="px-5 pb-5">
    <p class="text-xs text-gray-500 mb-2">الصق عملاء (سطر لكل عميل) بالصيغة دي مفصولة بـ <code>|</code>:<br>
      <span class="font-mono text-gray-600">الاسم | الرقم | النشاط | التصنيف | اللينك | ملاحظات</span></p>
    <form method="POST" action="/admin/crm/import">
      <textarea name="bulk" rows="4" placeholder="إسراء | 01010959964 | هاند ميد وهدايا | هاند ميد | instagram.com/... | اهتمت بالعرض" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono"></textarea>
      <button class="mt-2 bg-gray-800 text-white font-bold rounded-lg px-4 py-2 text-sm">استيراد</button>
    </form>
  </div>
</details>

<!-- رسالة تحديث جماعية -->
<details class="bg-white rounded-2xl shadow-sm mb-3">
  <summary class="cursor-pointer font-bold text-gray-800 px-5 py-4">📣 رسالة تحديث جماعية</summary>
  <div class="px-5 pb-5">
    <p class="text-xs text-gray-500 mb-2">اكتب التحديث هنا، وهيتحط تلقائياً في زر «📣 تحديث» لكل عميل — تضغط الزر وتبعت <strong>يدوياً</strong>.</p>
    <textarea id="broadcast" rows="2" placeholder="مثال: نزلت ميزة جديدة على المتجر 🎉 تحبي أوريهالك؟" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"></textarea>
  </div>
</details>

<!-- ردود جاهزة -->
<details class="bg-white rounded-2xl shadow-sm mb-3">
  <summary class="cursor-pointer font-bold text-gray-800 px-5 py-4">💬 ردود جاهزة (انسخ وعدّل قبل الإرسال)</summary>
  <div class="px-5 pb-5">
    <%
      var REPLIES = [
