    %>
    <div class="space-y-2">
      <% REPLIES.forEach(function(r){ %>
      <details class="border border-gray-100 rounded-lg">
        <summary class="cursor-pointer font-semibold text-sm text-gray-700 px-3 py-2"><%= r.t %></summary>
        <div class="px-3 pb-3">
          <p class="reply-text text-sm text-gray-600 whitespace-pre-line bg-gray-50 rounded p-2 leading-relaxed"><%= r.m %></p>
          <button type="button" class="copy-btn mt-2 text-xs brand-bg text-white rounded px-3 py-1">نسخ 📋</button>
        </div>
      </details>
      <% }); %>
    </div>
  </div>
</details>

<script>
  // اربط نص التحديث الجماعي بكل أزرار «📣 تحديث».
  (function(){
    var ta = document.getElementById('broadcast');
    function sync(){
      var txt = ta.value.trim();
      document.querySelectorAll('.wa-link').forEach(function(a){
        var base = a.getAttribute('data-base');
        a.href = txt ? (base + '?text=' + encodeURIComponent(txt)) : base;
      });
    }
    if (ta) ta.addEventListener('input', sync);
  })();

  // نسخ الردود الجاهزة.
  document.querySelectorAll('.copy-btn').forEach(function(b){
    b.addEventListener('click', function(){
      var p = b.closest('details').querySelector('.reply-text');
      if (!p) return;
      navigator.clipboard.writeText(p.innerText).then(function(){
        var o = b.textContent; b.textContent = 'تم النسخ ✓';
        setTimeout(function(){ b.textContent = o; }, 1500);
      });
    });
  });

  // بحث فوري.
  (function(){
    var box = document.getElementById('leadSearch');
    if (!box) return;
    var cards = Array.prototype.slice.call(document.querySelectorAll('.lead-card'));
    var none = document.getElementById('noResults');
    box.addEventListener('input', function(){
      var q = box.value.trim().toLowerCase(), shown = 0;
      cards.forEach(function(c){
        var match = !q || (c.getAttribute('data-search') || '').indexOf(q) !== -1;
        c.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (none) none.classList.toggle('hidden', shown !== 0);
    });
  })();
</script>

