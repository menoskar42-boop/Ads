<% pageTitle = 'CRM — العملاء المحتملين'; activePage = 'crm'; %>
<%- include('../_layout_top') %>
<%
  var STATUS_LABELS = { new:'جديد', contacted:'تم التواصل', interested:'مهتم', converted:'عميل ✅', lost:'غير مهتم' };
  var STATUS_BADGE = {
    new:'bg-gray-100 text-gray-700', contacted:'bg-blue-100 text-blue-700',
    interested:'bg-amber-100 text-amber-700', converted:'bg-green-100 text-green-700',
    lost:'bg-red-100 text-red-600'
  };
  var STATUSES = ['new','contacted','interested','converted','lost'];
  function fmtDate(d){ if(!d) return ''; try{ return new Date(d).toISOString().slice(0,10); }catch(e){ return ''; } }
%>

<div class="mb-5 flex items-center justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-2xl font-extrabold text-gray-900">CRM — العملاء المحتملين</h1>
    <p class="text-gray-500 text-sm">سجّل العملاء اللي تواصلت معاهم، تابعهم، وابعتلهم تحديثات على واتساب.</p>
  </div>
</div>

<!-- فلاتر الحالة -->
<div class="flex flex-wrap gap-2 mb-5 text-sm">
  <a href="/admin/crm" class="px-3 py-1.5 rounded-full font-semibold <%= currentFilter==='' ? 'brand-bg text-white' : 'bg-white text-gray-600 border border-gray-200' %>">الكل</a>
  <% STATUSES.forEach(function(s){ %>
    <a href="/admin/crm?status=<%= s %>" class="px-3 py-1.5 rounded-full font-semibold <%= currentFilter===s ? 'brand-bg text-white' : 'bg-white text-gray-600 border border-gray-200' %>">
      <%= STATUS_LABELS[s] %> (<%= countMap[s] || 0 %>)
    </a>
  <% }); %>
</div>

<!-- فلتر التصنيف -->
<% if (categories && categories.length) { %>
<div class="flex flex-wrap gap-2 mb-5 text-sm items-center">
  <span class="text-gray-400 text-xs font-bold">التصنيف:</span>
  <a href="/admin/crm<%= currentFilter ? '?status='+currentFilter : '' %>" class="px-3 py-1 rounded-full font-semibold <%= currentCategory==='' ? 'bg-gray-800 text-white' : 'bg-white text-gray-600 border border-gray-200' %>">الكل</a>
  <% categories.forEach(function(c){ %>
    <a href="/admin/crm?category=<%= encodeURIComponent(c.category) %><%= currentFilter ? '&status='+currentFilter : '' %>" class="px-3 py-1 rounded-full font-semibold <%= currentCategory===c.category ? 'bg-gray-800 text-white' : 'bg-white text-gray-600 border border-gray-200' %>"><%= c.category %> (<%= c.n %>)</a>
  <% }); %>
</div>
<% } %>

<!-- إضافة عميل -->
<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <h2 class="font-bold text-gray-800 mb-3">➕ إضافة عميل محتمل</h2>
  <form method="POST" action="/admin/crm/add" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <input name="name" placeholder="الاسم" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="phone" placeholder="رقم الواتساب (01xxxxxxxxx)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="business_name" placeholder="اسم النشاط" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="category" placeholder="التصنيف (ملابس/هاند ميد/أدوات منزلية...)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="link" placeholder="لينك الصفحة (فيسبوك/إنستجرام)" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="source" placeholder="المصدر" class="border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <input name="notes" placeholder="ملاحظات" class="border border-gray-200 rounded-lg px-3 py-2 text-sm sm:col-span-2" />
    <button class="brand-bg text-white font-bold rounded-lg px-4 py-2 text-sm">إضافة</button>
  </form>
</div>

<!-- استيراد جماعي (لصق نتائج البحث) -->
<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <h2 class="font-bold text-gray-800 mb-2">📥 استيراد جماعي</h2>
  <p class="text-xs text-gray-500 mb-2">الصق عملاء (سطر لكل عميل) بالصيغة دي مفصولة بـ <code>|</code>:<br>
    <span class="font-mono text-gray-600">الاسم | الرقم | النشاط | التصنيف | اللينك | ملاحظات</span></p>
  <form method="POST" action="/admin/crm/import">
    <textarea name="bulk" rows="4" placeholder="إسراء | 01010959964 | هاند ميد وهدايا | هاند ميد | instagram.com/... | اهتمت بالعرض" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono"></textarea>
    <button class="mt-2 bg-gray-800 text-white font-bold rounded-lg px-4 py-2 text-sm">استيراد</button>
  </form>
</div>

<!-- رسالة تحديث جماعية -->
<div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-5 mb-5">
  <h2 class="font-bold text-gray-800 mb-2">📣 رسالة تحديث جماعية</h2>
  <p class="text-xs text-gray-500 mb-2">اكتب التحديث هنا (مثلاً: ميزة جديدة على المتجر)، وهيتحط تلقائياً في زر واتساب لكل عميل — تضغط الزر وتبعت <strong>يدوياً</strong> لكل واحد.</p>
  <textarea id="broadcast" rows="2" placeholder="مثال: نزلت ميزة جديدة على المتجر الإلكتروني 🎉 تحبي أوريهالك؟" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"></textarea>
</div>

<!-- ردود جاهزة (انسخ وعدّل) -->
<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <h2 class="font-bold text-gray-800 mb-3">💬 ردود جاهزة (انسخ وعدّل قبل الإرسال)</h2>
  <%
    var REPLIES = [
      { t: '① مجاني إزاي / إيه الكاتش؟', m: 'أيوة يا فندم، مجاني فعلاً 🌹 وطبيعي تستغربي. OscarDevs منصّة بتكبّر، فبنقدّمه مجاناً لعدد محدود من الأنشطة اللي بتشترك دلوقتي — نبني سمعتنا، وانتي تكسبي متجر بيبيع لك. مفيش رسوم خفية، والإضافات المتقدّمة مستقبلاً اختيارية.' },
      { t: '② المثال', m: 'اتفضلي مثال حقيقي لمتجر على منصّتنا 👇 delta.oscardevs.com — تخيّلي منتجاتك معروضة كده. تحبي نبدأ؟ 😊' },
      { t: '③ خطوات البدء', m: 'يلّا نبدأ وأنا معاكي خطوة بخطوة:\n1️⃣ ادخلي oscardevs.com/apply\n2️⃣ اختاري «متجر»\n3️⃣ اكتبي اسم نشاطك + اختاري رابط متجرك + كلمة سر + إرسال.\nإنتي بتسجّلي بنفسك لأن كلمة السر خاصة بيكي (أمان حسابك). أول ما تبعتي أفعّلك فوراً 💪' },
      { t: '④ بكام بعد العرض؟', m: 'ضمن العرض الحالي مجاني مدى الحياة لو اشتركتي دلوقتي. بعد العرض الاشتراك بيكون مدفوع — فإنتي بتثبّتي مجانيتك للأبد لو بدأتي الآن 🎁' },
      { t: '⑤ إزاي أضيف منتجاتي؟', m: 'سهلة جداً: بعد تسجيل الدخول من oscardevs.com/company/login، من لوحة التحكّم تضيفي منتج بصورة وسعر وقسم — وأنا معاكي في أول منتج لو حابة 🌹' },
      { t: '⑥ صعب / محتاج خبرة؟', m: 'لأ خالص، لوحة تحكّم بسيطة — وإحنا بندعمك خطوة بخطوة. إنتي بتضيفي منتجاتك بس، والباقي علينا 😊' },
      { t: '⑦ متابعة (مشغولة/ساكتة)', m: 'خدي وقتك يا فندم، مفيش استعجال 🌸 العرض محجوزلك، وأول ما تفضي حتى ٥ دقايق نبدأ سوا. تحبي أطمن عليكي بكره؟' }
    ];
  %>
  <div class="space-y-2">
    <% REPLIES.forEach(function(r){ %>
    <details class="border border-gray-100 rounded-lg">
      <summary class="cursor-pointer font-semibold text-sm text-gray-700 px-3 py-2"><%= r.t %></summary>
      <div class="px-3 pb-3">
        <p class="reply-text text-sm text-gray-600 whitespace-pre-line bg-gray-50 rounded p-2 leading-relaxed"><%= r.m %></p>
        <button type="button" class="copy-btn mt-2 text-xs brand-bg text-white rounded px-3 py-1">نسخ 📋</button>
      </div>
    </details>
    <% }); %>
  </div>
</div>

<!-- قائمة العملاء -->
<% if (!leads.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-gray-400">مفيش عملاء لسه — ابدأ بإضافة عميل فوق.</div>
<% } else { %>
  <div class="space-y-3">
  <% leads.forEach(function(l){ %>
    <div class="bg-white rounded-2xl shadow-sm p-4">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div class="min-w-[200px]">
          <div class="font-bold text-gray-900"><%= l.name || l.business_name || 'بدون اسم' %>
            <span class="text-xs font-semibold rounded-full px-2 py-0.5 ms-1 <%= STATUS_BADGE[l.status] || STATUS_BADGE.new %>"><%= STATUS_LABELS[l.status] || l.status %></span>
          </div>
          <% if (l.business_name && l.name) { %><div class="text-sm text-gray-500"><%= l.business_name %></div><% } %>
          <div class="text-sm text-gray-600 mt-1">
            <%= l.phone || '—' %>
            <% if (l.category) { %> · <span class="bg-gray-100 text-gray-600 rounded px-1.5 py-0.5 text-xs"><%= l.category %></span><% } %>
            <% if (l.source) { %> · <span class="text-gray-400 text-xs"><%= l.source %></span><% } %>
          </div>
          <% if (l.link) { %><div class="text-xs mt-1"><a href="<%= l.link %>" target="_blank" rel="noopener" class="text-indigo-600 underline">صفحة العميل ↗</a></div><% } %>
          <% if (l.notes) { %><div class="text-xs text-gray-500 mt-1">📝 <%= l.notes %></div><% } %>
        </div>
        <div class="flex items-center gap-2">
          <% if (l.wa) { %>
            <a class="inline-flex items-center gap-1 bg-green-600 hover:bg-green-700 text-white text-sm font-bold rounded-lg px-3 py-2" href="https://wa.me/<%= l.wa %>" target="_blank" rel="noopener" title="افتح محادثة واتساب للرد مباشرة">💬 رد</a>
            <a class="wa-link inline-flex items-center gap-1 bg-green-500 hover:bg-green-600 text-white text-sm font-bold rounded-lg px-3 py-2" data-base="https://wa.me/<%= l.wa %>" href="https://wa.me/<%= l.wa %>" target="_blank" rel="noopener" title="ابعت التحديث الجماعي">📣 تحديث</a>
          <% } else { %>
            <span class="text-xs text-gray-400">لا يوجد رقم</span>
          <% } %>
          <form method="POST" action="/admin/crm/<%= l.id %>/delete" onsubmit="return confirm('حذف العميل ده؟');">
            <button class="text-gray-400 hover:text-red-500 text-sm px-2 py-2" title="حذف">🗑️</button>
          </form>
        </div>
      </div>
      <!-- تعديل الحالة/المتابعة -->
      <form method="POST" action="/admin/crm/<%= l.id %>/update" class="mt-3 grid grid-cols-1 sm:grid-cols-4 gap-2 items-center border-t border-gray-100 pt-3">
        <select name="status" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm">
          <% STATUSES.forEach(function(s){ %>
            <option value="<%= s %>" <%= l.status===s ? 'selected' : '' %>><%= STATUS_LABELS[s] %></option>
          <% }); %>
        </select>
        <input type="date" name="next_followup" value="<%= fmtDate(l.next_followup) %>" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm" title="متابعة قادمة" />
        <input name="notes" value="<%= l.notes || '' %>" placeholder="ملاحظات" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm" />
        <button class="bg-gray-800 text-white font-bold rounded-lg px-3 py-1.5 text-sm">حفظ</button>
      </form>
    </div>
  <% }); %>
  </div>
<% } %>

<script>
  // اربط نص التحديث الجماعي بكل أزرار واتساب (إرسال يدوي لكل عميل).
  (function(){
    var ta = document.getElementById('broadcast');
    function sync(){
      var txt = ta.value.trim();
      document.querySelectorAll('.wa-link').forEach(function(a){
        var base = a.getAttribute('data-base');
        a.href = txt ? (base + '?text=' + encodeURIComponent(txt)) : base;
      });
    }
    if (ta) ta.addEventListener('input', sync);
  })();

  // نسخ الردود الجاهزة للحافظة.
  document.querySelectorAll('.copy-btn').forEach(function(b){
    b.addEventListener('click', function(){
      var p = b.closest('details').querySelector('.reply-text');
      if (!p) return;
      navigator.clipboard.writeText(p.innerText).then(function(){
        var o = b.textContent;
        b.textContent = 'تم النسخ ✓';
        setTimeout(function(){ b.textContent = o; }, 1500);
      });
    });
  });
</script>

<%- include('../_layout_bottom') %>
