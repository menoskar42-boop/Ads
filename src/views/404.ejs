<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 – Not Found | Oscardevs Ads</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">
  <div class="max-w-md w-full text-center">
    <div class="w-24 h-24 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-8">
      <svg class="w-12 h-12 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <h1 class="text-6xl font-extrabold text-blue-600 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-gray-800 mb-3">Company Not Found</h2>
    <% if (typeof subdomain !== 'undefined' && subdomain) { %>
    <p class="text-gray-500 mb-8">
      We couldn't find a company with the subdomain
      <code class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded font-mono text-sm"><%= subdomain %></code>.
      <br/>It may not exist or is currently inactive.
    </p>
    <% } else { %>
    <p class="text-gray-500 mb-8">The page you're looking for doesn't exist on our platform.</p>
    <% } %>
    <a href="/" class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-full hover:bg-blue-700 transition">
      Back to Homepage
    </a>
  </div>
</body>
</html>
