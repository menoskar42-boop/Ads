<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<%# No ads_loader on 404 — error pages must never carry AdSense code (policy).
    Guarantees zero adsbygoogle in the 404 source, regardless of showAds. %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%# One variable for both: <title> and og:title said different things here,
      which is #12 in docs/SEO_MISTAKES_LOG.md — Google reads one headline and
      the social card shows another. The seo_meta form wins because that is the
      one already used everywhere else. %>
  <% var __t = 'الصفحة غير موجودة — OscarDevs'; %>
  <title><%= __t %></title>
  <meta name="description" content="الصفحة اللي بتدور عليها مش موجودة. ارجع للرئيسية أو تصفّح المدوّنة." />
  <meta name="robots" content="noindex,follow" />
  <%- include('partials/seo_meta', { title: __t, description: 'الصفحة اللي بتدور عليها مش موجودة. ارجع للرئيسية أو تصفّح المدوّنة.' }) %>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" />
  <style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">
  <div class="max-w-lg w-full text-center">
    <div class="w-24 h-24 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-8">
      <svg class="w-12 h-12 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <h1 class="text-6xl font-extrabold text-indigo-700 mb-3">404</h1>
    <h2 class="text-2xl font-bold text-gray-800 mb-3">الصفحة غير موجودة</h2>
    <% if (typeof subdomain !== 'undefined' && subdomain) { %>
      <p class="text-gray-500 mb-8">مفيش شركة بالاسم <code class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded font-mono text-sm"><%= subdomain %></code>. ممكن تكون اتشطبت أو غير مفعّلة.</p>
    <% } else { %>
      <p class="text-gray-500 mb-8">الصفحة اللي بتدور عليها مش موجودة. جرّب الروابط التالية:</p>
    <% } %>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="inline-block bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl hover:bg-indigo-800 transition shadow">الرئيسية</a>
      <a href="/blog" class="inline-block bg-gray-100 text-gray-700 font-bold px-6 py-2.5 rounded-xl hover:bg-gray-200 transition">المدوّنة</a>
      <a href="/about" class="inline-block bg-gray-100 text-gray-700 font-bold px-6 py-2.5 rounded-xl hover:bg-gray-200 transition">من نحن</a>
      <a href="/contact" class="inline-block bg-gray-100 text-gray-700 font-bold px-6 py-2.5 rounded-xl hover:bg-gray-200 transition">اتصل بنا</a>
    </div>
  </div>
</body>
</html>
