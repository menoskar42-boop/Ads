<%- include('head', { title: t('nt.msg.title'), tab: 'messages' }) %>
<% function fmtT(v){ if(!v) return '—'; try { return new Date(v).toLocaleString(LOC,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); } catch(e){ return '—'; } } %>

<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('nt.msg.title') %></h1>
<p class="text-slate-500 mb-5 text-sm"><%= t('nt.msg.sub') %></p>

<% if (!on) { %>
  <%# الميزة مقفولة افتراضياً بقرار المالك: كل ميزة للتاجر اختيارية. والصندوق
      المقفول بيقول ده صراحةً بدل ما يبان فاضي وكأن مفيش مرضى بيسألوا. %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center">
    <p class="font-bold text-slate-800 mb-1"><%= t('nt.msg.off') %></p>
    <p class="text-sm text-slate-500 mb-4"><%= t('nt.msg.off_hint') %></p>
    <a href="/nutrition/settings" class="inline-block bg-brand-600 text-white font-bold rounded-xl px-5 py-2.5 text-sm"><%= t('nt.msg.open_settings') %></a>
  </div>
<% } else if (!rows.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-slate-400 text-sm"><%= t('nt.msg.none') %></div>
<% } else { %>
<div class="grid gap-2">
  <% rows.forEach(function(r){ %>
  <a href="/nutrition/messages/<%= r.patient_id %>" class="block bg-white rounded-2xl shadow-sm p-4 hover:bg-brand-50">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="font-bold text-slate-900"><%= r.patient_name %></span>
      <span class="text-xs text-slate-500" dir="ltr"><%= r.phone || '' %></span>
      <% if (r.unread) { %>
        <span class="text-[11px] font-bold bg-brand-600 text-white rounded-full px-2 py-0.5"><%= t('nt.msg.unread') %>: <%= r.unread %></span>
      <% } %>
      <span class="ms-auto text-xs text-slate-400"><%= fmtT(r.last_at) %></span>
    </div>
    <p class="text-sm text-slate-600 mt-1 truncate">
      <% if (r.last_sender === 'practice') { %><span class="text-slate-400"><%= t('nt.msg.you') %>:</span> <% } %><%= r.last_body %>
    </p>
  </a>
  <% }); %>
</div>
<% } %>

</main></body></html>
