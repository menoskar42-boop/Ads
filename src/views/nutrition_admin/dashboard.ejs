<%- include('head', { title: t('nt.nav.dashboard'), tab: 'dashboard' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1">🥗 <%= t('nt.dash.hi') %></h1>
<p class="text-slate-500 mb-6 text-sm"><%= t('nt.dash.sub') %></p>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-slate-500 mb-1">👥 <%= t('nt.dash.active') %></div>
    <div class="text-2xl font-extrabold text-slate-900"><%= tally.active %></div>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-slate-500 mb-1">📁 <%= t('nt.dash.archived') %></div>
    <div class="text-2xl font-extrabold text-slate-400"><%= tally.archived %></div>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-slate-500 mb-1">⏳ <%= t('nt.dash.lapsed') %></div>
    <div class="text-2xl font-extrabold <%= lapsed.length ? 'text-amber-600' : 'text-slate-900' %>"><%= lapsed.length %></div>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-slate-500 mb-1">📋 <%= t('nt.dash.no_readings') %></div>
    <div class="text-2xl font-extrabold <%= never.length ? 'text-amber-600' : 'text-slate-900' %>"><%= never.length %></div>
  </div>
</div>

<%# The two lists a dietitian actually needs. People do not announce that they
    have stopped coming — they just stop, and a card that surfaces the silence
    is worth more than another total. %>
<div class="grid lg:grid-cols-2 gap-5">
  <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 font-bold text-slate-800"><%= t('nt.dash.lapsed_title') %></div>
    <% if (!lapsed.length) { %>
      <p class="px-5 py-6 text-sm text-slate-500"><%= t('nt.dash.lapsed_none') %></p>
    <% } else { %>
    <div class="divide-y divide-slate-100">
      <% lapsed.forEach(function(p){ %>
      <a href="/nutrition/patients/<%= p.id %>" class="px-5 py-2.5 flex items-center gap-2 text-sm hover:bg-slate-50">
        <span class="text-slate-800 font-semibold truncate"><%= p.name %></span>
        <span class="ms-auto text-xs text-amber-700"><%= String(p.last_seen).slice(0,10) %></span>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 font-bold text-slate-800"><%= t('nt.dash.never_title') %></div>
    <% if (!never.length) { %>
      <p class="px-5 py-6 text-sm text-slate-500"><%= t('nt.dash.never_none') %></p>
    <% } else { %>
    <div class="divide-y divide-slate-100">
      <% never.forEach(function(p){ %>
      <a href="/nutrition/patients/<%= p.id %>" class="px-5 py-2.5 flex items-center gap-2 text-sm hover:bg-slate-50">
        <span class="text-slate-800 font-semibold truncate"><%= p.name %></span>
        <span class="ms-auto text-xs text-slate-400"><%= t('nt.dash.add_first') %></span>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
