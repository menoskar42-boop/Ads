<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# Health data about named people. noindex is not a preference here, and these
    pages carry no ads — a logged-in patient file has no business showing one. %>
<meta name="robots" content="noindex,nofollow" />
<title><%= title %> — <%= company.company_name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans: ['Cairo','system-ui','sans-serif'] },
    colors: { brand: { 50:'#f0fdf4',100:'#dcfce7',200:'#bbf7d0',300:'#86efac',400:'#4ade80',500:'#22c55e',600:'#16a34a',700:'#15803d',800:'#166534',900:'#14532d' } }
  } } };
</script>
<style>
  body{font-family:'Cairo',sans-serif}
  @media (max-width: 639px) {
    table.rt, table.rt tbody, table.rt tr, table.rt td { display: block; width: 100%; }
    table.rt thead { display: none; }
    table.rt tr { background:#fff; border:1px solid #e5e7eb; border-radius:1rem; padding:.5rem .75rem; margin-bottom:.6rem; }
    table.rt td { display:flex; align-items:center; gap:.5rem; padding:.35rem 0 !important; border:0 !important; text-align:start !important; }
    table.rt td::before { content: attr(data-l); flex:0 0 40%; color:#4b5563; font-size:.7rem; font-weight:700; }
    table.rt td:not([data-l])::before { content:none; }
    table.rt td:not([data-l]) { justify-content:flex-end; }
    input, select, textarea { font-size:16px !important; }
    button, .btn { min-height:40px; }
  }
</style>
</head>
<body class="bg-slate-50 text-slate-800 pb-16 sm:pb-0">
<%
  var __tab = typeof tab !== 'undefined' ? tab : '';
  function __cls(k){ return 'px-3 py-1.5 rounded-lg ' + (__tab===k ? 'bg-white/25 font-bold' : 'hover:bg-white/15'); }
  /* A link the server answers with 403 is worse than no link. The guard in
     src/nutrition/perms.js is what actually decides; this only keeps the
     assistant's screen from showing doors that will not open. */
  var __p = (typeof perms !== 'undefined' && perms) ? perms
    : { patients: true, measure: true, clinical: true, settings: true, staff: true, isStaff: false };
  var __nav = [
    { key:'dashboard', path:'/nutrition',          label: t('nt.nav.dashboard'), on: true },
    { key:'patients',  path:'/nutrition/patients', label: t('nt.nav.patients'),  on: __p.patients },
    { key:'foods',     path:'/nutrition/foods',    label: t('nt.nav.foods'),     on: __p.settings },
    { key:'settings',  path:'/nutrition/settings', label: t('nt.nav.settings'),  on: __p.settings },
    { key:'staff',     path:'/nutrition/staff',    label: t('nt.nav.staff'),     on: __p.staff }
  ].filter(function(n){ return n.on; });
%>

<header class="bg-brand-600 text-white">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3 flex-wrap">
    <a href="/nutrition" class="font-black text-lg flex items-center gap-2">
      🥗 <span class="truncate max-w-[45vw] sm:max-w-none"><%= company.company_name %></span>
    </a>
    <nav class="hidden sm:flex items-center gap-1 text-sm ms-auto">
      <% __nav.forEach(function(n){ %><a href="<%= n.path %>" class="<%= __cls(n.key) %>"><%= n.label %></a><% }); %>
    </nav>
    <% if (__p.isStaff) { %><span class="hidden sm:inline text-xs text-white/80"><%= __p.name %> · <%= t('nt.staff.role.' + __p.role) %></span><% } %>
    <form method="post" action="/company/logout" class="ms-auto sm:ms-0">
      <button class="text-xs bg-white/15 hover:bg-white/25 rounded-lg px-3 py-1.5"><%= t('common.logout') %></button>
    </form>
  </div>
</header>

<nav class="sm:hidden bg-brand-700 text-white/90 overflow-x-auto">
  <div class="flex gap-1 px-3 py-2 text-xs whitespace-nowrap">
    <% __nav.forEach(function(n){ %><a href="<%= n.path %>" class="<%= __cls(n.key) %>"><%= n.label %></a><% }); %>
  </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-6">
