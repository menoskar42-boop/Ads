<%- include('head', { title: patient.name, tab: 'messages' }) %>
<% function fmtT(v){ if(!v) return ''; try { return new Date(v).toLocaleString(LOC,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); } catch(e){ return ''; } } %>

<div class="flex items-center gap-3 mb-4 flex-wrap">
  <a href="/nutrition/messages" class="text-slate-400 hover:text-slate-600 text-sm">← <%= t('nt.msg.title') %></a>
  <h1 class="text-xl font-black text-slate-900"><%= patient.name %></h1>
  <a href="/nutrition/patients/<%= patient.id %>" class="ms-auto text-xs font-bold text-brand-700 hover:underline"><%= t('nt.msg.open_file') %></a>
</div>

<% if (waiting !== null) { %>
  <%# مستني رد بقاله كام ساعة — محسوب من الرسايل نفسها، مش عمود بيعلّق خيوط
      قديمة «مستنية» للأبد. %>
  <div class="bg-amber-50 border border-amber-200 rounded-2xl px-4 py-2.5 mb-3 text-sm text-amber-900">
    ⏳ <%= t('nt.msg.waiting').replace('{h}', waiting) %>
  </div>
<% } %>
<% if (sent) { %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-3 text-sm text-emerald-800"><%= t('nt.msg.sent_ok') %></div>
<% } %>
<% if (err) { %>
  <div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-3 text-sm text-red-800"><%= t('nt.msg.err.' + err) %></div>
<% } %>

<div class="grid gap-2 mb-4 max-w-2xl">
  <% thread.forEach(function(m){ %>
  <div class="flex <%= m.mine ? 'justify-end' : 'justify-start' %>">
    <div class="max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm <%= m.mine ? 'bg-brand-600 text-white' : 'bg-white text-slate-800' %>">
      <div class="text-[11px] font-bold mb-0.5 <%= m.mine ? 'text-white/70' : 'text-slate-400' %>">
        <%= m.mine ? (m.author ? m.author : t('nt.msg.you')) : patient.name %>
      </div>
      <p class="text-sm whitespace-pre-line"><%= m.body %></p>
      <div class="text-[10px] mt-1 <%= m.mine ? 'text-white/70' : 'text-slate-400' %>">
        <%= fmtT(m.at) %><% if (m.state) { %> · <%= t('nt.msg.st.' + m.state) %><% } %>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<form method="post" action="/nutrition/messages/<%= patient.id %>" class="bg-white rounded-2xl shadow-sm p-4 max-w-2xl">
  <label class="text-xs font-bold text-slate-600 block mb-1"><%= t('nt.msg.reply') %></label>
  <textarea name="body" rows="3" required maxlength="<%= maxLen %>"
            class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"></textarea>
  <button class="mt-2 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl px-5 py-2.5 text-sm"><%= t('nt.msg.send') %></button>
</form>

</main></body></html>
