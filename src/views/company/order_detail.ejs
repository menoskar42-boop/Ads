<%
  pageTitle = `Order #${order.id}`;
  activePage = 'orders';
%>
<%- include('_layout_top') %>

  <div class="space-y-6 max-w-3xl">
    <div class="bg-white rounded-2xl shadow-sm p-6">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <div>
          <h2 class="text-xl font-bold text-gray-800 mb-1">Order #<%= order.id %></h2>
          <p class="text-xs text-gray-400"><%= new Date(order.created_at).toLocaleString() %></p>
        </div>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase <%= order.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : order.status === 'cancelled' ? 'bg-red-100 text-red-700' : order.status === 'delivered' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700' %>">
          <%= order.status %>
        </span>
      </div>

      <h3 class="font-bold text-gray-700 mb-2">Customer</h3>
      <dl class="text-sm space-y-1 mb-6">
        <div class="flex gap-3"><dt class="text-gray-400 w-24">Name</dt><dd class="font-semibold"><%= order.customer_name %></dd></div>
        <div class="flex gap-3"><dt class="text-gray-400 w-24">Phone</dt><dd class="font-mono"><a href="tel:<%= order.customer_phone %>" class="brand-text hover:underline"><%= order.customer_phone %></a></dd></div>
        <% if (order.customer_email) { %>
          <div class="flex gap-3"><dt class="text-gray-400 w-24">Email</dt><dd><a href="mailto:<%= order.customer_email %>" class="brand-text hover:underline"><%= order.customer_email %></a></dd></div>
        <% } %>
        <div class="flex gap-3"><dt class="text-gray-400 w-24">Address</dt><dd class="whitespace-pre-wrap"><%= order.shipping_address %></dd></div>
        <% if (order.notes) { %>
          <div class="flex gap-3"><dt class="text-gray-400 w-24">Notes</dt><dd class="whitespace-pre-wrap"><%= order.notes %></dd></div>
        <% } %>
      </dl>

      <h3 class="font-bold text-gray-700 mb-2">Items</h3>
      <table class="w-full text-sm mb-4">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
          <tr>
            <th class="px-3 py-2 text-left">Product</th>
            <th class="px-3 py-2 text-center">Qty</th>
            <th class="px-3 py-2 text-right">Unit</th>
            <th class="px-3 py-2 text-right">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% items.forEach(it => { %>
            <tr>
              <td class="px-3 py-2"><%= it.product_name %></td>
              <td class="px-3 py-2 text-center"><%= it.quantity %></td>
              <td class="px-3 py-2 text-right font-mono"><%= Number(it.unit_price).toFixed(2) %></td>
              <td class="px-3 py-2 text-right font-mono"><%= (Number(it.unit_price) * it.quantity).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr class="font-bold text-gray-800">
            <td colspan="3" class="px-3 py-3 text-right">Total</td>
            <td class="px-3 py-3 text-right font-mono"><%= Number(order.total_amount).toFixed(2) %></td>
          </tr>
        </tfoot>
      </table>

      <h3 class="font-bold text-gray-700 mb-2">Update Status</h3>
      <form method="POST" action="/company/orders/<%= order.id %>/status" class="flex items-center gap-2">
        <select name="status" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200">
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="brand-bg text-white text-sm font-semibold px-4 py-2 rounded-xl hover:opacity-90 transition">Update</button>
        <a href="/company/orders" class="text-gray-500 hover:text-gray-700 text-sm ml-auto">← Back</a>
      </form>
    </div>
  </div>

<%- include('_layout_bottom') %>
