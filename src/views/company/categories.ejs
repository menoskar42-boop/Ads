<%
  pageTitle = t('company.categories');
  activePage = 'categories';
%>
<%- include('_layout_top') %>

  <div class="space-y-6 max-w-2xl">
    <div class="bg-white rounded-2xl shadow-sm p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-1"><%= t('company.product_categories') %></h2>
      <p class="text-gray-400 text-sm mb-6"><%= t('company.categories_help') %></p>

      <form method="POST" action="/company/categories/add" class="flex items-center gap-2 mb-6">
        <input type="text" name="name" required placeholder="<%= t('common.name') %>"
          class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        <button type="submit" class="brand-bg text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:opacity-90 transition">+ <%= t('common.add') %></button>
      </form>

      <% if (!categories.length) { %>
        <p class="text-center text-gray-400 text-sm py-4"><%= t('company.no_categories') %></p>
      <% } else { %>
        <ul class="divide-y divide-gray-100">
          <% categories.forEach(c => { %>
            <li class="py-3 flex items-center justify-between gap-3">
              <form method="POST" action="/company/categories/<%= c.id %>/rename" class="flex items-center gap-2 flex-1">
                <input type="text" name="name" value="<%= c.name %>" required
                  class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
                <button type="submit" class="text-xs px-2.5 py-1.5 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition"><%= t('common.save') %></button>
              </form>
              <form method="POST" action="/company/categories/<%= c.id %>/delete" onsubmit="return confirm('<%= t('common.confirm_delete') %>');">
                <button type="submit" class="text-xs px-2.5 py-1.5 rounded-lg bg-red-50 text-red-700 hover:bg-red-100 transition"><%= t('common.delete') %></button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

<%- include('_layout_bottom') %>
