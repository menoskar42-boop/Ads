<% pageTitle = 'تحليلات المتجر'; activePage = 'analytics'; %>
<%- include('_layout_top') %>
<%
  var SRC_LABEL = { direct:'مباشر', search:'بحث (جوجل)', facebook:'فيسبوك', instagram:'إنستجرام', tiktok:'تيك توك', whatsapp:'واتساب', twitter:'تويتر/X', youtube:'يوتيوب', referral:'مواقع أخرى' };
  var maxDaily = 1; (data.daily || []).forEach(function(r){ if (r.n > maxDaily) maxDaily = r.n; });
  var maxSold = 1; (data.topProducts || []).forEach(function(p){ if (Number(p.sold_count) > maxSold) maxSold = Number(p.sold_count); });
  var srcTotal = 0; (data.sources || []).forEach(function(s){ srcTotal += s.n; }); srcTotal = srcTotal || 1;
%>
  <div class="max-w-4xl">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-5">
      <div>
        <h2 class="text-xl font-bold text-gray-800">📊 تحليلات المتجر</h2>
        <p class="text-gray-500 text-sm">آخر <%= days %> يوم — زيارات، مصادر الترافيك، ومعدّل التحويل.</p>
      </div>
      <form method="GET" class="flex items-center gap-2">
        <select name="days" onchange="this.form.submit()" class="border border-gray-200 rounded-xl px-3 py-2 text-sm bg-white">
          <% [7,30,90].forEach(function(d){ %><option value="<%= d %>" <%= days===d?'selected':'' %>>آخر <%= d %> يوم</option><% }); %>
        </select>
      </form>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-400">زيارات</div><div class="text-2xl font-black text-gray-800"><%= Number(data.totalVisits).toLocaleString('ar-EG') %></div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-400">مشاهدات منتجات</div><div class="text-2xl font-black text-gray-800"><%= Number(data.productViews).toLocaleString('ar-EG') %></div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-400">طلبات</div><div class="text-2xl font-black text-emerald-600"><%= Number(data.orders).toLocaleString('ar-EG') %></div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-400">معدّل التحويل</div><div class="text-2xl font-black text-indigo-600"><%= data.conversion %>%</div></div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <!-- Visits over time -->
      <div class="bg-white rounded-2xl shadow-sm p-5">
        <h3 class="font-bold text-gray-700 mb-3 text-sm">الزيارات يومياً</h3>
        <% if (!data.daily.length) { %>
          <p class="text-sm text-gray-400 text-center py-8">مفيش بيانات زيارات بعد.</p>
        <% } else { %>
          <div class="flex items-end gap-1 h-32">
            <% data.daily.forEach(function(r){ var h = Math.round(Number(r.n)/maxDaily*100); %>
            <div class="flex-1 flex flex-col items-center justify-end" title="<%= new Date(r.day).toLocaleDateString('ar-EG') %>: <%= r.n %>">
              <div class="w-full rounded-t bg-indigo-400" style="height:<%= Math.max(4,h) %>%"></div>
            </div>
            <% }); %>
          </div>
          <div class="text-[11px] text-gray-400 mt-2 flex justify-between"><span><%= new Date(data.daily[0].day).toLocaleDateString('ar-EG') %></span><span><%= new Date(data.daily[data.daily.length-1].day).toLocaleDateString('ar-EG') %></span></div>
        <% } %>
      </div>

      <!-- Traffic sources -->
      <div class="bg-white rounded-2xl shadow-sm p-5">
        <h3 class="font-bold text-gray-700 mb-3 text-sm">مصادر الترافيك</h3>
        <% if (!data.sources.length) { %>
          <p class="text-sm text-gray-400 text-center py-8">مفيش بيانات بعد.</p>
        <% } else { %>
          <div class="space-y-2">
            <% data.sources.forEach(function(s){ var pct = Math.round(s.n/srcTotal*100); %>
            <div>
              <div class="flex items-center justify-between text-xs text-gray-600 mb-1">
                <span><%= SRC_LABEL[s.source] || s.source %></span>
                <span class="font-semibold"><%= s.n %> (<%= pct %>%)</span>
              </div>
              <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full bg-emerald-400 rounded-full" style="width:<%= pct %>%"></div></div>
            </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Top products -->
    <div class="bg-white rounded-2xl shadow-sm p-5 mt-4">
      <h3 class="font-bold text-gray-700 mb-3 text-sm">أكثر المنتجات مبيعاً</h3>
      <% if (!data.topProducts.length) { %>
        <p class="text-sm text-gray-400 text-center py-6">مفيش منتجات.</p>
      <% } else { %>
        <div class="space-y-2">
          <% data.topProducts.forEach(function(p){ var pct = Math.round(Number(p.sold_count||0)/maxSold*100); %>
          <div class="flex items-center gap-3">
            <span class="text-sm text-gray-700 truncate w-40 shrink-0"><%= p.name %></span>
            <div class="flex-1 h-2.5 bg-gray-100 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:<%= Math.max(3,pct) %>%"></div></div>
            <span class="text-xs font-bold text-gray-500 w-12 text-left"><%= Number(p.sold_count||0) %></span>
          </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <p class="text-[11px] text-gray-400 mt-4">الزيارات بتُحسب من صفحات المتجر على النطاق الفرعي. الطلبات والإيرادات من نفس الفترة.</p>
  </div>
<%- include('_layout_bottom') %>
