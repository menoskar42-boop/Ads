<%
  pageTitle = t('company.stock_history') + ' — ' + product.name;
  activePage = 'products';
%>
<%- include('_layout_top') %>

  <div class="space-y-6 max-w-3xl">
    <div class="bg-white rounded-2xl shadow-sm p-6">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <div>
          <a href="/company/products" class="text-xs text-gray-400 hover:text-gray-600">← <%= t('company.products') %></a>
          <h2 class="text-xl font-bold text-gray-800 mt-1"><%= product.name %></h2>
          <p class="text-sm text-gray-500"><%= t('company.current_stock') %>: <span class="font-bold brand-text"><%= product.stock %></span></p>
        </div>
        <a href="/company/products/<%= product.id %>/edit" class="text-xs px-3 py-1.5 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200"><%= t('common.edit') %></a>
      </div>

      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= error %></div>
      <% } %>

      <h3 class="font-bold text-gray-700 mb-3"><%= t('company.add_stock_movement') %></h3>
      <form method="POST" action="/company/products/<%= product.id %>/stock" class="space-y-3 mb-6">
        <div class="grid sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs text-gray-500 mb-1"><%= t('company.change_amount') %></label>
            <input type="number" name="change_amount" required placeholder="+10 / -2"
              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs text-gray-500 mb-1"><%= t('company.reason') %></label>
            <select name="reason" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200">
              <option value="restock"><%= t('company.reason_restock') %></option>
              <option value="adjustment"><%= t('company.reason_adjustment') %></option>
              <option value="return"><%= t('company.reason_return') %></option>
            </select>
          </div>
        </div>
        <input type="text" name="notes" placeholder="<%= t('common.notes') %>"
          class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        <button type="submit" class="brand-bg text-white text-sm font-semibold px-4 py-2 rounded-xl hover:opacity-90 transition"><%= t('company.apply') %></button>
      </form>

      <h3 class="font-bold text-gray-700 mb-3"><%= t('company.history') %></h3>
      <% if (!movements.length) { %>
        <p class="text-center text-gray-400 text-sm py-4"><%= t('company.no_movements') %></p>
      <% } else { %>
        <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[460px]">
          <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
            <tr>
              <th class="px-3 py-2 text-left"><%= t('company.when') %></th>
              <th class="px-3 py-2 text-left"><%= t('company.reason') %></th>
              <th class="px-3 py-2 text-right"><%= t('company.change') %></th>
              <th class="px-3 py-2 text-left"><%= t('common.notes') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% movements.forEach(m => { %>
              <tr>
                <td class="px-3 py-2 text-xs text-gray-500"><%= new Date(m.created_at).toLocaleString() %></td>
                <td class="px-3 py-2"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold <%= m.reason === 'sale' ? 'bg-blue-100 text-blue-700' : m.reason === 'restock' ? 'bg-green-100 text-green-700' : m.reason === 'return' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700' %>"><%= t('company.reason_' + m.reason) %></span></td>
                <td class="px-3 py-2 text-right font-mono font-bold <%= m.change_amount > 0 ? 'text-green-600' : 'text-red-600' %>"><%= m.change_amount > 0 ? '+' : '' %><%= m.change_amount %></td>
                <td class="px-3 py-2 text-xs text-gray-500"><%= m.notes || (m.order_id ? '#' + m.order_id : '') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } %>
    </div>
  </div>

<%- include('_layout_bottom') %>
