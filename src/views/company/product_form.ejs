<%
  pageTitle = product ? 'Edit Product' : 'Add Product';
  activePage = 'products';
%>
<%- include('_layout_top') %>

  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1"><%= product && product.id ? 'Edit Product' : 'Add New Product' %></h2>
    <p class="text-gray-500 text-sm mb-6">Fill in the product details below.</p>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= error %></div>
    <% } %>

    <form method="POST" action="<%= product && product.id ? `/company/products/${product.id}/edit` : '/company/products/add' %>" enctype="multipart/form-data" class="space-y-5">
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Name *</label>
        <input type="text" name="name" required value="<%= product && product.name || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Description</label>
        <textarea name="description" rows="3"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"><%= product && product.description || '' %></textarea>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">Price (<%= company.currency || 'EGP' %>) *</label>
          <input type="number" step="0.01" min="0" name="price" required value="<%= product && product.price || '' %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">Stock *</label>
          <input type="number" min="0" name="stock" required value="<%= product && (product.stock !== undefined ? product.stock : '') || 0 %>"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">Image</label>
        <% if (product && product.image_url) { %>
          <img src="<%= product.image_url %>" alt="" class="w-24 h-24 rounded-xl object-cover mb-3" />
        <% } %>
        <input type="file" name="image_file" accept="image/*"
          class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer mb-2" />
        <p class="text-xs text-gray-400 mb-2">Upload (max 5MB) or paste a URL below.</p>
        <input type="text" name="image_url" value="<%= product && product.image_url || '' %>" placeholder="https://... or leave empty"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>

      <div class="flex items-center gap-3 pt-4">
        <button type="submit" class="brand-bg text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow-md">Save</button>
        <a href="/company/products" class="text-gray-500 hover:text-gray-700 text-sm">Cancel</a>
      </div>
    </form>
  </div>

<%- include('_layout_bottom') %>
