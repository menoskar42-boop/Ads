<%- include('_layout_top', { activePage: 'setup' }) %>

<%#
  The five steps, and an honest verdict on each. No step here is stored: the
  page asks the database what the shop actually looks like every time it is
  opened, so a green tick cannot outlive the thing that earned it.
%>

<h1 class="text-xl font-black text-gray-800 mb-1"><%= t('setup.title') %></h1>
<p class="text-gray-500 text-sm mb-4"><%= t('setup.sub') %></p>

<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <div class="flex items-center justify-between gap-3 mb-2">
    <div class="font-black text-gray-800 text-lg"><%= setup.done %>/<%= setup.total %></div>
    <div class="text-xs font-bold text-gray-500"><%= t('setup.steps_done') %></div>
  </div>
  <div class="h-2 rounded-full bg-gray-100 overflow-hidden">
    <div class="h-full brand-bg" style="width: <%= setup.percent %>%"></div>
  </div>
  <% if (setup.done === setup.total) { %>
    <p class="text-emerald-700 font-bold text-sm mt-3"><%= t('setup.all_done') %></p>
  <% } %>
</div>

<% setup.steps.forEach(function (s, i) {
     var tone = s.state === 'todo' ? 'border-amber-300 bg-amber-50'
              : s.state === 'unknown' ? 'border-gray-300 bg-gray-50'
              : s.state === 'note' ? 'border-sky-200 bg-sky-50'
              : 'border-emerald-200 bg-emerald-50';
     var mark = s.state === 'todo' ? '!' : s.state === 'unknown' ? '?' : s.state === 'note' ? 'i' : '✓';
     var whyKey = s.why === 'read' ? 'setup.w.read' : ('setup.w.' + s.key + '.' + s.why);
%>
  <div class="bg-white rounded-2xl shadow-sm p-5 mb-3 border <%= tone %>">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-start gap-3">
        <span class="w-7 h-7 rounded-full bg-white border border-gray-200 flex items-center justify-center text-sm font-black text-gray-700 flex-shrink-0"><%= i + 1 %></span>
        <div>
          <div class="font-black text-gray-800 text-sm"><%= t('setup.s.' + s.key) %></div>
          <div class="text-xs text-gray-500 mt-0.5"><%= t('setup.d.' + s.key) %></div>
        </div>
      </div>
      <span class="text-xs font-bold whitespace-nowrap rounded-full px-2.5 py-1 bg-white border border-gray-200 text-gray-700"><%= mark %> <%= t('setup.st.' + s.state) %></span>
    </div>

    <p class="text-sm text-gray-700 mt-3 leading-relaxed"><%= t(whyKey) %></p>

    <% if (s.key === 'launch' && Array.isArray(s.missing) && s.missing.length) { %>
      <ul class="mt-2 space-y-1">
        <% s.missing.forEach(function (m) { %>
          <li class="text-sm font-bold text-amber-900">— <%= t('setup.s.' + m) %></li>
        <% }); %>
      </ul>
    <% } %>

    <% if (s.key === 'launch') { %>
      <div class="mt-3">
        <div class="text-xs font-bold text-gray-500 mb-1"><%= t('setup.link') %></div>
        <a href="<%= publicUrl %>" target="_blank" rel="noopener"
           class="inline-block font-mono text-xs bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 break-all brand-text"><%= publicUrl %></a>
        <div class="mt-2">
          <a href="<%= publicUrl %>" target="_blank" rel="noopener"
             class="inline-block brand-bg text-white font-bold rounded-xl px-5 py-2 text-sm"><%= t('setup.open') %></a>
        </div>
      </div>
    <% } else if (s.href) { %>
      <div class="mt-3">
        <a href="<%= s.href %>" class="inline-block brand-bg text-white font-bold rounded-xl px-5 py-2 text-sm"><%= t('setup.go') %></a>
      </div>
    <% } %>
  </div>
<% }); %>

<%- include('_layout_bottom') %>
