<%
  pageTitle = 'Portfolio';
  activePage = 'portfolio';
%>
<%- include('_layout_top') %>

  <div class="space-y-6">

    <div class="bg-white rounded-2xl shadow-sm p-6 brand-border">
      <h2 class="text-xl font-bold text-gray-800 mb-1">Portfolio Items</h2>
      <p class="text-gray-400 text-sm">Items shown here appear as a gallery on your public landing page.</p>
    </div>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm"><%= error %></div>
    <% } %>

    <!-- Add item form -->
    <div class="bg-white rounded-2xl shadow-sm p-6">
      <h3 class="font-bold text-gray-700 mb-4">Add New Item</h3>
      <form method="POST" action="/company/portfolio/add" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Title</label>
          <input type="text" name="title" placeholder="Project title" required
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Image</label>
          <input type="file" name="image_file" accept="image/*"
            class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer mb-2" />
          <p class="text-xs text-gray-400 mb-2">Upload an image (max 5MB) or paste a URL below.</p>
          <input type="text" name="image_url" placeholder="https://... or leave empty"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-gray-500 mb-1">Description</label>
            <input type="text" name="description" placeholder="Short description"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Order</label>
            <input type="number" name="order_index" value="0" min="0"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
        </div>
        <button type="submit" class="brand-bg text-white font-bold px-6 py-2.5 rounded-xl hover:opacity-90 transition text-sm shadow">
          + Add Item
        </button>
      </form>
    </div>

    <!-- Items grid -->
    <% if (items.length === 0) { %>
    <div class="bg-white rounded-2xl shadow-sm p-10 text-center text-gray-400">
      <svg class="w-12 h-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <p class="font-semibold">No portfolio items yet.</p>
      <p class="text-sm mt-1">Add your first item using the form above.</p>
    </div>
    <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% items.forEach(item => { %>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden group">
        <% if (item.image_url) { %>
        <img src="<%= item.image_url %>" alt="<%= item.title %>"
          class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
          onerror="this.style.display='none'" />
        <% } %>
        <div class="p-4">
          <h4 class="font-bold text-gray-800 text-sm mb-0.5"><%= item.title || 'Untitled' %></h4>
          <% if (item.description) { %>
          <p class="text-xs text-gray-500 mb-3"><%= item.description %></p>
          <% } %>
          <form method="POST" action="/company/portfolio/delete/<%= item.id %>"
            onsubmit="return confirm('Delete this item?')">
            <button type="submit"
              class="text-xs text-red-500 hover:text-red-700 font-semibold flex items-center gap-1 transition">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Delete
            </button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>

<%- include('_layout_bottom') %>
