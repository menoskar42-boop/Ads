<%
  pageTitle = 'Portfolio';
  activePage = 'portfolio';
%>
<%- include('_layout_top') %>

  <div class="space-y-6">

    <div class="bg-white rounded-2xl shadow-sm p-6 brand-border">
      <h2 class="text-xl font-bold text-gray-800 mb-1">أعمالك</h2>
      <p class="text-gray-400 text-sm">
        الأعمال دي بتظهر في معرض صفحتك العامة. العميل اللي بيسأل «عملتوا إيه بالظبط
        والنتيجة كانت إيه؟» بيلاقي الإجابة في تفاصيل كل عمل — املاها لو تحب.
      </p>
    </div>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm"><%= error %></div>
    <% } %>
    <% if (typeof saved !== 'undefined' && saved) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3 text-sm">اتحفظ.</div>
    <% } %>

    <!-- Add item form -->
    <div class="bg-white rounded-2xl shadow-sm p-6">
      <h3 class="font-bold text-gray-700 mb-4">إضافة عمل جديد</h3>
      <form method="POST" action="/company/portfolio/add" enctype="multipart/form-data" class="space-y-4">
        <%- include('_portfolio_fields', { item: null }) %>
        <button type="submit" class="brand-bg text-white font-bold px-6 py-2.5 rounded-xl hover:opacity-90 transition text-sm shadow">
          + أضف العمل
        </button>
      </form>
    </div>

    <!-- Items grid -->
    <% if (items.length === 0) { %>
    <div class="bg-white rounded-2xl shadow-sm p-10 text-center text-gray-400">
      <svg class="w-12 h-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <p class="font-semibold">لسه مافيش أعمال.</p>
      <p class="text-sm mt-1">أضف أول عمل من الفورم اللي فوق — ولحد ما تضيف، قسم الأعمال مش بيظهر لزوّار صفحتك.</p>
    </div>
    <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% items.forEach(function(item, idx){ %>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden<%= item.is_hidden ? ' opacity-60' : '' %>">
        <% if (item.image_url) { %>
        <img src="<%= item.image_url %>" alt="<%= item.image_alt || item.title %>"
          class="w-full h-44 object-cover" onerror="this.style.display='none'" />
        <% } %>
        <div class="p-4">
          <div class="flex items-start justify-between gap-2 mb-1">
            <h4 class="font-bold text-gray-800 text-sm"><%= item.title || 'بدون عنوان' %></h4>
            <div class="flex gap-1 shrink-0">
              <% if (item.is_hidden) { %><span class="text-[10px] bg-gray-100 text-gray-500 rounded-full px-2 py-0.5">مخفي</span><% } %>
              <% if (item.is_featured) { %><span class="text-[10px] bg-amber-100 text-amber-700 rounded-full px-2 py-0.5">مميّز</span><% } %>
            </div>
          </div>
          <% if (item.category) { %><p class="text-[11px] text-gray-400 mb-1"><%= item.category %></p><% } %>
          <% if (item.description) { %><p class="text-xs text-gray-500 mb-3"><%= item.description %></p><% } %>

          <div class="flex flex-wrap items-center gap-3 text-xs">
            <button type="button" onclick="document.getElementById('edit-<%= item.id %>').classList.toggle('hidden')"
              class="text-blue-600 hover:text-blue-800 font-semibold">تعديل</button>

            <form method="POST" action="/company/portfolio/toggle/<%= item.id %>">
              <button type="submit" class="text-gray-600 hover:text-gray-900 font-semibold">
                <%= item.is_hidden ? 'إظهار' : 'إخفاء' %>
              </button>
            </form>

            <% if (idx > 0) { %>
            <form method="POST" action="/company/portfolio/move/<%= item.id %>">
              <input type="hidden" name="dir" value="up" />
              <button type="submit" class="text-gray-500 hover:text-gray-800" title="تقديم">↑</button>
            </form>
            <% } %>
            <% if (idx < items.length - 1) { %>
            <form method="POST" action="/company/portfolio/move/<%= item.id %>">
              <input type="hidden" name="dir" value="down" />
              <button type="submit" class="text-gray-500 hover:text-gray-800" title="تأخير">↓</button>
            </form>
            <% } %>

            <form method="POST" action="/company/portfolio/delete/<%= item.id %>"
              onsubmit="return confirm('حذف العمل ده نهائياً؟ لو عايز تشيله مؤقتاً استخدم «إخفاء».')">
              <button type="submit" class="text-red-500 hover:text-red-700 font-semibold">حذف</button>
            </form>
          </div>

          <!-- Edit form: same fields as Add, prefilled -->
          <div id="edit-<%= item.id %>" class="hidden mt-4 pt-4 border-t border-gray-100">
            <form method="POST" action="/company/portfolio/edit/<%= item.id %>" enctype="multipart/form-data" class="space-y-4">
              <%- include('_portfolio_fields', { item: item }) %>
              <button type="submit" class="brand-bg text-white font-bold px-5 py-2 rounded-xl hover:opacity-90 transition text-xs shadow">
                احفظ التعديل
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>

<%- include('_layout_bottom') %>
