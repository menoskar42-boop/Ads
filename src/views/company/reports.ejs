<% pageTitle = 'التقارير'; activePage = 'reports'; %>
<%- include('_layout_top') %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG'); }
  var maxDaily = daily.reduce(function(m,x){ return Math.max(m, Number(x.total)); }, 0) || 1;
  var STL = {pending:'بانتظار',confirmed:'مؤكّد',preparing:'بيتجهّز',shipped:'مشحون',out_for_delivery:'في الطريق',delivered:'تم التوصيل',cancelled:'ملغى'};
%>
  <div class="space-y-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-500">إجمالي الإيراد</div><div class="text-xl font-black text-gray-900 mt-1"><%= money(totals.revenue) %> ج</div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-500">إيراد الشهر</div><div class="text-xl font-black text-indigo-600 mt-1"><%= money(totals.month) %> ج</div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-500">إيراد اليوم</div><div class="text-xl font-black text-emerald-600 mt-1"><%= money(totals.today) %> ج</div></div>
      <div class="bg-white rounded-2xl shadow-sm p-4"><div class="text-xs text-gray-500">عدد الطلبات</div><div class="text-xl font-black text-gray-900 mt-1"><%= totals.orders %></div></div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-5">
      <h2 class="font-bold text-gray-700 mb-4 text-sm">الإيراد آخر 30 يوم</h2>
      <% if (!daily.length) { %><p class="text-gray-400 text-sm text-center py-4">لا توجد مبيعات.</p><% } else { %>
      <div class="flex items-end gap-1 h-40 overflow-x-auto">
        <% daily.forEach(function(x){ %>
        <div class="flex flex-col items-center gap-1 flex-1 min-w-[16px]" title="<%= money(x.total) %> ج">
          <div class="w-full bg-indigo-400 rounded-t" style="height:<%= Math.max(3, Math.round(Number(x.total)/maxDaily*130)) %>px"></div>
          <div class="text-[9px] text-gray-400"><%= new Date(x.d).getDate() %></div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 font-bold text-gray-700 text-sm">الطلبات حسب الحالة</div>
        <% byStatus.forEach(function(s){ %>
        <div class="flex justify-between px-5 py-2.5 border-b border-gray-50 last:border-0 text-sm"><span class="text-gray-600"><%= STL[s.status] || s.status %></span><span class="font-bold"><%= s.n %></span></div>
        <% }); %>
      </div>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 font-bold text-gray-700 text-sm">أكثر المنتجات مبيعاً</div>
        <% if (!topProducts.length) { %><div class="p-5 text-gray-400 text-sm">لا يوجد.</div><% } %>
        <% topProducts.forEach(function(p){ %>
        <div class="flex justify-between px-5 py-2.5 border-b border-gray-50 last:border-0 text-sm"><span class="text-gray-700 flex-1 truncate"><%= p.product_name %> <span class="text-gray-400 text-xs">×<%= p.qty %></span></span><span class="font-bold text-emerald-600"><%= money(p.revenue) %> ج</span></div>
        <% }); %>
      </div>
    </div>
  </div>
<%- include('_layout_bottom') %>
