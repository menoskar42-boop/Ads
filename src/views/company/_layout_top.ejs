      <a href="/company/banners"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='banners' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm5 9l3-3 3 3M9 9h6"/></svg>
        <%= t('company.banners') %>
      </a>
      <% } %>
      <% if (__can('/company/messages')) { %>
      <a href="/company/messages"
        class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='messages' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <%= t('company.messages') %>
        </span>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="bg-red-500 text-white text-xs font-bold rounded-full px-2 py-0.5"><%= unreadCount %></span>
        <% } %>
      </a>
      <% } %>
      <a href="/accounting"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m4 10V11m4 6V4M4 21h16"/></svg>
        <%= t('acct.title') %>
      </a>
      <hr class="my-2 border-gray-100" />
      <a href="<%= canonicalCompanyUrl(session.companySlug) %>" target="_blank"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-500 hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        View My Page
      </a>
      <% if (__can('/company/staff') && !__perms.isStaff) { %>
      <a href="/company/staff"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='staff' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <%= t('shopstaff.nav') %>
      </a>
      <% } %>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="flex-1">
    <%# شريط وضع العرض: الزائر داخل من غير كلمة سر. لازم يعرف إنه في نسخة
        للاطّلاع، ويكون قدامه طريق لصفحة العميل عشان يشوف الجهتين. %>
    <% if (typeof session !== 'undefined' && session && session.demoReadOnly) { %>
      <div class="bg-amber-50 border-b border-amber-200 px-4 py-2.5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm" dir="rtl">
        <span class="font-semibold text-amber-900">نسخة عرض — للاطّلاع فقط، التعديل متوقّف</span>
        <a href="<%= canonicalCompanyUrl(session.demoSlug || session.companySlug) %>" target="_blank"
           class="font-semibold text-amber-800 underline hover:no-underline">شوف صفحة العميل ←</a>
        <a href="/" class="text-amber-700 hover:underline">رجوع للموقع</a>
      </div>

      <%# التقاط العميل — **بعد** ما يشوف، مش قبل.
          الديمو مفتوح بالكامل من غير الفورم ده؛ ده عرض مش بوابة. والزرار
          بيتقفل ويفضل مقفول للجلسة، عشان اللي مش مهتم مايتزنقش كل صفحة. %>
      <div id="demoLead" class="border-b border-slate-200 bg-white px-4 py-2.5 text-sm" dir="rtl" hidden>
        <div class="max-w-5xl mx-auto flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-semibold text-slate-800">عايز واحد زيه لنشاطك؟</span>
          <span class="text-slate-500 hidden sm:inline">سيب رقمك ونكلّمك — من غير التزام.</span>
          <form id="demoLeadForm" class="flex flex-wrap items-center gap-2 grow">
            <label class="sr-only" for="dlName">اسمك</label>
            <input id="dlName" name="name" required maxlength="120" placeholder="اسمك"
                   class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm w-32 grow sm:grow-0">
            <label class="sr-only" for="dlPhone">رقم الموبايل</label>
            <input id="dlPhone" name="phone" required inputmode="tel" maxlength="24" placeholder="٠١٠٠٠٠٠٠٠٠٠"
                   class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm w-40 grow sm:grow-0" dir="ltr">
            <label class="sr-only" for="dlBiz">اسم نشاطك (اختياري)</label>
            <input id="dlBiz" name="business" maxlength="160" placeholder="اسم نشاطك (اختياري)"
                   class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm w-44 grow sm:grow-0">
            <button type="submit" id="dlSend"
                    class="bg-brand-600 text-white font-semibold rounded-lg px-3.5 py-1.5 text-sm">كلّموني</button>
          </form>
          <button type="button" id="dlClose" class="text-slate-400 hover:text-slate-600 text-xs">مش دلوقتي</button>
          <p id="dlMsg" class="w-full text-sm" hidden></p>
        </div>
      </div>
      <script>
      (function () {
        var box = document.getElementById('demoLead');
        if (!box) return;
        var KEY = 'od_demo_lead_done';
        // sessionStorage مش localStorage: «مش دلوقتي» تخصّ الزيارة دي.
        // اللي يرجع بكرة يشوفه تاني — ومش هيتلاحق للأبد.
        try { if (sessionStorage.getItem(KEY)) return; } catch (e) { /* متصفّح قافل التخزين */ }
        box.hidden = false;

        var form = document.getElementById('demoLeadForm');
        var msg = document.getElementById('dlMsg');
        var send = document.getElementById('dlSend');

        function say(text, ok) {
          msg.textContent = text;
          msg.className = 'w-full text-sm ' + (ok ? 'text-emerald-700' : 'text-red-600');
          msg.hidden = false;
        }

        document.getElementById('dlClose').addEventListener('click', function () {
          try { sessionStorage.setItem(KEY, '1'); } catch (e) { /* ولا يهمّك */ }
          box.hidden = true;
        });

        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          send.disabled = true;
          send.textContent = 'ثانية…';
          var body = new URLSearchParams(new FormData(form)).toString();
          fetch('/demo/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body,
          }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
            .then(function (d) {
              if (d && d.ok) {
                // نجاح = الطلب اتقبل. مابنقولش «هنكلّمك خلال ساعة» —
                // ده وعد بميعاد محدّش ضامنه.
                try { sessionStorage.setItem(KEY, '1'); } catch (e) { /* */ }
                form.hidden = true;
                say('تمام، وصلنا رقمك. هنكلّمك.', true);
              } else {
                say((d && d.error) || 'حصلت مشكلة. جرّب تاني.', false);
                send.disabled = false;
                send.textContent = 'كلّموني';
              }
            })
            .catch(function () {
              say('مافيش اتصال. جرّب تاني.', false);
              send.disabled = false;
              send.textContent = 'كلّموني';
            });
        });
      })();
      </script>
    <% } %>
