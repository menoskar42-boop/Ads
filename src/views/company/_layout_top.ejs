<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> – Oscardevs Ads</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= session.themeColor || '#2563eb' %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-border { border-left: 4px solid var(--brand); }
    .nav-active { background-color: var(--brand); color: white; }
    /* Inline help-tip icon + tooltip bubble */
    .help-tip { position:relative; display:inline-flex; vertical-align:middle; margin:0 4px; outline:none; }
    .help-tip__icon { width:18px; height:18px; border-radius:50%; background:#e0e7ff; color:#4338ca; font-size:11px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; cursor:help; transition:all .15s; }
    .help-tip:hover .help-tip__icon, .help-tip:focus .help-tip__icon { background:#4338ca; color:#fff; }
    .help-tip__bubble { position:absolute; bottom:calc(100% + 8px); right:50%; transform:translateX(50%); background:#1f2937; color:#fff; font-size:0.78rem; font-weight:600; line-height:1.5; padding:8px 12px; border-radius:8px; min-width:180px; max-width:260px; text-align:center; white-space:normal; opacity:0; visibility:hidden; transition:opacity .15s, visibility .15s; pointer-events:none; z-index:50; box-shadow:0 8px 20px rgba(0,0,0,0.18); }
    .help-tip__bubble::after { content:''; position:absolute; top:100%; right:50%; transform:translateX(50%); border:6px solid transparent; border-top-color:#1f2937; }
    .help-tip:hover .help-tip__bubble, .help-tip:focus .help-tip__bubble { opacity:1; visibility:visible; }
    .help-tip[data-place="bottom"] .help-tip__bubble { bottom:auto; top:calc(100% + 8px); }
    .help-tip[data-place="bottom"] .help-tip__bubble::after { top:auto; bottom:100%; border-top-color:transparent; border-bottom-color:#1f2937; }
    details.page-guide summary::-webkit-details-marker { display:none; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">

<!-- Top bar -->
<header class="bg-white shadow-sm sticky top-0 z-20">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 brand-bg rounded-xl flex items-center justify-center text-white font-black text-lg">O</div>
      <div>
        <span class="font-bold text-gray-800 text-sm"><%= session.companyName %></span>
        <span class="text-gray-400 text-xs block leading-none"><%= t('company.dashboard') %></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <form method="POST" action="/company/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" class="inline">
        <button type="submit" class="text-xs font-bold text-gray-600 hover:brand-text border border-gray-200 rounded-lg px-2.5 py-1"><%= t('common.toggle_lang') %></button>
      </form>
      <form method="POST" action="/company/logout">
        <button class="text-sm text-gray-500 hover:text-red-500 transition flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <%= t('common.logout') %>
        </button>
      </form>
    </div>
  </div>
</header>

<div class="max-w-7xl mx-auto px-4 py-6 flex flex-col lg:flex-row gap-6">

  <!-- Sidebar nav -->
  <aside class="lg:w-56 flex-shrink-0">
    <nav class="bg-white rounded-2xl shadow-sm p-3 space-y-1">
      <a href="/company/dashboard"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='dashboard' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
        <%= t('company.dashboard') %>
      </a>
      <a href="/company/profile"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='profile' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
        <%= t('company.settings') %>
      </a>
      <% if (typeof companyPageType === 'undefined' || companyPageType !== 'shop') { %>
        <a href="/company/portfolio"
          class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='portfolio' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <%= t('company.portfolio') %>
        </a>
      <% } else { %>
        <a href="/company/products"
          class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='products' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <%= t('company.products') %>
        </a>
        <a href="/company/categories"
          class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='categories' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          <%= t('company.categories') %>
        </a>
        <a href="/company/orders"
          class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='orders' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
          <span class="flex items-center gap-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <%= t('company.orders') %>
          </span>
          <% if (typeof pendingOrdersCount !== 'undefined' && pendingOrdersCount > 0) { %>
            <span class="bg-red-500 text-white text-xs font-bold rounded-full px-2 py-0.5"><%= pendingOrdersCount %></span>
          <% } %>
        </a>
      <% } %>
      <a href="/company/banners"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='banners' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm5 9l3-3 3 3M9 9h6"/></svg>
        <%= t('company.banners') %>
      </a>
      <a href="/company/messages"
        class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='messages' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <%= t('company.messages') %>
        </span>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="bg-red-500 text-white text-xs font-bold rounded-full px-2 py-0.5"><%= unreadCount %></span>
        <% } %>
      </a>
      <hr class="my-2 border-gray-100" />
      <a href="<%= canonicalCompanyUrl(session.companySlug) %>" target="_blank"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-500 hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        View My Page
      </a>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="flex-1">
