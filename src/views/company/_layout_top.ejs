<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title><%= pageTitle %> – Oscardevs Ads</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" />
  <%# لوحة التاجر كتطبيق يتثبّت (البند ٩١). `use-credentials` مقصودة: المانيفست
      بيتجاب من غير كوكيز افتراضياً، وبدونها السيرفر مش هيعرف التاجر ده مين
      فالتطبيق هيتثبّت باسم عام بدل اسم المتجر. %>
  <link rel="manifest" href="/company/manifest.webmanifest" crossorigin="use-credentials" />
  <meta name="theme-color" content="<%= session.themeColor || '#2563eb' %>" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="apple-touch-icon" href="/logo-192.png" />
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= session.themeColor || '#2563eb' %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-border { border-left: 4px solid var(--brand); }
    .nav-active { background-color: var(--brand); color: white; }
    /* Inline help-tip icon + tooltip bubble */
    .help-tip { position:relative; display:inline-flex; vertical-align:middle; margin:0 4px; outline:none; }
    .help-tip__icon { width:18px; height:18px; border-radius:50%; background:#e0e7ff; color:#4338ca; font-size:11px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; cursor:help; transition:all .15s; }
    .help-tip:hover .help-tip__icon, .help-tip:focus .help-tip__icon { background:#4338ca; color:#fff; }
    .help-tip__bubble { position:absolute; bottom:calc(100% + 8px); right:50%; transform:translateX(50%); background:#1f2937; color:#fff; font-size:0.78rem; font-weight:600; line-height:1.5; padding:8px 12px; border-radius:8px; min-width:180px; max-width:260px; text-align:center; white-space:normal; opacity:0; visibility:hidden; transition:opacity .15s, visibility .15s; pointer-events:none; z-index:50; box-shadow:0 8px 20px rgba(0,0,0,0.18); }
    .help-tip__bubble::after { content:''; position:absolute; top:100%; right:50%; transform:translateX(50%); border:6px solid transparent; border-top-color:#1f2937; }
    .help-tip:hover .help-tip__bubble, .help-tip:focus .help-tip__bubble { opacity:1; visibility:visible; }
    .help-tip[data-place="bottom"] .help-tip__bubble { bottom:auto; top:calc(100% + 8px); }
    .help-tip[data-place="bottom"] .help-tip__bubble::after { top:auto; bottom:100%; border-top-color:transparent; border-bottom-color:#1f2937; }
    details.page-guide summary::-webkit-details-marker { display:none; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">

<!-- Top bar -->
<header class="bg-white shadow-sm sticky top-0 z-20">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 brand-bg rounded-xl flex items-center justify-center text-white font-black text-lg">O</div>
      <div>
        <span class="font-bold text-gray-800 text-sm"><%= session.companyName %></span>
        <span class="text-gray-400 text-xs block leading-none"><%= t('company.dashboard') %></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <form method="POST" action="/company/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" class="inline">
        <button type="submit" class="text-xs font-bold text-gray-600 hover:brand-text border border-gray-200 rounded-lg px-2.5 py-1"><%= t('common.toggle_lang') %></button>
      </form>
      <%- include('../partials/merchant_chips') %>
      <form method="POST" action="/company/logout">
        <button class="text-sm text-gray-500 hover:text-red-500 transition flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <%= t('common.logout') %>
        </button>
      </form>
    </div>
  </div>
</header>

<div class="max-w-7xl mx-auto px-4 py-6 flex flex-col lg:flex-row gap-6">

  <!-- Sidebar nav -->
  <aside class="lg:w-56 flex-shrink-0">
<%
  // A link that answers with a locked door reads as the software being broken,
  // so the menu shows what this session can actually open. For the owner (the
  // default) `__can` is true for everything, and the sidebar is unchanged.
  var __perms = (typeof perms !== 'undefined' && perms) ? perms : { role: 'owner' };
  var __shopPerms = null;
  try { __shopPerms = require('../../shop/perms'); } catch (e) { __shopPerms = null; }
  function __can(href) {
    if (!__perms.isStaff || !__shopPerms) return true;
    var need = __shopPerms.needsFor(String(href).replace(/^\/company/, ''));
    return !need || __perms[need] === true;
  }
%>
    <nav class="bg-white rounded-2xl shadow-sm p-3 space-y-1">
      <% if (__can('/company/dashboard')) { %>
      <a href="/company/dashboard"
        class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition <%= activePage==='dashboard' ? 'nav-active' : 'text-gray-600 hover:bg-gray-50' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
        <%= t('company.dashboard') %>
      </a>
      <% } %>
      <%# The five-step setup. Shop panels only, and owner-only by the guard —
          it reaches the identity, the payment keys and the public link. %>
