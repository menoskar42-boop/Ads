<% pageTitle = 'الاشتراكات'; activePage = 'subscriptions'; %>
<%- include('_layout_top') %>
  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-3xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1">🔁 الاشتراكات المتكررة</h2>
    <p class="text-gray-500 text-sm mb-5">العملاء المشتركين في منتجاتك. بيتولّد طلب جديد تلقائياً في تاريخ التجديد لكل اشتراك نشط.</p>

    <% if (!subs.length) { %>
      <p class="text-sm text-gray-400 text-center py-8">مفيش اشتراكات بعد. فعّل «الاشتراك المتكرر» على منتج من صفحة تعديله.</p>
    <% } else { %>
      <div class="space-y-2">
        <% subs.forEach(function(s){ var active = s.status==='active'; %>
        <div class="flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 <%= active?'':'opacity-60' %>">
          <div class="min-w-0 flex-1">
            <div class="font-bold text-gray-800 text-sm truncate"><%= s.product_name %> <span class="text-xs text-gray-400">×<%= s.quantity %></span></div>
            <div class="text-xs text-gray-500"><%= s.customer_name || 'عميل' %><%= s.customer_phone ? (' · ' + s.customer_phone) : '' %> · كل <%= s.interval_days %> يوم</div>
          </div>
          <div class="text-left shrink-0">
            <div class="text-emerald-600 font-bold text-sm"><%= Number(s.unit_price).toFixed(2) %> ج</div>
            <div class="text-xs <%= active?'text-gray-400':'text-red-400' %>"><%= active ? ('التجديد: ' + new Date(s.next_renewal).toLocaleDateString('ar-EG')) : 'ملغي' %></div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>
<%- include('_layout_bottom') %>
