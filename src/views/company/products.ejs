<%
  pageTitle = t('company.products');
  activePage = 'products';
%>
<%- include('_layout_top') %>

  <div class="space-y-6">
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between flex-wrap gap-4">
      <div>
        <h2 class="text-xl font-bold text-gray-800 mb-1"><%= t('company.products') %></h2>
        <p class="text-gray-400 text-sm"><%= products.length %></p>
      </div>
      <a href="/company/products/add" class="brand-bg text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">+ <%= t('company.add_product') %></a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
      <% if (!products.length) { %>
        <div class="p-12 text-center text-gray-400 text-sm"><%= t('company.no_products') %></div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
              <tr>
                <th class="px-4 py-3 text-left"><%= t('common.name') %></th>
                <th class="px-4 py-3 text-left"><%= t('common.category') %></th>
                <th class="px-4 py-3 text-right"><%= t('common.price') %></th>
                <th class="px-4 py-3 text-center"><%= t('common.stock') %></th>
                <th class="px-4 py-3 text-center"><%= t('common.status') %></th>
                <th class="px-4 py-3 text-right"><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% products.forEach(p => { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-3">
                      <% if (p.image_url) { %>
                        <img src="<%= p.image_url %>" alt="<%= p.name %>" class="w-10 h-10 rounded-lg object-cover" />
                      <% } else { %>
                        <div class="w-10 h-10 rounded-lg bg-gray-100"></div>
                      <% } %>
                      <span class="font-semibold text-gray-700"><%= p.name %></span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-xs text-gray-500"><%= p.category_name || '—' %></td>
                  <td class="px-4 py-3 text-right font-mono"><%= Number(p.price).toFixed(2) %> <%= company.currency || 'EGP' %></td>
                  <td class="px-4 py-3 text-center"><a href="/company/products/<%= p.id %>/stock" class="hover:underline brand-text font-semibold"><%= p.stock %></a></td>
                  <td class="px-4 py-3 text-center">
                    <% if (p.is_active) { %>
                      <span class="inline-block px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-semibold"><%= t('common.active') %></span>
                    <% } else { %>
                      <span class="inline-block px-2 py-0.5 bg-gray-100 text-gray-500 rounded-full text-xs font-semibold"><%= t('common.inactive') %></span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-1.5 flex-wrap">
                      <a href="/company/products/<%= p.id %>/edit" class="text-xs px-2.5 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition"><%= t('common.edit') %></a>
                      <form method="POST" action="/company/products/<%= p.id %>/toggle-active" class="inline">
                        <button type="submit" class="text-xs px-2.5 py-2 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition"><%= p.is_active ? t('company.hide') : t('company.show') %></button>
                      </form>
                      <form method="POST" action="/company/products/<%= p.id %>/delete" class="inline" onsubmit="return confirm('<%= t('common.confirm_delete') %>');">
                        <button type="submit" class="text-xs px-2.5 py-2 rounded-lg bg-red-50 text-red-700 hover:bg-red-100 transition"><%= t('common.delete') %></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<%- include('_layout_bottom') %>
