<%
  pageTitle = 'Deals Products';
  activePage = 'deals-products';
%>
<%- include('_layout_top') %>

<div class="space-y-6">
  <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between flex-wrap gap-4">
    <div>
      <h2 class="text-xl font-bold text-gray-800 mb-1">منتجات Deals</h2>
      <p class="text-gray-400 text-sm">إدارة المنتجات اليدوية وروابط Amazon Affiliate</p>
    </div>
    <a href="/company/deals-products/add" class="brand-bg text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">+ إضافة منتج</a>
  </div>

  <div class="bg-amber-50 border border-amber-200 rounded-2xl px-5 py-4 text-sm text-amber-800">
    Amazon Creators API غير مفعّل حاليًا. مصدر المنتجات النشط هو <strong>Manual</strong> فقط.
  </div>

  <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
    <% if (!products.length) { %>
      <div class="p-12 text-center text-gray-400 text-sm">لم تتم إضافة منتجات بعد.</div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 text-xs">
            <tr>
              <th class="px-4 py-3 text-right">المنتج</th>
              <th class="px-4 py-3 text-right">المصدر</th>
              <th class="px-4 py-3 text-right">السعر</th>
              <th class="px-4 py-3 text-center">الحالة</th>
              <th class="px-4 py-3 text-right">إجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% products.forEach(p => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="" class="w-11 h-11 rounded-lg object-cover" /><% } %>
                    <div>
                      <div class="font-semibold text-gray-700"><%= p.title %></div>
                      <div class="text-xs text-gray-400"><%= p.slug %></div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-xs"><span class="px-2 py-1 rounded-full bg-blue-50 text-blue-700">MANUAL</span></td>
                <td class="px-4 py-3 font-mono"><%= p.current_price == null ? '—' : Number(p.current_price).toFixed(2) + ' ' + (p.currency || 'EGP') %></td>
                <td class="px-4 py-3 text-center">
                  <% if (p.is_published) { %><span class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs">منشور</span>
                  <% } else { %><span class="px-2 py-1 rounded-full bg-gray-100 text-gray-500 text-xs">مسودة</span><% } %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2 flex-wrap">
                    <a href="/company/deals-products/<%= p.id %>/edit" class="text-xs px-3 py-2 rounded-lg bg-blue-50 text-blue-700">تعديل</a>
                    <form method="POST" action="/company/deals-products/<%= p.id %>/toggle-published">
                      <button class="text-xs px-3 py-2 rounded-lg bg-gray-100 text-gray-600"><%= p.is_published ? 'إخفاء' : 'نشر' %></button>
                    </form>
                    <form method="POST" action="/company/deals-products/<%= p.id %>/delete" onsubmit="return confirm('حذف المنتج؟');">
                      <button class="text-xs px-3 py-2 rounded-lg bg-red-50 text-red-700">حذف</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('_layout_bottom') %>