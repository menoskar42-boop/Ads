<%
  /* The fields of one portfolio item, shared by the Add form and every Edit
     form. One copy: a field added to the top form and forgotten in the bottom
     one is how "edit" quietly loses data.
     `item` is null when adding. */
  var it = item || {};
%>
<div>
  <label class="block text-xs font-semibold text-gray-500 mb-1">العنوان *</label>
  <input type="text" name="title" placeholder="اسم المشروع" required maxlength="120"
    value="<%= it.title || '' %>"
    class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
</div>

<div>
  <label class="block text-xs font-semibold text-gray-500 mb-1">الصورة</label>
  <input type="file" name="image_file" accept="image/png,image/jpeg,image/gif,image/webp"
    class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer mb-2" />
  <p class="text-xs text-gray-400 mb-2">
    PNG أو JPG أو GIF أو WEBP (أقصى ٥ ميجا)، أو الصق رابط تحت.
    <% if (it.image_url) { %><span class="text-gray-500">— لو سبته فاضي هتفضل الصورة الحالية.</span><% } %>
  </p>
  <input type="text" name="image_url" placeholder="https://... أو سيبه فاضي"
    value="<%= it.image_url || '' %>"
    class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
</div>

<%# صورة «قبل» (البند ٩٠): العمود كان موجود في المخطط من ساعة ما دراسة الحالة
    اتعملت، ومفيش أي شاشة بتكتبه — فالمقارنة اللي الصفحة العامة مستنياها
    ماكانتش بتوصل أبداً. وصورة «قبل» من غير «بعد» مش مقارنة، فمابتتخزّنش. %>
<div>
  <label class="block text-xs font-semibold text-gray-500 mb-1">صورة «قبل» (اختيارية)</label>
  <input type="file" name="before_image_file" accept="image/png,image/jpeg,image/gif,image/webp"
    class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer mb-2" />
  <p class="text-xs text-gray-400">
    لو حطيتها، الصفحة هتعرض «قبل» و«بعد» جنب بعض. الصورة الأساسية فوق هي «بعد».
  </p>
  <% if (it.before_image_url) { %>
    <div class="flex items-center gap-2 mt-2">
      <img src="<%= it.before_image_url %>" alt="صورة قبل الحالية" class="w-16 h-16 object-cover rounded-lg border border-gray-200" />
      <label class="flex items-center gap-2 text-xs text-gray-500">
        <input type="checkbox" name="remove_before" value="1" class="rounded" /> شيل صورة «قبل»
      </label>
    </div>
  <% } %>
</div>

<div class="grid sm:grid-cols-2 gap-4">
  <div>
    <label class="block text-xs font-semibold text-gray-500 mb-1">وصف الصورة (alt)</label>
    <input type="text" name="image_alt" maxlength="160" placeholder="بيتقري لضعاف البصر وبيفيد جوجل"
      value="<%= it.image_alt || '' %>"
      class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
  </div>
  <div>
    <label class="block text-xs font-semibold text-gray-500 mb-1">التصنيف</label>
    <input type="text" name="category" maxlength="60" placeholder="هوية · موقع · حملة · تصوير…"
      value="<%= it.category || '' %>"
      class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
  </div>
</div>

<div class="grid sm:grid-cols-3 gap-4">
  <div class="sm:col-span-2">
    <label class="block text-xs font-semibold text-gray-500 mb-1">وصف قصير</label>
    <input type="text" name="description" placeholder="سطر واحد بيظهر تحت العنوان"
      value="<%= it.description || '' %>"
      class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
  </div>
  <div>
    <label class="block text-xs font-semibold text-gray-500 mb-1">الترتيب</label>
    <input type="number" name="order_index" value="<%= it.order_index || 0 %>" min="0"
      class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
  </div>
</div>

<!-- The case study. Every field optional: an item with a title and a photo is
     still a valid item, exactly as before these fields existed. -->
<details class="border border-gray-200 rounded-xl p-4" <%= (it.problem || it.solution || it.result || it.client_name) ? 'open' : '' %>>
  <summary class="text-xs font-bold text-gray-600 cursor-pointer">
    تفاصيل المشروع (اختيارية — بس دي اللي بتقنع العميل)
  </summary>
  <div class="mt-4 space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">العميل أو نوع النشاط</label>
        <input type="text" name="client_name" maxlength="120" placeholder="مطعم · عيادة · متجر ملابس"
          value="<%= it.client_name || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">رابط المشروع</label>
        <input type="url" name="project_url" maxlength="500" placeholder="https://..."
          value="<%= it.project_url || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm" />
      </div>
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-500 mb-1">المشكلة قبل الشغل</label>
      <textarea name="problem" rows="2" maxlength="1200" placeholder="كان عنده إيه بالظبط؟"
        class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm"><%= it.problem || '' %></textarea>
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-500 mb-1">اللي عملته</label>
      <textarea name="solution" rows="2" maxlength="1200" placeholder="الحل اللي نفّذته"
        class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm"><%= it.solution || '' %></textarea>
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-500 mb-1">النتيجة</label>
      <textarea name="result" rows="2" maxlength="1200" placeholder="زيادة حجوزات؟ مبيعات؟ سرعة؟ اكتب رقم لو عندك"
        class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm"><%= it.result || '' %></textarea>
      <p class="text-xs text-gray-400 mt-1">اكتب اللي حصل فعلاً. رقم مش حقيقي بيضر أكتر ما بينفع.</p>
    </div>
    <label class="flex items-center gap-2 text-xs text-gray-600">
      <input type="checkbox" name="is_featured" value="on" <%= it.is_featured ? 'checked' : '' %> />
      عمل مميّز — يظهر في الأول
    </label>
  </div>
</details>
