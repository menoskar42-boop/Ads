<% pageTitle = 'سلات متروكة'; activePage = 'abandoned'; %>
<%- include('_layout_top') %>
  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-3xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1">🛒 سلات متروكة</h2>
    <p class="text-gray-500 text-sm mb-5">عملاء وصلوا لصفحة الدفع وما كمّلوش الطلب (من 30 دقيقة فأكثر). ذكّرهم على واتساب.</p>

    <% if (!carts.length) { %>
      <p class="text-sm text-gray-400 text-center py-8">مفيش سلات متروكة حالياً. كله بيكمّل طلبه 👍</p>
    <% } else { %>
      <div class="space-y-3">
        <% carts.forEach(function(a){
             var phone = (a.customer_phone || '').replace(/[^0-9]/g,'');
             var waNum = (company.whatsapp_number || phone);
             var msg = 'أهلاً ' + (a.customer_name || '') + '، لاحظنا إنك سيبت طلبك من غير ما تكمّله (' + (a.items_summary || '') + '). محتاج مساعدة تكمّل؟';
             var intlPhone = phone.length <= 11 ? ('20' + phone.replace(/^0/, '')) : phone;
             var waHref = phone ? ('https://wa.me/' + intlPhone + '?text=' + encodeURIComponent(msg)) : null;
        %>
        <div class="border border-gray-200 rounded-xl p-4">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <div class="font-bold text-gray-800"><%= a.customer_name || 'عميل' %></div>
              <div class="text-xs text-gray-500" dir="ltr"><%= a.customer_phone || a.customer_email || '—' %></div>
              <div class="text-sm text-gray-600 mt-1"><%= a.items_summary || '' %></div>
            </div>
            <div class="text-left shrink-0">
              <div class="text-emerald-600 font-bold"><%= Number(a.total).toFixed(2) %> ج</div>
              <div class="text-xs text-gray-400"><%= a.item_count %> صنف · <%= new Date(a.updated_at).toLocaleString('ar-EG') %></div>
            </div>
          </div>
          <% if (waHref) { %>
          <a href="<%= waHref %>" target="_blank" rel="nofollow noopener"
             class="inline-flex items-center gap-2 mt-3 bg-green-600 text-white text-sm font-bold px-4 py-2 rounded-lg hover:bg-green-700 transition">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/></svg>
            ذكّره على واتساب
          </a>
          <% } else { %>
            <div class="text-xs text-gray-400 mt-2">مفيش رقم واتساب لهذا العميل.</div>
          <% } %>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>
<%- include('_layout_bottom') %>
