<%
  pageTitle = 'Edit Profile';
  activePage = 'profile';
  var curOptions = ['EGP','USD','SAR','AED','KWD','QAR','EUR','GBP','MAD','JOD'];
%>
<%- include('_layout_top') %>

  <div class="max-w-2xl space-y-6">

    <div class="bg-white rounded-2xl shadow-sm p-6 brand-border">
      <h2 class="text-xl font-bold text-gray-800 mb-1"><%= t('company.edit_profile') || 'إعدادات المتجر' %></h2>
      <p class="text-gray-400 text-sm">التغييرات تظهر فوراً على صفحة متجرك العامة.</p>
    </div>

    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3 text-sm flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <%= success %>
    </div>
    <% } %>
    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/company/profile" enctype="multipart/form-data" class="space-y-6">

      <!-- Brand -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">🎨</span> الهوية والعلامة</h3>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">اسم المتجر</label>
          <input type="text" name="company_name" value="<%= company.company_name %>" required
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">الوصف</label>
          <textarea name="description" rows="3"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition resize-none"><%= company.description || '' %></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">الشعار (اللوجو)</label>
          <% if (company.logo_url) { %>
            <div class="mb-3 flex items-center gap-3">
              <img src="<%= company.logo_url %>" alt="Current logo" class="w-16 h-16 rounded-xl object-cover border border-gray-200" />
              <span class="text-xs text-gray-400">الشعار الحالي</span>
            </div>
          <% } %>
          <input type="file" name="logo_file" accept="image/*"
            class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer mb-3" />
          <p class="text-xs text-gray-400 mb-2">ارفع صورة (PNG, JPEG, GIF, WEBP, SVG — أقصى 5MB) أو ألصق رابطاً بالأسفل.</p>
          <input type="text" name="logo_url" value="<%= company.logo_url || '' %>" placeholder="https://... أو اتركه فارغاً"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">لون الثيم</label>
            <div class="flex items-center gap-3">
              <input type="color" name="theme_color" value="<%= company.theme_color %>"
                class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
              <span class="text-sm text-gray-400">يُستخدم في الأزرار والعناصر المميزة</span>
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">العملة</label>
            <select name="currency" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition bg-white">
              <% curOptions.forEach(function(c){ %>
                <option value="<%= c %>" <%= (company.currency || 'EGP') === c ? 'selected' : '' %>><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="grid sm:grid-cols-3 gap-4 pt-2 border-t border-gray-100">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">اللون الثانوي (Accent)</label>
            <input type="color" name="color_accent" value="<%= company.color_accent || '#FF5B4A' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">لون كرت الهيرو 1</label>
            <input type="color" name="hero_card1_color" value="<%= company.hero_card1_color || '#FF8500' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">لون كرت الهيرو 2</label>
            <input type="color" name="hero_card2_color" value="<%= company.hero_card2_color || '#00A572' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
        </div>
        <p class="text-xs text-gray-400">اللون الأساسي بيتولّد منه باقي درجات الموقع تلقائياً. كروت الهيرو يظهر لونها لما ماتكونش محمّل عليها صور.</p>
        <div class="grid sm:grid-cols-3 gap-4 pt-2 border-t border-gray-100">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">لون نص الهيرو</label>
            <input type="color" name="hero_text_color" value="<%= company.hero_text_color || '#FFFFFF' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">خلفية زر "تسوّق الآن"</label>
            <input type="color" name="hero_btn_bg" value="<%= company.hero_btn_bg || '#FFFFFF' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">لون نص زر "تسوّق الآن"</label>
            <input type="color" name="hero_btn_text" value="<%= company.hero_btn_text || '#0F0F1E' %>" class="w-12 h-12 rounded-xl border border-gray-200 cursor-pointer p-1" />
          </div>
        </div>
      </div>

      <!-- Storefront -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">🛍️</span> واجهة المتجر</h3>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">عنوان الهيرو الرئيسي</label>
          <input type="text" name="hero_headline" value="<%= company.hero_headline || '' %>" placeholder="مثال: كل اللي محتاجه في مكان واحد"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">نص الهيرو الفرعي</label>
          <textarea name="hero_subtext" rows="2" placeholder="جملة قصيرة تحفّز الزائر على التسوّق"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition resize-none"><%= company.hero_subtext || '' %></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">نص زر الهيرو (CTA)</label>
          <input type="text" name="hero_cta_text" value="<%= company.hero_cta_text || '' %>" placeholder="تسوّق الآن"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">شريط العروض المتحرك</label>
          <textarea name="promo_text" rows="3" placeholder="افصل كل رسالة بسطر جديد، مثال:&#10;شحن سريع لكل المحافظات&#10;الدفع عند الاستلام متاح&#10;خصومات مستمرة"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition resize-none"><%= company.promo_text || '' %></textarea>
          <p class="text-xs text-gray-400 mt-1">كل سطر = رسالة في الشريط المتحرك أعلى المتجر. اتركه فارغاً لاستخدام الرسائل الافتراضية.</p>
        </div>
      </div>

      <!-- Section visibility -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-3">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">👁️</span> إظهار / إخفاء الأقسام</h3>
        <p class="text-gray-400 text-sm">تحكّم في الأقسام اللي تظهر على صفحة متجرك.</p>
        <% var toggles = (company.page_type === 'portfolio') ? [
             ['show_about', 'قسم نبذة عنا'],
             ['show_services', 'قسم الخدمات'],
             ['show_portfolio', 'قسم معرض الأعمال'],
             ['show_contact', 'قسم تواصل معنا']
           ] : [
             ['show_promo_bar', 'شريط العروض المتحرك (أعلى الصفحة)'],
             ['show_hero_cards', 'كروت الهيرو الجانبية (برتقالي/أخضر)'],
             ['show_banners', 'قسم البانرات العريض'],
             ['show_categories', 'قسم التصنيفات'],
             ['show_trust_bar', 'شريط الثقة (شحن سريع، دفع آمن، دعم...)'],
             ['show_contact', 'قسم تواصل معنا']
           ]; %>
        <% toggles.forEach(function(tg){ %>
          <label class="flex items-center gap-3 cursor-pointer py-1">
            <input type="checkbox" name="<%= tg[0] %>" <%= (company[tg[0]] === false) ? '' : 'checked' %> class="w-5 h-5 rounded" />
            <span class="text-sm font-semibold text-gray-600"><%= tg[1] %></span>
          </label>
        <% }) %>
      </div>

      <% if (company.page_type === 'portfolio') { %>
      <!-- Portfolio services -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">🧩</span> نصوص الخدمات الثلاث</h3>
        <p class="text-gray-400 text-sm">عدّل عنوان ووصف كل خدمة. اتركها فارغة لاستخدام النص الافتراضي.</p>
        <% var svcDefaults = [
             ['service1_title','service1_desc','الاستشارات','استشارات استراتيجية مخصصة لأهداف عملك ونموه'],
             ['service2_title','service2_desc','الابتكار','حلول تقنية متطورة تحقق نتائج حقيقية وملموسة'],
             ['service3_title','service3_desc','الدعم','فرق متخصصة جاهزة لدعمك على مدار الساعة طوال الأسبوع']
           ]; %>
        <% svcDefaults.forEach(function(s, i){ %>
          <div class="border border-gray-100 rounded-xl p-4 space-y-2">
            <div class="text-xs font-bold text-gray-400">خدمة <%= i + 1 %></div>
            <input type="text" name="<%= s[0] %>" value="<%= company[s[0]] || '' %>" placeholder="<%= s[2] %>" maxlength="60"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
            <textarea name="<%= s[1] %>" rows="2" placeholder="<%= s[3] %>" maxlength="200"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition resize-none"><%= company[s[1]] || '' %></textarea>
          </div>
        <% }) %>
      </div>
      <% } %>

      <!-- Social links -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">🔗</span> روابط السوشيال والمواقع الخارجية</h3>
        <p class="text-gray-400 text-sm">أضف روابط حساباتك الكاملة (تبدأ بـ https://). بتظهر كأيقونات على صفحتك العامة وبتربط ظهورك في جوجل والذكاء الاصطناعي بحساباتك الفعلية (sameAs schema).</p>
        <% var socials = [
             ['social_facebook', 'فيسبوك', 'https://facebook.com/yourpage'],
             ['social_instagram', 'إنستجرام', 'https://instagram.com/yourhandle'],
             ['social_linkedin', 'لينكدإن', 'https://linkedin.com/in/yourprofile'],
             ['social_twitter', 'إكس / تويتر', 'https://x.com/yourhandle'],
             ['social_tiktok', 'تيك توك', 'https://tiktok.com/@yourhandle'],
             ['social_youtube', 'يوتيوب', 'https://youtube.com/@yourchannel'],
             ['social_threads', 'ثريدز', 'https://threads.net/@yourhandle'],
             ['social_website', 'موقع خارجي', 'https://yoursite.com']
           ]; %>
        <div class="grid sm:grid-cols-2 gap-3">
          <% socials.forEach(function(s){ %>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1.5"><%= s[1] %></label>
              <input type="url" name="<%= s[0] %>" value="<%= company[s[0]] || '' %>" maxlength="300" placeholder="<%= s[2] %>" pattern="https?://.*"
                class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 ltr" dir="ltr" />
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Contact -->
      <div class="bg-white rounded-2xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800 flex items-center gap-2"><span class="text-lg">📞</span> بيانات التواصل</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">رقم الهاتف</label>
            <input type="tel" name="contact_phone" value="<%= company.contact_phone || '' %>" maxlength="30"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">واتساب</label>
            <input type="tel" name="contact_whatsapp" value="<%= company.contact_whatsapp || '' %>" maxlength="30" placeholder="مثال: 201xxxxxxxxx"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">البريد الإلكتروني</label>
            <input type="email" name="contact_email" value="<%= company.contact_email || '' %>"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1.5">العنوان</label>
            <input type="text" name="contact_address" value="<%= company.contact_address || '' %>"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition" />
          </div>
        </div>
      </div>

      <div class="pt-1">
        <button type="submit" class="brand-bg text-white font-bold px-8 py-3 rounded-xl hover:opacity-90 transition shadow">
          حفظ التغييرات
        </button>
      </div>
    </form>

  </div>

<%- include('_layout_bottom') %>
