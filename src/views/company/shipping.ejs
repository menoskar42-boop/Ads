<% pageTitle = 'الشحن'; activePage = 'shipping'; %>
<%- include('_layout_top') %>
  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl">
    <h2 class="text-xl font-bold text-gray-800 mb-1">الشحن حسب المحافظة</h2>
    <p class="text-gray-500 text-sm mb-5">حدّد تكلفة الشحن لكل محافظة — العميل يختار محافظته في الـcheckout فتتحسب تلقائياً.</p>

    <form method="POST" action="/company/shipping/add" class="grid sm:grid-cols-4 gap-2 mb-6">
      <input name="governorate" required maxlength="60" placeholder="المحافظة (القاهرة)" class="border border-gray-200 rounded-xl px-3 py-2 text-sm" />
      <input name="cost" type="number" step="0.01" min="0" required placeholder="التكلفة" class="border border-gray-200 rounded-xl px-3 py-2 text-sm" />
      <input name="free_over" type="number" step="0.01" min="0" placeholder="مجاني فوق" class="border border-gray-200 rounded-xl px-3 py-2 text-sm" />
      <input name="eta_days" maxlength="40" placeholder="مدة التوصيل (2-3 أيام)" class="border border-gray-200 rounded-xl px-3 py-2 text-sm" />
      <button class="brand-bg text-white text-xs font-bold px-4 py-2 rounded-lg hover:opacity-90 sm:col-span-4">+ إضافة/تحديث محافظة</button>
    </form>

    <% if (!zones.length) { %>
      <p class="text-sm text-gray-400 text-center py-6">مفيش محافظات مضافة — أضف واحدة عشان الشحن يشتغل.</p>
    <% } else { %>
      <div class="space-y-2">
        <% zones.forEach(function(z){ %>
        <div class="flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3">
          <span class="font-bold text-gray-800 flex-1 text-sm"><%= z.governorate %></span>
          <span class="text-emerald-600 font-bold text-sm"><%= Number(z.cost)===0 ? 'مجاني' : (Number(z.cost)+' ج') %></span>
          <% if (z.free_over) { %><span class="text-xs text-gray-400">مجاني فوق <%= Number(z.free_over) %></span><% } %>
          <% if (z.eta_days) { %><span class="text-xs text-gray-400"><%= z.eta_days %></span><% } %>
          <form method="POST" action="/company/shipping/<%= z.id %>/delete" onsubmit="return confirm('حذف؟')"><button class="bg-red-500 text-white text-xs rounded-full w-6 h-6">×</button></form>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Courier integration (phase 25) -->
  <div class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl mt-5">
    <h2 class="text-xl font-bold text-gray-800 mb-1">تكامل شركة الشحن</h2>
    <p class="text-gray-500 text-sm mb-4">اربط حساب شركة الشحن بتاعتك عشان تطلع بوليصة شحن (AWB) وتتبّع من داخل لوحة الطلبات. كل تاجر بيستخدم حسابه ومفتاحه الخاص.</p>
    <% if (typeof saved !== 'undefined' && saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 mb-4 text-sm">تم الحفظ ✅</div><% } %>
    <% var integ = (typeof integration !== 'undefined' && integration) ? integration : { provider: 'none' }; %>
    <form method="POST" action="/company/shipping/integration" class="grid gap-3">
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">المزوّد</label>
        <select name="provider" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white">
          <% courierProviders.forEach(function(p){ %>
            <option value="<%= p.key %>" <%= integ.provider===p.key?'selected':'' %>><%= p.label %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5">مفتاح الـAPI (لـBosta فقط)</label>
        <input name="api_key" value="<%= integ.api_key || '' %>" dir="ltr" autocomplete="off" placeholder="Bosta Business API Key" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm font-mono" />
        <p class="text-xs text-gray-400 mt-1">للإدخال اليدوي مش محتاج مفتاح — بتكتب رقم البوليصة على كل طلب بنفسك.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-2">
        <input name="pickup_phone" value="<%= integ.pickup_phone || '' %>" dir="ltr" placeholder="هاتف الاستلام (اختياري)" class="border border-gray-200 rounded-xl px-4 py-3 text-sm" />
        <input name="pickup_address" value="<%= integ.pickup_address || '' %>" placeholder="عنوان الاستلام (اختياري)" class="border border-gray-200 rounded-xl px-4 py-3 text-sm" />
      </div>
      <button class="brand-bg text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow w-max">حفظ</button>
    </form>
  </div>
<%- include('_layout_bottom') %>
