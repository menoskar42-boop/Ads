<%
  pageTitle = 'Orders';
  activePage = 'orders';
%>
<%- include('_layout_top') %>

  <div class="space-y-6">
    <%- include('_push_setup') %>
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between flex-wrap gap-4">
      <div>
        <h2 class="text-xl font-bold text-gray-800 mb-1">Orders</h2>
        <p class="text-gray-400 text-sm"><%= orders.length %> orders<% if (currentStatus) { %> (<%= currentStatus %>)<% } %></p>
      </div>
      <form method="GET" action="/company/orders" class="flex items-center gap-2">
        <select name="status" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200">
          <option value="" <%= currentStatus === '' ? 'selected' : '' %>>All</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= currentStatus === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="brand-bg text-white text-sm font-semibold px-4 py-2 rounded-xl hover:opacity-90 transition">Filter</button>
      </form>
    </div>

    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
      <% if (!orders.length) { %>
        <div class="p-12 text-center text-gray-400 text-sm">No orders yet.</div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
              <tr>
                <th class="px-4 py-3 text-left">#</th>
                <th class="px-4 py-3 text-left">Customer</th>
                <th class="px-4 py-3 text-left">Phone</th>
                <th class="px-4 py-3 text-right">Total</th>
                <th class="px-4 py-3 text-center">Status</th>
                <th class="px-4 py-3 text-left">Date</th>
                <th class="px-4 py-3 text-right"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% orders.forEach(o => { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-mono text-gray-500">#<%= o.id %></td>
                  <td class="px-4 py-3 font-semibold text-gray-700"><%= o.customer_name %></td>
                  <td class="px-4 py-3 font-mono text-xs"><%= o.customer_phone %></td>
                  <td class="px-4 py-3 text-right font-bold"><%= Number(o.total_amount).toFixed(2) %></td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold <%= o.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : o.status === 'cancelled' ? 'bg-red-100 text-red-700' : o.status === 'delivered' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700' %>">
                      <%= o.status %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-xs text-gray-400"><%= new Date(o.created_at).toLocaleString() %></td>
                  <td class="px-4 py-3 text-right">
                    <a href="/company/orders/<%= o.id %>" class="text-xs px-2.5 py-1.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition">View</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<%- include('_layout_bottom') %>
