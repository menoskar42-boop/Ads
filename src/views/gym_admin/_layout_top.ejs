<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= (typeof pageTitle !== 'undefined' ? pageTitle : 'إدارة الجيم') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>*{font-family:'Cairo',sans-serif}body{background:#0a0a0a;color:#e5e5e5}.card{background:#141414;border:1px solid #232323}.fld{background:#0f0f0f;border:1px solid #2a2a2a;color:#e5e5e5}.accent-bg{background:#E4FF1A;color:#0a0a0a}</style>
</head>
<body class="min-h-screen">
<% var __nav=[['dashboard','لوحة','/gym'],['members','الأعضاء','/gym/members'],['attendance','الحضور','/gym/attendance'],['bookings','الحجوزات','/gym/bookings'],['reports','التقارير','/gym/reports'],['pos','نقطة بيع','/gym/pos'],['plans','الباقات','/gym/plans'],['trainers','المدرّبون','/gym/trainers'],['classes','الكلاسات','/gym/classes'],['media','الصور','/gym/media'],['settings','الإعدادات','/gym/settings']]; %>
<div class="flex min-h-screen">
  <aside class="w-56 shrink-0 bg-black border-l border-neutral-800 hidden md:flex flex-col p-3">
    <a href="/gym" class="font-black text-lg px-2 py-3 flex items-center gap-2"><span>🏋️</span> <%= company.company_name %></a>
    <nav class="flex-1 space-y-1 mt-2">
      <% __nav.forEach(function(n){ %>
      <a href="<%= n[2] %>" class="block px-3 py-2 rounded-lg text-sm font-semibold <%= tab===n[0] ? 'accent-bg' : 'text-neutral-300 hover:bg-neutral-900' %>"><%= n[1] %></a>
      <% }); %>
    </nav>
    <a href="<%= 'https://' + company.slug + '.oscardevs.com' %>" target="_blank" class="text-xs text-neutral-500 px-3 py-2 hover:text-white">عرض الصفحة ↗</a>
    <%- include('../partials/pay_link') %>
    <form method="POST" action="/company/logout"><button class="w-full text-right text-xs text-red-400 px-3 py-2 hover:text-red-300">تسجيل خروج</button></form>
  </aside>
  <main class="flex-1 min-w-0">
    <div class="md:hidden bg-black border-b border-neutral-800 px-4 py-2 flex gap-1 overflow-x-auto">
      <% __nav.forEach(function(n){ %><a href="<%= n[2] %>" class="text-xs whitespace-nowrap px-3 py-1.5 rounded-full <%= tab===n[0] ? 'accent-bg' : 'text-neutral-400' %>"><%= n[1] %></a><% }); %>
    </div>
    <div class="p-4 sm:p-6 max-w-4xl">
