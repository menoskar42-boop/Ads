<% var pageTitle=member.name; %>
<%- include('_layout_top') %>
  <a href="/gym/members" class="text-xs text-neutral-500 hover:text-white">← كل الأعضاء</a>
  <h1 class="text-2xl font-black mt-2 mb-1"><%= member.name %></h1>
  <div class="text-sm text-neutral-400 mb-5"><% if(member.phone){ %><span dir="ltr"><%= member.phone %></span><% } %><% if(member.code){ %> · كود: <span dir="ltr"><%= member.code %></span><% } %></div>
  <% if (saved) { %><div class="bg-emerald-900/40 border border-emerald-700 text-emerald-300 rounded-xl px-4 py-2 mb-4 text-sm">تم الحفظ ✅</div><% } %>

  <div class="grid md:grid-cols-2 gap-4">
    <!-- Membership history -->
    <div class="card rounded-2xl p-5">
      <h2 class="font-bold text-sm mb-3">تاريخ الاشتراكات</h2>
      <% if (!history.length) { %><p class="text-sm text-neutral-500 text-center py-4">مفيش اشتراكات.</p><% } else { %>
        <div class="space-y-1.5">
          <% history.forEach(function(h){ var active=h.status==='active'&&new Date(h.end_date)>=new Date(); %>
          <div class="flex items-center justify-between text-sm border-b border-neutral-800 pb-1.5">
            <span><%= h.plan_name || 'اشتراك' %></span>
            <span class="text-xs <%= active?'text-emerald-400':'text-neutral-500' %>">حتى <%= new Date(h.end_date).toLocaleDateString('ar-EG') %></span>
          </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Add measurement -->
    <div class="card rounded-2xl p-5">
      <h2 class="font-bold text-sm mb-3">📏 تسجيل قياس جديد</h2>
      <form method="POST" action="/gym/members/<%= member.id %>/measure" class="grid grid-cols-2 gap-2">
        <label class="text-xs text-neutral-400 col-span-2">التاريخ<input name="measured_on" type="date" class="fld rounded-lg px-2 py-1.5 text-sm w-full mt-1" /></label>
        <input name="weight" type="number" step="0.1" placeholder="الوزن (كجم)" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="body_fat" type="number" step="0.1" placeholder="نسبة الدهون %" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="chest" type="number" step="0.1" placeholder="الصدر (سم)" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="waist" type="number" step="0.1" placeholder="الخصر (سم)" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="arm" type="number" step="0.1" placeholder="الذراع (سم)" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="photo_url" placeholder="رابط صورة (اختياري)" dir="ltr" class="fld rounded-lg px-2 py-1.5 text-sm" />
        <input name="notes" placeholder="ملاحظات" class="fld rounded-lg px-2 py-1.5 text-sm col-span-2" />
        <button class="accent-bg font-bold rounded-lg py-2 text-sm col-span-2">حفظ القياس</button>
      </form>
    </div>
  </div>

  <!-- Measurement history -->
  <div class="card rounded-2xl p-5 mt-4">
    <h2 class="font-bold text-sm mb-3">📈 تتبّع التقدّم</h2>
    <% if (!measures.length) { %><p class="text-sm text-neutral-500 text-center py-4">مفيش قياسات مسجّلة.</p><% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-neutral-500 text-xs border-b border-neutral-800">
            <th class="text-right py-1.5">التاريخ</th><th>الوزن</th><th>دهون%</th><th>صدر</th><th>خصر</th><th>ذراع</th><th>صورة</th>
          </tr></thead>
          <tbody>
            <% measures.forEach(function(x){ %>
            <tr class="border-b border-neutral-900">
              <td class="py-1.5"><%= new Date(x.measured_on).toLocaleDateString('ar-EG') %></td>
              <td class="text-center"><%= x.weight!=null?Number(x.weight):'—' %></td>
              <td class="text-center"><%= x.body_fat!=null?Number(x.body_fat):'—' %></td>
              <td class="text-center"><%= x.chest!=null?Number(x.chest):'—' %></td>
              <td class="text-center"><%= x.waist!=null?Number(x.waist):'—' %></td>
              <td class="text-center"><%= x.arm!=null?Number(x.arm):'—' %></td>
              <td class="text-center"><% if(x.photo_url){ %><a href="<%= x.photo_url %>" target="_blank" rel="noopener" class="accent text-xs">📷</a><% } else { %>—<% } %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<%- include('_layout_bottom') %>
