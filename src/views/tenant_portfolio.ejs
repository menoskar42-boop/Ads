          <div class="stars" aria-label="تقييم خمس نجوم">★★★★★</div>
          <blockquote>«<%= tt.quote %>»</blockquote>
          <figcaption class="who">
            <span class="avatar"><%= av %></span>
            <span><span class="name"><%= tt.name %></span><br><span class="role"><%= tt.role || '' %></span></span>
          </figcaption>
        </figure>
        <% }) %>
