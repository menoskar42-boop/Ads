          <span><span class="k">واتساب</span><br><span class="v" dir="ltr"><%= company.contact_whatsapp %></span></span>
        </a>
        <% } %>
        <% if (company.contact_address) { %>
        <a class="info-card" href="#">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span><span class="k">العنوان</span><br><span class="v" style="direction:rtl"><%= company.contact_address %></span></span>
        </a>
