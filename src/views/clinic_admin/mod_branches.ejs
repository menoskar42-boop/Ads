<%- include('head', { title: 'الفروع', tab: 'branches' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1">فروع العيادة</h1>
<p class="text-slate-500 mb-6">أضف فروع العيادة المتعددة لو عندك أكثر من مقر</p>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-1">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3">إضافة فرع</h2>
      <form method="post" action="/clinic/branches" class="grid gap-2.5">
        <input name="name" required maxlength="120" placeholder="اسم الفرع" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <input name="address" maxlength="200" placeholder="العنوان" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <input name="phone" maxlength="30" placeholder="الهاتف" dir="ltr" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm">إضافة</button>
      </form>
    </div>
  </div>
  <div class="lg:col-span-2">
    <% if (!branches.length) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-sm">مفيش فروع مضافة.</div>
    <% } else { %>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <% branches.forEach(function(b){ %>
      <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
        <div class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">🏢</div>
        <div class="min-w-0 flex-1"><div class="font-bold text-slate-900"><%= b.name %></div><div class="text-xs text-slate-500"><%= b.address||'' %><%= b.phone?(' · '+b.phone):'' %></div></div>
        <form method="post" action="/clinic/branches/<%= b.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm.delete')) %>)"><button class="text-slate-300 hover:text-red-600 text-sm">حذف</button></form>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
