<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= title %> — <%= company.company_name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans: ['Cairo','system-ui','sans-serif'] },
    colors: { brand: { 50:'#ecfeff',100:'#cffafe',200:'#a5f3fc',300:'#67e8f9',400:'#22d3ee',500:'#0891b2',600:'#0e7490',700:'#155e75',800:'#164e63',900:'#0c4a5e' } }
  } } };
</script>
<style>
  body{font-family:'Cairo',sans-serif}

  /* ── Wide tables become cards on a phone ──────────────────────────────────
     Horizontal scrolling inside a page is the worst pattern on mobile: the
     columns that matter are off-screen and the gesture fights page scroll.
     Add class="rt" to a <table> and give each <td> a data-l="<%= t('common.address') %>"; below
     640px each row stacks into a labelled card and nothing is hidden. */
  @media (max-width: 639px) {
    table.rt, table.rt tbody, table.rt tr, table.rt td { display: block; width: 100%; }
    table.rt thead { display: none; }
    table.rt tr {
      background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem;
      padding: .5rem .75rem; margin-bottom: .6rem;
    }
    table.rt td {
      display: flex; align-items: center; gap: .5rem;
      padding: .35rem 0 !important; border: 0 !important; text-align: start !important;
    }
    table.rt td::before {
      content: attr(data-l); flex: 0 0 40%;
      color: #64748b; font-size: .7rem; font-weight: 700;
    }
    /* A cell with no label is an actions row — let it use the full width. */
    table.rt td:not([data-l])::before { content: none; }
    table.rt td:not([data-l]) { justify-content: flex-end; }
  }

  /* Comfortable tap targets: iOS also stops zooming on focus at >=16px. */
  @media (max-width: 639px) {
    input, select, textarea { font-size: 16px !important; }
    button, .btn { min-height: 40px; }
  }
</style>
</head>
<body class="bg-slate-50 text-slate-800 pb-16 sm:pb-0">
<%
  var __tab = typeof tab !== 'undefined' ? tab : '';
  function __cls(k){ return 'px-3 py-1.5 rounded-lg ' + (__tab===k ? 'bg-white/25 font-bold' : 'hover:bg-white/15'); }

  // Enabled optional modules, used by both the desktop nav and the mobile sheet.
  var __mods = [];
  if (typeof clinicModules !== 'undefined' && typeof enabledModules !== 'undefined') {
    __mods = clinicModules.filter(function(m){ return enabledModules.has(m.key); })
      // Module labels live in modules.js as Arabic defaults; look each one up so
      // an English clinic gets an English nav. Falls back to the default if a
      // key is ever missing, rather than rendering the key itself.
      .map(function(m){
        var k = 'clinic.mod.' + m.key, tr = t(k);
        return { key: m.key, path: m.path, icon: m.icon, label: (tr && tr !== k) ? tr : m.label };
      });
  }
  // Everything that is not one of the five bottom-bar tabs lives in "المزيد".
  var __more = [{ path:'/clinic/invoices', label:t('clinic.nav.invoices'), icon:'🧾', key:'invoices' },
                { path:'/clinic/doctors',  label:t('clinic.nav.doctors'),  icon:'👨‍⚕️', key:'doctors' },
                { path:'/clinic/services', label:t('clinic.nav.services'),  icon:'💠', key:'services' }]
    .concat(__mods.map(function(m){ return { path:m.path, label:m.label, icon:m.icon, key:m.key }; }))
    .concat([{ path:'/clinic/modules', label:t('clinic.nav.modules'), icon:'🧩', key:'modules' },
             { path:'/clinic/addons',  label:t('clinic.nav.addons'), icon:'✨', key:'addons' },
             // A log nobody can reach is a table, not an audit trail.
             { path:'/clinic/audit',   label:t('clinic.nav.audit'), icon:'🕵️', key:'audit' },
             { path:'/clinic/settings',label:t('clinic.nav.settings'),icon:'⚙️', key:'settings' }]);

  // Drop what this login cannot open. The server refuses it either way
  // (src/clinic/perms.js) — this only stops the nav offering a locked door.
  var __perms = (typeof perms !== 'undefined' && perms) ? perms
    : { medical:true, finance:true, schedule:true, patients:true, settings:true, staff:true };
  var __PATH_PERM = { '/clinic/invoices':'finance', '/clinic/finance':'finance',
    '/clinic/cashbox':'finance', '/clinic/insurance':'finance', '/clinic/installments':'finance',
    '/clinic/settings':'settings', '/clinic/modules':'settings', '/clinic/addons':'settings',
    '/clinic/integrations':'settings', '/clinic/services':'settings', '/clinic/doctors':'settings',
    '/clinic/audit':'settings', '/clinic/staff':'staff',
    '/clinic/queue':'schedule', '/clinic/appointments':'schedule', '/clinic/patients':'patients' };
  __more = __more.filter(function(m){
    var need = __PATH_PERM[m.path];
    return !need || __perms[need];
  });
%>
<header class="bg-brand-700 text-white sticky top-0 z-30">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-3">
    <a href="/clinic" class="font-extrabold text-base sm:text-lg flex items-center gap-1 truncate">
      🩺 <span class="truncate"><%= company.company_name %></span>
    </a>

    <!-- Desktop: the full nav, unchanged. -->
    <nav class="hidden sm:flex items-center gap-1 text-sm ms-auto flex-wrap">
      <a href="/clinic" class="<%= __cls('dashboard') %>"><%= t('clinic.nav.dashboard') %></a>
      <a href="/clinic/queue" class="<%= __cls('queue') %>"><%= t('clinic.nav.queue') %></a>
      <a href="/clinic/appointments" class="<%= __cls('appointments') %>"><%= t('clinic.nav.appointments') %></a>
      <a href="/clinic/patients" class="<%= __cls('patients') %>"><%= t('clinic.nav.patients') %></a>
      <a href="/clinic/invoices" class="<%= __cls('invoices') %>"><%= t('clinic.nav.invoices') %></a>
      <a href="/clinic/doctors" class="<%= __cls('doctors') %>"><%= t('clinic.nav.doctors') %></a>
      <a href="/clinic/services" class="<%= __cls('services') %>"><%= t('clinic.nav.services') %></a>
      <% __mods.forEach(function(m){ %>
      <a href="<%= m.path %>" class="<%= __cls(m.key) %>"><%= m.label %></a>
      <% }); %>
      <a href="/clinic/modules" class="<%= __cls('modules') %>"><%= t('clinic.nav.modules') %></a>
      <a href="/clinic/addons" class="<%= __cls('addons') %>"><%= t('clinic.nav.addons') %></a>
      <a href="/clinic/settings" class="<%= __cls('settings') %>"><%= t('clinic.nav.settings') %></a>
      <a href="https://<%= company.slug %>.oscardevs.com" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-lg hover:bg-white/15"><%= t('clinic.nav.view_page') %> ↗</a>
      <!-- Posts to the existing company toggle, which stores the choice on the
           user record — so it survives logout, not just this browser. -->
      <form method="post" action="/company/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" class="inline">
        <button class="px-3 py-1.5 rounded-lg hover:bg-white/15 font-semibold"><%= t('clinic.lang.switch') %></button>
      </form>
      <%- include('../partials/merchant_chips') %>
      <form method="post" action="/company/logout" class="inline"><button class="px-3 py-1.5 rounded-lg hover:bg-white/15"><%= t('clinic.nav.logout') %></button></form>
    </nav>

    <!-- Mobile: the header only carries the two rarely-tapped actions; the
         real navigation is the thumb-reachable bar at the bottom. -->
    <div class="sm:hidden ms-auto flex items-center gap-1">
      <a href="https://<%= company.slug %>.oscardevs.com" target="_blank" rel="noopener"
         title="<%= t('clinic.nav.view_page') %>" class="px-2 py-1.5 rounded-lg hover:bg-white/15">↗</a>
      <form method="post" action="/company/lang/<%= lang === 'ar' ? 'en' : 'ar' %>">
        <button class="px-2 py-1.5 rounded-lg hover:bg-white/15 text-xs font-bold"><%= t('clinic.lang.switch') %></button>
      </form>
      <form method="post" action="/company/logout"><button class="px-2 py-1.5 rounded-lg hover:bg-white/15 text-sm"><%= t('clinic.nav.logout') %></button></form>
    </div>
  </div>
</header>

<!-- ── Bottom tab bar (mobile only) ─────────────────────────────────────────
     Five tabs for what a clinic actually opens all day, plus a sheet for the
     rest. It is fixed, so it can be declared here even though each page closes
     its own </main> — there is no shared footer partial to hook into. -->
<%
  function __btab(k){ return __tab === k
    ? 'text-brand-700 font-bold'
    : 'text-slate-400'; }
%>
<nav class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 shadow-[0_-2px_10px_rgba(0,0,0,0.04)]">
  <div class="grid grid-cols-5">
    <a href="/clinic" class="flex flex-col items-center justify-center py-2 <%= __btab('dashboard') %>">
      <span class="text-lg leading-none">🏠</span><span class="text-[10px] mt-0.5"><%= t('clinic.nav.home') %></span>
    </a>
    <a href="/clinic/queue" class="flex flex-col items-center justify-center py-2 <%= __btab('queue') %>">
      <span class="text-lg leading-none">🚶</span><span class="text-[10px] mt-0.5"><%= t('clinic.nav.queue') %></span>
    </a>
    <a href="/clinic/appointments" class="flex flex-col items-center justify-center py-2 <%= __btab('appointments') %>">
      <span class="text-lg leading-none">📅</span><span class="text-[10px] mt-0.5"><%= t('clinic.nav.appointments') %></span>
    </a>
    <a href="/clinic/patients" class="flex flex-col items-center justify-center py-2 <%= __btab('patients') %>">
      <span class="text-lg leading-none">👥</span><span class="text-[10px] mt-0.5"><%= t('clinic.nav.patients') %></span>
    </a>
    <button type="button" onclick="__openMore()" id="__moreBtn"
            class="flex flex-col items-center justify-center py-2 text-slate-400">
      <span class="text-lg leading-none">⋯</span><span class="text-[10px] mt-0.5"><%= t('clinic.nav.more') %></span>
    </button>
  </div>
</nav>

<!-- The rest of the sections, as a sheet rather than a hidden menu: a phone
     has room to show them all at once, so nothing needs hunting for. -->
<div id="__moreSheet" class="sm:hidden fixed inset-0 z-50 hidden" onclick="if(event.target===this)__closeMore()">
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="absolute bottom-0 inset-x-0 bg-white rounded-t-3xl p-4 pb-6 max-h-[75vh] overflow-y-auto">
    <div class="w-10 h-1 bg-slate-200 rounded-full mx-auto mb-4"></div>
    <div class="grid grid-cols-3 gap-2">
      <% __more.forEach(function(m){ %>
      <a href="<%= m.path %>"
         class="flex flex-col items-center gap-1 p-3 rounded-2xl <%= __tab === m.key ? 'bg-brand-50 text-brand-700 font-bold' : 'bg-slate-50 text-slate-700' %>">
        <span class="text-xl"><%= m.icon || '•' %></span>
        <span class="text-[11px] text-center leading-tight"><%= m.label %></span>
      </a>
      <% }); %>
    </div>
    <button type="button" onclick="__closeMore()" class="w-full mt-4 py-2.5 rounded-xl bg-slate-100 text-slate-600 text-sm font-semibold"><%= t('clinic.nav.close') %></button>
  </div>
</div>
<script>
  function __openMore(){ document.getElementById('__moreSheet').classList.remove('hidden'); }
  function __closeMore(){ document.getElementById('__moreSheet').classList.add('hidden'); }
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') __closeMore(); });

  // Every save here is a full page POST, so between the click and the reload the
  // page looks frozen and staff click twice — which posts the payment, the visit
  // or the vitals row twice. Disabling the button on submit says "it's working"
  // and makes the double-click harmless.
  var __SAVING = <%- jsonLd(t('common.saving')) %>;
  document.addEventListener('submit', function(ev){
    var f = ev.target;
    if (!f || f.method === 'get' || f.hasAttribute('data-noload')) return;
    var b = f.querySelector('button:not([type=button]):not([formnovalidate])');
    if (!b || b.disabled) return;
    // Let the browser finish native validation first, otherwise a blocked
    // submit leaves the button dead.
    setTimeout(function(){
      // A `onsubmit="return confirm(...)"` that the user cancelled, or a failed
      // native validation, means nothing was sent — leave the button alive.
      if (ev.defaultPrevented) return;
      if (f.checkValidity && !f.checkValidity()) return;
      b.disabled = true;
      b.dataset.label = b.textContent;
      b.textContent = __SAVING;
    }, 0);
  }, true);
  // Back/forward cache can restore the page with the button still disabled.
  window.addEventListener('pageshow', function(){
    document.querySelectorAll('button[data-label]').forEach(function(b){
      b.disabled = false; b.textContent = b.dataset.label; b.removeAttribute('data-label');
    });
  });
</script>

<main class="max-w-5xl mx-auto px-4 py-6">
<%
  /* A failed save used to end at ?saved=1 all the same — the catch logged to
     the server and the page said "done". Every route that can fail now
     redirects with ?error=save instead, and the banner lives here so no page
     has to remember to render it. */
  var __qs = (typeof query !== 'undefined' && query) ? query
    : ((typeof req !== 'undefined' && req && req.query) ? req.query : {});
%>
<% if (__qs.error === 'save') { %>
<div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-4">
  <%= t('clinic.save_failed') %>
</div>
<% } %>
<% if (__qs.error === 'settled') { %>
<div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm mb-4">
  <%= t('clinic.inv.settled') %>
</div>
<% } %>
<% if (__qs.change) { %>
<div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm mb-4">
  <%= t('clinic.inv.change').replace('{n}', __qs.change) %>
</div>
<% } %>
<% if (__qs.error === 'final' || __qs.error === 'backwards') { %>
<div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-4">
  <%= t(__qs.error === 'final' ? 'clinic.flow.final' : 'clinic.flow.backwards') %>
</div>
<% } %>
