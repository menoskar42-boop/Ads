<%- include('head', { title: 'لوحة التحكم', tab: 'dashboard' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1">مرحبًا 👋</h1>
<p class="text-slate-500 mb-6">نظرة سريعة على عيادتك اليوم</p>

<div class="grid gap-4 grid-cols-2 lg:grid-cols-5 mb-6">
  <a href="/clinic/queue" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-300">
    <div class="text-3xl font-black text-amber-600"><%= stats.waiting %></div>
    <div class="text-sm text-slate-500 mt-1">في الطابور الآن</div>
  </a>
  <a href="/clinic/appointments" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-300">
    <div class="text-3xl font-black text-brand-600"><%= stats.pending %></div>
    <div class="text-sm text-slate-500 mt-1">حجوزات بانتظار التأكيد</div>
  </a>
  <a href="/clinic/finance" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-300">
    <div class="text-3xl font-black text-emerald-600"><%= stats.revenue.toLocaleString('ar-EG') %></div>
    <div class="text-sm text-slate-500 mt-1">تحصيل اليوم (ج)</div>
  </a>
  <a href="/clinic/doctors" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-300">
    <div class="text-3xl font-black text-slate-900"><%= stats.doctors %></div>
    <div class="text-sm text-slate-500 mt-1">الأطباء</div>
  </a>
  <a href="/clinic/patients" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-300">
    <div class="text-3xl font-black text-slate-900"><%= stats.patients %></div>
    <div class="text-sm text-slate-500 mt-1">المرضى</div>
  </a>
</div>

<div class="flex flex-wrap gap-2 mb-8">
  <a href="/clinic/queue" class="bg-brand-500 hover:bg-brand-600 text-white text-sm font-bold rounded-xl px-4 py-2">➕ تسجيل وصول مريض</a>
  <a href="/clinic/invoices" class="bg-white border border-slate-200 hover:border-brand-300 text-slate-700 text-sm font-bold rounded-xl px-4 py-2">🧾 فاتورة جديدة</a>
  <a href="/clinic/patients" class="bg-white border border-slate-200 hover:border-brand-300 text-slate-700 text-sm font-bold rounded-xl px-4 py-2">🧑 إضافة مريض</a>
</div>

<div class="flex items-center justify-between mb-3">
  <h2 class="text-lg font-extrabold text-slate-900">المواعيد القادمة</h2>
  <a href="/clinic/appointments" class="text-brand-600 font-bold text-sm">كل المواعيد ←</a>
</div>

<% if (!upcoming.length) { %>
  <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-500">مفيش مواعيد قادمة حاليًا.</div>
<% } else { %>
<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
  <% upcoming.forEach(function(a){ %>
  <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
    <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 grid place-items-center">🗓️</div>
    <div class="min-w-0 flex-1">
      <div class="font-bold text-slate-900 truncate"><%= a.patient_name %> <span class="text-slate-400 font-normal text-sm" dir="ltr"><%= a.patient_phone %></span></div>
      <div class="text-xs text-slate-500"><%= a.doctor_name || 'بدون طبيب محدد' %><%= a.slot_at ? (' · ' + new Date(a.slot_at).toLocaleString('ar-EG')) : '' %></div>
    </div>
    <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= a.status==='confirmed' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>"><%= a.status==='confirmed' ? 'مؤكّد' : 'بانتظار' %></span>
  </div>
  <% }); %>
</div>
<% } %>

</main></body></html>
