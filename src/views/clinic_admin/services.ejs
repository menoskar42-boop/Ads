<%- include('head', { title: t('sv.title'), tab: 'services' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('sv.title') %></h1>
<p class="text-slate-500 mb-6"><%= t('sv.sub') %></p>

<div class="grid gap-6 lg:grid-cols-2">
  <!-- Services -->
  <div class="space-y-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('sv.add') %></h2>
      <form method="post" action="/clinic/services" class="grid gap-2.5">
        <input name="name" required maxlength="120" placeholder="<%= t('sv.name') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <div class="flex gap-2">
          <input name="price" type="number" step="0.01" min="0" placeholder="<%= t('sv.price') %> (<%= t('cur.egp') %>)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
          <input name="doctor_pct" type="number" step="0.01" min="0" max="100" value="60" placeholder="<%= t('sv.doctor_pct') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="is_active" value="1" checked /> <%= t('sv.active') %></label>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('dr.add') %></button>
      </form>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <div class="px-5 py-3 border-b border-slate-100 font-extrabold text-slate-900 text-sm"><%= t('sv.list') %> (<%= services.length %>)</div>
      <% if (!services.length) { %>
        <div class="p-6 text-center text-slate-400 text-sm"><%= t('sv.empty') %></div>
      <% } else { services.forEach(function(s){ %>
      <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900 <%= s.is_active?'':'opacity-50 line-through' %>"><%= s.name %></div>
          <div class="text-xs text-slate-500"><%= Number(s.price).toLocaleString(LOC) %> <%= t('cur.egp') %> · <%= t('sv.doctor_share') %> <%= Number(s.doctor_pct) %>%</div>
        </div>
        <form method="post" action="/clinic/services/<%= s.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm.delete')) %>)"><button class="text-slate-300 hover:text-red-600 text-sm"><%= t('common.delete') %></button></form>
      </div>
      <% }); } %>
    </div>
  </div>

  <!-- Visit types -->
  <div class="space-y-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('sv.vt_add') %></h2>
      <form method="post" action="/clinic/visit-types" class="grid gap-2.5">
        <input name="name" required maxlength="80" placeholder="<%= t('sv.vt_name') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <div class="flex gap-2">
          <input name="price" type="number" step="0.01" min="0" placeholder="<%= t('sv.price') %> (<%= t('cur.egp') %>)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
          <input name="duration_min" type="number" min="1" value="20" placeholder="<%= t('sv.duration') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
        </div>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('dr.add') %></button>
      </form>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <div class="px-5 py-3 border-b border-slate-100 font-extrabold text-slate-900 text-sm"><%= t('sv.vt_list') %> (<%= visitTypes.length %>)</div>
      <% if (!visitTypes.length) { %>
        <div class="p-6 text-center text-slate-400 text-sm"><%= t('sv.vt_empty') %></div>
      <% } else { visitTypes.forEach(function(vt){ %>
      <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900"><%= vt.name %></div>
          <div class="text-xs text-slate-500"><%= Number(vt.price).toLocaleString(LOC) %> <%= t('cur.egp') %> · <%= vt.duration_min %> <%= t('sv.minutes') %></div>
        </div>
        <form method="post" action="/clinic/visit-types/<%= vt.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('confirm.delete')) %>)"><button class="text-slate-300 hover:text-red-600 text-sm"><%= t('common.delete') %></button></form>
      </div>
      <% }); } %>
    </div>
  </div>
</div>

</main></body></html>
