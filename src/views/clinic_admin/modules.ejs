<%- include('head', { title: t('clinic.page.modules'), tab: 'modules' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('md.title') %></h1>
<p class="text-slate-500 mb-6"><%= t('md.sub') %></p>

<% if (saved) { %>
<div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-3 mb-5 text-sm text-emerald-800">
  <%= t('md.saved') %>
</div>
<% } %>

<% if (specialtyLabel && bySpecialty.size) { %>
<div class="bg-blue-50 border border-blue-200 rounded-2xl px-4 py-3 mb-5 text-sm text-blue-800">
  <%= t('md.your_spec') %> <strong><%= specialtyLabel %></strong> <%= t('md.auto_on') %>
</div>
<% } %>

<%# The list is filtered by specialty, so say so. A dentist who switches to
    internal medicine would otherwise think the dental module broke rather
    than that it belongs to a specialty they no longer practise. %>
<% if (specialtyLabel && hiddenCount) { %>
<div class="bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 mb-5 text-sm text-slate-600">
  <%= t('md.filtered_1') %> <strong><%= specialtyLabel %></strong>.
  <%= hiddenCount %> <%= t('md.filtered_2') %>
  <a href="/clinic/settings" class="text-indigo-600 font-semibold hover:underline"><%= t('md.filtered_link') %></a>
</div>
<% } %>

<form method="post" action="/clinic/modules">
  <div class="grid lg:grid-cols-2 gap-3 mb-5">
    <% modules.forEach(function(m){
         var on = enabled.has(m.key);
         var auto = bySpecialty.has(m.key);
    %>
    <label class="bg-white rounded-2xl shadow-sm p-4 flex items-start gap-3 cursor-pointer border-2 transition
                  <%= on ? 'border-emerald-200' : 'border-transparent hover:border-slate-200' %>">
      <input type="checkbox" name="modules" value="<%= m.key %>" <%= on ? 'checked' : '' %>
             class="mt-1 w-5 h-5 shrink-0" />
      <span class="text-2xl shrink-0"><%= m.icon %></span>
      <span class="flex-1 min-w-0">
        <span class="flex items-center gap-2 flex-wrap">
          <strong class="text-slate-900"><% var lk = 'clinic.mod.' + m.key, ltr = t(lk); %><%= (ltr && ltr !== lk) ? ltr : m.label %></strong>
          <% if (auto) { %>
            <span class="text-[10px] font-bold bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full"><%= t('md.suggested') %></span>
          <% } %>
        </span>
        <span class="block text-sm text-slate-500 leading-relaxed mt-0.5"><% var dk = 'md.d.' + m.key, dtr = t(dk); %><%= (dtr && dtr !== dk) ? dtr : m.desc %></span>
      </span>
    </label>
    <% }); %>
  </div>

  <button class="bg-slate-900 text-white text-sm font-bold px-6 py-3 rounded-xl hover:bg-slate-800">
    <%= t('md.save') %>
  </button>
</form>

<div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 mt-6 text-sm text-slate-600">
  <strong class="text-slate-800"><%= t('md.where_ai') %></strong>
  <p class="mt-1 leading-relaxed">
    <%= t('md.free_note') %>
        <a href="/clinic/addons" class="text-indigo-600 underline font-semibold"><%= t('md.addons_page') %></a>.
  </p>
</div>

</main></body></html>
