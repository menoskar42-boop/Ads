<%- include('head', { title: t('clinic.page.appointments'), tab: 'appointments' }) %>
<%
  var __statuses = { '':'الكل', pending:'بانتظار', confirmed:'مؤكّد', done:'تمّت', cancelled:'ملغاة' };
  function __badge(s){ return s==='confirmed'?'bg-emerald-100 text-emerald-700':(s==='done'?'bg-slate-200 text-slate-600':(s==='cancelled'?'bg-rose-100 text-rose-600':'bg-amber-100 text-amber-700')); }
  function __label(s){ return {pending:'بانتظار',confirmed:'مؤكّد',done:'تمّت',cancelled:'ملغاة'}[s]||s; }
%>
<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('ap.title') %></h1>
<p class="text-slate-500 mb-4"><%= t('ap.sub') %></p>

<div class="flex items-center gap-2 mb-4 flex-wrap">
  <% Object.keys(__statuses).forEach(function(k){ %>
    <a href="/clinic/appointments<%= k?('?status='+k):'' %>" class="px-3 py-1.5 rounded-full text-sm font-bold <%= status===k ? 'bg-brand-600 text-white' : 'bg-white border border-slate-200 text-slate-600' %>"><%= __statuses[k] %></a>
  <% }); %>
</div>

<% if (!appts.length) { %>
  <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-500"><%= t('ap.empty') %></div>
<% } else { %>
<div class="space-y-3">
  <% appts.forEach(function(a){ %>
  <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center gap-3 flex-wrap">
    <div class="min-w-0 flex-1">
      <div class="font-bold text-slate-900"><%= a.patient_name %> <a href="tel:<%= a.patient_phone %>" class="text-brand-600 text-sm font-semibold" dir="ltr"><%= a.patient_phone %></a></div>
      <div class="text-xs text-slate-500 mt-0.5"><%= a.doctor_name || 'بدون طبيب' %><%= a.slot_at ? (' · ' + new Date(a.slot_at).toLocaleString('ar-EG')) : '' %></div>
      <% if (a.reason) { %><div class="text-xs text-slate-400 mt-0.5">📝 <%= a.reason %></div><% } %>
    </div>
    <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= __badge(a.status) %>"><%= __label(a.status) %></span>
    <% if (typeof waReady !== 'undefined' && waReady && a.patient_phone) { %>
    <form method="post" action="/clinic/appointments/<%= a.id %>/whatsapp" class="inline">
      <input type="hidden" name="back" value="<%= status %>" />
      <button class="text-xs px-2.5 py-1.5 rounded-lg border border-emerald-200 text-emerald-700 hover:bg-emerald-50 font-semibold" title="<%= t('ap.wa_api_t') %>"><%= t('ap.wa_api') %></button>
    </form>
    <% } else if (a.patient_phone) {
         var __waPhone = String(a.patient_phone).replace(/[^0-9]/g, '');
         var __waIntl = __waPhone.length <= 11 ? ('20' + __waPhone.replace(/^0/, '')) : __waPhone;
         var __waMsg = 'أهلاً ' + (a.patient_name || '') + '، بخصوص موعدك في العيادة' + (a.slot_at ? (' يوم ' + new Date(a.slot_at).toLocaleString('ar-EG')) : '') + '.';
    %>
    <a href="https://wa.me/<%= __waIntl %>?text=<%= encodeURIComponent(__waMsg) %>" target="_blank" rel="nofollow noopener"
       class="text-xs px-2.5 py-1.5 rounded-lg border border-emerald-200 text-emerald-700 hover:bg-emerald-50 font-semibold" title="<%= t('ap.wa_open') %>"><%= t('ap.wa') %></a>
    <% } %>
    <form method="post" action="/clinic/appointments/<%= a.id %>/status" class="flex items-center gap-1">
      <input type="hidden" name="back" value="<%= status %>" />
      <% ['confirmed','done','cancelled'].forEach(function(st){ if(a.status!==st){ %>
        <button name="status" value="<%= st %>" class="text-xs px-2.5 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-semibold"><%= __label(st) %></button>
      <% } }); %>
    </form>
  </div>
  <% }); %>
</div>
<% } %>

</main></body></html>
