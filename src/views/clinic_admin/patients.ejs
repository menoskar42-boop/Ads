<%- include('head', { title: t('clinic.page.patients'), tab: 'patients' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('pt.title') %></h1>
<p class="text-slate-500 mb-6"><%= t('pt.sub') %></p>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-1">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pt.add') %></h2>
      <form method="post" action="/clinic/patients" class="grid gap-2.5">
        <input name="name" required maxlength="80" placeholder="<%= t('pt.name') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <input name="phone" maxlength="20" placeholder="<%= t('pt.mobile') %>" dir="ltr" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <div class="flex gap-2">
          <select name="gender" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1 bg-white"><option value=""><%= t('pt.gender') %></option><option value="ذكر"><%= t('pt.male') %></option><option value="أنثى"><%= t('pt.female') %></option></select>
          <input name="birth_year" type="number" min="1900" max="2025" placeholder="<%= t('pt.birth_year') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
        </div>
        <textarea name="notes" maxlength="1000" rows="3" placeholder="<%= t('pt.notes_opt') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"></textarea>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('pt.add_btn') %></button>
      </form>
    </div>
  </div>
  <div class="lg:col-span-2">
    <form method="get" class="mb-3"><input name="q" value="<%= q %>" placeholder="<%= t('pt.search') %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" /></form>
    <% if (!patients.length) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-500"><%= t('pt.empty') %></div>
    <% } else { %>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <% patients.forEach(function(p){ %>
      <a href="/clinic/patients/<%= p.id %>" class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0 hover:bg-brand-50/40">
        <div class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">🧑</div>
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900 truncate"><%= p.name %> <span class="text-brand-600 text-sm" dir="ltr"><%= p.phone||'' %></span></div>
          <div class="text-xs text-slate-500"><%= p.gender === 'ذكر' ? t('pt.male') : (p.gender === 'أنثى' ? t('pt.female') : (p.gender || '')) %><%= p.birth_year?(' · '+p.birth_year):'' %><%= p.notes?(' · '+String(p.notes).slice(0,40)):'' %></div>
        </div>
        <div class="text-slate-300">‹</div>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
