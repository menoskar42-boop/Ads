<%- include('head', { title: t('iv.one') + ' #' + inv.id, tab: 'invoices' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC); }
  function fmtDT(t){ if(!t) return '—'; try { return new Date(t).toLocaleString(LOC,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  var STLABEL = { pending:t('iv.st.pending'), partial:t('iv.st.partial'), paid:t('iv.st.paid'), cancelled:t('iv.st.cancelled') };
  var STCLS = { pending:'bg-amber-100 text-amber-700', partial:'bg-blue-100 text-blue-700', paid:'bg-emerald-100 text-emerald-700', cancelled:'bg-slate-100 text-slate-400' };
  var due = Math.max(0, Number(inv.total_amount) - Number(inv.paid_amount));
  var MLABEL = { cash:t('pm.cash'), card:t('pm.card'), wallet:t('pm.wallet'), transfer:t('pm.transfer') };
%>

<div class="flex items-center gap-3 mb-4 flex-wrap">
  <a href="/clinic/invoices" class="text-brand-600 text-sm">‹ <%= t('iv.back') %></a>
  <h1 class="text-2xl font-black text-slate-900"><%= t('iv.one') %> #<%= inv.id %></h1>
  <span class="text-xs rounded-full px-2.5 py-1 font-bold <%= STCLS[inv.status] %>"><%= STLABEL[inv.status] %></span>
  <button onclick="window.print()" class="no-print ms-auto bg-slate-100 hover:bg-slate-200 rounded-xl px-4 py-2 text-sm font-bold"><%= t('iv.print') %></button>
</div>
<div class="print-only hidden mb-4">
  <div class="text-xl font-black text-slate-900"><%= company.company_name %></div>
  <div class="text-sm text-slate-500"><%= t('iv.one') %> #<%= inv.id %></div>
</div>
<style>
  @media print {
    header, nav, .no-print, form { display: none !important; }
    .print-only { display: block !important; }
    body { background: #fff !important; }
    main { max-width: 100% !important; padding: 0 !important; }
    .lg\:col-span-1 { display: none !important; }
    .lg\:col-span-2 { grid-column: span 3 / span 3 !important; }
    .border { border-color: #e2e8f0 !important; }
  }
</style>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <div class="flex justify-between items-start mb-4 flex-wrap gap-2">
        <div>
          <div class="font-extrabold text-slate-900"><%= inv.patient_name || t('iv.no_patient') %></div>
          <div class="text-xs text-slate-500" dir="ltr"><%= inv.patient_phone || '' %></div>
        </div>
        <div class="text-xs text-slate-400"><%= fmtDT(inv.created_at) %></div>
      </div>
      <table class="w-full text-sm text-start">
        <thead class="text-xs text-slate-400 border-b border-slate-100"><tr><th class="py-2 font-medium"><%= t('iv.c.item') %></th><th class="py-2 font-medium"><%= t('iv.c.qty') %></th><th class="py-2 font-medium"><%= t('iv.c.price') %></th><th class="py-2 font-medium"><%= t('iv.c.total') %></th></tr></thead>
        <tbody>
          <% items.forEach(function(it){ %>
          <tr class="border-b border-slate-50 last:border-0"><td class="py-2.5"><%= it.name %></td><td class="py-2.5"><%= it.quantity %></td><td class="py-2.5"><%= money(it.unit_price) %></td><td class="py-2.5 font-bold"><%= money(it.total_price) %></td></tr>
          <% }); %>
        </tbody>
      </table>
      <div class="mt-4 pt-3 border-t border-slate-100 space-y-1 text-sm">
        <div class="flex justify-between text-slate-500"><span><%= t('iv.subtotal') %></span><span><%= money(inv.subtotal) %> <%= t('cur.egp') %></span></div>
        <% if (Number(inv.discount_amount)>0) { %><div class="flex justify-between text-slate-500"><span><%= t('iv.discount_line') %></span><span>- <%= money(inv.discount_amount) %> <%= t('cur.egp') %></span></div><% } %>
        <div class="flex justify-between font-black text-slate-900 text-base"><span><%= t('iv.grand_total') %></span><span><%= money(inv.total_amount) %> <%= t('cur.egp') %></span></div>
        <div class="flex justify-between text-emerald-600"><span><%= t('iv.paid') %></span><span><%= money(inv.paid_amount) %> <%= t('cur.egp') %></span></div>
        <% if (due>0 && inv.status!=='cancelled') { %><div class="flex justify-between text-amber-600 font-bold"><span><%= t('iv.due') %></span><span><%= money(due) %> <%= t('cur.egp') %></span></div><% } %>
      </div>
    </div>

    <% if (payments.length) { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3 text-sm"><%= t('iv.payments_log') %></h2>
      <div class="space-y-1.5">
        <% payments.forEach(function(pm){ %>
        <div class="flex justify-between text-sm border-b border-slate-50 last:border-0 py-1.5"><span class="text-slate-500"><%= fmtDT(pm.created_at) %> · <%= MLABEL[pm.method]||pm.method %></span><span class="font-bold text-slate-800"><%= money(pm.amount) %> <%= t('cur.egp') %></span></div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <div class="lg:col-span-1">
    <% if (inv.status!=='paid' && inv.status!=='cancelled') { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('iv.collect') %></h2>
      <form method="post" action="/clinic/invoices/<%= inv.id %>/payments" class="grid gap-2.5">
        <input name="amount" type="number" step="0.01" min="0.01" value="<%= due>0?due:'' %>" required placeholder="<%= t('iv.amount') %> (<%= t('cur.egp') %>)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <select name="method" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value="cash"><%= MLABEL.cash %></option><option value="card"><%= MLABEL.card %></option><option value="wallet"><%= MLABEL.wallet %></option><option value="transfer"><%= MLABEL.transfer %></option>
        </select>
        <button class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('iv.record_payment') %></button>
      </form>
      <form method="post" action="/clinic/invoices/<%= inv.id %>/cancel" onsubmit="return confirm(<%= JSON.stringify(t('confirm.delete')) %>)" class="mt-3">
        <button class="w-full text-slate-400 hover:text-red-600 text-sm"><%= t('iv.cancel_invoice') %></button>
      </form>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
