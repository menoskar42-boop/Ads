<%- include('head', { title: 'فاتورة #' + inv.id, tab: 'invoices' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG'); }
  function fmtDT(t){ if(!t) return '—'; try { return new Date(t).toLocaleString('ar-EG',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  var STLABEL = { pending:'غير مدفوعة', partial:'مدفوعة جزئياً', paid:'مدفوعة', cancelled:'ملغاة' };
  var STCLS = { pending:'bg-amber-100 text-amber-700', partial:'bg-blue-100 text-blue-700', paid:'bg-emerald-100 text-emerald-700', cancelled:'bg-slate-100 text-slate-400' };
  var due = Math.max(0, Number(inv.total_amount) - Number(inv.paid_amount));
  var MLABEL = { cash:'نقدي', card:'بطاقة', wallet:'محفظة', transfer:'تحويل' };
%>

<div class="flex items-center gap-3 mb-4 flex-wrap">
  <a href="/clinic/invoices" class="text-brand-600 text-sm">‹ الفواتير</a>
  <h1 class="text-2xl font-black text-slate-900">فاتورة #<%= inv.id %></h1>
  <span class="text-xs rounded-full px-2.5 py-1 font-bold <%= STCLS[inv.status] %>"><%= STLABEL[inv.status] %></span>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <div class="flex justify-between items-start mb-4 flex-wrap gap-2">
        <div>
          <div class="font-extrabold text-slate-900"><%= inv.patient_name || 'بدون مريض' %></div>
          <div class="text-xs text-slate-500" dir="ltr"><%= inv.patient_phone || '' %></div>
        </div>
        <div class="text-xs text-slate-400"><%= fmtDT(inv.created_at) %></div>
      </div>
      <table class="w-full text-sm text-right">
        <thead class="text-xs text-slate-400 border-b border-slate-100"><tr><th class="py-2 font-medium">البند</th><th class="py-2 font-medium">الكمية</th><th class="py-2 font-medium">السعر</th><th class="py-2 font-medium">الإجمالي</th></tr></thead>
        <tbody>
          <% items.forEach(function(it){ %>
          <tr class="border-b border-slate-50 last:border-0"><td class="py-2.5"><%= it.name %></td><td class="py-2.5"><%= it.quantity %></td><td class="py-2.5"><%= money(it.unit_price) %></td><td class="py-2.5 font-bold"><%= money(it.total_price) %></td></tr>
          <% }); %>
        </tbody>
      </table>
      <div class="mt-4 pt-3 border-t border-slate-100 space-y-1 text-sm">
        <div class="flex justify-between text-slate-500"><span>المجموع</span><span><%= money(inv.subtotal) %> ج</span></div>
        <% if (Number(inv.discount_amount)>0) { %><div class="flex justify-between text-slate-500"><span>الخصم</span><span>- <%= money(inv.discount_amount) %> ج</span></div><% } %>
        <div class="flex justify-between font-black text-slate-900 text-base"><span>الإجمالي</span><span><%= money(inv.total_amount) %> ج</span></div>
        <div class="flex justify-between text-emerald-600"><span>المدفوع</span><span><%= money(inv.paid_amount) %> ج</span></div>
        <% if (due>0 && inv.status!=='cancelled') { %><div class="flex justify-between text-amber-600 font-bold"><span>المتبقّي</span><span><%= money(due) %> ج</span></div><% } %>
      </div>
    </div>

    <% if (payments.length) { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3 text-sm">سجل المدفوعات</h2>
      <div class="space-y-1.5">
        <% payments.forEach(function(pm){ %>
        <div class="flex justify-between text-sm border-b border-slate-50 last:border-0 py-1.5"><span class="text-slate-500"><%= fmtDT(pm.created_at) %> · <%= MLABEL[pm.method]||pm.method %></span><span class="font-bold text-slate-800"><%= money(pm.amount) %> ج</span></div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <div class="lg:col-span-1">
    <% if (inv.status!=='paid' && inv.status!=='cancelled') { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3">تحصيل دفعة</h2>
      <form method="post" action="/clinic/invoices/<%= inv.id %>/payments" class="grid gap-2.5">
        <input name="amount" type="number" step="0.01" min="0.01" value="<%= due>0?due:'' %>" required placeholder="المبلغ (ج)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <select name="method" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value="cash">نقدي</option><option value="card">بطاقة</option><option value="wallet">محفظة إلكترونية</option><option value="transfer">تحويل بنكي</option>
        </select>
        <button class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl px-4 py-2 text-sm">تسجيل الدفعة</button>
      </form>
      <form method="post" action="/clinic/invoices/<%= inv.id %>/cancel" onsubmit="return confirm('إلغاء الفاتورة؟')" class="mt-3">
        <button class="w-full text-slate-400 hover:text-red-600 text-sm">إلغاء الفاتورة</button>
      </form>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
