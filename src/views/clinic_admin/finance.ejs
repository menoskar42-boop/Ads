<%- include('head', { title: 'التقارير المالية', tab: 'invoices' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC); }
  var MLABEL = { cash:'نقدي', card:'بطاقة', wallet:'محفظة', transfer:'تحويل' };
  var maxDaily = daily.reduce(function(m,x){ return Math.max(m, Number(x.total)); }, 0) || 1;
  function fmtDay(d){ try { return new Date(d).toLocaleDateString(LOC,{day:'numeric',month:'short',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
%>

<div class="flex items-center justify-between gap-3 flex-wrap mb-1">
  <div class="flex items-center gap-3">
    <a href="/clinic/invoices" class="text-brand-600 text-sm">‹ الفواتير</a>
    <h1 class="text-2xl font-black text-slate-900">التقارير المالية</h1>
  </div>
  <form method="get" class="flex items-center gap-2">
    <input type="month" name="month" value="<%= month %>" class="border border-slate-200 rounded-xl px-3 py-1.5 text-sm" />
    <button class="bg-slate-100 hover:bg-slate-200 rounded-xl px-3 py-1.5 text-sm font-bold">عرض</button>
  </form>
</div>
<p class="text-slate-500 mb-6 text-sm"><%= month ? ('شهر ' + month) : 'الشهر الحالي' %></p>

<div class="grid grid-cols-3 gap-3 mb-6">
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500">المحصّل</div><div class="text-xl font-black text-emerald-600 mt-1"><%= money(totals.collected) %> <%= t('cur.egp') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500">إجمالي الفواتير</div><div class="text-xl font-black text-slate-900 mt-1"><%= money(totals.billed) %> <%= t('cur.egp') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500">مبالغ مستحقة</div><div class="text-xl font-black text-amber-600 mt-1"><%= money(totals.outstanding) %> <%= t('cur.egp') %></div></div>
</div>

<!-- Daily revenue bars -->
<div class="bg-white border border-slate-200 rounded-2xl p-5 mb-6">
  <h2 class="font-extrabold text-slate-900 mb-4 text-sm">التحصيل اليومي</h2>
  <% if (!daily.length) { %>
    <div class="text-slate-400 text-sm text-center py-4">لا توجد مدفوعات في هذه الفترة.</div>
  <% } else { %>
  <div class="flex items-end gap-1.5 h-40 overflow-x-auto">
    <% daily.forEach(function(x){ %>
    <div class="flex flex-col items-center gap-1 flex-1 min-w-[28px]" title="<%= money(x.total) %> ج">
      <div class="text-[10px] text-slate-500 font-bold"><%= money(x.total) %></div>
      <div class="w-full bg-brand-400 rounded-t" style="height: <%= Math.max(4, Math.round(Number(x.total)/maxDaily*120)) %>px"></div>
      <div class="text-[10px] text-slate-400 whitespace-nowrap"><%= fmtDay(x.d) %></div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <!-- Doctor earnings -->
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 font-extrabold text-slate-900 text-sm">حسابات الأطباء (نصيب الطبيب من الفواتير المدفوعة)</div>
    <% if (!byDoctor.length) { %>
      <div class="p-6 text-center text-slate-400 text-sm">لا توجد أرباح محتسبة بعد.</div>
    <% } else { byDoctor.forEach(function(d){ %>
    <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
      <div class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">🩺</div>
      <div class="min-w-0 flex-1"><div class="font-bold text-slate-900 truncate"><%= d.name %></div><div class="text-xs text-slate-500"><%= d.invoices %> فاتورة</div></div>
      <div class="font-black text-emerald-600"><%= money(d.earnings) %> <%= t('cur.egp') %></div>
    </div>
    <% }); } %>
  </div>

  <!-- Payment methods -->
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 font-extrabold text-slate-900 text-sm">طرق الدفع</div>
    <% if (!byMethod.length) { %>
      <div class="p-6 text-center text-slate-400 text-sm">لا توجد مدفوعات.</div>
    <% } else { byMethod.forEach(function(m){ %>
    <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
      <div class="min-w-0 flex-1"><div class="font-bold text-slate-900"><%= MLABEL[m.method]||m.method %></div><div class="text-xs text-slate-500"><%= m.n %> عملية</div></div>
      <div class="font-black text-slate-800"><%= money(m.total) %> <%= t('cur.egp') %></div>
    </div>
    <% }); } %>
  </div>
</div>

<!-- Top services -->
<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden mt-6">
  <div class="px-5 py-3 border-b border-slate-100 font-extrabold text-slate-900 text-sm">أكثر الخدمات دخلاً</div>
  <% if (!byService.length) { %>
    <div class="p-6 text-center text-slate-400 text-sm">لا توجد بنود فواتير.</div>
  <% } else { byService.forEach(function(s){ %>
  <div class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0">
    <div class="min-w-0 flex-1"><div class="font-bold text-slate-900 truncate"><%= s.name %></div><div class="text-xs text-slate-500"><%= s.n %> مرة</div></div>
    <div class="font-black text-slate-800"><%= money(s.revenue) %> <%= t('cur.egp') %></div>
  </div>
  <% }); } %>
</div>

</main></body></html>
