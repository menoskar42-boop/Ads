<%- include('head', { title: t('iv.receipt'), tab: 'invoices' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC); }
  function fmtDT(t){ if(!t) return '—'; try { return new Date(t).toLocaleString(LOC,{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  var MLABEL = { cash:t('pm.cash'), card:t('pm.card'), wallet:t('pm.wallet'), transfer:t('pm.transfer') };
  var amount = Math.abs(Number(pay.amount));
%>
<style>
  @media print {
    header, nav, .no-print { display: none !important; }
    body { background: #fff !important; }
    main { max-width: 100% !important; padding: 0 !important; }
  }
</style>

<div class="no-print flex items-center gap-3 mb-4 flex-wrap">
  <a href="/clinic/invoices/<%= inv.id %>" class="text-brand-600 text-sm">‹ <%= t('iv.back_invoice') %></a>
  <button onclick="window.print()" class="ms-auto bg-slate-100 hover:bg-slate-200 rounded-xl px-4 py-2 text-sm font-bold"><%= t('iv.print') %></button>
</div>

<div class="bg-white border border-slate-200 rounded-2xl p-6 max-w-md mx-auto">
  <div class="text-center mb-4">
    <div class="text-xl font-black text-slate-900"><%= company.company_name %></div>
    <div class="text-sm font-bold <%= isRefund ? 'text-red-600' : 'text-slate-500' %> mt-1">
      <%= isRefund ? t('iv.refund_receipt') : t('iv.receipt') %>
    </div>
  </div>

  <div class="text-3xl font-black text-center <%= isRefund ? 'text-red-600' : 'text-emerald-600' %> mb-4">
    <%= money(amount) %> <span class="text-base"><%= t('cur.egp') %></span>
  </div>

  <dl class="text-sm space-y-2">
    <div class="flex justify-between"><dt class="text-slate-500"><%= t('iv.one') %></dt><dd class="font-bold">#<%= inv.id %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500"><%= t('pf.title') %></dt><dd class="font-bold"><%= pay.patient_name || t('iv.no_patient') %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500"><%= t('iv.method') %></dt><dd class="font-bold"><%= MLABEL[pay.method] || pay.method %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500"><%= t('iv.when') %></dt><dd class="font-bold"><%= fmtDT(pay.created_at) %></dd></div>
    <div class="flex justify-between border-t border-slate-100 pt-2"><dt class="text-slate-500"><%= t('iv.grand_total') %></dt><dd><%= money(pay.total_amount) %> <%= t('cur.egp') %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500"><%= t('iv.paid') %></dt><dd><%= money(pay.paid_amount) %> <%= t('cur.egp') %></dd></div>
    <% var left = Math.max(0, Number(pay.total_amount) - Number(pay.paid_amount)); %>
    <% if (left > 0) { %>
      <div class="flex justify-between text-amber-700 font-bold"><dt><%= t('iv.due') %></dt><dd><%= money(left) %> <%= t('cur.egp') %></dd></div>
    <% } %>
  </dl>
</div>

</main></body></html>
