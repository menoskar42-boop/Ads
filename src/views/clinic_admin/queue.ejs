<%- include('head', { title: t('clinic.page.queue'), tab: 'queue' }) %>
<%
  function fmtTime(t){ if(!t) return '—'; try { return new Date(t).toLocaleTimeString(LOC,{hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  // From the dictionary, so the English page is English and a new status shows
  // up as a missing key in the checks rather than as blank text on a screen.
  function stLabel(st){ return t('q.st.' + st); }
  var STCLS = { waiting:'bg-amber-100 text-amber-700', in_room:'bg-blue-100 text-blue-700',
    done:'bg-emerald-100 text-emerald-700', no_show:'bg-red-100 text-red-700',
    cancelled:'bg-slate-100 text-slate-500' };
  var waiting = visits.filter(function(v){return v.status==='waiting';}).length;
  var inroom = visits.filter(function(v){return v.status==='in_room';}).length;
  var done = visits.filter(function(v){return v.status==='done';}).length;
%>

<div class="flex items-center justify-between gap-3 flex-wrap mb-1">
  <h1 class="text-2xl font-black text-slate-900"><%= t('q.title') %></h1>
  <form method="get" class="flex items-center gap-2">
    <input type="date" name="date" value="<%= date %>" class="border border-slate-200 rounded-xl px-3 py-1.5 text-sm" />
    <button class="bg-slate-100 hover:bg-slate-200 rounded-xl px-3 py-1.5 text-sm font-bold"><%= t('q.show') %></button>
  </form>
</div>
<p class="text-slate-500 mb-5"><%= t('q.sorted') %></p>

<div class="grid grid-cols-3 gap-3 mb-6">
  <div class="bg-white border border-slate-200 rounded-2xl p-4 text-center"><div class="text-2xl font-black text-amber-600"><%= waiting %></div><div class="text-xs text-slate-500 mt-1"><%= t('q.waiting') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4 text-center"><div class="text-2xl font-black text-blue-600"><%= inroom %></div><div class="text-xs text-slate-500 mt-1"><%= t('q.in_room') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4 text-center"><div class="text-2xl font-black text-emerald-600"><%= done %></div><div class="text-xs text-slate-500 mt-1"><%= t('q.done_today') %></div></div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-1">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('q.add') %></h2>
      <form method="post" action="/clinic/visits" class="grid gap-2.5">
        <label class="text-xs text-slate-500"><%= t('q.existing') %></label>
        <select name="patient_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('q.pick') %></option>
          <% patients.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %><%= p.phone?(' · '+p.phone):'' %></option><% }); %>
        </select>
        <div class="text-center text-xs text-slate-400"><%= t('q.or_new') %></div>
        <input name="patient_name" maxlength="80" placeholder="<%= t('q.new_name') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <input name="patient_phone" maxlength="20" placeholder="<%= t('q.mobile_opt') %>" dir="ltr" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <select name="doctor_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('q.doctor') %></option>
          <% doctors.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
        </select>
        <select name="visit_type_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('q.visit_type') %></option>
          <% visitTypes.forEach(function(vt){ %><option value="<%= vt.id %>"><%= vt.name %><%= Number(vt.price)?(' · '+vt.price+' '+t('cur.egp')):'' %></option><% }); %>
        </select>
        <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="is_urgent" value="1" /> <%= t('q.urgent_case') %></label>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('q.check_in') %></button>
      </form>
    </div>
  </div>

  <div class="lg:col-span-2">
    <% if (typeof err !== 'undefined' && err) { %>
      <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl px-4 py-3 text-sm mb-4"><%= t('q.err.' + err) %></div>
    <% } %>

    <% if (!visits.length) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-500"><%= t('q.empty') %> <%= date ? t('q.on_day') : t('q.on_today') %>.</div>
    <% } else { %>
      <%# Doctor by doctor: one flat list of twenty names cannot answer "who is
          next for Dr Ahmed", which is the only question this screen is asked. %>
      <% groups.forEach(function (g) { %>
        <div class="mb-5">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="font-extrabold text-slate-900">
              <%= g.doctor_name || t('q.no_doctor') %><% if (g.room) { %> <span class="text-sm font-bold text-slate-500">· <%= t('q.room') %> <%= g.room %></span><% } %>
            </h2>
            <span class="text-xs text-slate-500"><%= g.waiting %> <%= t('q.waiting') %><% if (g.inRoom) { %> · <%= g.inRoom %> <%= t('q.in_room') %><% } %></span>
          </div>

          <div class="space-y-2.5">
            <% g.visits.forEach(function (v, i) { var acts = actionsFor(v.status); %>
              <div class="bg-white border <%= v.is_urgent && v.status==='waiting' ? 'border-red-200' : 'border-slate-200' %> rounded-2xl p-4 flex items-center gap-3 flex-wrap">
                <div class="w-8 h-8 rounded-lg bg-slate-100 grid place-items-center text-sm font-black text-slate-500"><%= i+1 %></div>
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-slate-900 flex items-center gap-2">
                    <% if (v.patient_id) { %><a href="/clinic/patients/<%= v.patient_id %>" class="hover:text-brand-600"><%= v.patient_name || t('q.a_patient') %></a><% } else { %><%= v.patient_name || t('q.a_patient') %><% } %>
                    <% if (v.is_urgent) { %><span class="text-[10px] bg-red-100 text-red-600 rounded px-1.5 py-0.5 font-bold"><%= t('q.urgent') %></span><% } %>
                  </div>
                  <div class="text-xs text-slate-500">
                    <%= fmtTime(v.arrival_at) %><%= v.visit_type_name?(' · '+v.visit_type_name):'' %>
                    <%# A visit that closed because it was moved says so, from the
                        stored link — not from guessing at a note. %>
                    <% if (v.rescheduled_to) { %>
                      · <span class="text-brand-600 font-bold"><%= t('q.moved_to') %> <%= new Date(v.rescheduled_to).toLocaleString(LOC) %></span>
                    <% } %>
                  </div>
                </div>
                <span class="text-xs rounded-full px-2.5 py-1 font-bold <%= STCLS[v.status] %>"><%= stLabel(v.status) %></span>

                <div class="flex items-center gap-1.5 flex-wrap">
                  <% if (acts.indexOf('in_room') >= 0) { %>
                    <form method="post" action="/clinic/visits/<%= v.id %>/status" class="inline"><input type="hidden" name="status" value="in_room" /><button class="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg px-2.5 py-1.5 font-bold"><%= t('q.call_in') %></button></form>
                  <% } %>
                  <% if (acts.indexOf('done') >= 0) { %>
                    <form method="post" action="/clinic/visits/<%= v.id %>/status" class="inline"><input type="hidden" name="status" value="done" /><button class="text-xs bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-lg px-2.5 py-1.5 font-bold"><%= t('q.complete') %></button></form>
                  <% } %>
                  <% if (acts.indexOf('no_show') >= 0) { %>
                    <form method="post" action="/clinic/visits/<%= v.id %>/status" class="inline"><input type="hidden" name="status" value="no_show" /><button class="text-xs bg-red-50 text-red-700 hover:bg-red-100 rounded-lg px-2.5 py-1.5 font-bold"><%= t('q.no_show') %></button></form>
                  <% } %>
                  <% if (acts.indexOf('reschedule') >= 0) { %>
                    <form method="post" action="/clinic/visits/<%= v.id %>/reschedule" class="inline flex items-center gap-1">
                      <input type="datetime-local" name="when" required class="border border-slate-200 rounded-lg px-2 py-1 text-xs" />
                      <button class="text-xs bg-brand-50 text-brand-700 hover:bg-brand-100 rounded-lg px-2.5 py-1.5 font-bold"><%= t('q.reschedule') %></button>
                    </form>
                  <% } %>
                  <% if (acts.indexOf('cancelled') >= 0) { %>
                    <form method="post" action="/clinic/visits/<%= v.id %>/status" class="inline"><input type="hidden" name="status" value="cancelled" /><button class="text-xs text-slate-400 hover:text-red-600 px-2 py-1.5"><%= t('q.cancel') %></button></form>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

</main></body></html>
