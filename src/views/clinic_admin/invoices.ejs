<%- include('head', { title: t('iv.title'), tab: 'invoices' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC); }
  function fmtDate(t){ if(!t) return '—'; try { return new Date(t).toLocaleDateString(LOC,{month:'short',day:'numeric',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  var STLABEL = { pending:t('iv.st.pending'), partial:t('iv.st.partial'), paid:t('iv.st.paid'), cancelled:t('iv.st.cancelled') };
  var STCLS = { pending:'bg-amber-100 text-amber-700', partial:'bg-blue-100 text-blue-700', paid:'bg-emerald-100 text-emerald-700', cancelled:'bg-slate-100 text-slate-400' };
%>

<div class="flex items-center justify-between gap-3 flex-wrap mb-1">
  <h1 class="text-2xl font-black text-slate-900"><%= t('iv.title') %></h1>
  <a href="/clinic/finance" class="bg-slate-800 hover:bg-slate-900 text-white text-sm font-bold rounded-xl px-4 py-2"><%= t('iv.reports') %></a>
</div>
<p class="text-slate-500 mb-6"><%= t('iv.sub') %></p>

<!-- Finance summary -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500"><%= t('iv.today_collected') %></div><div class="text-xl font-black text-emerald-600 mt-1"><%= money(summary.today_collected) %> <%= t('cur.egp') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500"><%= t('iv.total_collected') %></div><div class="text-xl font-black text-slate-900 mt-1"><%= money(summary.collected) %> <%= t('cur.egp') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500"><%= t('iv.outstanding') %></div><div class="text-xl font-black text-amber-600 mt-1"><%= money(summary.outstanding) %> <%= t('cur.egp') %></div></div>
  <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-xs text-slate-500"><%= t('iv.open_count') %></div><div class="text-xl font-black text-slate-900 mt-1"><%= summary.open_count %></div></div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <!-- New invoice -->
  <div class="lg:col-span-1">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('iv.new') %></h2>
      <form method="post" action="/clinic/invoices" class="grid gap-2.5">
        <select name="patient_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('iv.pick_patient') %></option>
          <% patients.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %><%= p.phone?(' · '+p.phone):'' %></option><% }); %>
        </select>
        <% if (typeof doctors !== 'undefined' && doctors.length) { %>
        <select name="doctor_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('iv.pick_doctor') %></option>
          <% doctors.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
        </select>
        <% } %>
        <% if (services.length) { %>
        <div class="text-xs text-slate-500"><%= t('iv.pick_services') %></div>
        <div class="max-h-44 overflow-y-auto border border-slate-100 rounded-xl p-2 space-y-1">
          <% services.forEach(function(s){ %>
          <label class="flex items-center gap-2 text-sm text-slate-700 py-0.5"><input type="checkbox" name="service_id" value="<%= s.id %>" /> <span class="flex-1"><%= s.name %></span><span class="text-slate-400 text-xs"><%= money(s.price) %> <%= t('cur.egp') %></span></label>
          <% }); %>
        </div>
        <% } else { %>
        <div class="text-xs text-slate-400 bg-slate-50 rounded-xl p-2 text-center"><%= t('iv.no_services') %></div>
        <% } %>
        <div class="flex gap-2">
          <input name="manual_name" maxlength="120" placeholder="<%= t('iv.manual_item') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm flex-1" />
          <input name="manual_price" type="number" step="0.01" min="0" placeholder="<%= t('iv.manual_price') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm w-24" />
        </div>
        <input name="discount_amount" type="number" step="0.01" min="0" placeholder="<%= t('iv.discount') %> (<%= t('cur.egp') %>)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('iv.create') %></button>
      </form>
    </div>
  </div>

  <!-- Invoice list -->
  <div class="lg:col-span-2">
    <div class="flex gap-1.5 mb-3 text-sm flex-wrap">
      <a href="/clinic/invoices" class="px-3 py-1.5 rounded-lg <%= !status?'bg-brand-500 text-white':'bg-white border border-slate-200' %>"><%= t('iv.all') %></a>
      <a href="/clinic/invoices?status=pending" class="px-3 py-1.5 rounded-lg <%= status==='pending'?'bg-brand-500 text-white':'bg-white border border-slate-200' %>"><%= t('iv.f.pending') %></a>
      <a href="/clinic/invoices?status=partial" class="px-3 py-1.5 rounded-lg <%= status==='partial'?'bg-brand-500 text-white':'bg-white border border-slate-200' %>"><%= t('iv.f.partial') %></a>
      <a href="/clinic/invoices?status=paid" class="px-3 py-1.5 rounded-lg <%= status==='paid'?'bg-brand-500 text-white':'bg-white border border-slate-200' %>"><%= t('iv.f.paid') %></a>
    </div>
    <% if (!invoices.length) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-sm"><%= t('iv.empty') %></div>
    <% } else { %>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <% invoices.forEach(function(inv){ %>
      <a href="/clinic/invoices/<%= inv.id %>" class="flex items-center gap-3 p-4 border-b border-slate-100 last:border-0 hover:bg-brand-50/40">
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900 truncate"><%= inv.patient_name || t('iv.no_patient') %> <span class="text-xs text-slate-400">#<%= inv.id %></span></div>
          <div class="text-xs text-slate-500"><%= fmtDate(inv.created_at) %> · <%= money(inv.total_amount) %> <%= t('cur.egp') %><% if(Number(inv.paid_amount)>0 && inv.status!=='paid'){ %> · <%= t('iv.paid_of') %> <%= money(inv.paid_amount) %><% } %></div>
        </div>
        <span class="text-xs rounded-full px-2.5 py-1 font-bold <%= STCLS[inv.status] %>"><%= STLABEL[inv.status] %></span>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
