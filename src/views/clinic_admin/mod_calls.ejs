<%- include('head', { title: 'مركز الاتصال', tab: 'callcenter' }) %>
<%
  function fmtDT(t){ try { return new Date(t).toLocaleString('ar-EG',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  function fmtDate(t){ if(!t) return ''; try { return new Date(t).toLocaleDateString('ar-EG',{month:'short',day:'numeric',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
%>

<h1 class="text-2xl font-black text-slate-900 mb-1">مركز الاتصال</h1>
<p class="text-slate-500 mb-6">سجل المكالمات والمتابعات مع المرضى</p>

<% if (followups.length) { %>
<div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 mb-5">
  <div class="font-bold text-blue-800 text-sm mb-2">📌 متابعات قادمة</div>
  <div class="space-y-1">
    <% followups.forEach(function(f){ %>
    <div class="text-sm text-blue-700"><%= fmtDate(f.follow_up_at) %> — <%= f.patient_name||f.phone||'—' %><%= f.purpose?(' · '+f.purpose):'' %></div>
    <% }); %>
  </div>
</div>
<% } %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-1">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 lg:sticky lg:top-4">
      <h2 class="font-extrabold text-slate-900 mb-3">تسجيل مكالمة</h2>
      <form method="post" action="/clinic/calls" class="grid gap-2.5">
        <select name="patient_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white"><option value="">مريض (اختياري)</option><% patients.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }); %></select>
        <input name="phone" maxlength="30" placeholder="رقم الهاتف" dir="ltr" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <select name="direction" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white"><option value="out">صادرة</option><option value="in">واردة</option></select>
        <input name="purpose" maxlength="120" placeholder="سبب المكالمة (تذكير موعد…)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <input name="outcome" maxlength="120" placeholder="النتيجة" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <label class="text-xs text-slate-500">متابعة في</label>
        <input name="follow_up_at" type="date" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <textarea name="note" rows="2" maxlength="500" placeholder="ملاحظات" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"></textarea>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm">حفظ</button>
      </form>
    </div>
  </div>

  <div class="lg:col-span-2">
    <% if (!calls.length) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-sm">مفيش مكالمات مسجّلة.</div>
    <% } else { %>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
      <% calls.forEach(function(c){ %>
      <div class="flex items-start gap-3 p-4 border-b border-slate-100 last:border-0">
        <div class="w-8 h-8 rounded-lg <%= c.direction==='in'?'bg-emerald-50 text-emerald-600':'bg-blue-50 text-blue-600' %> grid place-items-center text-sm"><%= c.direction==='in'?'↙':'↗' %></div>
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900 text-sm"><%= c.patient_name||c.phone||'—' %> <span class="text-xs text-slate-400"><%= fmtDT(c.created_at) %></span></div>
          <div class="text-xs text-slate-500"><%= c.purpose||'' %><%= c.outcome?(' · '+c.outcome):'' %><%= c.follow_up_at?(' · متابعة '+fmtDate(c.follow_up_at)):'' %></div>
          <% if (c.note) { %><div class="text-xs text-slate-400 mt-0.5"><%= c.note %></div><% } %>
        </div>
        <form method="post" action="/clinic/calls/<%= c.id %>/delete"><button class="text-slate-300 hover:text-red-600 text-sm">حذف</button></form>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

</main></body></html>
