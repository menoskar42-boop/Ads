<%- include('head', { title: t('pf.title') + ' ' + patient.name, tab: 'patients' }) %>
<%
  function fmtDate(t){ if(!t) return '—'; try { return new Date(t).toLocaleDateString(LOC,{year:'numeric',month:'short',day:'numeric',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  function fmtDT(t){ if(!t) return '—'; try { return new Date(t).toLocaleString(LOC,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Africa/Cairo'}); } catch(e){ return ''; } }
  var STLABEL = { waiting:t('pf.st.waiting'), in_room:t('pf.st.in_room'), done:t('pf.st.done'), cancelled:t('pf.st.cancelled') };
  // Gender is stored in Arabic; map it at display time rather than migrating
  // rows, so an English clinic reads "Male" without touching patient records.
  var GENDER = { 'ذكر': t('pt.male'), 'أنثى': t('pt.female') };
%>

<div class="flex items-center gap-3 mb-1 flex-wrap">
  <a href="/clinic/patients" class="text-brand-600 text-sm">‹ <%= t('pf.back') %></a>
  <h1 class="text-2xl font-black text-slate-900"><%= patient.name %></h1>
</div>
<p class="text-slate-500 mb-6 text-sm">
  <span dir="ltr"><%= patient.phone || '' %></span><%= patient.gender?(' · ' + (GENDER[patient.gender] || patient.gender)):'' %><%= patient.birth_year?(' · ' + t('pf.born') + ' ' + patient.birth_year):'' %>
</p>

<div class="grid gap-6 lg:grid-cols-3">
  <!-- Left: forms -->
  <div class="lg:col-span-1 space-y-4">
    <!-- Vitals -->
    <a href="/clinic/patients/<%= patient.id %>/trends"
       class="block bg-gradient-to-l from-cyan-50 to-teal-50 border border-cyan-200 rounded-2xl p-4 hover:shadow transition">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📊</span>
        <div class="flex-1">
          <div class="font-bold text-slate-800"><%= t('pf.trends') %></div>
          <div class="text-xs text-slate-500"><%= t('pf.trends_sub') %></div>
        </div>
        <span class="text-cyan-600">←</span>
      </div>
    </a>

    <a href="/clinic/patients/<%= patient.id %>/vaccines"
       class="block bg-gradient-to-l from-violet-50 to-purple-50 border border-violet-200 rounded-2xl p-4 hover:shadow transition">
      <div class="flex items-center gap-3">
        <span class="text-2xl">💉</span>
        <div class="flex-1">
          <div class="font-bold text-slate-800"><%= t('pf.vax') %></div>
          <div class="text-xs text-slate-500"><%= t('pf.vax_sub') %></div>
        </div>
        <span class="text-violet-600">←</span>
      </div>
    </a>

    <div id="vitals" class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.vitals') %></h2>
      <%
        // Fields follow the clinic's specialty: a dentist is not asked for SpO2
        // and a chest clinic is not missing it. Unknown/blank specialty falls
        // back to the full set, so nothing is lost for clinics that have not
        // chosen one yet.
        var VSTEP = { temperature: '0.1', weight: '0.1', height: '0.1' };
      %>
      <form method="post" action="/clinic/patients/<%= patient.id %>/vitals" class="grid grid-cols-2 gap-2">
        <% (specVitals || []).forEach(function(k){ %>
          <% // Unescaped output: escaping the quotes turns the step attribute into
             // an invalid value, and the browser then silently rejects 37.2 °C. %>
          <input name="<%= k %>" type="number" <%- VSTEP[k] ? 'step="' + VSTEP[k] + '"' : '' %>
                 placeholder="<%= vitalsLabels[k] %>"
                 class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        <% }); %>

        <% (specExtra || []).forEach(function(f){ %>
          <div class="col-span-2">
            <label class="block text-xs font-semibold text-slate-600 mb-1"><%= f.label %></label>
            <% if (f.type === 'scale') { %>
              <select name="sx_<%= f.key %>" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm">
                <option value="">—</option>
                <% for (var i = 1; i <= 10; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
              </select>
            <% } else { %>
              <input name="sx_<%= f.key %>"
                     type="<%= f.type === 'num' ? 'number' : (f.type === 'date' ? 'date' : 'text') %>"
                     <%- f.type === 'num' ? 'step="any"' : '' %>
                     class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
            <% } %>
          </div>
        <% }); %>

        <% if (!(specVitals || []).length && !(specExtra || []).length) { %>
          <p class="col-span-2 text-xs text-slate-400">
            <%= t('pf.no_vitals_spec') %>
          </p>
        <% } %>

        <textarea name="notes" rows="2" maxlength="500" placeholder="<%= t('pf.vitals_note') %>"
                  class="col-span-2 border border-slate-200 rounded-xl px-3 py-2 text-sm"></textarea>
        <button class="col-span-2 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('pf.save_vitals') %></button>
      </form>
      <% if (specialtyLabel) { %>
        <p class="text-xs text-slate-400 mt-2"><%= t('pf.fields_by_spec') %> <strong><%= specialtyLabel %></strong></p>
      <% } %>
    </div>

    <!-- Clinical note -->
    <div id="notes" class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.note') %></h2>
      <form method="post" action="/clinic/patients/<%= patient.id %>/notes" class="grid gap-2">
        <select name="category" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value="general"><%= t('pf.cat.general') %></option><option value="complaint"><%= t('pf.cat.complaint') %></option>
          <option value="exam"><%= t('pf.cat.exam') %></option><option value="diagnosis"><%= t('pf.cat.diagnosis') %></option><option value="plan"><%= t('pf.cat.plan') %></option>
        </select>
        <select name="doctor_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('hv.doctor') %></option>
          <% doctors.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
        </select>
        <textarea name="content" rows="3" required maxlength="5000" placeholder="<%= t('pf.write_note') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"></textarea>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('pf.save_note') %></button>
      </form>
    </div>

    <!-- Prescription -->
    <div id="prescriptions" class="bg-white border border-slate-200 rounded-2xl p-5">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.rx') %></h2>
      <form method="post" action="/clinic/patients/<%= patient.id %>/prescriptions" class="grid gap-2">
        <select name="doctor_id" class="border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('hv.doctor') %></option>
          <% doctors.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
        </select>
        <div id="rx-rows" class="grid gap-2">
          <div class="grid grid-cols-2 gap-2">
            <div class="col-span-2 relative">
              <input name="med_name" placeholder="<%= t('pf.med_name') %>" autocomplete="off"
                     oninput="medLookup(this)" onblur="medHide(this)"
                     class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
              <div class="med-sug hidden absolute z-20 top-full mt-1 w-full bg-white border border-slate-200 rounded-xl shadow-lg max-h-56 overflow-y-auto"></div>
            </div>
            <input name="med_dose" placeholder="<%= t('pf.med_dose') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
            <input name="med_freq" placeholder="<%= t('pf.med_freq') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
            <input name="med_duration" placeholder="<%= t('pf.med_duration') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm col-span-2" />
          </div>
        </div>
        <button type="button" onclick="addRxRow()" class="text-xs text-brand-600 font-bold text-start"><%= t('pf.add_med') %></button>
        <textarea name="notes" rows="2" maxlength="1000" placeholder="<%= t('pf.rx_notes') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"></textarea>
        <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('pf.save_rx') %></button>
      </form>
    </div>
  </div>

  <!-- Right: history -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Visits -->
    <section id="visits">
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.visits') %> (<%= visits.length %>)</h2>
      <% if (!visits.length) { %>
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center text-slate-400 text-sm"><%= t('pf.no_visits') %></div>
      <% } else { %>
      <div class="space-y-2.5">
        <% visits.forEach(function(v){ %>
        <div class="bg-white border border-slate-200 rounded-2xl p-4">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="font-bold text-slate-800 text-sm"><%= fmtDate(v.visit_date) %><%= v.doctor_name?(' · '+v.doctor_name):'' %><%= v.visit_type_name?(' · '+v.visit_type_name):'' %></div>
            <span class="text-xs text-slate-400"><%= STLABEL[v.status] %></span>
          </div>
          <% if (v.diagnosis) { %><div class="text-sm text-slate-600 mt-1"><span class="text-slate-400"><%= t('pf.diagnosis') %></span> <%= v.diagnosis %></div><% } %>
          <% if (v.notes) { %><div class="text-sm text-slate-600 mt-0.5"><%= v.notes %></div><% } %>
          <details class="mt-2"><summary class="text-xs text-brand-600 cursor-pointer"><%= t('pf.edit_diagnosis') %></summary>
            <form method="post" action="/clinic/visits/<%= v.id %>/diagnosis" class="grid gap-2 mt-2">
              <input type="hidden" name="patient_id" value="<%= patient.id %>" />
              <input name="diagnosis" value="<%= v.diagnosis||'' %>" placeholder="<%= t('pf.ph_diagnosis') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />
              <textarea name="notes" rows="2" placeholder="<%= t('pf.visit_notes') %>" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"><%= v.notes||'' %></textarea>
              <button class="bg-slate-800 text-white font-bold rounded-xl px-4 py-1.5 text-sm w-fit"><%= t('common.save') %></button>
            </form>
          </details>
        </div>
        <% }); %>
      </div>
      <% } %>
    </section>

    <!-- Vitals history -->
    <% if (vitals.length) { %>
    <section>
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.vitals_log') %></h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-x-auto">
        <table class="w-full text-sm text-start min-w-[520px]">
          <thead class="text-xs text-slate-400 border-b border-slate-100"><tr>
            <th class="p-3 font-medium"><%= t('pf.c.date') %></th><th class="p-3 font-medium"><%= t('pf.c.bp') %></th><th class="p-3 font-medium"><%= t('pf.c.hr') %></th>
            <th class="p-3 font-medium"><%= t('pf.c.temp') %></th><th class="p-3 font-medium"><%= t('pf.c.weight') %></th><th class="p-3 font-medium">SpO₂</th>
          </tr></thead>
          <tbody>
            <% vitals.forEach(function(x){ %>
            <tr class="border-b border-slate-50 last:border-0">
              <td class="p-3 text-slate-500 text-xs"><%= fmtDT(x.recorded_at) %></td>
              <td class="p-3"><%= (x.systolic&&x.diastolic)?(x.systolic+'/'+x.diastolic):'—' %></td>
              <td class="p-3"><%= x.heart_rate||'—' %></td>
              <td class="p-3"><%= x.temperature||'—' %></td>
              <td class="p-3"><%= x.weight||'—' %></td>
              <td class="p-3"><%= x.spo2||'—' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
    <% } %>

    <!-- Notes history -->
    <% if (notes.length) { %>
    <section>
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.notes_log') %></h2>
      <div class="space-y-2">
        <% notes.forEach(function(n){ %>
        <div class="bg-white border border-slate-200 rounded-2xl p-4">
          <div class="text-xs text-slate-400 mb-1"><%= fmtDT(n.created_at) %><%= n.doctor_name?(' · '+n.doctor_name):'' %><%= n.category&&n.category!=='general'?(' · '+t('pf.cat.'+n.category)):'' %></div>
          <% if (n.title) { %><div class="font-bold text-slate-800 text-sm"><%= n.title %></div><% } %>
          <div class="text-sm text-slate-600 whitespace-pre-line"><%= n.content %></div>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Prescriptions history -->
    <% if (prescriptions.length) { %>
    <section>
      <h2 class="font-extrabold text-slate-900 mb-3"><%= t('pf.rx_log') %></h2>
      <div class="space-y-2">
        <% prescriptions.forEach(function(r){ %>
        <div class="bg-white border border-slate-200 rounded-2xl p-4">
          <div class="text-xs text-slate-400 mb-2"><%= fmtDT(r.created_at) %><%= r.doctor_name?(' · '+r.doctor_name):'' %></div>
          <ul class="text-sm text-slate-700 space-y-1">
            <% r.meds.forEach(function(m){ %>
            <li class="flex gap-2"><span class="text-brand-500">•</span><span><strong><%= m.name %></strong><%= m.dose?(' — '+m.dose):'' %><%= m.freq?(' · '+m.freq):'' %><%= m.duration?(' · '+m.duration):'' %></span></li>
            <% }); %>
          </ul>
          <% if (r.notes) { %><div class="text-xs text-slate-500 mt-2"><%= r.notes %></div><% } %>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>
  </div>
</div>

<script>
var L = <%- JSON.stringify({
  medName:     t('pf.med_name'),
  medDose:     t('pf.med_dose'),
  medFreq:     t('pf.med_freq'),
  medDuration: t('pf.med_duration'),
}) %>;
var MED_EN_FIRST = <%- JSON.stringify(lang === 'en') %>;
function medName(m){
  // An English clinic reads the English trade name first; either way the other
  // name is the fallback, so a drug that only has one is never blank.
  return MED_EN_FIRST ? (m.name_en || m.name_ar) : (m.name_ar || m.name_en);
}
function addRxRow(){
  var wrap = document.getElementById('rx-rows');
  var div = document.createElement('div');
  div.className = 'grid grid-cols-2 gap-2 border-t border-slate-100 pt-2';
  div.innerHTML = '<div class="col-span-2 relative">'
    +   '<input name="med_name" placeholder="' + L.medName + '" autocomplete="off"'
    +   ' oninput="medLookup(this)" onblur="medHide(this)"'
    +   ' class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />'
    +   '<div class="med-sug hidden absolute z-20 top-full mt-1 w-full bg-white border border-slate-200 rounded-xl shadow-lg max-h-56 overflow-y-auto"></div>'
    + '</div>'
    + '<input name="med_dose" placeholder="' + L.medDose + '" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />'
    + '<input name="med_freq" placeholder="' + L.medFreq + '" class="border border-slate-200 rounded-xl px-3 py-2 text-sm" />'
    + '<input name="med_duration" placeholder="' + L.medDuration + '" class="border border-slate-200 rounded-xl px-3 py-2 text-sm col-span-2" />';
  wrap.appendChild(div);
}

/* Medicine lookup against the shared Egyptian catalogue.
   Deliberately non-blocking: the field stays a normal text input, so a drug
   that is not in the catalogue can still be written by hand. Suggestions
   assist, they never gate. */
var medTimer = null, medSeq = 0;
function medBox(input){ return input.parentNode.querySelector('.med-sug'); }
function medHide(input){ setTimeout(function(){ medBox(input).classList.add('hidden'); }, 150); }

function medLookup(input){
  var box = medBox(input);
  var q = input.value.trim();
  clearTimeout(medTimer);
  if (q.length < 2) { box.classList.add('hidden'); return; }
  // Debounced so typing a drug name is one request, not one per keystroke.
  medTimer = setTimeout(function(){
    var seq = ++medSeq;
    fetch('/clinic/api/medicines?q=' + encodeURIComponent(q))
      .then(function(r){ return r.json(); })
      .then(function(rows){
        if (seq !== medSeq) return;            // a newer query already answered
        if (!rows.length) { box.classList.add('hidden'); return; }
        box.innerHTML = '';
        rows.forEach(function(m){
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'w-full text-start px-3 py-2 text-sm hover:bg-slate-50 border-b border-slate-50 last:border-0';
          var sub = [m.form, m.manufacturer].filter(Boolean).join(' · ');
          b.innerHTML = '<div class="font-semibold text-slate-800">' + medName(m) + '</div>'
            + (sub ? '<div class="text-xs text-slate-400">' + sub + '</div>' : '');
          b.onclick = function(){
            input.value = medName(m);
            box.classList.add('hidden');
            var dose = input.parentNode.parentNode.querySelector('[name=med_dose]');
            if (dose) dose.focus();
          };
          box.appendChild(b);
        });
        box.classList.remove('hidden');
      })
      .catch(function(){ box.classList.add('hidden'); });
  }, 220);
}
</script>

</main></body></html>
