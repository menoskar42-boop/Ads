<%- include('head', { title: t('cs.title'), tab: 'settings' }) %>

<h1 class="text-2xl font-black text-slate-900 mb-1"><%= t('cs.title') %></h1>
<p class="text-slate-500 mb-6"><%= t('cs.sub') %></p>

<% if (typeof s !== 'undefined' && s && s._saved) { %><% } %>
<% var __saved = false; try { __saved = (typeof s !== 'undefined'); } catch(e){} %>

<div class="max-w-2xl">
  <div class="bg-white border border-slate-200 rounded-2xl p-6">
    <form method="post" action="/clinic/settings" class="grid gap-3">
      <label class="text-sm font-bold text-slate-700"><%= t('cs.specialty') %>
        <select name="specialty" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value=""><%= t('cs.pick_specialty') %></option>
          <% if (customSpecialty) { %>
            <option value="<%= customSpecialty %>" selected><%= customSpecialty %> <%= t('cs.saved_now') %></option>
          <% } %>
          <% specialties.forEach(function(sp){ %>
            <option value="<%= sp.key %>" <%= s.specialty === sp.key ? 'selected' : '' %>><%= sp.label %></option>
          <% }); %>
        </select>
        <span class="block text-xs font-normal text-slate-400 mt-1">
          <%= t('cs.specialty_hint') %>
        </span>
      </label>
      <label class="text-sm font-bold text-slate-700"><%= t('cs.about') %>
        <textarea name="about" maxlength="2000" rows="3" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm"><%= s.about||'' %></textarea>
      </label>
      <label class="text-sm font-bold text-slate-700"><%= t('cs.address') %>
        <input name="address" maxlength="200" value="<%= s.address||'' %>" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="text-sm font-bold text-slate-700"><%= t('cs.phone') %>
          <input name="phone" maxlength="30" value="<%= s.phone||'' %>" dir="ltr" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        </label>
        <label class="text-sm font-bold text-slate-700"><%= t('cs.whatsapp') %>
          <input name="whatsapp" maxlength="30" value="<%= s.whatsapp||'' %>" dir="ltr" placeholder="201xxxxxxxxx" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        </label>
      </div>
      <label class="text-sm font-bold text-slate-700"><%= t('cs.hours') %>
        <input name="hours" maxlength="200" value="<%= s.hours||'' %>" placeholder="<%= t('cs.hours_ph') %>" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-700 mt-1"><input type="checkbox" name="booking_enabled" value="1" <%= s.booking_enabled!==false ? 'checked' : '' %> /> <%= t('cs.booking') %></label>
      <button class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl px-5 py-2.5 mt-2"><%= t('cs.save') %></button>
    </form>
  </div>
</div>

</main></body></html>
