<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG',{maximumFractionDigits:2}); }
%>
<div class="flex items-center gap-3 flex-wrap mb-4">
  <div>
    <h1 class="font-black text-xl">المستحق قريّب</h1>
    <p class="text-slate-500 text-sm mt-0.5">
      الأقساط اللي لسه مافاتش ميعادها. تذكير قبل الميعاد بيوصّل الفلوس؛ تذكير بعده بيبقى مطاردة.
    </p>
  </div>
  <form class="ms-auto text-sm">
    <select name="days" onchange="this.form.submit()" class="border border-teal-200 rounded-xl px-3 py-2">
      <% [3,7,14,30].forEach(function(n){ %>
        <option value="<%= n %>" <%= days===n?'selected':'' %>>خلال <%= n %> يوم</option>
      <% }) %>
    </select>
  </form>
</div>

<% if (!list.length) { %>
  <div class="bg-white rounded-2xl border border-teal-100 p-8 text-center text-slate-400 text-sm">
    مفيش أقساط مستحقة في المدة دي.
  </div>
<% } else { %>
  <div class="bg-white rounded-2xl border border-teal-100 p-4 mb-4">
    <span class="text-xs text-slate-500 font-bold">المتوقّع خلال <%= days %> يوم</span>
    <span class="text-2xl font-black text-brand-800 ms-2"><bdi><%= money(total) %></bdi></span>
  </div>

  <table class="rt w-full bg-white rounded-2xl border border-teal-100 text-sm overflow-hidden">
    <thead class="bg-teal-50 text-brand-800 text-xs">
      <tr>
        <th class="text-start p-3">الميعاد</th>
        <th class="text-start p-3">العميل</th>
        <th class="text-start p-3">القسط</th>
        <th class="text-start p-3">المبلغ</th>
        <th class="text-start p-3">تحصيل</th>
      </tr>
    </thead>
    <tbody>
      <% list.forEach(function(x){ %>
        <tr class="border-t border-teal-50">
          <td class="p-3 font-bold" data-l="الميعاد"><%= P.dateLabel(x.r.due_on) %></td>
          <td class="p-3" data-l="العميل">
            <a href="/qastly/plans/<%= x.p.id %>" class="font-bold text-brand-800"><%= x.p.customer_name %></a>
            <% if (x.p.item) { %><span class="text-xs text-slate-400 block"><%= x.p.item %></span><% } %>
          </td>
          <td class="p-3 text-slate-600" data-l="القسط"><%= x.r.seq %> من <%= x.p.count %></td>
          <td class="p-3" data-l="المبلغ"><b><bdi><%= money(x.r.remaining) %></bdi></b></td>
          <td class="p-3" data-l="تحصيل">
            <form method="post" action="/qastly/plans/<%= x.p.id %>/pay" class="flex gap-1">
              <input type="hidden" name="back" value="/qastly/due?days=<%= days %>" />
              <input name="amount" type="number" min="0" step="0.01" dir="ltr" value="<%= x.r.remaining %>"
                class="w-24 border border-teal-200 rounded-lg px-2 py-1.5 text-xs" />
              <button class="bg-emerald-600 text-white text-xs font-bold rounded-lg px-3">دفع</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('foot') %>
