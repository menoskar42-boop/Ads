<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG',{maximumFractionDigits:2}); }
%>
<div class="mb-5">
  <h1 class="font-black text-xl">المتأخرين</h1>
  <p class="text-slate-500 text-sm mt-1">
    كل عميل فات عليه ميعاد قسط، والرسالة مكتوبة له جاهزة ومعاها لينك كشف حسابه —
    إنت بتراجع وتبعت من واتسابك.
  </p>
</div>

<% if (!list.length) { %>
  <div class="bg-white rounded-2xl border border-teal-100 p-8 text-center text-slate-500 text-sm">
    <div class="text-3xl mb-2">👏</div>
    محدش فات عليه ميعاد.
  </div>
<% } else { %>
  <div class="bg-rose-800 text-white rounded-2xl p-5 mb-5">
    <div class="text-xs font-bold text-rose-200">إجمالي المتأخر عند <%= list.length %> عميل</div>
    <div class="text-3xl font-black mt-1"><bdi><%= money(total) %></bdi> <span class="text-base text-rose-200">جنيه</span></div>
  </div>

  <div class="space-y-3">
    <% list.forEach(function(p){ %>
      <div class="bg-white rounded-2xl border border-teal-100 p-5">
        <div class="flex items-start gap-3 flex-wrap">
          <div>
            <a href="/qastly/plans/<%= p.id %>" class="font-black text-brand-800"><%= p.customer_name %></a>
            <div class="text-xs text-slate-500 mt-0.5">
              <%= P.planCode(p.id) %><% if (p.item) { %> · <%= p.item %><% } %>
              <% if (p.customer_phone) { %> · <span dir="ltr"><%= p.customer_phone %></span><% } %>
            </div>
          </div>
          <div class="ms-auto text-end">
            <div class="font-black text-rose-600 text-lg"><bdi><%= money(p.a.lateAmount) %></bdi></div>
            <div class="text-xs text-rose-500"><%= p.a.lateCount %> قسط متأخر</div>
          </div>
        </div>

        <div class="text-xs text-slate-500 mt-2">
          إجمالي المتبقّي <bdi><%= money(p.a.remaining) %></bdi> من <bdi><%= money(p.total) %></bdi>
          <% if (p.guarantor_name) { %> · الضامن: <%= p.guarantor_name %><% } %>
        </div>

        <details class="mt-3">
          <summary class="text-xs font-bold text-brand-700 cursor-pointer">اقرا الرسالة قبل ما تبعتها</summary>
          <pre class="bg-teal-50 rounded-xl p-3 text-xs whitespace-pre-wrap leading-relaxed mt-2"><%= p.msg %></pre>
        </details>

        <div class="flex flex-wrap gap-2 mt-3">
          <% if (p.wa) { %>
            <a href="<%= p.wa %>" target="_blank" rel="noopener"
              class="bg-emerald-500 text-white font-bold rounded-xl px-5 py-2.5 text-sm">افتح واتساب</a>
          <% } else { %>
            <span class="text-xs text-slate-400 self-center">مفيش رقم — ضيفه من ملف العميل.</span>
          <% } %>
          <form method="post" action="/qastly/plans/<%= p.id %>/reminded">
            <input type="hidden" name="amount" value="<%= p.a.lateAmount %>" />
            <input type="hidden" name="body" value="<%= p.msg %>" />
            <input type="hidden" name="back" value="/qastly/late" />
            <button class="bg-brand-100 text-brand-800 font-bold rounded-xl px-5 py-2.5 text-sm">سجّل إني بعتّها</button>
          </form>
          <form method="post" action="/qastly/plans/<%= p.id %>/pay" class="flex gap-1">
            <input type="hidden" name="back" value="/qastly/late" />
            <input name="amount" type="number" min="0" step="0.01" dir="ltr" value="<%= p.a.lateAmount %>"
              class="w-28 border border-teal-200 rounded-xl px-3 text-sm" />
            <button class="bg-emerald-600 text-white font-bold rounded-xl px-4 py-2.5 text-sm">دفع</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('foot') %>
