<%- include('head') %>
<h1 class="font-black text-xl mb-4">الإعدادات</h1>
<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-2.5 text-sm font-bold mb-4">تم الحفظ ✓</div><% } %>
<form method="post" action="/qastly/settings" class="space-y-5">
  <section class="bg-white rounded-2xl border border-teal-100 p-5">
    <h2 class="font-black mb-3">بيانات المحل</h2>
    <p class="text-xs text-slate-500 mb-3">
      الاسم ده بيظهر آخر كل رسالة تذكير وفي كشف حساب العميل.
    </p>
    <div class="grid sm:grid-cols-2 gap-3 text-sm">
      <input name="business_name" value="<%= settings.business_name || '' %>" placeholder="اسم المحل" class="border border-teal-100 rounded-xl px-3 py-2" />
      <input name="activity" value="<%= settings.activity || '' %>" placeholder="بتبيع إيه؟ (أجهزة، موبايلات، موبيليا…)" class="border border-teal-100 rounded-xl px-3 py-2" />
      <input name="phone" dir="ltr" value="<%= settings.phone || '' %>" placeholder="التليفون" class="border border-teal-100 rounded-xl px-3 py-2" />
      <input name="whatsapp" dir="ltr" value="<%= settings.whatsapp || '' %>" placeholder="واتساب" class="border border-teal-100 rounded-xl px-3 py-2" />
      <input name="address" value="<%= settings.address || '' %>" placeholder="العنوان" class="sm:col-span-2 border border-teal-100 rounded-xl px-3 py-2" />
      <textarea name="about" rows="3" placeholder="نبذة — بتظهر في صفحتك على الإنترنت" class="sm:col-span-2 border border-teal-100 rounded-xl px-3 py-2"><%= settings.about || '' %></textarea>
      <input name="map_url" dir="ltr" value="<%= settings.map_url || '' %>" placeholder="رابط الخريطة" class="sm:col-span-2 border border-teal-100 rounded-xl px-3 py-2" />
    </div>
  </section>

  <section class="bg-white rounded-2xl border border-teal-100 p-5">
    <h2 class="font-black mb-1">التذكير</h2>
    <p class="text-xs text-slate-500 mb-3">
      تذكير قبل الميعاد بيوصّل الفلوس. تذكير بعده بيبقى مطاردة.
    </p>
    <div class="grid sm:grid-cols-2 gap-3 text-sm">
      <label class="block"><span class="text-xs font-bold text-slate-500">يظهر في «المستحق» قبل الميعاد بكام يوم</span>
        <input name="remind_before" type="number" min="0" max="30" dir="ltr" value="<%= Number(settings.remind_before || 2) %>" class="w-full border border-teal-100 rounded-xl px-3 py-2 mt-1" /></label>
      <label class="block"><span class="text-xs font-bold text-slate-500">فترة سماح بعد الميعاد (يوم)</span>
        <input name="grace_days" type="number" min="0" max="30" dir="ltr" value="<%= Number(settings.grace_days || 0) %>" class="w-full border border-teal-100 rounded-xl px-3 py-2 mt-1" /></label>
    </div>
  </section>

  <section class="bg-white rounded-2xl border border-teal-100 p-5">
    <h2 class="font-black mb-3">الأقسام</h2>
    <div class="grid sm:grid-cols-2 gap-2 text-sm">
      <% FLAGS.forEach(function(f){ %>
        <label class="flex items-start gap-3 p-3 rounded-xl border border-teal-50 <%= f.core?'bg-teal-50/40':'' %>">
          <input type="checkbox" name="flags" value="<%= f.key %>" class="mt-1" <%= flags.has(f.key)?'checked':'' %> <%= f.core?'disabled checked':'' %> />
          <span><span class="font-bold"><%= f.icon %> <%= f.label %></span>
            <span class="block text-xs text-slate-500 mt-0.5"><%= f.desc %></span>
            <% if (f.core) { %><span class="block text-[10px] text-slate-400 mt-0.5">أساسي — مش بيتقفل</span><% } %></span>
        </label>
      <% }) %>
    </div>
  </section>
  <button class="bg-brand-700 text-white font-bold rounded-xl px-8 py-3">حفظ</button>
</form>
<%- include('foot') %>
