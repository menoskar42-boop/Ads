<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('food.opt.title') %> — <%= item.name_ar || item.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  .fld { border:1px solid #d1d5db; border-radius:8px; padding:6px 8px; font-size:.85rem; background:#fff; width:100%; }
  .lbl { font-size:.7rem; color:#6b7280; margin-bottom:2px; display:block; }
</style>
</head>
<body class="bg-gray-50 text-gray-900">
<%- include('nav', { active: 'menu' }) %>

<main class="max-w-3xl mx-auto px-4 py-6 space-y-5">
  <div>
    <h1 class="text-xl font-extrabold mb-1"><%= t('food.opt.title') %> — <%= item.name_ar || item.name %></h1>
    <p class="text-sm text-gray-500 leading-relaxed"><%= t('food.opt.sub') %></p>
  </div>

  <% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm"><%= t('food.opt.saved') %></div><% } %>
  <% if (err) { %><div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm"><%= t('food.opt.err.' + err) %></div><% } %>

  <% if (!groups.length) { %>
    <div class="bg-white border border-gray-100 rounded-2xl p-8 text-center text-gray-400 text-sm"><%= t('food.opt.none') %></div>
  <% } %>

  <% groups.forEach(function (g) { %>
    <section class="bg-white border border-gray-100 rounded-2xl p-4">
      <div class="flex items-center justify-between gap-3 flex-wrap mb-2">
        <div>
          <h2 class="font-bold text-gray-800"><%= g.name %><%= g.required ? ' *' : '' %></h2>
          <p class="text-xs text-gray-400">
            <%= t('food.opt.min') %>: <%= g.min_select %> · <%= t('food.opt.max') %>: <%= g.max_select === 0 ? t('food.opt.no_limit') : g.max_select %>
          </p>
        </div>
        <form method="post" action="/food/item/<%= item.id %>/options/<%= g.id %>/delete">
          <button data-confirm="<%= t('common.tap_confirm') %>" class="text-xs bg-red-50 text-red-600 font-bold rounded-lg px-3 py-1.5"><%= t('pharmacy.admin.delete') %></button>
        </form>
      </div>

      <% if (!g.values.length) { %>
        <p class="text-xs text-gray-400 py-2"><%= t('food.opt.no_values') %></p>
      <% } else { %>
        <div class="divide-y divide-gray-100 mb-2">
          <% g.values.forEach(function (v) { %>
            <div class="py-2 flex items-center justify-between gap-2">
              <span class="text-sm text-gray-800"><%= v.name %></span>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold <%= Number(v.price_delta) > 0 ? 'text-orange-700' : Number(v.price_delta) < 0 ? 'text-emerald-700' : 'text-gray-400' %>">
                  <%= Number(v.price_delta) > 0 ? '+' : '' %><%= Number(v.price_delta).toFixed(2) %>
                </span>
                <form method="post" action="/food/item/<%= item.id %>/options/value/<%= v.id %>/delete">
                  <button class="text-xs text-gray-400 hover:text-red-600">✕</button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <form method="post" action="/food/item/<%= item.id %>/options/<%= g.id %>/value" class="grid sm:grid-cols-3 gap-2 items-end border-t border-dashed border-gray-200 pt-3">
        <label><span class="lbl"><%= t('food.opt.value_name') %></span><input name="name" maxlength="80" class="fld" required /></label>
        <label><span class="lbl"><%= t('food.opt.delta') %></span><input name="price_delta" type="number" step="0.01" value="0" class="fld" /></label>
        <button class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg px-4 py-2 text-sm"><%= t('food.opt.add_value') %></button>
      </form>
    </section>
  <% }); %>

  <section class="bg-white border border-gray-100 rounded-2xl p-4">
    <h2 class="font-bold text-gray-800 mb-1"><%= t('food.opt.add_group') %></h2>
    <p class="text-xs text-gray-500 mb-3"><%= t('food.opt.group_hint') %></p>
    <form method="post" action="/food/item/<%= item.id %>/options/group" class="grid sm:grid-cols-4 gap-2 items-end">
      <label><span class="lbl"><%= t('food.opt.group_name') %></span><input name="name" maxlength="80" class="fld" required /></label>
      <label><span class="lbl"><%= t('food.opt.min') %></span><input name="min_select" type="number" min="0" value="0" class="fld" /></label>
      <label><span class="lbl"><%= t('food.opt.max') %></span><input name="max_select" type="number" min="0" value="0" class="fld" /></label>
      <div class="flex items-center gap-2">
        <label class="flex items-center gap-1 text-xs font-bold"><input type="checkbox" name="required" class="w-4 h-4 accent-orange-600" /><%= t('food.opt.required') %></label>
        <button class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg px-4 py-2 text-sm"><%= t('pharmacy.admin.add') %></button>
      </div>
    </form>
  </section>

  <a href="/food/menu" class="inline-block text-sm text-gray-500 hover:underline">← <%= t('food.admin.menu') %></a>
</main>
</body></html>
