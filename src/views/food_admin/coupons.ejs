<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('orders.coupons') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; } .fld { border:1px solid #d1d5db; border-radius:8px; padding:7px 9px; width:100%; background:#fff; font-size:.85rem; } .lbl { font-size:.68rem; color:#6b7280; margin-bottom:2px; display:block; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'coupons' }) %>
<%
  function __money(v){ var n=Number(v); if(!isFinite(n)) return '0'; return n.toLocaleString(lang==='ar'?'ar-EG':'en-US',{maximumFractionDigits:2}); }
  var __cur = t('pharmacy.currency');
%>

<main class="max-w-3xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓ <%= t('pharmacy.admin.saved') %></div><% } %>
  <%
    /* A code, not a sentence: the page used to print whatever ?error= carried,
       so a link could put any text on the merchant's own screen. */
    var __errMsg = errorCode === 'no_code' ? t('food.admin.coupon_no_code')
      : (errorCode === 'save' ? t('food.admin.save_failed') : null);
  %>
  <% if (__errMsg) { %><div class="mb-4 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm font-bold"><%= __errMsg %></div><% } %>

  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 mb-5">
    <h2 class="font-extrabold text-orange-700 mb-3">🎟️ <%= t('orders.add_coupon') %></h2>
    <form method="post" action="/food/coupons/add" class="grid gap-3 sm:grid-cols-3">
      <div><span class="lbl"><%= t('orders.coupon_code') %></span><input name="code" required class="fld" style="text-transform:uppercase" dir="ltr" /></div>
      <div><span class="lbl"><%= t('orders.discount_percent') %></span><input name="discount_percent" type="number" min="0" max="100" value="10" class="fld" /></div>
      <div><span class="lbl"><%= t('orders.max_discount') %> (<%= __cur %>)</span><input name="max_discount" type="number" step="0.01" min="0" class="fld" /></div>
      <div><span class="lbl"><%= t('orders.coupon_min') %> (<%= __cur %>)</span><input name="min_order" type="number" step="0.01" min="0" value="0" class="fld" /></div>
      <div><span class="lbl"><%= t('orders.usage_limit') %></span><input name="usage_limit" type="number" min="0" value="0" class="fld" /></div>
      <div><span class="lbl"><%= t('orders.expires') %></span><input name="expires_at" type="date" class="fld" /></div>
      <div class="sm:col-span-3"><button type="submit" class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl px-6 py-2.5"><%= t('orders.add_coupon') %></button></div>
    </form>
  </div>

  <% if (!coupons.length) { %>
    <div class="text-center py-12 text-gray-400"><%= t('orders.no_coupons') %></div>
  <% } else { %>
    <div class="space-y-2">
      <% coupons.forEach(function(c){ %>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-3 flex items-center gap-3 flex-wrap">
          <span class="font-extrabold text-lg" dir="ltr"><%= c.code %></span>
          <span class="text-sm text-gray-600"><%= c.discount_percent %>%<% if (Number(c.max_discount)>0) { %> · ≤ <%= __money(c.max_discount) %> <%= __cur %><% } %></span>
          <% if (Number(c.min_order)>0) { %><span class="text-xs text-gray-400"><%= t('orders.coupon_min') %> <%= __money(c.min_order) %></span><% } %>
          <span class="text-xs text-gray-400"><%= c.used_count %><% if (Number(c.usage_limit)>0) { %>/<%= c.usage_limit %><% } %></span>
          <% if (c.expires_at) { %><span class="text-xs text-gray-400"><%= new Date(c.expires_at).toISOString().slice(0,10) %></span><% } %>
          <span class="text-[11px] font-bold rounded-full px-2 py-0.5 <%= c.is_active ? 'text-green-700 bg-green-50':'text-gray-500 bg-gray-100' %>"><%= c.is_active ? t('pharmacy.admin.banner_active') : t('pharmacy.admin.banner_paused') %></span>
          <div class="ms-auto flex gap-1">
            <form method="post" action="/food/coupons/<%= c.id %>/toggle" class="inline"><button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-gray-100 text-gray-600"><%= c.is_active ? t('pharmacy.admin.banner_paused') : t('pharmacy.admin.banner_active') %></button></form>
            <form method="post" action="/food/coupons/<%= c.id %>/delete" class="inline"><button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-red-50 text-red-600" data-confirm="<%= t('common.tap_confirm') %>"><%= t('pharmacy.admin.delete') %></button></form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body>
</html>
