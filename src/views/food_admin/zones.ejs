<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('food.zone.title') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>
  * { font-family: 'Cairo', sans-serif; }
  .fld { border:1px solid #d1d5db; border-radius:8px; padding:6px 8px; font-size:.85rem; background:#fff; width:100%; }
  .lbl { font-size:.7rem; color:#6b7280; margin-bottom:2px; display:block; }
</style>
</head>
<body class="bg-gray-50 text-gray-900">
<%- include('nav', { active: 'zones' }) %>

<main class="max-w-4xl mx-auto px-4 py-6 space-y-5">
  <div>
    <h1 class="text-xl font-extrabold mb-1"><%= t('food.zone.title') %></h1>
    <p class="text-sm text-gray-500 leading-relaxed"><%= t('food.zone.sub') %></p>
  </div>

  <% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm"><%= t('food.zone.saved') %></div><% } %>
  <% if (err) { %><div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm"><%= t('food.zone.err.' + err) %></div><% } %>

  <% if (!zones.length) { %>
    <div class="bg-white border border-gray-100 rounded-2xl p-6 text-center text-sm text-gray-500">
      <%= t('food.zone.none') %>
      <% if (outlets.length) { %>
        <div class="mt-2 text-xs text-gray-400">
          <% outlets.forEach(function (o) { %>
            <span class="inline-block me-2"><%= o.name_ar || o.name %>: <%= Number(o.delivery_fee || 0).toFixed(2) %></span>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-100 rounded-2xl overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs">
          <tr>
            <th class="text-start px-3 py-2"><%= t('food.zone.name') %></th>
            <th class="text-start px-3 py-2"><%= t('food.zone.fee') %></th>
            <th class="text-start px-3 py-2"><%= t('food.zone.min') %></th>
            <th class="text-start px-3 py-2"><%= t('food.zone.free_over') %></th>
            <th class="text-start px-3 py-2"><%= t('food.zone.eta') %></th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% zones.forEach(function (z) { %>
            <tr class="border-t border-gray-100">
              <form method="post" action="/food/zones/save">
                <input type="hidden" name="id" value="<%= z.id %>" />
                <td class="px-3 py-2"><input name="name" value="<%= z.name %>" class="fld" /></td>
                <td class="px-3 py-2 w-28"><input name="fee" type="number" step="0.01" min="0" value="<%= Number(z.fee) %>" class="fld" /></td>
                <td class="px-3 py-2 w-28"><input name="min_order" type="number" step="0.01" min="0" value="<%= Number(z.min_order) %>" class="fld" /></td>
                <td class="px-3 py-2 w-28"><input name="free_over" type="number" step="0.01" min="0" value="<%= z.free_over == null ? '' : Number(z.free_over) %>" placeholder="—" class="fld" /></td>
                <td class="px-3 py-2 w-24"><input name="eta_min" type="number" min="0" value="<%= z.eta_min == null ? '' : z.eta_min %>" class="fld" /></td>
                <td class="px-3 py-2 whitespace-nowrap">
                  <button class="bg-orange-600 text-white font-bold rounded-lg px-3 py-1.5 text-xs"><%= t('pharmacy.admin.save') %></button>
                  <button formaction="/food/zones/<%= z.id %>/remove" formnovalidate data-confirm="<%= t('common.tap_confirm') %>"
                          class="bg-red-50 text-red-600 font-bold rounded-lg px-2 py-1.5 text-xs">✕</button>
                </td>
              </form>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <section class="bg-white border border-gray-100 rounded-2xl p-4">
    <h2 class="font-bold text-gray-800 mb-1"><%= t('food.zone.add') %></h2>
    <p class="text-xs text-gray-500 mb-3"><%= t('food.zone.hint') %></p>
    <form method="post" action="/food/zones/save" class="grid sm:grid-cols-6 gap-2 items-end">
      <label class="sm:col-span-2"><span class="lbl"><%= t('food.zone.name') %></span><input name="name" maxlength="80" class="fld" required /></label>
      <label><span class="lbl"><%= t('food.zone.fee') %></span><input name="fee" type="number" step="0.01" min="0" value="0" class="fld" /></label>
      <label><span class="lbl"><%= t('food.zone.min') %></span><input name="min_order" type="number" step="0.01" min="0" value="0" class="fld" /></label>
      <label><span class="lbl"><%= t('food.zone.free_over') %></span><input name="free_over" type="number" step="0.01" min="0" placeholder="—" class="fld" /></label>
      <div class="flex gap-2">
        <label class="flex-1"><span class="lbl"><%= t('food.zone.outlet') %></span>
          <select name="outlet_id" class="fld">
            <% outlets.forEach(function (o) { %><option value="<%= o.id %>"><%= o.name_ar || o.name %></option><% }); %>
          </select></label>
        <button class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg px-4 py-2 text-sm h-fit"><%= t('pharmacy.admin.add') %></button>
      </div>
    </form>
  </section>
</main>
</body></html>
