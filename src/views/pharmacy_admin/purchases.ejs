<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('ph.po.title') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-900">
<%- include('nav', { active: 'purchases' }) %>

<main class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
    <div>
      <h1 class="text-xl font-extrabold mb-1"><%= t('ph.po.title') %></h1>
      <p class="text-sm text-gray-500"><%= t('ph.po.sub') %></p>
    </div>
    <a href="/pharmacy/purchases/new" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-5 py-2.5 text-sm"><%= t('ph.po.new') %></a>
  </div>

  <% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm mb-4"><%= t('ph.po.saved') %></div><% } %>
  <% if (err) { %><div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm mb-4"><%= t('ph.po.err.' + err) %></div><% } %>

  <% if (!rows.length) { %>
    <div class="bg-white border border-gray-100 rounded-2xl p-10 text-center text-gray-400"><%= t('ph.po.none') %></div>
  <% } else { %>
    <div class="space-y-3">
      <% rows.forEach(function (o) {
           var tone = o.state === 'received' ? 'bg-emerald-100 text-emerald-800'
                    : o.state === 'partial' ? 'bg-amber-100 text-amber-800'
                    : o.state === 'cancelled' ? 'bg-gray-200 text-gray-600'
                    : o.state === 'sent' ? 'bg-sky-100 text-sky-800'
                    : 'bg-gray-100 text-gray-600';
      %>
        <a href="/pharmacy/purchases/<%= o.id %>" class="block bg-white border border-gray-100 rounded-2xl p-4 hover:border-emerald-200">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <div class="font-bold text-gray-800">#<%= o.id %> · <%= o.supplier || t('ph.po.no_supplier') %></div>
              <div class="text-xs text-gray-400 mt-0.5"><%= new Date(o.created_at).toLocaleString(LOC) %></div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs text-gray-500"><%= o.qty_received %>/<%= o.qty_ordered %> <%= t('ph.po.units') %></span>
              <span class="text-xs font-bold rounded-full px-2.5 py-1 <%= tone %>"><%= t('ph.po.state.' + o.state) %></span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</main>
</body></html>
