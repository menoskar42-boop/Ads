<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('pharmacy.admin.pos') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>* { font-family: 'Cairo', sans-serif; } .fld{border:1px solid #d1d5db;border-radius:10px;padding:10px 12px;width:100%;outline:none}
  .scanbtn{flex:0 0 auto;width:52px;border:1px solid #0e7c66;color:#0e7c66;background:#fff;border-radius:10px;font-size:1.4rem;cursor:pointer}
  #scanOverlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:60;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}
  #reader{width:100%;max-width:360px;border-radius:16px;overflow:hidden;background:#000}</style>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<%# The GS1 decoder — the same file the server parses with, not a copy. Loaded
    from our own origin so the till keeps decoding packs with the net down. %>
<script src="/pharmacy/js/gs1.js"></script>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'pos' }) %>

<main class="max-w-3xl mx-auto px-4 py-6">
  <div class="flex gap-2 mb-2">
    <input id="posSearch" class="fld text-lg" style="flex:1" placeholder="<%= t('pharmacy.pos.search') %>" autocomplete="off" autofocus />
    <button id="posScan" type="button" class="scanbtn" aria-label="scan">📷</button>
  </div>
  <div id="posResults" class="bg-white rounded-xl border border-gray-100 shadow-sm divide-y hidden"></div>

  <div id="scanOverlay" style="display:none">
    <div id="reader"></div>
    <button id="scanClose" class="mt-4 bg-white text-gray-800 font-bold rounded-xl px-6 py-2">✕</button>
  </div>

  <div id="posStatus" class="hidden text-sm font-bold rounded-xl px-4 py-2 mt-2"></div>

  <div id="posHeldBox" class="hidden mt-5 bg-white rounded-2xl border border-amber-200 shadow-sm p-4">
    <div class="font-extrabold text-amber-700 mb-2">⏸️ <%= t('ph.pos.held') %></div>
    <div id="posHeld" class="divide-y"></div>
  </div>

  <div class="mt-5 bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
    <div class="font-extrabold text-emerald-700 mb-3">🧾 <%= t('pharmacy.pos.cart') %></div>
    <div id="posEmpty" class="text-center text-gray-400 py-8"><%= t('pharmacy.pos.empty') %></div>
    <div id="posCart" class="divide-y"></div>
    <div id="posFooter" class="hidden mt-4">
      <%# A discount box, because 47.50 gets rounded to 47 at every till in the
          country and a system with no way to do it gets bypassed on paper. %>
      <div class="flex items-center gap-2 mb-3">
        <label class="text-sm text-gray-500"><%= t('ph.pos.discount') %></label>
        <input id="posDisc" type="number" min="0" max="100" step="1" value="0" class="fld w-20 text-center" />
        <span class="text-sm text-gray-400">%</span>
        <span id="posDiscAmt" class="text-sm text-red-600 font-bold"></span>
      </div>
      <div class="flex items-center justify-between text-lg font-extrabold mb-3">
        <span><%= t('pharmacy.pos.total') %></span>
        <span><span id="posTotal">0</span> <%= t('pharmacy.currency') %></span>
      </div>
      <div class="flex gap-2">
        <button id="posCheckout" class="bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold rounded-xl px-6 py-3 flex-1 text-lg"><%= t('pharmacy.pos.checkout') %></button>
        <%# Parking a basket is what keeps the queue moving when a customer goes
            back for one more thing. It lives in the same local store as the
            offline queue, so it works with the internet down — which is exactly
            when a pharmacy least wants the queue to stop. %>
        <button id="posHold" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl px-4 py-3"><%= t('ph.pos.hold') %></button>
      </div>
    </div>
  </div>

  <%# The manager signs in with their real credentials, not a four-digit code:
      a PIN that unlocks the day's takings gets watched over a shoulder once
      and then belongs to everybody. %>
  <div id="posApprove" class="hidden fixed inset-0 bg-black/60 z-40 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-5 w-full max-w-sm">
      <div class="font-extrabold mb-1"><%= t('ph.pos.needs_manager') %></div>
      <p id="posApproveWhy" class="text-sm text-gray-500 mb-3"></p>
      <input id="posMgrUser" class="fld w-full mb-2" dir="ltr" autocomplete="off" placeholder="<%= t('ph.pos.manager_user') %>" />
      <input id="posMgrPw" type="password" class="fld w-full mb-3" dir="ltr" autocomplete="new-password" placeholder="<%= t('ph.pos.manager_pw') %>" />
      <div id="posApproveErr" class="hidden text-sm text-red-600 font-bold mb-2"></div>
      <div class="flex gap-2">
        <button id="posMgrOk" class="bg-emerald-700 text-white font-bold rounded-xl px-4 py-2 flex-1"><%= t('ph.pos.approve') %></button>
        <button id="posMgrCancel" class="bg-gray-100 text-gray-700 font-bold rounded-xl px-4 py-2"><%= t('common.cancel') %></button>
      </div>
    </div>
  </div>

  <div id="posToast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl shadow-lg hidden"></div>
</main>

<script>
(function(){
  var CUR  = <%- jsonLd(t('pharmacy.currency')) %>;
  var LANG = <%- jsonLd(lang) %>;
  var MSG  = {
    done: <%- jsonLd(t('pharmacy.pos.done')) %>, insuf: <%- jsonLd(t('pharmacy.pos.insufficient')) %>,
    avail: <%- jsonLd(t('pharmacy.pos.available_short')) %>, offline: <%- jsonLd(t('pharmacy.pos.offline')) %>,
    online: <%- jsonLd(t('pharmacy.pos.online')) %>, pending: <%- jsonLd(t('pharmacy.pos.pending')) %>,
    savedOff: <%- jsonLd(t('pharmacy.pos.saved_offline')) %>, loading: <%- jsonLd(t('pharmacy.pos.loading')) %>,
    held: <%- jsonLd(t('ph.pos.held_done')) %>, resumed: <%- jsonLd(t('ph.pos.resumed')) %>,
    discOffline: <%- jsonLd(t('ph.pos.disc_offline')) %>,
    needMgr: <%- jsonLd(t('ph.pos.needs_manager_why')) %>,
    badMgr: <%- jsonLd(t('ph.pos.bad_approval')) %>
  };
  // The ceiling this cashier may apply alone. The server checks again at
  // checkout — this only decides whether the till asks for a manager.
  var DISC_MAX = <%- jsonLd(Number(discountMax) || 0) %>;
  var DBNAME = 'oscardevs_pos_<%= company.id %>';
  var $ = function(id){ return document.getElementById(id); };
  function nm(it){ return (LANG==='en' && it.name_en) ? it.name_en : it.name_ar; }
  function esc(s){ return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function uidGen(){ return (crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now()+'-'+Math.random().toString(36).slice(2)); }

  // Register the /pharmacy-scoped SW so the POS shell loads offline.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/pharmacy-sw.js', { scope: '/pharmacy/' }).catch(function(){});
  }

  // ── IndexedDB (inventory cache + offline sale queue) ──
  var db = null;
  function openDB(){
    return new Promise(function(res, rej){
      // Version 2 adds the parked baskets. onupgradeneeded runs for a browser
      // still on 1, so a till that has been open since yesterday picks the
      // store up without losing its queue.
      var r = indexedDB.open(DBNAME, 2);
      r.onupgradeneeded = function(e){
        var d = e.target.result;
        if(!d.objectStoreNames.contains('inv')) d.createObjectStore('inv', { keyPath:'medicine_id' });
        if(!d.objectStoreNames.contains('queue')) d.createObjectStore('queue', { keyPath:'uid' });
        if(!d.objectStoreNames.contains('held')) d.createObjectStore('held', { keyPath:'uid' });
      };
      r.onsuccess = function(e){ res(e.target.result); };
      r.onerror = function(){ rej(r.error); };
    });
  }
  function tx(store, mode){ return db.transaction(store, mode).objectStore(store); }
  function getAll(store){ return new Promise(function(res){ var out=[]; var c=tx(store,'readonly').openCursor(); c.onsuccess=function(e){ var cur=e.target.result; if(cur){ out.push(cur.value); cur.continue(); } else res(out); }; c.onerror=function(){ res(out); }; }); }
  function put(store, val){ return new Promise(function(res){ var rq=tx(store,'readwrite').put(val); rq.onsuccess=function(){res();}; rq.onerror=function(){res();}; }); }
  function del(store, key){ return new Promise(function(res){ var rq=tx(store,'readwrite').delete(key); rq.onsuccess=function(){res();}; rq.onerror=function(){res();}; }); }
  function clearStore(store){ return new Promise(function(res){ var rq=tx(store,'readwrite').clear(); rq.onsuccess=function(){res();}; rq.onerror=function(){res();}; }); }

  var cart = {}; // medicine_id -> {name, price, qty, available}

  // Refresh the local inventory cache from the server (when online).
  function refreshInventory(){
    if(!navigator.onLine) return Promise.resolve();
    return fetch('/pharmacy/api/inventory-all').then(function(r){ return r.json(); }).then(function(rows){
      if(!Array.isArray(rows)) return;
      return clearStore('inv').then(function(){
        return Promise.all(rows.map(function(it){ return put('inv', it); }));
      });
    }).catch(function(){});
  }

  // Search the LOCAL cache (works offline).
  var searchBox = $('posSearch'), results = $('posResults'), timer=null;
  searchBox.addEventListener('input', function(){
    clearTimeout(timer); var q=searchBox.value.trim();
    if(!q){ results.classList.add('hidden'); results.innerHTML=''; return; }
    timer = setTimeout(function(){ doSearch(q); }, 150);
  });

  // Desktop barcode/QR readers are HID devices: they TYPE the code into the
  // focused box and press Enter. The box is autofocused, so scanning already
  // filled it — but Enter did nothing and the pharmacist had to reach for the
  // mouse on every item, which defeats the scanner. Enter now adds the single
  // exact barcode match and clears the box, ready for the next scan.
  // An Egyptian pack's DataMatrix is one long string holding the GTIN, the
  // batch and the expiry — searching for it whole finds nothing. Decoded with
  // the SAME module the server uses (served at /pharmacy/js/gs1.js) so the till
  // still works with the internet down, which is the whole point of this screen.
  function scanKeys(code) {
    if (!window.GS1) return [code];
    var p = window.GS1.parse(code);
    if (!p.gs1) return [code];
    lastScan = p;
    return window.GS1.searchKeys(p).concat([code]);
  }
  var lastScan = null;

  function matchBarcode(rows, code) {
    var keys = scanKeys(code);
    return rows.filter(function (it) {
      return it.barcode && keys.indexOf(String(it.barcode)) >= 0;
    });
  }

  // What the pack itself said, shown next to the item. A batch or an expiry the
  // pharmacist can see is a batch they can check against the shelf.
  function scanNote() {
    if (!lastScan) return '';
    var bits = [];
    if (lastScan.batch) bits.push('تشغيلة ' + lastScan.batch);
    if (lastScan.expiry) bits.push('صلاحية ' + lastScan.expiry);
    return bits.join(' · ');
  }

  searchBox.addEventListener('keydown', function (ev) {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    var code = (searchBox.value || '').trim();
    if (!code) return;
    lastScan = null;
    getAll('inv').then(function (rows) {
      var exact = matchBarcode(rows, code);
      // Only an unambiguous barcode is auto-added. A name search that happens to
      // match one row is not the same thing, and adding the wrong medicine
      // because it was the only hit is worse than making them tap it.
      if (exact.length === 1) {
        addToCart(exact[0]);
        var note = scanNote();
        toast(nm(exact[0]) + (note ? ' — ' + note : ''));
        searchBox.value = ''; results.classList.add('hidden');
      } else { doSearch(code); }
    });
  });
  function doSearch(q){
    var ql = q.toLowerCase();
    getAll('inv').then(function(rows){
      var m = rows.filter(function(it){
        return (it.name_ar && it.name_ar.toLowerCase().indexOf(ql)>=0) ||
               (it.name_en && it.name_en.toLowerCase().indexOf(ql)>=0) ||
               (it.barcode && String(it.barcode)===q);
      }).slice(0,30);
      results.innerHTML='';
      if(!m.length){ results.classList.add('hidden'); return; }
      m.forEach(function(it){
        var b=document.createElement('button');
        b.className='w-full text-start px-4 py-3 hover:bg-gray-50 flex items-center justify-between gap-2';
        var pri=nm(it), sec=(LANG==='en'&&it.name_en)?it.name_ar:it.name_en;
        b.innerHTML='<span><b>'+esc(pri)+'</b>'+(sec?' <span style="color:#9ca3af;font-size:.8rem">'+esc(sec)+'</span>':'')+'</span>'+
          '<span style="white-space:nowrap"><span style="color:#0e7c66;font-weight:700">'+(Number(it.price)||0).toFixed(2)+' '+CUR+'</span> · '+MSG.avail+' '+it.available+'</span>';
        b.onclick=function(){ addToCart(it); searchBox.value=''; results.classList.add('hidden'); searchBox.focus(); };
        results.appendChild(b);
      });
      results.classList.remove('hidden');
    });
  }

  function addToCart(it){
    var id=it.medicine_id;
    if(!cart[id]) cart[id]={ name:nm(it), price:Number(it.price)||0, qty:0, available:Number(it.available)||0 };
    if(cart[id].qty < cart[id].available) cart[id].qty++; else toast(MSG.insuf);
    render();
  }
  function render(){
    var box=$('posCart'); box.innerHTML=''; var total=0, any=false;
    Object.keys(cart).forEach(function(id){
      var c=cart[id]; if(c.qty<=0) return; any=true; total+=c.price*c.qty;
      var row=document.createElement('div'); row.className='py-3 flex items-center justify-between gap-2';
      row.innerHTML='<div class="min-w-0"><div class="font-bold truncate">'+esc(c.name)+'</div><div style="color:#6b7280;font-size:.8rem">'+c.price.toFixed(2)+' '+CUR+'</div></div>';
      var ctrl=document.createElement('div'); ctrl.className='flex items-center gap-2 shrink-0';
      ctrl.innerHTML='<button class="w-8 h-8 rounded-lg bg-gray-100 font-bold">−</button><span class="w-8 text-center font-bold">'+c.qty+'</span><button class="w-8 h-8 rounded-lg bg-gray-100 font-bold">+</button>';
      var btns=ctrl.querySelectorAll('button');
      btns[0].onclick=function(){ c.qty--; render(); };
      btns[1].onclick=function(){ if(c.qty<c.available) c.qty++; else toast(MSG.insuf); render(); };
      row.appendChild(ctrl); box.appendChild(row);
    });
    $('posEmpty').classList.toggle('hidden', any);
    $('posFooter').classList.toggle('hidden', !any);
    var pct = discPct();
    var cut = Math.min(total, Math.round(total * pct) / 100);
    $('posDiscAmt').textContent = cut ? ('−' + cut.toFixed(2) + ' ' + CUR) : '';
    $('posTotal').textContent = (total - cut).toFixed(2);
  }
  function discPct(){
    var v = Number($('posDisc').value);
    if(!isFinite(v) || v <= 0) return 0;
    return Math.min(100, Math.round(v * 100) / 100);
  }
  $('posDisc').addEventListener('input', render);

  // ── Parked baskets ──
  // The queue keeps moving when a customer goes back for one more thing. Stored
  // in the same local database as the offline queue, so it works with the
  // internet down — which is exactly when a pharmacy least wants a stuck till.
  function renderHeld(){
    return getAll('held').then(function(rows){
      var box=$('posHeld'); box.innerHTML='';
      $('posHeldBox').classList.toggle('hidden', !rows.length);
      rows.sort(function(a,b){ return b.ts - a.ts; }).forEach(function(h){
        var n=h.items.reduce(function(s,i){ return s+i.qty; },0);
        var sum=h.items.reduce(function(s,i){ return s+i.price*i.qty; },0);
        var row=document.createElement('div');
        row.className='py-2 flex items-center justify-between gap-2';
        row.innerHTML='<div class="min-w-0"><div class="font-bold truncate">'+esc(h.items.map(function(i){return i.name;}).join(' · '))+'</div>'
          +'<div style="color:#6b7280;font-size:.8rem">'+n+' × · '+sum.toFixed(2)+' '+CUR+'</div></div>';
        var ctrl=document.createElement('div'); ctrl.className='flex items-center gap-1 shrink-0';
        var take=document.createElement('button');
        take.className='text-sm font-bold bg-emerald-50 text-emerald-700 rounded-lg px-3 py-1.5';
        take.textContent=<%- jsonLd(t('ph.pos.resume')) %>;
        take.onclick=function(){
          // Merged, not replaced: dropping whatever is on the screen to bring a
          // parked basket back would lose a sale in progress.
          h.items.forEach(function(i){
            if(!cart[i.medicine_id]) cart[i.medicine_id]={ name:i.name, price:i.price, qty:0, available:i.available||i.qty };
            cart[i.medicine_id].qty += i.qty;
          });
          del('held', h.uid).then(renderHeld).then(function(){ render(); toast(MSG.resumed); });
        };
        var drop=document.createElement('button');
        drop.className='text-sm text-gray-400 hover:text-red-600 px-2';
        drop.textContent='✕';
        drop.onclick=function(){ del('held', h.uid).then(renderHeld); };
        ctrl.appendChild(take); ctrl.appendChild(drop);
        row.appendChild(ctrl); box.appendChild(row);
      });
    });
  }
  $('posHold').onclick=function(){
    var items=cartItems();
    if(!items.length) return;
    put('held', { uid:uidGen(), items:items, ts:Date.now() }).then(function(){
      cart={}; $('posDisc').value=0; render(); toast(MSG.held); return renderHeld();
    });
  };

  function cartItems(){
    return Object.keys(cart).filter(function(id){return cart[id].qty>0;}).map(function(id){
      return { medicine_id:parseInt(id,10), qty:cart[id].qty, price:cart[id].price,
               name:cart[id].name, available:cart[id].available };
    });
  }

  // ── The manager approval dialog ──
  var pendingApproval = null;
  function askManager(why){
    $('posApproveWhy').textContent = why;
    $('posApproveErr').classList.add('hidden');
    $('posMgrUser').value=''; $('posMgrPw').value='';
    $('posApprove').classList.remove('hidden');
    $('posMgrUser').focus();
  }
  $('posMgrCancel').onclick=function(){ $('posApprove').classList.add('hidden'); pendingApproval=null; };
  $('posMgrOk').onclick=function(){
    if(!pendingApproval) return;
    pendingApproval($('posMgrUser').value, $('posMgrPw').value);
  };

  // Checkout: queue the sale locally, decrement local stock, then try to sync.
  $('posCheckout').onclick=function(){
    var items=cartItems();
    if(!items.length) return;
    var pct=discPct();

    // Above this cashier's ceiling: a manager signs in, ONLINE, because there
    // is no way to check a password against nothing. Offline the sale still
    // goes through — at the discount the cashier was allowed to give — and the
    // difference lands on the review list for a human to settle.
    if(pct > DISC_MAX){
      if(!navigator.onLine){ toast(MSG.discOffline); return; }
      pendingApproval = function(user, pw){
        sendOnline(items, pct, user, pw);
      };
      askManager(MSG.needMgr.replace('{max}', DISC_MAX));
      return;
    }
    queueSale(items, pct);
  };

  // An approved discount cannot go through the offline queue — the approval is
  // the whole point and only the server can check it — so it is sent directly.
  function sendOnline(items, pct, user, pw){
    fetch('/pharmacy/pos/checkout',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({ items:items, discount_percent:pct, approver_user:user, approver_password:pw })})
      .then(function(r){ return r.json().then(function(j){ return { ok:r.ok, j:j }; }); })
      .then(function(out){
        if(!out.ok || !out.j.ok){
          $('posApproveErr').textContent = MSG.badMgr;
          $('posApproveErr').classList.remove('hidden');
          return;
        }
        $('posApprove').classList.add('hidden'); pendingApproval=null;
        cart={}; $('posDisc').value=0; render();
        toast(MSG.done);
        refreshInventory();
      })
      .catch(function(){
        $('posApproveErr').textContent = MSG.badMgr;
        $('posApproveErr').classList.remove('hidden');
      });
  }

  function queueSale(items, pct){
    var sale={ uid:uidGen(), items:items, discount_percent:pct, ts:Date.now() };
    put('queue', sale).then(function(){
      // optimistic local stock decrement
      return Promise.all(items.map(function(it){
        return new Promise(function(res){ var rq=tx('inv','readwrite').get(it.medicine_id); rq.onsuccess=function(e){ var rec=e.target.result; if(rec){ rec.available=Math.max(0,(Number(rec.available)||0)-it.qty); tx('inv','readwrite').put(rec); } res(); }; rq.onerror=function(){res();}; });
      }));
    }).then(function(){
      cart={}; $('posDisc').value=0; render();
      toast(navigator.onLine ? MSG.done : MSG.savedOff);
      trySync();
    });
  }

  // Flush the offline queue to the server (idempotent via uid).
  var syncing=false;
  function trySync(){
    if(syncing || !navigator.onLine){ updateStatus(); return Promise.resolve(); }
    syncing=true;
    return getAll('queue').then(function(q){
      if(!q.length){ syncing=false; updateStatus(); return; }
      var sales=q.map(function(s){ return { offline_uid:s.uid, items:s.items, discount_percent:s.discount_percent||0 }; });
      return fetch('/pharmacy/pos/sync',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sales:sales})})
        .then(function(r){ return r.json(); }).then(function(res){
          var done=(res && res.synced) || [];
          return Promise.all(done.map(function(uid){ return del('queue', uid); }));
        }).then(function(){ return refreshInventory(); })
        .then(function(){ syncing=false; updateStatus(); })
        .catch(function(){ syncing=false; updateStatus(); });
    }).catch(function(){ syncing=false; updateStatus(); });
  }

  function updateStatus(){
    var el=$('posStatus');
    getAll('queue').then(function(q){
      var pend=q.length;
      if(!navigator.onLine){
        el.textContent=MSG.offline+(pend?(' · '+pend+' '+MSG.pending):'');
        el.className='text-sm font-bold rounded-xl px-4 py-2 mt-2 bg-amber-50 text-amber-700';
      } else if(pend){
        el.textContent=pend+' '+MSG.pending+'…';
        el.className='text-sm font-bold rounded-xl px-4 py-2 mt-2 bg-blue-50 text-blue-700';
      } else {
        el.classList.add('hidden'); return;
      }
      el.classList.remove('hidden');
    });
  }

  window.addEventListener('online', function(){ trySync(); refreshInventory().then(updateStatus); });
  window.addEventListener('offline', updateStatus);

  var toastTimer=null;
  function toast(m){ var el=$('posToast'); el.textContent=m; el.classList.remove('hidden'); clearTimeout(toastTimer); toastTimer=setTimeout(function(){el.classList.add('hidden');},2400); }

  // ── Barcode camera scanning ──
  var scanBtn=$('posScan'), overlay=$('scanOverlay'), scanClose=$('scanClose'), scanner=null;
  function stopScan(){ if(scanner){ scanner.stop().then(function(){ try{scanner.clear();}catch(e){} }).catch(function(){}); scanner=null; } overlay.style.display='none'; }
  scanClose.onclick=stopScan;
  scanBtn.onclick=function(){
    if(typeof Html5Qrcode==='undefined'){ searchBox.focus(); return; }
    overlay.style.display='flex'; scanner=new Html5Qrcode('reader');
    scanner.start({facingMode:'environment'}, {fps:10, qrbox:{width:260,height:150}}, function(code){
      stopScan();
      lastScan = null;
      getAll('inv').then(function(rows){
        var hit = matchBarcode(rows, String(code))[0];
        if(hit){ addToCart(hit); var n = scanNote(); toast(nm(hit) + (n ? ' — ' + n : '')); }
        else { searchBox.value=code; doSearch(code); }
      });
    }, function(){}).catch(function(){ overlay.style.display='none'; scanner=null; searchBox.focus(); });
  };

  // ── Boot ──
  openDB().then(function(d){ db=d; return refreshInventory(); })
    .then(function(){ trySync(); updateStatus(); return renderHeld(); }).catch(function(){
    // IndexedDB unavailable — degrade gracefully to online-only search.
    toast(MSG.loading);
  });
})();
</script>
</body>
</html>
