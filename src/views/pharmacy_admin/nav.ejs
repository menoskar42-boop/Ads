<%
  var __active = typeof active !== 'undefined' ? active : '';
  var __other = lang === 'ar' ? 'en' : 'ar';
%>
<header class="bg-emerald-700 text-white">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-3 flex-wrap">
    <a href="/pharmacy" class="font-extrabold text-lg flex items-center gap-1">💊 <%= company.company_name %></a>
    <nav class="flex items-center gap-1 text-sm mr-auto ms-auto flex-wrap">
      <% var P = (typeof perms !== 'undefined' && perms) ? perms : { pos:true, inventory:true, orders:true, settings:true, staff:true }; %>
      <a href="/pharmacy" class="px-3 py-1.5 rounded-lg <%= __active==='dashboard'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.dashboard') %></a>
      <% if (P.pos) { %><a href="/pharmacy/pos" class="px-3 py-1.5 rounded-lg <%= __active==='pos'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.pos') %></a><% } %>
      <% if (P.pos) { %><a href="/pharmacy/sales" class="px-3 py-1.5 rounded-lg <%= __active==='sales'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('ph.sales.title') %></a><% } %>
      <% if (P.inventory) { %><a href="/pharmacy/inventory" class="px-3 py-1.5 rounded-lg <%= __active==='inventory'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.inventory') %></a><% } %>
      <% if (P.orders) { %><a href="/pharmacy/orders" class="px-3 py-1.5 rounded-lg <%= __active==='orders'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.orders') %></a><% } %>
      <% if (P.staff) { %><a href="/pharmacy/staff" class="px-3 py-1.5 rounded-lg <%= __active==='staff'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.staff') %></a><% } %>
      <% if (P.settings) { %><a href="/pharmacy/banners" class="px-3 py-1.5 rounded-lg <%= __active==='banners'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.banners') %></a><% } %>
      <% if (P.settings) { %><a href="/pharmacy/settings" class="px-3 py-1.5 rounded-lg <%= __active==='settings'?'bg-white/25 font-bold':'hover:bg-white/15' %>"><%= t('pharmacy.admin.settings') %></a><% } %>
      <a href="/accounting" class="px-3 py-1.5 rounded-lg hover:bg-white/15">📊 <%= t('acct.title') %></a>
      <a href="https://<%= company.slug %>.oscardevs.com" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-lg hover:bg-white/15"><%= t('pharmacy.admin.view_public') %></a>
      <a href="?lang=<%= __other %>" class="px-3 py-1.5 rounded-lg bg-white/15 hover:bg-white/25 font-bold"><%= t('common.toggle_lang') %></a>
      <form method="post" action="/company/logout" class="inline"><button class="px-3 py-1.5 rounded-lg hover:bg-white/15"><%= t('pharmacy.admin.logout') %></button></form>
    </nav>
  </div>
</header>
