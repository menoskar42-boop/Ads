<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('pharmacy.admin.staff') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; } .fld{border:1px solid #d1d5db;border-radius:10px;padding:9px 11px;width:100%;outline:none;background:#fff} .lbl{font-size:.75rem;color:#6b7280;margin-bottom:2px;display:block}</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'staff' }) %>

<main class="max-w-3xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓</div><% } %>
  <% if (error) { %><div class="mb-4 bg-red-50 text-red-700 rounded-xl px-4 py-2 text-sm font-bold"><%= error %></div><% } %>

  <details class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5" open>
    <summary class="font-extrabold text-emerald-700 cursor-pointer">➕ <%= t('pharmacy.staff.add') %></summary>
    <p class="text-xs text-gray-400 mt-2"><%= t('pharmacy.staff.login_note') %></p>
    <form method="post" action="/pharmacy/staff/add" class="mt-3 grid gap-3 sm:grid-cols-2">
      <div><span class="lbl"><%= t('pharmacy.staff.name') %></span><input name="name" required class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.staff.role') %></span>
        <select name="role" class="fld">
          <option value="pharmacist"><%= t('pharmacy.role.pharmacist') %></option>
          <option value="cashier" selected><%= t('pharmacy.role.cashier') %></option>
          <option value="delivery"><%= t('pharmacy.role.delivery') %></option>
        </select>
      </div>
      <div><span class="lbl"><%= t('pharmacy.staff.username') %></span><input name="username" required dir="ltr" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.staff.password') %></span><input name="password" required class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.staff.phone') %></span><input name="phone" dir="ltr" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.staff.commission') %></span><input name="commission_percent" type="number" step="0.5" min="0" value="0" class="fld" /></div>
      <div class="sm:col-span-2 flex items-center justify-between gap-2">
        <span class="text-xs text-gray-400"><%= t('pharmacy.staff.commission_hint') %></span>
        <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg px-6 py-2"><%= t('pharmacy.admin.save') %></button>
      </div>
    </form>
  </details>

  <% if (!staff.length) { %>
    <div class="text-center py-12 text-gray-500"><%= t('pharmacy.staff.no_staff') %></div>
  <% } else { %>
    <div class="space-y-3">
      <% staff.forEach(function(s){ %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex items-center justify-between gap-3 <%= s.is_active ? '' : 'opacity-60' %>">
          <div class="min-w-0">
            <div class="font-extrabold text-gray-900"><%= s.name %>
              <span class="text-xs font-bold rounded-full px-2 py-0.5 ms-1 bg-emerald-50 text-emerald-700"><%= t('pharmacy.role.' + s.role) %></span>
            </div>
            <div class="text-xs text-gray-500 mt-1">
              <span dir="ltr">@<%= s.username %></span>
              <% if (s.phone) { %> · <span dir="ltr"><%= s.phone %></span><% } %>
              <% if (Number(s.commission_percent) > 0) { %> · 💰 <%= Number(s.commission_percent) %>%<% } %>
              <% if (!s.is_active) { %> · <span class="text-red-500"><%= t('pharmacy.staff.inactive') %></span><% } %>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <form method="post" action="/pharmacy/staff/<%= s.id %>/toggle"><button class="text-sm font-bold rounded-lg px-3 py-1.5 border <%= s.is_active ? 'border-amber-400 text-amber-600' : 'border-emerald-500 text-emerald-600' %>"><%= s.is_active ? t('pharmacy.staff.disable') : t('pharmacy.staff.enable') %></button></form>
            <form method="post" action="/pharmacy/staff/<%= s.id %>/delete" onsubmit="return confirm('<%= t('pharmacy.admin.confirm_delete') %>')"><button class="text-sm font-bold rounded-lg px-3 py-1.5 bg-red-50 text-red-600"><%= t('pharmacy.admin.delete') %></button></form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>
</body>
</html>
