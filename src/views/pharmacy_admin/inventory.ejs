<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('pharmacy.admin.inventory') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  input, select { outline: none; }
  .fld { border:1px solid #d1d5db; border-radius:8px; padding:6px 8px; font-size:.85rem; width:100%; background:#fff; }
  .lbl { font-size:.7rem; color:#6b7280; margin-bottom:2px; display:block; }
</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'inventory' }) %>

<main class="max-w-5xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓ <%= t('pharmacy.admin.saved') %></div><% } %>
  <% if (synced) { %><div class="mb-4 bg-blue-50 text-blue-700 rounded-xl px-4 py-2 text-sm font-bold"><%= t('pharmacy.admin.sync_started') %></div><% } %>
  <% if (error) { %><div class="mb-4 bg-red-50 text-red-700 rounded-xl px-4 py-2 text-sm font-bold"><%= error %></div><% } %>

  <!-- Catalog status + manual refresh (the list also auto-updates on its own) -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-2">
    <div class="text-sm text-gray-600">
      💊 <%= t('pharmacy.admin.catalog_count').replace('%n', Number(catalogCount||0).toLocaleString(lang==='ar'?'ar-EG':'en')) %>
      <% if (lastSync) { %><span class="text-gray-400 text-xs"> · <%= t('pharmacy.admin.last_sync') %>: <%= new Date(lastSync).toISOString().slice(0,10) %></span><% } %>
    </div>
    <form method="post" action="/pharmacy/catalog/sync">
      <button class="text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg px-3 py-1.5"><%= t('pharmacy.admin.refresh_catalog') %></button>
    </form>
  </div>

  <!-- Add stock -->
  <details class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5" open>
    <summary class="font-extrabold text-emerald-700 cursor-pointer">➕ <%= t('pharmacy.admin.add_stock') %></summary>
    <form method="post" action="/pharmacy/inventory/add" enctype="multipart/form-data" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 relative">
        <span class="lbl"><%= t('pharmacy.admin.from_catalog') %></span>
        <input type="hidden" name="medicine_id" id="medId" />
        <input id="catSearch" autocomplete="off" class="fld" placeholder="<%= t('pharmacy.admin.search_catalog') %>" />
        <div id="catResults" class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg hidden max-h-64 overflow-auto"></div>
      </div>
      <div><span class="lbl"><%= t('pharmacy.admin.or_new') %> — <%= t('pharmacy.admin.name_ar') %></span><input name="new_name_ar" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.name_en') %></span><input name="new_name_en" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.qty') %></span><input name="qty" type="number" min="0" value="0" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.price') %></span><input name="price" type="number" step="0.01" min="0" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.cost') %></span><input name="cost" type="number" step="0.01" min="0" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.min_qty') %></span><input name="min_qty" type="number" min="0" value="5" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.expiry') %></span><input name="expiry" type="date" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.barcode') %></span><input name="barcode" class="fld" /></div>
      <div><span class="lbl"><%= t('pharmacy.admin.image') %></span><input type="file" name="image_file" accept="image/*" class="fld" style="padding:4px" /></div>
      <div class="sm:col-span-2 lg:col-span-3"><span class="lbl"><%= t('pharmacy.admin.desc') %></span><input name="description" class="fld" /></div>
      <div class="flex items-end"><button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg px-5 py-2 w-full"><%= t('pharmacy.admin.save') %></button></div>
    </form>
  </details>

  <%# Expiry watch. The date was captured from day one and never surfaced — the
      only way to find near-expiry stock was to read every row, which nobody
      does, so it rotted on the shelf. Two counters, each a link that filters
      the list to exactly those items. Shown only when there is something to
      act on: a bar that is permanently on screen stops being read. %>
  <%
    var __exp = (typeof expiryCounts !== 'undefined' && expiryCounts) ? expiryCounts : { expired: 0, soon: 0 };
    var __filter = typeof expiryFilter !== 'undefined' ? expiryFilter : '';
    var __qs = (currentSearch ? '&q=' + encodeURIComponent(currentSearch) : '') + (lang !== 'ar' ? '&lang=' + lang : '');
  %>
  <% if (__exp.out || __exp.low || __filter === 'low' || __filter === 'out') { %>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span class="text-xs font-bold text-gray-400"><%= t('pharmacy.admin.stock_watch') %></span>
    <% if (__exp.out) { %>
      <a href="/pharmacy/inventory?filter=out<%= __qs %>"
         class="text-xs font-bold rounded-full px-3 py-1.5 <%= __filter==='out' ? 'bg-red-600 text-white' : 'text-red-600 bg-red-50 hover:bg-red-100' %>">
        <%= t('pharmacy.out') %> · <%= __exp.out %>
      </a>
    <% } %>
    <% if (__exp.low) { %>
      <a href="/pharmacy/inventory?filter=low<%= __qs %>"
         class="text-xs font-bold rounded-full px-3 py-1.5 <%= __filter==='low' ? 'bg-amber-500 text-white' : 'text-amber-700 bg-amber-50 hover:bg-amber-100' %>">
        <%= t('pharmacy.admin.stock_low') %> · <%= __exp.low %>
      </a>
    <% } %>
    <% if (__filter === 'low' || __filter === 'out') { %>
      <a href="/pharmacy/inventory<%= currentSearch ? '?q=' + encodeURIComponent(currentSearch) : '' %>"
         class="text-xs font-bold text-gray-500 underline px-2"><%= t('pharmacy.admin.exp_show_all') %></a>
    <% } %>
  </div>
  <% } %>

  <% if (__exp.expired || __exp.soon || __filter === 'expired' || __filter === 'soon') { %>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <span class="text-xs font-bold text-gray-400"><%= t('pharmacy.admin.exp_watch') %></span>
    <% if (__exp.expired) { %>
      <a href="/pharmacy/inventory?filter=expired<%= __qs %>"
         class="text-xs font-bold rounded-full px-3 py-1.5 <%= __filter==='expired' ? 'bg-red-600 text-white' : 'text-red-600 bg-red-50 hover:bg-red-100' %>">
        <%= t('pharmacy.admin.exp_expired') %> · <%= __exp.expired %>
      </a>
    <% } %>
    <% if (__exp.soon) { %>
      <a href="/pharmacy/inventory?filter=soon<%= __qs %>"
         class="text-xs font-bold rounded-full px-3 py-1.5 <%= __filter==='soon' ? 'bg-amber-500 text-white' : 'text-amber-700 bg-amber-50 hover:bg-amber-100' %>">
        <%= t('pharmacy.admin.exp_soon') %> · <%= __exp.soon %>
      </a>
    <% } %>
    <% if (__filter === 'expired' || __filter === 'soon') { %>
      <a href="/pharmacy/inventory<%= currentSearch ? '?q=' + encodeURIComponent(currentSearch) : '' %>"
         class="text-xs font-bold text-gray-500 underline px-2"><%= t('pharmacy.admin.exp_show_all') %></a>
    <% } else if (!__exp.expired && !__exp.soon) { %>
      <span class="text-xs text-gray-400"><%= t('pharmacy.admin.exp_none') %></span>
    <% } %>
  </div>
  <% } %>

  <!-- Search -->
  <form method="get" class="mb-4 flex gap-2">
    <% if (lang !== 'ar') { %><input type="hidden" name="lang" value="<%= lang %>" /><% } %>
    <input name="q" value="<%= currentSearch || '' %>" placeholder="<%= t('pharmacy.admin.search_inv') %>" class="fld flex-1" style="padding:10px 12px;font-size:1rem" />
    <button class="bg-gray-800 text-white rounded-lg px-5 font-bold"><%= t('common.search') %></button>
  </form>

  <% if (!items.length) { %>
    <div class="text-center py-14 text-gray-500"><%= t('pharmacy.admin.no_items') %></div>
  <% } else { %>
    <div class="space-y-3">
      <% items.forEach(function(it){
           var expStr = it.expiry ? new Date(it.expiry).toISOString().slice(0,10) : '';
      %>
        <form method="post" action="/pharmacy/inventory/<%= it.id %>/update" enctype="multipart/form-data"
              class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="min-w-0">
              <% var _p = (lang==='en' && it.name_en) ? it.name_en : it.name_ar; var _s = (lang==='en' && it.name_en) ? it.name_ar : it.name_en; %>
              <div class="font-extrabold text-gray-900 truncate"><%= _p %></div>
              <div class="text-xs text-gray-400"><%= _s || '' %><% if (it.form) { %> · <%= it.form %><% } %></div>
            </div>
            <%
              /* stock_status comes from SQL so the badge, the chip counts and
                 the filter can never disagree. It is computed on AVAILABLE
                 stock (qty minus what online orders reserved) — the old badge
                 compared bare qty, so ten boxes with nine reserved showed a
                 green "متوفر" while one was sellable. */
              var avail = Number(it.available_qty)||0;
              var st = it.stock_status === 'out' ? 'out' : (it.stock_status === 'low' ? 'low' : 'in');
            %>
            <div class="shrink-0 flex items-center gap-1.5">
              <%# The expiry badge sits BEFORE the stock badge on purpose: an
                  expired box is not sellable however many of it there are. %>
              <% if (it.expiry_status === 'expired' || it.expiry_status === 'soon') {
                   var d = Math.abs(Number(it.days_to_expiry) || 0); %>
                <span class="text-xs font-bold rounded-full px-2 py-1 <%= it.expiry_status==='expired' ? 'text-white bg-red-600' : 'text-amber-800 bg-amber-100' %>">
                  <% if (it.expiry_status === 'expired') { %>
                    <%= t('pharmacy.admin.exp_expired') %><%= d ? ' · ' + d + ' ' + t('pharmacy.admin.exp_expired_since') : '' %>
                  <% } else { %>
                    <%= d %> <%= t('pharmacy.admin.exp_days_left') %>
                  <% } %>
                </span>
              <% } %>
              <span class="text-xs font-bold rounded-full px-2 py-1 <%= st==='in'?'text-green-700 bg-green-50':(st==='low'?'text-amber-700 bg-amber-50':'text-red-600 bg-red-50') %>">
                <%= st==='in'?t('pharmacy.available'):(st==='low'?t('pharmacy.limited'):t('pharmacy.out')) %>
              </span>
            </div>
          </div>
          <div class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
            <div><span class="lbl"><%= t('pharmacy.admin.qty') %></span><input name="qty" type="number" min="0" value="<%= it.qty %>" class="fld" /></div>
            <div><span class="lbl"><%= t('pharmacy.admin.price') %></span><input name="price" type="number" step="0.01" min="0" value="<%= it.price!=null?Number(it.price):'' %>" class="fld" /></div>
            <div><span class="lbl"><%= t('pharmacy.admin.cost') %></span><input name="cost" type="number" step="0.01" min="0" value="<%= it.cost!=null?Number(it.cost):'' %>" class="fld" /></div>
            <div><span class="lbl"><%= t('pharmacy.admin.min_qty') %></span><input name="min_qty" type="number" min="0" value="<%= it.min_qty %>" class="fld" /></div>
            <div><span class="lbl"><%= t('pharmacy.admin.expiry') %></span><input name="expiry" type="date" value="<%= expStr %>" class="fld" /></div>
            <div><span class="lbl"><%= t('pharmacy.admin.barcode') %></span><input name="barcode" value="<%= it.barcode || '' %>" class="fld" /></div>
            <div class="flex items-center gap-2">
              <% if (it.image_url) { %><img src="<%= it.image_url %>" alt="" class="w-10 h-10 rounded-lg object-cover border border-gray-200 shrink-0" /><% } %>
              <div class="min-w-0"><span class="lbl"><%= it.image_url ? t('pharmacy.admin.change_image') : t('pharmacy.admin.image') %></span><input type="file" name="image_file" accept="image/*" class="fld" style="padding:4px" /></div>
            </div>
            <div class="col-span-2 sm:col-span-3 lg:col-span-6"><span class="lbl"><%= t('pharmacy.admin.desc') %></span><input name="description" value="<%= it.description || '' %>" class="fld" /></div>
          </div>
          <div class="flex gap-2 mt-3">
            <button class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg px-5 py-2 text-sm"><%= t('pharmacy.admin.update') %></button>
            <button formaction="/pharmacy/inventory/<%= it.id %>/delete"
                    onclick="return confirm('<%= t('pharmacy.admin.confirm_delete') %>')"
                    class="bg-red-50 text-red-600 font-bold rounded-lg px-4 py-2 text-sm"><%= t('pharmacy.admin.delete') %></button>
          </div>
        </form>
      <% }) %>
    </div>
  <% } %>
</main>

<script>
(function () {
  var lang = '<%= lang %>';
  var box = document.getElementById('catSearch');
  var results = document.getElementById('catResults');
  var medId = document.getElementById('medId');
  var priceInput = document.querySelector('input[name="price"]');
  if (!box) return;
  var timer = null;

  function hide() { results.classList.add('hidden'); results.innerHTML = ''; }

  function pick(m) {
    medId.value = m.id;
    var primary = (lang === 'en' && m.name_en) ? m.name_en : m.name_ar;
    box.value = primary;
    if (priceInput && !priceInput.value && m.default_price != null) priceInput.value = m.default_price;
    hide();
  }

  function render(list) {
    if (!list.length) { hide(); return; }
    results.innerHTML = '';
    list.forEach(function (m) {
      var a = (lang === 'en' && m.name_en) ? m.name_en : m.name_ar;
      var b = (lang === 'en' && m.name_en) ? m.name_ar : (m.name_en || '');
      var row = document.createElement('div');
      row.className = 'px-3 py-2 text-sm cursor-pointer hover:bg-emerald-50 border-b border-gray-50';
      row.innerHTML = '<div class="font-bold text-gray-800"></div>'
        + '<div class="text-xs text-gray-400"></div>';
      row.children[0].textContent = a;
      row.children[1].textContent = [b, m.manufacturer].filter(Boolean).join(' · ');
      row.addEventListener('mousedown', function (e) { e.preventDefault(); pick(m); });
      results.appendChild(row);
    });
    results.classList.remove('hidden');
  }

  box.addEventListener('input', function () {
    medId.value = ''; // typing invalidates a previous pick
    var q = box.value.trim();
    if (timer) clearTimeout(timer);
    if (q.length < 2) { hide(); return; }
    timer = setTimeout(function () {
      fetch('/pharmacy/api/catalog-search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(render)
        .catch(hide);
    }, 220);
  });

  document.addEventListener('click', function (e) {
    if (e.target !== box && !results.contains(e.target)) hide();
  });
})();
</script>
</body>
</html>
