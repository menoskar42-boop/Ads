<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('pharmacy.orders.title') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>* { font-family: 'Cairo', sans-serif; } .drvmap{height:200px;border-radius:12px;overflow:hidden;margin-top:10px}</style>
</head>
<body class="bg-gray-800/0 text-gray-800 bg-gray-50">
<%- include('nav', { active: 'orders' }) %>

<main class="max-w-3xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓</div><% } %>
  <h1 class="text-xl font-extrabold mb-4"><%= t('pharmacy.orders.title') %></h1>

  <% if (!orders.length) { %>
    <div class="text-center py-14 text-gray-500"><%= t('pharmacy.orders.none') %></div>
  <% } else { %>
    <div class="space-y-3">
      <% orders.forEach(function(o){
           var badge = { pending:'bg-emerald-100 text-emerald-800', accepted:'bg-blue-50 text-blue-700',
             preparing:'bg-indigo-50 text-indigo-700', ready:'bg-purple-50 text-purple-700',
             out_for_delivery:'bg-orange-50 text-orange-700',
             delivered:'bg-green-50 text-green-700', rejected:'bg-red-50 text-red-600', cancelled:'bg-gray-100 text-gray-500' }[o.status] || 'bg-gray-100 text-gray-600';
           var ev = (typeof lastEvent !== 'undefined' && lastEvent) ? lastEvent[o.id] : null;
      %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="font-extrabold"><%= t('pharmacy.orders.order') %> #<%= o.id %></span>
            <span class="text-xs font-bold rounded-full px-2 py-1 <%= badge %>"><%= t('pharmacy.status.' + o.status) %></span>
          </div>
          <div class="text-sm text-gray-600 mb-2">
            👤 <%= o.customer_name %> · <span dir="ltr"><%= o.customer_phone %></span>
            <% if (o.customer_address) { %><br>📍 <%= o.customer_address %><% } %>
          </div>
          <ul class="text-sm text-gray-700 mb-3 ps-1">
            <% (itemsByOrder[o.id] || []).forEach(function(it){ var _nm = (lang==='en' && it.med_en) ? it.med_en : it.name; %>
              <li>• <%= _nm %> × <%= it.qty %><% if (it.price!=null) { %> — <%= Number(it.price).toFixed(2) %> <%= t('pharmacy.currency') %><% } %></li>
            <% }) %>
          </ul>
          <% if (ev && ev.actor) { %>
            <div class="text-xs text-gray-400 mb-2"><%= t('pharmacy.orders.changed_by') %>: <span class="font-bold text-gray-500"><%= ev.actor %></span></div>
          <% } %>
          <div class="flex items-center justify-between gap-2 border-t pt-3">
            <span class="font-extrabold text-emerald-700"><%= Number(o.total_amount||0).toFixed(2) %> <%= t('pharmacy.currency') %></span>
            <form method="post" action="/pharmacy/orders/<%= o.id %>/status" class="flex items-center gap-2">
              <select name="status" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm">
                <% flow.forEach(function(s){ %><option value="<%= s %>" <%= s===o.status?'selected':'' %>><%= t('pharmacy.status.' + s) %></option><% }) %>
              </select>
              <button class="bg-gray-800 text-white rounded-lg px-3 py-1.5 text-sm font-bold"><%= t('pharmacy.orders.change_status') %></button>
            </form>
          </div>
          <% if (o.status === 'out_for_delivery') { %>
            <div class="mt-3 pt-3 border-t">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-bold text-orange-700"><%= t('pharmacy.gps.driver_map') %></span>
                <% if (perms && perms.deliveryOnly) { %>
                  <button type="button" class="gps-share bg-orange-600 text-white rounded-lg px-3 py-1.5 text-sm font-bold" data-oid="<%= o.id %>"><%= t('pharmacy.gps.share') %></button>
                <% } %>
              </div>
              <div class="drvmap" id="map-<%= o.id %>" data-oid="<%= o.id %>"></div>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>
<script>
(function(){
  if (typeof L === 'undefined') return;
  var shareTxt = <%- jsonLd(t('pharmacy.gps.share')) %>;
  var stopTxt  = <%- jsonLd(t('pharmacy.gps.sharing')) %>;

  // Live driver map per out-for-delivery order (poll the pharmacy endpoint).
  document.querySelectorAll('.drvmap').forEach(function(el){
    var oid = el.getAttribute('data-oid');
    var map = L.map(el, { attributionControl:false }).setView([26.82, 30.80], 6);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom:19 }).addTo(map);
    var marker = null;
    function poll(){
      fetch('/pharmacy/orders/'+oid+'/location').then(function(r){return r.json();}).then(function(d){
        if(d && d.lat!=null && d.lng!=null){
          var ll=[Number(d.lat), Number(d.lng)];
          if(!marker){ marker=L.marker(ll).addTo(map); map.setView(ll,15); } else { marker.setLatLng(ll); }
        }
      }).catch(function(){});
    }
    setTimeout(function(){ map.invalidateSize(); poll(); }, 200);
    setInterval(poll, 8000);
  });

  // Delivery driver: toggle sharing their live location.
  document.querySelectorAll('.gps-share').forEach(function(btn){
    var oid = btn.getAttribute('data-oid'); var watch = null;
    btn.onclick = function(){
      if(watch !== null){ navigator.geolocation.clearWatch(watch); watch=null; btn.textContent=shareTxt; btn.classList.remove('bg-red-600'); btn.classList.add('bg-orange-600'); return; }
      if(!navigator.geolocation){ return; }
      btn.textContent=stopTxt; btn.classList.remove('bg-orange-600'); btn.classList.add('bg-red-600');
      watch = navigator.geolocation.watchPosition(function(pos){
        fetch('/pharmacy/orders/'+oid+'/location',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({lat:pos.coords.latitude,lng:pos.coords.longitude})}).catch(function(){});
      }, function(){}, { enableHighAccuracy:true, maximumAge:5000, timeout:20000 });
    };
  });
})();
</script>
</body>
</html>
