<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('ph.po.title') %> #<%= po.id %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>
  * { font-family: 'Cairo', sans-serif; }
  .fld { border:1px solid #d1d5db; border-radius:8px; padding:6px 8px; font-size:.85rem; width:100%; background:#fff; }
  .lbl { font-size:.7rem; color:#6b7280; margin-bottom:2px; display:block; }
</style>
</head>
<body class="bg-gray-50 text-gray-900">
<%- include('nav', { active: 'purchases' }) %>

<main class="max-w-5xl mx-auto px-4 py-6">
  <%
    var tone = state === 'received' ? 'bg-emerald-100 text-emerald-800'
             : state === 'partial' ? 'bg-amber-100 text-amber-800'
             : state === 'cancelled' ? 'bg-gray-200 text-gray-600'
             : state === 'sent' ? 'bg-sky-100 text-sky-800'
             : 'bg-gray-100 text-gray-600';
    var money = !(typeof perms !== 'undefined' && perms) || perms.canFinance !== false;
  %>
  <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
    <div>
      <h1 class="text-xl font-extrabold mb-1"><%= t('ph.po.title') %> #<%= po.id %></h1>
      <p class="text-sm text-gray-500"><%= po.supplier || t('ph.po.no_supplier') %> · <%= new Date(po.created_at).toLocaleString(LOC) %></p>
    </div>
    <span class="text-xs font-bold rounded-full px-3 py-1.5 <%= tone %>"><%= t('ph.po.state.' + state) %></span>
  </div>

  <% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm mb-4"><%= t('ph.po.saved') %></div><% } %>
  <% if (err) { %><div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm mb-4"><%= t('ph.po.err.' + err) %></div><% } %>

  <%# The two states a person sets. «اتستلم» is not one of them — it is read
      from the lines below, so it cannot disagree with them. %>
  <div class="flex items-center gap-2 flex-wrap mb-5">
    <% if (state === 'draft') { %>
      <form method="POST" action="/pharmacy/purchases/<%= po.id %>/status">
        <input type="hidden" name="status" value="sent" />
        <button class="bg-sky-600 hover:bg-sky-700 text-white font-bold rounded-xl px-5 py-2 text-sm"><%= t('ph.po.mark_sent') %></button>
      </form>
    <% } %>
    <% if (state !== 'cancelled' && state !== 'received') { %>
      <form method="POST" action="/pharmacy/purchases/<%= po.id %>/status">
        <input type="hidden" name="status" value="cancelled" />
        <button class="bg-white border border-gray-200 text-gray-600 font-bold rounded-xl px-5 py-2 text-sm"><%= t('ph.po.cancel') %></button>
      </form>
    <% } %>
    <% if (money) { %>
      <span class="text-xs text-gray-500 ms-auto"><%= t('ph.po.total_ordered') %>: <%= totals.ordered.toFixed(2) %> · <%= t('ph.po.total_received') %>: <%= totals.received.toFixed(2) %></span>
    <% } %>
  </div>

  <div class="space-y-3">
    <% items.forEach(function (i) {
         var lt = i.lineState === 'complete' ? 'bg-emerald-100 text-emerald-800'
                : i.lineState === 'partial' ? 'bg-amber-100 text-amber-800'
                : i.lineState === 'over' ? 'bg-sky-100 text-sky-800'
                : 'bg-gray-100 text-gray-600';
    %>
      <div class="bg-white border border-gray-100 rounded-2xl p-4">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div class="min-w-0">
            <div class="font-bold text-gray-800"><%= i.name_at_order || i.name %></div>
            <div class="text-xs text-gray-500 mt-1">
              <%= t('ph.po.ordered') %>: <%= i.qty_ordered %> ·
              <%= t('ph.po.received') %>: <%= i.qty_received %> ·
              <%= t('ph.po.outstanding') %>: <%= i.outstanding %>
              <% if (money && i.cost != null) { %> · <%= t('ph.po.cost') %>: <%= Number(i.cost).toFixed(2) %><% } %>
            </div>
          </div>
          <span class="text-xs font-bold rounded-full px-2.5 py-1 <%= lt %>"><%= t('ph.po.line.' + i.lineState) %></span>
        </div>

        <% if (canReceive.ok) { %>
          <%# `expected` is the count this form was drawn with. The server only
              accepts the receipt while that is still the count in the table, so
              a double-tap records one delivery, not two. %>
          <form method="POST" action="/pharmacy/purchases/<%= po.id %>/receive" class="grid sm:grid-cols-<%= money ? 5 : 4 %> gap-2 mt-3 items-end">
            <input type="hidden" name="item_id" value="<%= i.id %>" />
            <input type="hidden" name="expected" value="<%= i.qty_received %>" />
            <label><span class="lbl"><%= t('ph.po.arrived') %></span>
              <input name="qty" type="number" min="1" value="<%= i.outstanding || 1 %>" class="fld" required /></label>
            <label><span class="lbl"><%= t('ph.po.batch_no') %></span><input name="batch_no" maxlength="60" class="fld" /></label>
            <label><span class="lbl"><%= t('ph.po.expiry') %></span><input name="expiry" type="date" class="fld" /></label>
            <%# The cost is a money field. A pharmacist who may receive stock but
                may not see the takings does not get shown what it was bought
                for — and leaving the field out means the server keeps the cost
                the order was placed with, rather than blanking it. %>
            <% if (money) { %>
            <label><span class="lbl"><%= t('ph.po.cost') %></span>
              <input name="cost" type="number" step="0.01" min="0" value="<%= i.cost == null ? '' : i.cost %>" class="fld" /></label>
            <% } %>
            <button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-4 py-2 text-sm"><%= t('ph.po.receive') %></button>
          </form>
        <% } else { %>
          <p class="text-xs text-gray-400 mt-3"><%= t('ph.po.cannot.' + canReceive.why) %></p>
        <% } %>
      </div>
    <% }); %>
  </div>

  <% if (receipts.length) { %>
    <h2 class="font-bold text-gray-700 text-sm mt-6 mb-2"><%= t('ph.po.deliveries') %></h2>
    <div class="bg-white border border-gray-100 rounded-2xl divide-y divide-gray-100">
      <% receipts.forEach(function (r) { %>
        <div class="px-4 py-2.5 text-xs text-gray-600 flex items-center justify-between gap-3 flex-wrap">
          <span><%= new Date(r.created_at).toLocaleString(LOC) %> · <%= r.received_by || '' %></span>
          <span><%= t('ph.po.qty') %>: <%= r.qty %><% if (r.batch_no) { %> · <%= t('ph.po.batch_no') %>: <%= r.batch_no %><% } %><% if (r.expiry) { %> · <%= t('ph.po.expiry') %>: <%= new Date(r.expiry).toLocaleDateString(LOC) %><% } %></span>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body></html>
