<%- include('partials/header') %>
<%- include('partials/nav') %>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      منصة واحدة تدير نشاطك من أوله لآخره
    </div>

    <h1>
      <span class="line-1">منصة حلول رقمية</span>
      <span class="line-2">متكاملة لنشاطك</span>
    </h1>

    <p class="hero-sub">
      مش مجرد تصميم مواقع. عندك موقع أو متجر إلكتروني، ونظام إدارة كامل
      لعيادتك أو صيدليتك أو مطعمك أو الجيم أو عيادة التغذية أو معرض الموبيليا،
      وتطبيقات موبايل — كله من مكان واحد وبفريق واحد.
    </p>

    <div class="hero-actions">
      <button class="btn-primary" onclick="document.getElementById('services').scrollIntoView({behavior:'smooth'})">
        ⚡ اختر الحل المناسب لنشاطك
      </button>
      <button class="btn-ghost" onclick="document.getElementById('process').scrollIntoView({behavior:'smooth'})">
        كيف نشتغل؟
      </button>
    </div>

    <div class="stats-bar">
      <div class="stat">
        <div class="stat-num"><span>8</span></div>
        <div class="stat-label">أنظمة جاهزة لكل نشاط</div>
      </div>
      <div class="stat">
        <div class="stat-num">+<span>50</span></div>
        <div class="stat-label">مشروع تم تسليمه</div>
      </div>
      <div class="stat">
        <div class="stat-num"><span>7</span> أيام</div>
        <div class="stat-label">وقت التسليم</div>
      </div>
    </div>
  </div>
</section>

