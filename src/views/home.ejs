<!-- PROCESS -->
<section class="process" id="process">
  <div class="process-inner">
    <div class="process-header">
      <div class="section-tag">🗺 طريقة العمل</div>
      <h2 class="section-title reveal">من <em>فكرتك</em> لموقع شغال</h2>
      <p class="section-sub reveal">4 خطوات بسيطة وموقعك جاهز</p>
    </div>
    <div class="process-steps">
      <div class="step">
        <div class="step-num">01</div>
        <div>
          <div class="step-title">تكلمنا عن فكرتك</div>
          <p class="step-desc">بتقولنا إيه اللي عاوزه، الهدف من الموقع، ومين الجمهور المستهدف. محتاج 15 دقيقة بس.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <div>
          <div class="step-title">عرض الأسعار والتصميم</div>
          <p class="step-desc">بنبعتلك عرض سعر مفصّل وأمثلة تصاميم مشابهة. بتوافق وتاخد بال، ونبدأ.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <div>
          <div class="step-title">التنفيذ والمراجعة</div>
          <p class="step-desc">بنبدأ الشغل ونبعتلك نسخة للمراجعة. بتقولنا التعديلات وبنعملها على طول.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <div>
          <div class="step-title">التسليم والرفع</div>
          <p class="step-desc">موقعك على النت، معاك تدريب على الاستخدام، ودعم لمدة شهر مجاناً.</p>
        </div>
      </div>
    </div>
  </div>
</section>

