<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      متاح الآن للمشاريع الجديدة
    </div>

    <h1>
      <span class="line-1">مواقع تفتح لك</span>
      <span class="line-2">أبواب النجاح</span>
    </h1>

    <p class="hero-sub">
      موقع احترافي يجعل عملاءك يثقون فيك من اللحظة الأولى.
      سواء كنت محتاج بورتفوليو يُبرز موهبتك، أو متجر إلكتروني يبيع على مدار الساعة.
    </p>

    <div class="hero-actions">
      <button class="btn-primary" onclick="document.getElementById('services').scrollIntoView({behavior:'smooth'})">
        ⚡ اطلب موقعك الآن
      </button>
      <button class="btn-ghost" onclick="document.getElementById('process').scrollIntoView({behavior:'smooth'})">
        كيف نشتغل؟
      </button>
    </div>

    <div class="stats-bar">
      <div class="stat">
        <div class="stat-num">+<span>50</span></div>
        <div class="stat-label">موقع تم تسليمه</div>
      </div>
      <div class="stat">
        <div class="stat-num"><span>100</span>%</div>
        <div class="stat-label">رضا العملاء</div>
      </div>
      <div class="stat">
        <div class="stat-num"><span>7</span> أيام</div>
        <div class="stat-label">وقت التسليم</div>
      </div>
    </div>
  </div>
</section>

