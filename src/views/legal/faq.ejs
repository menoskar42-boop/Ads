<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<%- include('../partials/ads_loader') %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% var pageTitle = 'الأسئلة الشائعة — OscarDevs'; %>
<% var pageDescription = 'إجابات سريعة عن أسعار ومدّة تنفيذ المواقع والمتاجر، طرق الدفع والاشتراك، إدارة موقعك بنفسك، ملكية الدومين والبيانات، والدعم بعد التسليم في OscarDevs.'; %>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDescription %>" />
<%- include('../partials/seo_meta', { title: pageTitle, description: pageDescription }) %>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50">

<header class="bg-white shadow-sm">
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold text-indigo-700">OscarDevs</a>
    <nav class="text-sm text-gray-500 flex gap-4">
      <a href="/" class="hover:text-indigo-700">الرئيسية</a>
      <a href="/about" class="hover:text-indigo-700">من نحن</a>
      <a href="/blog" class="hover:text-indigo-700">المدوّنة</a>
      <a href="/contact" class="hover:text-indigo-700">اتصل بنا</a>
    </nav>
  </div>
</header>

<%# BreadcrumbList اتشال من هنا: الـpartial `breadcrumbs` بيطلّعه بالفعل،
    فالصفحة كانت بتنشر الكيان مرتين. جوجل بتشترط واحد لكل صفحة، وتكراره
    بيخلّي أي اختلاف بينهم تناقض في نفس الصفحة. %>
<main class="max-w-4xl mx-auto px-4 py-10">
  <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'الرئيسية', href: '/' }, { label: 'الأسئلة الشائعة' } ] }) %>
  <header class="text-center mb-10">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3">الأسئلة الشائعة</h1>
    <p class="text-gray-500 max-w-2xl mx-auto leading-relaxed">جمعنا الأسئلة اللي بتوصلنا أكتر من غيرها، وإجاباتها المباشرة. لو سؤالك مش هنا، <a href="/contact" class="text-indigo-700 font-semibold underline">تواصل معنا</a>.</p>
  </header>

  <%
    var faqs = [
      { q: 'إيه هي OscarDevs؟', a: 'منصّة عربية ليها وجهان: (١) تقدر تنشئ بنفسك (self-service) نوع من أربع صفحات — بورتفوليو، متجر إلكتروني، صيدلية أونلاين، أو صفحة مطاعم/سوبر ماركت للطلبات، و(٢) نقدّم خدمة تصميم مواقع وتطبيقات موبايل مخصّصة للشركات. كله موجّه للسوق العربي بتصميم احترافي وأسعار مناسبة.' },
      { q: 'إيه أنواع الصفحات اللي أقدر أنشئها؟', a: 'أربعة أنواع: <strong>بورتفوليو</strong> (يعرض أعمالك وخدماتك مع نموذج تواصل)، <strong>متجر إلكتروني</strong> (سلّة ودفع وطلبات وشحن)، <strong>صيدلية أونلاين</strong> (كتالوج أدوية بمخزون وسلة وتتبّع طلب وتوصيل)، و<strong>مطاعم/سوبر ماركت</strong> (منيو بأصناف وسلة وطلب أونلاين وتتبّع). كل نوع بلوحة تحكم عربية سهلة.' },
      { q: 'إيه الفرق بين موقع البورتفوليو والمتجر الإلكتروني؟', a: 'البورتفوليو موقع يعرض أعمالك وخدماتك للحصول على عملاء جدد عن طريق نموذج تواصل. المتجر الإلكتروني نقطة بيع كاملة بسلّة، دفع، ونظام طلبات وشحن. لو بتبيع خدمات بسعر متفاوض، اختر بورتفوليو. لو بتبيع منتجات بسعر ثابت، اختر متجر إلكتروني.' },
      { q: 'عندي صيدلية أو مطعم — أقدر أستخدم المنصّة؟', a: 'أكيد. <strong>الصيدلية</strong> بتيجي بكتالوج أدوية جاهز، إدارة مخزون، سلة تطلب أكتر من دواء مرة واحدة، وتتبّع للطلب. <strong>المطاعم والسوبر ماركت</strong> بتيجي بمنيو بأقسام وأصناف وصور، سلة، طلب أونلاين، وتتبّع حالة. الصفحة والطلبات مجانية بالكامل.' },
      { q: 'هل المنصّة مجانية فعلاً؟', a: 'حالياً إنشاء موقع البورتفوليو أو المتجر الإلكتروني على منصّتنا <strong>مجاني</strong> لعدد محدود من الأنشطة ضمن عرض مؤقت — تسجّل بنفسك وتضيف منتجاتك أو أعمالك من لوحة تحكّم بسيطة. أما تصميم موقع أو تطبيق موبايل مخصّص للشركات فهو خدمة مدفوعة منفصلة.' },
      { q: 'كم تكلفة الموقع؟', a: 'موقع البورتفوليو أو المتجر الإلكتروني على المنصّة <strong>مجاني حالياً</strong> (عرض مؤقت، تنشئه بنفسك). أما المشاريع المخصّصة (تصميم موقع خاص أو تطبيق موبايل للشركات) فلها تكلفة حسب المتطلبات، نتفق عليها قبل البدء. ولو بتقارن نماذج التسعير (اشتراك ثابت مقابل عمولة على كل بيعة)، <a href="/compare">فيه صفحة بتحسبها بأرقامك</a>.' },
      { q: 'في كم يوم يكون الموقع جاهز؟', a: 'لو بتنشئ متجرك أو بورتفوليوك على المنصّة بنفسك، بيكون جاهز <strong>فوراً</strong> بعد التفعيل وتبدأ تضيف محتواك في دقايق. أما المشروع المخصّص (موقع أو تطبيق) فمدّته حسب حجمه، وغالباً من أسبوع لأسبوعين.' },
      { q: 'هل أحتاج خبرة تقنية لإدارة موقعي؟', a: 'لا. كل المواقع بتيجي بلوحة تحكم سهلة، تقدر من خلالها تعدّل النصوص، الألوان، الشعار، البانرات، المنتجات، والإعدادات بدون أي كود. وبنوفّر تدريب مختصر بعد التسليم.' },
      { q: 'هل بتدعموا اللغة العربية بالكامل؟', a: 'نعم، كل المواقع متاحة بالعربية (RTL) وبواجهة إدارة عربية كاملة، مع إمكانية تفعيل الإنجليزية كلغة ثانية على نفس الموقع.' },
      { q: 'هل اسم النطاق (Domain) داخل الخدمة؟', a: 'متجرك أو بورتفوليوك على المنصّة بييجي على رابط فرعي مجاني (اسمك.oscardevs.com). لو حابب دومين خاص (.com) بنساعدك تحجزه ويكلّف حوالي ١٠-١٥ دولار سنوياً تدفعهم لمزوّد النطاق مباشرة. في المشاريع المخصّصة بنرتّب الاستضافة والدومين ضمن الاتفاق.' },
      { q: 'كيف يتم الدفع؟', a: 'إنشاء البورتفوليو أو المتجر على المنصّة مجاني حالياً، فمفيش دفع. أما المشاريع المخصّصة فبنظام ٥٠٪ مقدّم لبدء العمل و٥٠٪ بعد المعاينة والاعتماد، عن طريق التحويل البنكي أو InstaPay أو Vodafone Cash.' },
      { q: 'هل بتقدّموا دعم بعد التسليم؟', a: 'نعم. أول ٣٠ يوم بعد التسليم بنوفّر دعم مجاني لأي مشكلة فنية أو استفسار. بعدها فيه باقات صيانة شهرية اختيارية تشمل التحديثات، النسخ الاحتياطي، والدعم الفني.' },
      { q: 'هل أملك موقعي بالكامل بعد التسليم؟', a: 'نعم، الموقع والمحتوى ملكك ١٠٠٪. تقدر تنقل البيانات لأي مكان، تطلب نسخة احتياطية كاملة، أو تنقل النطاق لأي مزوّد آخر. مفيش قفل تقني علينا.' },
      { q: 'هل المواقع متوافقة مع الموبايل؟', a: 'كل المواقع متجاوبة بالكامل (Mobile-first) وبتشتغل بسلاسة على كل أحجام الشاشات: موبايل، تابلت، حاسوب. وبنختبر يدوياً قبل التسليم.' },
      { q: 'هل بتقدّموا خدمات SEO؟', a: 'نعم، كل مواقعنا بتيجي بـ SEO جاهز من أول يوم: hierarchy عناوين صحيحة، meta tags، sitemap.xml، canonical URLs، structured data، وسرعة عالية. وبنقدّم استشارة SEO مدفوعة لو محتاج خطة محتوى متقدّمة.' },
      { q: 'إيه طرق الدفع المتاحة لعملائي؟', a: 'الافتراضي هو <strong>الدفع عند الاستلام</strong>، وتقدر من لوحة التحكم تضيف طرق تانية تظهر لعميلك: تحويل على محفظة إلكترونية (فودافون/اتصالات/أورنج كاش)، InstaPay، Payoneer، تحويل بنكي، أو صياغة خاصة زي «٥٠٪ مقدّم و٥٠٪ عند الاستلام». تظهر الطرق اللي بتختارها بس، وإلا يفضل الدفع عند الاستلام.' },
      { q: 'هل ممكن أربط بوابة دفع أونلاين خاصة بيّ؟', a: 'نعم. بندعم <strong>Paymob</strong> وغيرها (Fawry, Stripe, PayPal — تباعاً)، وكل تاجر بيدخل <strong>مفاتيح حسابه الخاصة</strong> في إعداداته، فالمدفوعات بتروح لحساب التاجر مباشرة على البوابة. وتقدر تختار تخلّي الدفع أونلاين مع باقي الطرق أو تكتفي بالبوابة.' },
      { q: 'هل فيه نظام حسابات وأرباح للتاجر؟', a: 'نعم، كل صفحة ليها <strong>نظام محاسبي كامل</strong>: تسجّل سعر الشراء (الجملة) لكل منتج، المصروفات الثابتة (مرتبات/إيجار/مرافق)، وعمولات الموظفين، ويطلع لك <strong>تقرير أرباح شهري</strong> تلقائي (إيرادات − تكلفة − مصروفات − عمولات − ضريبة = صافي الربح). الضريبة اختيارية (على الربح أو المبيعات) والافتراضي بدونها.' },
      { q: 'هل بتدعموا التوصيل وعمولات الموظفين؟', a: 'نعم، تقدر تفعّل التوصيل وتحدّد رسومه، وتسجّل موظفينك (ديليفري/شيف/استقبال/كاشير) بعمولات لكل طلب أو نسبة من المبيعات أو مبلغ ثابت شهري — وكلها بتتحسب تلقائياً ضمن تقرير الأرباح.' },
      { q: 'إيه هو مساعد الطلب الذكي؟', a: 'ميزة اختيارية <strong>مدفوعة</strong> لصفحات المطاعم: العميل يكتب طلبه بلغته الطبيعية (مثلاً «عايز ٢ برجر وعصير») والمساعد يفهمه ويجهّز السلة تلقائياً من منيوك أنت فقط. الصفحة والطلبات نفسها مجانية، والمساعد الذكي هو الجزء المدفوع اللي تقدر تفعّله لو حبيت.' },
      { q: 'لو محتاج تعديل بعد التسليم، يتكلّف كام؟', a: 'التعديلات الصغيرة (نصوص، صور، أسعار) تقدر تعملها بنفسك من لوحة التحكم مجاناً. التعديلات الكبيرة (إعادة تصميم، ميزات جديدة) لها سعر منفصل حسب الطلب.' },
      { q: 'كيف أبدأ؟', a: 'لو عايز صفحة على المنصّة (بورتفوليو، متجر، صيدلية، أو مطاعم): سجّل بنفسك من صفحة <a href="/apply" class="text-indigo-700 underline">قدّم طلب</a>، اختر النوع، وبعد التفعيل تبدأ تضيف محتواك وتظبط الدفع والحسابات من لوحة التحكم. لو عايز موقع أو تطبيق مخصّص: تواصل معنا من <a href="/contact" class="text-indigo-700 underline">صفحة التواصل</a> ونرتّب التفاصيل.' }
    ];
  %>

  <div class="space-y-3">
    <% faqs.forEach(function(f){ %>
      <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
        <summary class="cursor-pointer p-5 flex items-center justify-between gap-3 font-bold text-gray-800 hover:text-indigo-700 transition list-none">
          <span><%= f.q %></span>
          <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-gray-600 leading-loose text-[15px]"><%- f.a %></div>
      </details>
    <% }) %>
  </div>

  <div class="mt-10 bg-indigo-50 border border-indigo-100 rounded-2xl p-6 text-center">
    <p class="text-gray-700 mb-3">عندك سؤال مش موجود هنا؟</p>
    <a href="/contact" class="inline-block bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl hover:bg-indigo-800 transition shadow">اسألنا مباشرة</a>
  </div>
  <%- include('../partials/ad_unit', { slot: ads.slots.pageBottom }) %>
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    <% faqs.forEach(function(f, i){ %>
    {
      "@type": "Question",
      "name": <%- jsonLd(f.q) %>,
      "acceptedAnswer": { "@type": "Answer", "text": <%- jsonLd(f.a.replace(/<[^>]*>/g, '')) %> }
    }<%= i < faqs.length - 1 ? ',' : '' %>
    <% }) %>
  ]
}
</script>

</body>
</html>
