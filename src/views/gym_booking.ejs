<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# A private link to one booking: never indexed. %>
<meta name="robots" content="noindex,nofollow" />
<title><%= t('gb.title') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>*{font-family:'Cairo',sans-serif}body{background:#0a0a0a;color:#e5e5e5}.fld{background:#0f0f0f;border:1px solid #2a2a2a;color:#e5e5e5}.accent-bg{background:#E4FF1A;color:#0a0a0a}</style>
</head>
<body class="min-h-screen grid place-items-center p-4">
  <div class="w-full max-w-sm">
    <a href="https://<%= company.slug %>.oscardevs.com" class="block text-center font-black text-xl mb-1">🏋️ <%= company.company_name %></a>
    <h1 class="text-center text-neutral-400 text-sm mb-6"><%= t('gb.title') %></h1>

    <% if (saved) { %>
      <div class="rounded-2xl p-4 mb-4 text-center bg-emerald-900/40 border border-emerald-700 text-emerald-300 text-sm font-bold"><%= t('gb.saved') %></div>
    <% } %>
    <% if (err) { %>
      <div class="rounded-2xl p-4 mb-4 text-center bg-red-900/30 border border-red-800 text-red-300 text-sm font-bold"><%= t('gb.err.' + err) %></div>
    <% } %>

    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 mb-4">
      <div class="font-black text-lg"><%= booking.class_name %></div>
      <div class="text-sm text-neutral-400 mt-1">
        <%= booking.booking_date ? String(booking.booking_date).slice(0, 10) : '' %><% if (booking.start_time) { %> · <%= booking.start_time %><% } %><% if (booking.trainer_name) { %> · <%= booking.trainer_name %><% } %>
      </div>
      <div class="text-sm text-neutral-400"><%= booking.member_name %></div>

      <%# The three states a member can be in, said plainly — including the one
          that used to be invisible: waiting, and where in the queue. %>
      <div class="mt-3">
        <% if (booking.status === 'booked') { %>
          <span class="text-sm font-bold text-emerald-400"><%= t('gb.st.booked') %></span>
          <% if (booking.promoted_at) { %>
            <div class="text-xs text-emerald-300 mt-1"><%= t('gb.promoted') %></div>
          <% } %>
        <% } else if (booking.status === 'waitlist') { %>
          <span class="text-sm font-bold text-amber-400"><%= t('gb.st.waitlist') %></span>
          <% if (place) { %><span class="text-xs text-neutral-400">· <%= t('gb.place') %> <%= place %></span><% } %>
        <% } else { %>
          <span class="text-sm font-bold text-neutral-500"><%= t('gb.st.cancelled') %></span>
        <% } %>
      </div>
    </div>

    <% if (canCancel.ok) { %>
      <form method="post" action="/gym/booking/<%= booking.token %>/move" class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 grid gap-3 mb-3">
        <label class="text-xs text-neutral-400"><%= t('gb.move') %></label>
        <input name="date" type="date" required class="fld rounded-xl px-4 py-3 text-sm text-center" />
        <p class="text-xs text-neutral-500"><%= t('gb.move_hint') %></p>
        <button class="bg-neutral-800 text-neutral-100 font-bold rounded-xl py-3"><%= t('gb.move_do') %></button>
      </form>

      <form method="post" action="/gym/booking/<%= booking.token %>/cancel"
            onsubmit="return confirm(<%= JSON.stringify(t('gb.cancel_confirm')) %>)">
        <button class="w-full bg-red-900/40 border border-red-800 text-red-300 font-bold rounded-xl py-3"><%= t('gb.cancel') %></button>
      </form>
      <p class="text-xs text-neutral-500 text-center mt-3"><%= t('gb.free_seat') %></p>
    <% } else { %>
      <p class="text-xs text-neutral-500 text-center"><%= t('gb.err.' + canCancel.why) %></p>
    <% } %>
  </div>
</body>
</html>
