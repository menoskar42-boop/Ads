<% pageTitle = t('coach.title') %>
<%- include('head') %>
<main class="wrap" style="padding-top:6px;display:flex;flex-direction:column;min-height:calc(100vh - 150px)">
  <div style="display:flex;align-items:center;gap:10px;margin:4px 4px 12px">
    <span style="display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:var(--accent);color:#fff;font-size:1.2rem">🤖</span>
    <div><h1 class="kkb-display" style="font-size:1.15rem;margin:0"><%= t('coach.title') %></h1><div class="muted" style="font-size:.74rem"><%= t('coach.hint') %></div></div>
  </div>

  <% if (!aiEnabled) { %>
    <div class="card" style="padding:24px;text-align:center"><p class="muted" style="margin:0"><%= t('coach.off') %></p></div>
  <% } else { %>
    <div id="log" style="flex:1;display:flex;flex-direction:column;gap:10px;overflow-y:auto;padding:4px 2px 12px"></div>
    <div id="starters" style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:8px">
      <% ['coach.q1','coach.q2','coach.q3'].forEach(function(q){ %><button type="button" class="pill starter"><%= t(q) %></button><% }) %>
    </div>
    <form id="coachForm" style="display:flex;gap:8px;padding-bottom:6px">
      <input id="cInput" class="fld" autocomplete="off" maxlength="300" placeholder="<%= t('coach.placeholder') %>" style="flex:1" />
      <button id="cSend" class="btn btn-primary" style="width:auto;padding:0 18px">➤</button>
    </form>
  <% } %>
</main>
<script>
(function(){
  var log=document.getElementById('log'), form=document.getElementById('coachForm'), inp=document.getElementById('cInput'), send=document.getElementById('cSend');
  if(!form) return;
  var OFF=<%- JSON.stringify(t('coach.off')) %>, LIM=<%- JSON.stringify(t('coach.limited')) %>, ERR=<%- JSON.stringify(t('coach.err')) %>;
  var history=[], busy=false;
  function bubble(role,text){
    var w=document.createElement('div'); w.style.cssText='display:flex;'+(role==='user'?'justify-content:flex-start':'justify-content:flex-end');
    var b=document.createElement('div'); b.textContent=text;
    b.style.cssText='max-width:82%;padding:10px 13px;border-radius:16px;font-size:.9rem;line-height:1.5;'+(role==='user'?'background:var(--paper);border:1px solid var(--line)':'background:var(--accent);color:#fff');
    w.appendChild(b); log.appendChild(w); log.scrollTop=log.scrollHeight; return b;
  }
  function ask(msg){
    if(busy||!msg) return; busy=true; send.disabled=true;
    bubble('user',msg); history.push({role:'user',content:msg});
    var t=bubble('assistant','…');
    fetch('/coach/ask',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg,history:history.slice(-6)})})
      .then(function(r){return r.json();}).then(function(d){
        t.textContent = d.reply || (d.disabled?OFF:(d.limited?LIM:ERR));
        if(d.reply) history.push({role:'assistant',content:d.reply});
      }).catch(function(){ t.textContent=ERR; }).then(function(){ busy=false; send.disabled=false; });
  }
  form.addEventListener('submit',function(e){ e.preventDefault(); var v=(inp.value||'').trim(); if(!v)return; inp.value=''; var s=document.getElementById('starters'); if(s)s.style.display='none'; ask(v); });
  document.querySelectorAll('.starter').forEach(function(b){ b.addEventListener('click',function(){ var s=document.getElementById('starters'); if(s)s.style.display='none'; ask(b.textContent); }); });
})();
</script>
<%- include('app_nav', { active: 'home' }) %>
<%- include('foot') %>
