<% pageTitle = t('nav.home') %>
<%- include('head') %>
<%
  var __cat = {}; CATEGORIES.forEach(function(c){ __cat[c.key]=c; });
  function __d(v){ try { return new Date(v).toLocaleDateString(lang==='en'?'en-US':'ar-EG',{day:'numeric',month:'short'}); } catch(e){ return ''; } }

  // This page has ONE job: answer "can I spend right now, and how much?" — the
  // question kakeibo is a method for asking, at the till, in two seconds.
  // Everything that does not answer it moved below into a section the reader
  // opens on purpose.
  //
  // Three states with different copy each, because the right thing to do
  // differs: today's money is still there / today is spent / the whole period
  // is overspent.
  var __state = data.overBudget ? 'over' : (data.leftToday < 0 ? 'today_done' : 'ok');
  var __tone  = __state === 'ok' ? 'var(--accent-2)' : 'var(--warn)';
  var __hero  = __state === 'ok' ? data.leftToday : Math.abs(data.leftToday);
  var __usedPct = data.perDay > 0 ? Math.min(100, Math.round(data.spentToday / data.perDay * 100)) : 100;
%>
<main class="wrap" style="max-width:520px;padding-top:6px">

  <!-- ══════════ THE ANSWER ══════════ -->
  <section class="card" style="padding:26px 22px 22px;text-align:center;background:linear-gradient(135deg,var(--surface),var(--paper))">
    <div class="muted" style="font-size:.84rem;font-weight:600">
      <%= __state === 'over' ? t('dash.over_label') : (__state === 'today_done' ? t('dash.today_over_label') : t('dash.can_spend')) %>
    </div>

    <div class="kkb-display" style="font-size:2.9rem;font-weight:800;line-height:1.1;margin:6px 0 2px;color:<%= __tone %>">
      <bdi><%= money(__hero) %></bdi>
    </div>

    <%# A number with no sentence is a dashboard. A number with a sentence is
        advice — and advice is what somebody standing in a shop needs. %>
    <div class="muted" style="font-size:.8rem;line-height:1.7;max-width:34ch;margin:0 auto">
      <% if (__state === 'over') { %><%= t('dash.over_help') %>
      <% } else if (__state === 'today_done') { %><%= t('dash.today_over_help') %>
      <% } else { %><%= t('dash.can_spend_help') %><% } %>
    </div>

    <% if (!data.overBudget) { %>
    <div style="height:8px;background:var(--paper);border:1px solid var(--line);border-radius:99px;overflow:hidden;margin:16px 0 8px">
      <div style="height:100%;width:<%= __usedPct %>%;background:<%= __usedPct>=100?'var(--warn)':'var(--accent-2)' %>"></div>
    </div>
    <div class="muted" style="font-size:.74rem;display:flex;justify-content:space-between">
      <span><%= t('dash.spent_today') %> <b><%= money(data.spentToday) %></b></span>
      <span><%= t('dash.per_day') %> <b><%= money(data.perDay) %></b></span>
    </div>
    <% } %>

    <a href="/add" class="btn btn-primary" style="margin-top:18px;display:flex;align-items:center;justify-content:center;gap:8px">
      ➕ <%= t('dash.log_expense') %>
    </a>
  </section>

  <!-- ══════════ THE PERIOD, IN ONE LINE ══════════ -->
  <section class="card" style="padding:14px 16px;margin-top:12px;display:flex;align-items:center;gap:12px">
    <div style="flex:1">
      <div class="muted" style="font-size:.72rem;font-weight:600"><%= t('dash.remaining') %></div>
      <div style="font-weight:800;font-size:1.08rem;color:<%= data.remaining>=0?'var(--ink)':'var(--warn)' %>"><bdi><%= money(data.remaining) %></bdi></div>
    </div>
    <div style="width:1px;height:30px;background:var(--line)"></div>
    <div style="flex:1;text-align:center">
      <div class="muted" style="font-size:.72rem;font-weight:600"><%= t('dash.days_left') %></div>
      <div style="font-weight:800;font-size:1.08rem"><%= num(data.daysLeft) %></div>
    </div>
    <div style="width:1px;height:30px;background:var(--line)"></div>
    <div style="flex:1;text-align:end">
      <div class="muted" style="font-size:.72rem;font-weight:600"><%= t('dash.next_pay') %></div>
      <div style="font-weight:700;font-size:.86rem"><%= __d(data.nextPay) %></div>
    </div>
  </section>

  <!-- ══════════ A WARNING, ONLY WHEN THERE IS ONE ══════════ -->
  <%# Shown only when the projection says the period actually ends short. A
      forecast that is permanently on screen stops being read. %>
  <% if (data.willOverspend && !data.overBudget) { %>
  <div style="display:flex;align-items:center;gap:9px;background:color-mix(in srgb,var(--warn) 12%,var(--surface));border:1px solid var(--line);border-radius:14px;padding:11px 14px;margin-top:12px;font-size:.84rem;line-height:1.6">
    <span style="font-size:1.1rem">⚠️</span>
    <span><%= t('dash.pace_warning') %> <b><%= money(data.projectedSpend) %></b></span>
  </div>
  <% } %>

  <!-- ══════════ RECENT ══════════ -->
  <section style="margin-top:16px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin:0 4px 8px">
      <h2 class="kkb-display" style="font-size:1.05rem;margin:0"><%= t('dash.recent') %></h2>
      <% if (data.recent.length) { %><a href="/expenses" style="font-size:.8rem"><%= lang==='en'?'All':'الكل' %></a><% } %>
    </div>
    <% if (!data.recent.length) { %>
      <div class="card" style="padding:26px;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:8px">🧾</div>
        <p class="muted" style="margin:0 0 12px"><%= t('dash.no_expenses') %></p>
        <a href="/add" class="btn btn-primary" style="width:auto;display:inline-flex;padding:11px 20px">➕ <%= t('dash.add_first') %></a>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% data.recent.forEach(function(e){ var c=__cat[e.category]||__cat.other; %>
          <div class="card" style="padding:11px 14px;display:flex;align-items:center;gap:11px">
            <span style="display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:<%= c.color %>1f;font-size:1.15rem"><%= c.icon %></span>
            <div style="flex:1;min-width:0">
              <div style="font-weight:700;font-size:.92rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= e.description || t('cat.'+c.key) %></div>
              <div class="muted" style="font-size:.72rem"><%= t('cat.'+c.key) %> · <%= __d(e.spent_on) %></div>
            </div>
            <b style="white-space:nowrap"><bdi><%= money(e.amount) %></bdi></b>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- ══════════ EVERYTHING ELSE, FOLDED AWAY ══════════ -->
  <%# The level, the streak, the twin, the challenge, the insight and the goal
      all still exist and still work. They are simply not the first thing
      somebody sees when they opened the app to find out whether they can buy a
      coffee. Nothing was deleted — the front door was cleared. %>
  <details id="kkbMore" style="margin-top:16px">
    <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:center;gap:7px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--surface);font-size:.84rem;font-weight:700;color:var(--muted)">
      <span><%= t('dash.more') %></span><span style="font-size:.7rem">▾</span>
    </summary>

    <div style="margin-top:12px;display:grid;gap:12px">

      <% if (typeof insight !== 'undefined' && insight) { %>
      <section class="card" style="padding:14px 16px;display:flex;gap:11px;align-items:flex-start;border-inline-start:3px solid var(--accent)">
        <span style="font-size:1.2rem">💡</span>
        <div>
          <div class="muted" style="font-size:.68rem;font-weight:700"><%= t('ai.insight') %></div>
          <div style="font-size:.9rem;margin-top:2px;line-height:1.55"><%= insight %></div>
        </div>
      </section>
      <% } %>

      <% if (typeof challenge !== 'undefined' && challenge) { %>
      <section class="card" style="padding:14px 16px;display:flex;gap:11px;align-items:center">
        <span style="font-size:1.25rem">🎯</span>
        <div><div class="muted" style="font-size:.68rem;font-weight:700"><%= t('ai.challenge') %></div><div style="font-weight:700;font-size:.9rem;margin-top:1px"><%= challenge %></div></div>
      </section>
      <% } %>

      <section style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="card" style="padding:14px 16px">
          <div class="muted" style="font-size:.74rem;font-weight:600">🎯 <%= t('dash.goal') %></div>
          <div style="font-weight:800;margin-top:2px"><%= money(data.goal) %></div>
          <div style="height:7px;background:var(--paper);border:1px solid var(--line);border-radius:99px;overflow:hidden;margin-top:8px"><div style="height:100%;width:<%= data.goalProgress %>%;background:var(--accent)"></div></div>
          <div class="muted" style="font-size:.68rem;margin-top:4px"><%= t('dash.goal_progress') %>: <%= data.goalProgress %>%</div>
        </div>
        <div class="card" style="padding:14px 16px;display:grid;gap:8px;align-content:start">
          <div style="display:flex;justify-content:space-between;font-size:.8rem"><span class="muted"><%= t('dash.week') %></span><b><%= money(data.spentWeek) %></b></div>
          <div style="display:flex;justify-content:space-between;font-size:.8rem"><span class="muted"><%= t('dash.month') %></span><b><%= money(data.spentMonth) %></b></div>
          <div style="display:flex;justify-content:space-between;font-size:.8rem"><span class="muted"><%= t('dash.saving_rate') %></span><b class="accent"><%= data.savingRate %>%</b></div>
        </div>
      </section>

      <% if (typeof gam !== 'undefined' && gam) { %>
      <section class="card" style="padding:14px 16px;display:flex;align-items:center;gap:12px">
        <div style="display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:color-mix(in srgb,var(--accent) 14%,transparent);flex:none">
          <b class="kkb-display accent" style="font-size:1.1rem"><%= gam.level %></b>
        </div>
        <div style="flex:1;font-size:.8rem;font-weight:700;display:flex;justify-content:space-between">
          <span><%= t('gam.level') %> <%= gam.level %></span>
          <span class="muted"><%= gam.xp %> <%= t('gam.xp') %> · <%= gam.streak %> <%= t('gam.streak') %></span>
        </div>
      </section>
      <% } %>

      <% if (typeof twin !== 'undefined' && twin && twin.predictedTotal > 0) { %>
      <a href="/twin" class="card" style="padding:14px 16px;display:flex;gap:11px;align-items:center;text-decoration:none;color:inherit">
        <span style="font-size:1.25rem">🧬</span>
        <div style="flex:1"><div class="muted" style="font-size:.68rem;font-weight:700"><%= t('twin.title') %> · <%= t('twin.predicted') %></div><div style="font-weight:800;font-size:1rem"><bdi><%= money(twin.predictedTotal) %></bdi></div></div>
        <span class="muted" style="font-size:1.1rem">‹</span>
      </a>
      <% } %>

      <%# The coach lives here now rather than as a floating button. Two robots
          on one screen — a 🤖 insight card and a 🤖 bubble — read as two
          different assistants, and the reader has to work out which is which. %>
      <% if (typeof aiEnabled !== 'undefined' && aiEnabled) { %>
      <a href="/coach" class="card" style="padding:14px 16px;display:flex;gap:11px;align-items:center;text-decoration:none;color:inherit">
        <span style="font-size:1.25rem">🤖</span>
        <div style="flex:1;font-weight:700;font-size:.9rem"><%= t('coach.open') %></div>
        <span class="muted" style="font-size:1.1rem">‹</span>
      </a>
      <% } %>

    </div>
  </details>
</main>

<script>
  // Remember whether the extras were open. Somebody who wants them should not
  // re-open them on every visit, and somebody who does not should never have to
  // scroll past them again.
  (function () {
    var d = document.getElementById('kkbMore');
    if (!d) return;
    try { if (localStorage.getItem('kkb-more') === '1') d.open = true; } catch (e) {}
    d.addEventListener('toggle', function () {
      try { localStorage.setItem('kkb-more', d.open ? '1' : '0'); } catch (e) {}
    });
  })();
</script>

<%- include('app_nav', { active: 'home' }) %>
<%- include('foot') %>
