<% pageTitle = t('onb.title') %>
<%- include('head') %>
<% var p = (typeof profile !== 'undefined' && profile) ? profile : {};
   // A zero only means "I don't know" for somebody who has already been through
   // this screen. On a brand-new profile the columns default to 0 too, and
   // pre-ticking the box there would answer the question for them.
   var __seen = !!p.onboarded;
   var __incUnknown  = __seen && !(Number(p.monthly_income) > 0);
   var __goalUnknown = __seen && !(Number(p.saving_goal) > 0); %>
<main class="wrap" style="padding-top:20px;padding-bottom:48px">
  <section style="text-align:center;margin:8px 0 22px">
    <div class="hanko" style="width:52px;height:52px;margin:0 auto 12px;font-size:1.4rem">計</div>
    <h1 class="kkb-display" style="font-size:1.7rem;margin:0 0 8px"><%= t('onb.title') %></h1>
    <p class="muted" style="margin:0"><%= t('onb.sub') %></p>
  </section>

  <section class="card" style="padding:22px">
    <% if (error) { %><div style="background:rgba(192,57,43,.1);color:var(--accent);border-radius:12px;padding:10px 12px;font-size:.9rem;font-weight:600;margin-bottom:14px"><%= error %></div><% } %>
    <form method="post" action="/onboarding" style="display:flex;flex-direction:column;gap:16px">

      <%# "I don't know yet" is the honest answer for a lot of people on day one —
          freelancers, anyone paid in cash, anyone who has never added it up. The
          old form made both money questions `required`, so that person either
          invented a number (which then drives every figure in the app) or gave
          up at the first screen. Ticking the box empties and disables the field,
          so nothing is submitted and the server stores 0 = "not set yet". With
          JS off the field simply stays empty, which the server reads the same
          way — the escape hatch does not depend on the script running. %>
      <div>
        <label class="lbl">💰 <%= t('onb.income') %></label>
        <input name="monthly_income" id="incomeInput" type="number" inputmode="decimal" step="0.01" min="0" class="fld" dir="ltr" placeholder="0" value="<%= (p.monthly_income && Number(p.monthly_income)>0) ? Number(p.monthly_income) : '' %>" />
        <p class="muted" style="font-size:.76rem;margin:5px 2px 0"><%= t('onb.income_hint') %></p>
        <label class="muted" style="display:flex;align-items:center;gap:7px;font-size:.78rem;margin:7px 2px 0;cursor:pointer">
          <input type="checkbox" class="kkb-dunno" data-for="incomeInput" <%= __incUnknown ? 'checked' : '' %> style="width:auto;margin:0" />
          <span><%= t('onb.dunno') %></span>
        </label>
      </div>

      <%# One question, not two. The schedule and the day number are a single
          thing a person knows ("I get paid on the 25th" / "at month end"), and
          splitting them into two labelled fields made it read as two decisions.
          The day box only appears for the schedule that uses it. %>
      <div>
        <label class="lbl">📅 <%= t('onb.salary_type') %></label>
        <% var pst = p.salary_type || 'fixed'; %>
        <div style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center">
          <select name="salary_type" id="salaryType" class="fld">
            <option value="fixed" <%= pst==='fixed'?'selected':'' %>><%= t('onb.stype.fixed') %></option>
            <option value="last" <%= pst==='last'?'selected':'' %>><%= t('onb.stype.last') %></option>
            <option value="before_last" <%= pst==='before_last'?'selected':'' %>><%= t('onb.stype.before_last') %></option>
            <%# The Egyptian market this is built for is full of people with no
                payday at all — freelancers, drivers, anyone paid per job. The
                three options above all ask "which day of the month", which is a
                question they cannot answer, so they picked one at random and
                every figure in the app was then anchored to a date that means
                nothing to them. This option drops the payday entirely and
                budgets by the calendar month. %>
            <option value="irregular" <%= pst==='irregular'?'selected':'' %>><%= t('onb.stype.irregular') %></option>
          </select>
          <input id="salaryDayRow" name="salary_day" type="number" inputmode="numeric" min="1" max="31"
            value="<%= p.salary_day || 1 %>" class="fld" dir="ltr" aria-label="<%= t('onb.salary_day') %>"
            style="width:80px;text-align:center" />
        </div>
        <p id="salaryDayHint" class="muted" style="font-size:.76rem;margin:5px 2px 0"><%= t('onb.salary_day_hint') %></p>
        <p id="irregularHint" class="muted" style="font-size:.76rem;margin:5px 2px 0;display:none"><%= t('onb.income_hint_irregular') %></p>
      </div>

      <div>
        <label class="lbl">🎯 <%= t('onb.goal') %></label>
        <input name="saving_goal" id="goalInput" type="number" inputmode="decimal" step="0.01" min="0" class="fld" dir="ltr" placeholder="0" value="<%= (p.saving_goal && Number(p.saving_goal)>0) ? Number(p.saving_goal) : '' %>" />
        <p class="muted" style="font-size:.76rem;margin:5px 2px 0"><%= t('onb.goal_hint') %></p>
        <p id="goalSuggest" class="muted" style="font-size:.74rem;margin:4px 2px 0;display:none"><%= t('onb.goal_suggest') %></p>
        <label class="muted" style="display:flex;align-items:center;gap:7px;font-size:.78rem;margin:7px 2px 0;cursor:pointer">
          <input type="checkbox" class="kkb-dunno" data-for="goalInput" <%= __goalUnknown ? 'checked' : '' %> style="width:auto;margin:0" />
          <span><%= t('onb.dunno') %></span>
        </label>
      </div>

      <p class="muted" style="font-size:.74rem;margin:-6px 2px 0"><%= t('onb.dunno_hint') %></p>

      <%# Country, weekend and currency are already on the answer most people
          would pick, and none of them stops the app working. Asking for them up
          front turned a three-field start into a seven-field form, so they fold
          away — visible to anyone whose situation differs, invisible to
          everyone else. %>
      <details style="border:1px solid var(--line);border-radius:14px;padding:0 14px">
        <summary style="cursor:pointer;padding:13px 0;font-weight:700;font-size:.88rem;color:var(--muted)">
          <%= t('onb.advanced') %>
        </summary>
        <p class="muted" style="font-size:.76rem;margin:0 0 14px"><%= t('onb.advanced_hint') %></p>

      <%
        var __cn = {
          EG:['مصر','Egypt'], SA:['السعودية','Saudi Arabia'], AE:['الإمارات','UAE'], KW:['الكويت','Kuwait'],
          QA:['قطر','Qatar'], BH:['البحرين','Bahrain'], OM:['عُمان','Oman'], JO:['الأردن','Jordan'],
          IQ:['العراق','Iraq'], LB:['لبنان','Lebanon'], PS:['فلسطين','Palestine'], SY:['سوريا','Syria'],
          YE:['اليمن','Yemen'], MA:['المغرب','Morocco'], DZ:['الجزائر','Algeria'], TN:['تونس','Tunisia'],
          LY:['ليبيا','Libya'], SD:['السودان','Sudan']
        };
        function __cname(c){ var n=__cn[c]; return n ? (lang==='en'?n[1]:n[0]) : c; }
      %>
      <div>
        <label class="lbl">🏳️ <%= t('onb.country') %></label>
        <select name="country" class="fld">
          <% countries.forEach(function(c){ %><option value="<%= c %>" <%= c===(p.country||'EG')?'selected':'' %>><%= __cname(c) %></option><% }) %>
        </select>
        <p class="muted" style="font-size:.76rem;margin:5px 2px 0"><%= t('onb.country_hint') %></p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div>
          <label class="lbl">🗓️ <%= t('onb.weekend') %></label>
          <select name="weekend" class="fld">
            <% ['fri_sat','fri','sat_sun','sun','none'].forEach(function(w){ %><option value="<%= w %>" <%= w===(p.weekend||'fri_sat')?'selected':'' %>><%= t('onb.wknd.' + w) %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="lbl">🌐 <%= t('onb.currency') %></label>
          <select name="currency" class="fld" dir="ltr">
            <% currencies.forEach(function(c){ %><option value="<%= c %>" <%= c === (p.currency||'EGP') ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
        </div>
      </div>
      <p class="muted" style="font-size:.76rem;margin:-6px 2px 14px"><%= t('onb.weekend_hint') %></p>
      </details>

      <button class="btn btn-primary" style="margin-top:4px">✨ <%= t('onb.finish') %></button>
    </form>
  </section>
</main>
<script>
// "I don't know yet": empty the field and take it out of the submission, so the
// server stores 0 rather than a number the person made up. Ticked on load if the
// profile already has 0 there, so re-opening this screen shows the same answer
// they gave.
(function(){
  Array.prototype.forEach.call(document.querySelectorAll('.kkb-dunno'), function(box){
    var fld=document.getElementById(box.getAttribute('data-for'));
    if(!fld) return;
    function sync(){
      fld.disabled = box.checked;
      fld.style.opacity = box.checked ? '.45' : '';
      if(box.checked) fld.value='';
    }
    box.addEventListener('change',sync);
    sync();
  });
})();

(function(){
  var sel=document.getElementById('salaryType'), row=document.getElementById('salaryDayRow');
  var dayHint=document.getElementById('salaryDayHint'), irrHint=document.getElementById('irregularHint');
  function sync(){
    row.style.display = sel.value==='fixed' ? '' : 'none';
    // The day-number hint explains a box that is not on screen unless the
    // schedule uses it, and the irregular note only makes sense for the one
    // choice that has no payday.
    var irr = sel.value==='irregular';
    if(dayHint) dayHint.style.display = sel.value==='fixed' ? '' : 'none';
    if(irrHint) irrHint.style.display = irr ? '' : 'none';
  }
  if(sel&&row){ sel.addEventListener('change',sync); sync(); }
})();

// "How much should I save?" is the question that stalls people on this screen.
// Offer 10% of income as a starting point once they type it — only into an
// empty field, and only until they type their own number, so a suggestion
// never overwrites a decision.
(function(){
  var inc=document.querySelector('input[name="monthly_income"]');
  var goal=document.getElementById('goalInput'), note=document.getElementById('goalSuggest');
  if(!inc||!goal) return;
  var touched = goal.value !== '';
  goal.addEventListener('input',function(){ touched=true; if(note) note.style.display='none'; });
  inc.addEventListener('input',function(){
    if(touched) return;
    var v=parseFloat(inc.value);
    if(!isFinite(v)||v<=0){ goal.value=''; if(note) note.style.display='none'; return; }
    goal.value=Math.round(v*0.10);
    if(note) note.style.display='';
  });
})();
</script>
<%- include('foot') %>
