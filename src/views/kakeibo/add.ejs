<%
  var ed = (typeof editExpense !== 'undefined' && editExpense) ? editExpense : null;
  function __eymd(v){ try{ var d=new Date(v); var p=function(n){return (n<10?'0':'')+n;}; return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }catch(e){ return today; } }
  pageTitle = ed ? t('add.edit') : t('add.title');
%>
<%- include('head') %>
<main class="wrap" style="padding-top:6px">
  <h1 class="kkb-display" style="font-size:1.3rem;margin:4px 4px 14px"><%= ed ? t('add.edit') : t('add.title') %></h1>
  <% if (error) { %><div style="background:rgba(192,57,43,.1);color:var(--accent);border-radius:12px;padding:10px 12px;font-size:.9rem;font-weight:600;margin-bottom:12px"><%= error %></div><% } %>

  <form method="post" action="<%= ed ? '/expense/'+ed.id+'/update' : '/add' %>" enctype="multipart/form-data" class="card" style="padding:20px;display:flex;flex-direction:column;gap:16px">

    <!-- Quick capture: voice + receipt scan -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <button type="button" id="voiceBtn" class="btn btn-ghost" style="padding:11px">🎤 <%= t('ai.voice') %></button>
      <button type="button" id="scanBtn" class="btn btn-ghost" style="padding:11px">📷 <%= aiEnabled ? t('add.receipt').replace(/\s*\(.+\)/,'') : t('add.receipt').replace(/\s*\(.+\)/,'') %></button>
    </div>
    <p id="capMsg" class="muted" style="font-size:.74rem;margin:-8px 2px 0;text-align:center;display:none"></p>

    <div style="text-align:center">
      <label class="lbl" style="text-align:center"><%= t('add.amount') %></label>
      <input name="amount" type="number" inputmode="decimal" step="0.01" min="0" required autofocus value="<%= ed ? Number(ed.amount) : '' %>"
        class="fld kkb-display" dir="ltr" placeholder="0" style="text-align:center;font-size:2rem;font-weight:700;border:0;background:transparent" />
    </div>

    <div>
      <label class="lbl"><%= t('add.category') %></label>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
        <% CATEGORIES.forEach(function(c, i){ var sel = ed ? (ed.category===c.key) : (i===0); %>
          <label style="cursor:pointer">
            <input type="radio" name="category" value="<%= c.key %>" <%= sel?'checked':'' %> style="position:absolute;opacity:0" onchange="document.querySelectorAll('.catchip').forEach(function(x){x.dataset.on='0'});this.parentNode.querySelector('.catchip').dataset.on='1'" />
            <span class="catchip" data-on="<%= sel?'1':'0' %>" style="display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 4px;border:1.5px solid var(--line);border-radius:14px;font-size:.7rem;font-weight:700;transition:.15s">
              <span style="font-size:1.2rem"><%= c.icon %></span><%= t('cat.'+c.key) %>
            </span>
          </label>
        <% }) %>
      </div>
    </div>

    <%# Payment method, date and receipt are already right on almost every
        entry — cash, today, no photo. Leaving them open made logging a coffee
        a six-field form, so they fold away. Opened automatically while editing
        an older expense, which is exactly when they are likely to be wrong.
        The file input still lives here: the 📷 button above clicks it. %>
    <details <%= ed ? 'open' : '' %> style="border:1px solid var(--line);border-radius:14px;padding:0 14px">
      <summary style="cursor:pointer;padding:12px 0;font-weight:700;font-size:.85rem;color:var(--muted)">
        <%= t('add.more') %>
      </summary>
      <p class="muted" style="font-size:.74rem;margin:0 0 12px"><%= t('add.more_hint') %></p>

      <%# الوصف اتنقل جوّه هنا: تسجيل قهوة بقى مبلغ + تصنيف + حفظ. اللي عايز
          يكتب وصف لسه يقدر، بس مش شرط يعدّي عليه كل مرة. الـid زي ما هو لأن
          اقتراح الذكاء الاصطناعي تحت بيكتب فيه. %>
      <div style="margin-bottom:12px">
        <label class="lbl"><%= t('add.desc') %></label>
        <input name="description" id="descInput" maxlength="200" class="fld" autocomplete="off" value="<%= ed && ed.description ? ed.description : '' %>" />
        <p id="aiSug" class="muted" style="font-size:.72rem;margin:5px 2px 0;display:none"></p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div>
          <label class="lbl"><%= t('add.method') %></label>
          <select name="payment_method" class="fld">
            <% PAYMENT_METHODS.forEach(function(m){ %><option value="<%= m %>" <%= ed && ed.payment_method===m ? 'selected':'' %>><%= t('pm.'+m) %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="lbl"><%= t('add.date') %></label>
          <input name="spent_on" type="date" value="<%= ed ? __eymd(ed.spent_on) : today %>" class="fld" dir="ltr" />
        </div>
      </div>

      <div style="margin-top:12px;padding-bottom:14px">
        <label class="lbl">🧾 <%= t('add.receipt') %><% if (ed && ed.receipt_url) { %> · <a href="<%= ed.receipt_url %>" target="_blank">🧾</a><% } %></label>
        <input name="receipt" id="receiptInput" type="file" accept="image/*" capture="environment" class="fld" style="padding:9px" />
      </div>
    </details>

    <button class="btn btn-primary">💾 <%= ed ? t('add.update') : t('add.save') %></button>
  </form>
</main>
<style>.catchip[data-on="1"]{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}</style>
<script>
/* Auto-suggest a category from the description (local-first on the server;
   AI only when needed). Fires once the user pauses typing. Never blocks saving. */
(function(){
  var inp=document.getElementById('descInput'), sug=document.getElementById('aiSug');
  var SUG=<%- JSON.stringify(t('ai.suggested')) %>, userTouched=false;
  document.querySelectorAll('input[name="category"]').forEach(function(r){ r.addEventListener('change',function(){userTouched=true;}); });
  var timer=null, last='';
  function pick(cat){
    var r=document.querySelector('input[name="category"][value="'+cat+'"]'); if(!r)return;
    r.checked=true; document.querySelectorAll('.catchip').forEach(function(x){x.dataset.on='0'});
    r.parentNode.querySelector('.catchip').dataset.on='1';
  }
  function ask(){
    var v=(inp.value||'').trim(); if(v.length<2||v===last||userTouched){return;} last=v;
    fetch('/ai/categorize',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({description:v})})
      .then(function(r){return r.json();}).then(function(d){
        if(d&&d.category&&!userTouched){ pick(d.category); sug.textContent=SUG+' — '+(d.label||d.category); sug.style.display=''; }
      }).catch(function(){});
  }
  if(inp){ inp.addEventListener('input',function(){clearTimeout(timer);timer=setTimeout(ask,700);}); inp.addEventListener('blur',ask); }

  // Shared helpers to prefill the form from voice/OCR results.
  window.__kkbFill=function(d){
    if(d.amount!=null){ var a=document.querySelector('input[name="amount"]'); if(a) a.value=d.amount; }
    if(d.description){ if(inp){ inp.value=d.description; } }
    if(d.date && /^\d{4}-\d{2}-\d{2}$/.test(d.date)){ var dt=document.querySelector('input[name="spent_on"]'); if(dt) dt.value=d.date; }
    if(d.category){ userTouched=false; pick(d.category); userTouched=true; }
  };
})();

// Voice entry (Web Speech API) → parse → prefill.
(function(){
  var btn=document.getElementById('voiceBtn'), msg=document.getElementById('capMsg');
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  var UNS=<%- JSON.stringify(t('ai.voice_unsupported')) %>, LIS=<%- JSON.stringify(t('ai.listening')) %>, HINT=<%- JSON.stringify(t('ai.voice_hint')) %>;
  function show(t){ msg.textContent=t; msg.style.display=''; }
  if(!btn) return;
  if(!SR){ btn.addEventListener('click',function(){show(UNS);}); return; }
  btn.addEventListener('click',function(){
    var rec=new SR(); rec.lang=document.documentElement.lang==='en'?'en-US':'ar-EG'; rec.interimResults=false; rec.maxAlternatives=1;
    show(LIS+' — '+HINT); btn.disabled=true;
    rec.onresult=function(e){ var txt=e.results[0][0].transcript;
      fetch('/ai/voice',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:txt})})
        .then(function(r){return r.json();}).then(function(d){ if(d&&d.ok){ window.__kkbFill(d); msg.textContent='✓ '+txt; } else { msg.textContent=txt; } })
        .catch(function(){ msg.textContent=txt; });
    };
    rec.onerror=function(){ btn.disabled=false; };
    rec.onend=function(){ btn.disabled=false; };
    rec.start();
  });
})();

// Receipt scan (OCR via vision) — triggered by the scan button / file pick.
(function(){
  var scan=document.getElementById('scanBtn'), file=document.getElementById('receiptInput'), msg=document.getElementById('capMsg');
  var AIEN=<%- JSON.stringify(!!aiEnabled) %>, SCAN=<%- JSON.stringify(t('ai.scan')) %>, DONE=<%- JSON.stringify(t('ai.scan_done')) %>, FAIL=<%- JSON.stringify(t('ai.scan_fail')) %>;
  if(scan&&file) scan.addEventListener('click',function(){ file.click(); });
  if(file&&AIEN) file.addEventListener('change',function(){
    if(!file.files||!file.files[0])return;
    msg.textContent=SCAN; msg.style.display='';
    var fd=new FormData(); fd.append('image',file.files[0]);
    fetch('/ai/ocr',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(d){
      if(d&&d.ok){ window.__kkbFill(d); msg.textContent=DONE; } else { msg.textContent=FAIL; }
    }).catch(function(){ msg.textContent=FAIL; });
  });
})();
</script>
<%- include('app_nav', { active: 'add' }) %>
<%- include('foot') %>
