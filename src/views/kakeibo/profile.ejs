<% pageTitle = t('prof.title') %>
<%- include('head') %>
<main class="wrap" style="padding-top:6px">
  <h1 class="kkb-display" style="font-size:1.3rem;margin:4px 4px 14px"><%= t('prof.title') %></h1>
  <% if (saved) { %><div style="background:rgba(47,111,94,.12);color:var(--accent-2);border-radius:12px;padding:9px 12px;font-size:.88rem;font-weight:700;margin-bottom:12px"><%= t('prof.saved') %></div><% } %>

  <% if (typeof upgraded !== 'undefined' && upgraded) { %><div style="background:rgba(47,111,94,.12);color:var(--accent-2);border-radius:12px;padding:9px 12px;font-size:.88rem;font-weight:700;margin-bottom:12px"><%= t('up.done') %></div><% } %>

  <section class="card" style="padding:18px;display:flex;align-items:center;gap:12px;margin-bottom:12px">
    <span class="hanko" style="width:46px;height:46px;font-size:1.3rem">👤</span>
    <div style="flex:1;min-width:0">
      <div style="font-weight:800"><%= user.display_name || user.email || 'Guest' %></div>
      <% if (user.is_guest) { %><div class="muted" style="font-size:.74rem"><%= t('prof.guest') %></div>
      <% } else if (user.email) { %><div class="muted" style="font-size:.76rem" dir="ltr"><%= user.email %></div><% } %>
    </div>
  </section>

  <% if (user.is_guest) { %>
  <section class="card" style="padding:18px;margin-bottom:12px;border:1.5px solid var(--accent)">
    <div style="font-weight:800;margin-bottom:2px">🔐 <%= t('up.title') %></div>
    <p class="muted" style="font-size:.78rem;margin:0 0 12px"><%= t('up.hint') %></p>
    <% if (typeof upErr !== 'undefined' && upErr) { %><div style="background:rgba(192,57,43,.1);color:var(--accent);border-radius:12px;padding:8px 12px;font-size:.85rem;font-weight:600;margin-bottom:10px"><%= upErr %></div><% } %>
    <form method="post" action="/account/upgrade" style="display:flex;flex-direction:column;gap:10px">
      <input name="name" maxlength="80" class="fld" placeholder="<%= t('common.name') %>" />
      <input name="email" type="email" dir="ltr" required class="fld" placeholder="<%= t('common.email') %>" />
      <input name="password" type="password" required minlength="6" class="fld" placeholder="<%= t('common.password') %>" />
      <button class="btn btn-primary"><%= t('up.btn') %></button>
    </form>
  </section>
  <% } %>

  <section class="card" style="padding:18px">
    <div style="font-weight:700;margin-bottom:12px">💼 <%= t('prof.settings') %></div>
    <form method="post" action="/profile" style="display:flex;flex-direction:column;gap:14px">
      <div><label class="lbl"><%= t('prof.income') %></label><input name="monthly_income" type="number" step="0.01" min="0" value="<%= Number(profile.monthly_income) %>" class="fld" dir="ltr" /></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><label class="lbl"><%= t('prof.goal') %></label><input name="saving_goal" type="number" step="0.01" min="0" value="<%= Number(profile.saving_goal) %>" class="fld" dir="ltr" /></div>
        <div><label class="lbl"><%= t('prof.currency') %></label><select name="currency" class="fld" dir="ltr"><% currencies.forEach(function(c){ %><option value="<%= c %>" <%= c===profile.currency?'selected':'' %>><%= c %></option><% }) %></select></div>
      </div>
      <button class="btn btn-primary"><%= t('common.save') %></button>
    </form>
  </section>

  <%# These were eight identical ghost buttons in a stack. Eight equal-weight
      options with nothing but a name on each is a menu you have to open one by
      one to understand. Same destinations, now grouped by what you came here to
      do, with one line each saying what it is for.

      The advanced six are split off into "Tools" and held back until there are
      five expenses on file. Every one of them reads the ledger — the twin learns
      habits, the simulator cuts categories, the coach answers from your numbers
      — so on day one they are dead ends that make the app look big and unhelpful
      at once. Nothing is disabled: this is the menu, not the door. /twin,
      /simulator, /investments, /family and /coach all still serve, so a saved
      link or a browser autocomplete keeps working from the first day. %>
  <%
    var __n    = typeof expenseCount !== 'undefined' ? Number(expenseCount) || 0 : 0;
    var __min  = typeof toolsMin  !== 'undefined' ? Number(toolsMin)  : 5;
    var __more = typeof toolsMore !== 'undefined' ? Number(toolsMore) : 20;
    var __unlocked = __n >= __min;
    var __ai = typeof aiEnabled !== 'undefined' && aiEnabled;

    // Step one: the three that do something useful with a handful of expenses.
    var __tools = [['/simulator', '🧪', 'sim.title', 'prof.d_simulator']];
    if (__ai) __tools.push(['/coach', '🤖', 'coach.title', 'prof.d_coach']);
    // Step two: the twin needs recurring expenses to detect, and investments and
    // family are not about this month's spending at all.
    var __later = [
      ['/twin',        '🧬', 'twin.title',  'prof.d_twin'],
      ['/investments', '📈', 'inv.title',   'prof.d_investments'],
      ['/family',      '👨‍👩‍👧', 'fam.title', 'prof.d_family'],
    ];
    // Built once, so "everything there is" cannot drift out of step with the
    // two steps. The note below shows __all; the menu shows __tools.
    var __all = __tools.concat(__later);
    if (__n >= __more) __tools = __all;
    var __groups = [
      ['prof.grp_money', [
        ['/budgets', '🎛️', 'bud.title',   'prof.d_budgets'],
        ['/goals',   '🎯', 'goals.title', 'prof.d_goals'],
      ]],
    ];
    if (__unlocked) __groups.push(['prof.grp_tools', __tools]);
    __groups.push(['prof.grp_setup', [
      ['/onboarding', '📅', 'prof.edit_salary', 'prof.d_salary'],
      ['/holidays',   '🎌', 'hol.title',        'prof.d_holidays'],
    ]]);
  %>
  <% __groups.forEach(function(g){ %>
  <section style="margin-top:16px">
    <div class="muted" style="font-size:.72rem;font-weight:800;margin:0 4px 8px;letter-spacing:.5px"><%= t(g[0]) %></div>
    <div style="display:flex;flex-direction:column;gap:8px">
      <% g[1].forEach(function(it){ %>
      <a href="<%= it[0] %>" class="card" style="padding:13px 15px;display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit">
        <span style="font-size:1.2rem;flex:none"><%= it[1] %></span>
        <div style="flex:1;min-width:0">
          <div style="font-weight:700;font-size:.92rem"><%= t(it[2]) %></div>
          <div class="muted" style="font-size:.74rem;margin-top:1px"><%= t(it[3]) %></div>
        </div>
        <span class="muted" style="font-size:1.05rem;flex:none">‹</span>
      </a>
      <% }) %>
    </div>
  </section>
  <% }) %>

  <%# Not a lock and not a paywall — an invitation with a progress line.
      "Try the tools" opens onto the real list with working links, because
      nothing here is actually withheld: /simulator and the rest serve from day
      one. Anyone curious enough to open it gets everything immediately, which
      is the difference between "not shown yet" and "not allowed".

      Dismissible, and the choice is remembered. Somebody who has read it once
      and decided not to care should not be told again on every visit. It never
      comes back either way — once the tools appear, this note is gone. %>
  <% if (!__unlocked) { %>
  <section id="toolsSoon" class="card" style="padding:14px 16px;margin-top:16px">
    <div style="display:flex;align-items:flex-start;gap:10px">
      <div style="flex:1;min-width:0">
        <div style="font-size:.86rem;line-height:1.7"><%= t('prof.tools_soon', { n: __min }) %></div>
        <div class="muted" style="font-size:.76rem;margin-top:3px"><%= t('prof.tools_progress', { done: __n, n: __min }) %></div>
      </div>
      <button type="button" id="toolsSoonHide" class="muted" aria-label="<%= t('prof.tools_hide') %>"
        style="flex:none;background:none;border:0;font-size:1.1rem;line-height:1;cursor:pointer;color:inherit;padding:2px 4px">×</button>
    </div>
    <details style="margin-top:10px">
      <summary style="cursor:pointer;list-style:none;font-size:.82rem;font-weight:700;color:var(--accent)">
        <%= t('prof.tools_try') %> ›
      </summary>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
        <% __all.forEach(function(it){ %>
        <a href="<%= it[0] %>" class="card" style="padding:12px 14px;display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit">
          <span style="font-size:1.15rem;flex:none"><%= it[1] %></span>
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;font-size:.9rem"><%= t(it[2]) %></div>
            <div class="muted" style="font-size:.73rem;margin-top:1px"><%= t(it[3]) %></div>
          </div>
          <span class="muted" style="font-size:1.05rem;flex:none">‹</span>
        </a>
        <% }) %>
      </div>
    </details>
  </section>
  <script>
  (function(){
    var box=document.getElementById('toolsSoon'), btn=document.getElementById('toolsSoonHide'), KEY='kkb-tools-soon';
    if(!box||!btn) return;
    try { if(localStorage.getItem(KEY)==='hidden') box.style.display='none'; } catch(e){}
    btn.addEventListener('click',function(){
      box.style.display='none';
      try { localStorage.setItem(KEY,'hidden'); } catch(e){}
    });
  })();
  </script>
  <% } %>

  <section class="card" style="padding:16px;margin-top:14px">
    <div style="font-weight:700;margin-bottom:2px">⬇︎ <%= t('exp.title') %></div>
    <p class="muted" style="font-size:.76rem;margin:0 0 12px"><%= t('exp.hint') %></p>
    <div style="display:flex;flex-direction:column;gap:8px">
      <a href="/export/expenses.csv" class="btn btn-ghost">📊 <%= t('exp.csv') %></a>
      <a href="/export/data.json" class="btn btn-ghost">🗂️ <%= t('exp.json') %></a>
    </div>
  </section>

  <%# Notifications belong to the same held-back set: reminders to log an expense
      are noise to somebody who has not started, and asking for the browser
      permission on day one is the surest way to have it denied for good. %>
  <% if (typeof pushEnabled !== 'undefined' && pushEnabled && __unlocked) { %>
  <section class="card" style="padding:16px;margin-top:14px">
    <div style="font-weight:700;margin-bottom:2px">🔔 <%= t('push.title') %></div>
    <p class="muted" style="font-size:.76rem;margin:0 0 12px"><%= t('push.hint') %></p>
    <button type="button" id="pushBtn" class="btn btn-ghost"><%= t('push.enable') %></button>
    <p id="pushMsg" class="muted" style="font-size:.74rem;margin:8px 2px 0;display:none"></p>
  </section>
  <script>
  (function(){
    var KEY=<%- jsonLd(pushKey) %>, btn=document.getElementById('pushBtn'), msg=document.getElementById('pushMsg');
    var ON=<%- jsonLd(t('push.on')) %>, DEN=<%- jsonLd(t('push.denied')) %>, OFF=<%- jsonLd(t('push.off')) %>, TEST=<%- jsonLd(t('push.test')) %>;
    function show(t){ msg.textContent=t; msg.style.display=''; }
    function b64(s){ var p='='.repeat((4-s.length%4)%4); var b=(s+p).replace(/-/g,'+').replace(/_/g,'/'); var r=atob(b),a=new Uint8Array(r.length); for(var i=0;i<r.length;i++)a[i]=r.charCodeAt(i); return a; }
    if(!('serviceWorker'in navigator)||!('PushManager'in window)||!KEY){ btn.disabled=true; show(OFF); return; }
    btn.addEventListener('click',function(){
      btn.disabled=true;
      Notification.requestPermission().then(function(perm){
        if(perm!=='granted'){ btn.disabled=false; return show(DEN); }
        return navigator.serviceWorker.ready.then(function(reg){
          return reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64(KEY)});
        }).then(function(sub){
          return fetch('/push/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({subscription:sub.toJSON()})});
        }).then(function(){ btn.textContent=TEST; btn.disabled=false; show(ON);
          btn.onclick=function(){ fetch('/push/test',{method:'POST'}); };
        });
      }).catch(function(){ btn.disabled=false; show(OFF); });
    });
  })();
  </script>
  <% } %>

  <section style="margin-top:14px">
    <form method="post" action="/logout"><button class="btn btn-ghost" style="color:var(--accent)"><%= t('common.logout') %></button></form>
  </section>
</main>
<%- include('app_nav', { active: 'profile' }) %>
<%- include('foot') %>
