<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var S = (typeof furnitureSettings !== 'undefined' && furnitureSettings) || {};
  var items = (typeof furnitureProducts !== 'undefined' && furnitureProducts) || [];
  var __name = S.business_name || company.company_name || t('fnp.showroom');
  var __brand = ' | OscarDevs';
  // Under 60 characters, the limit the project records after the Bing audit.
  var __base = __name + ' — ' + t('fnp.tagline');
  var __title = (__base.length + __brand.length) <= 60 ? (__base + __brand)
    : (__base.length <= 60 ? __base : __base.slice(0, 60));

  var __about = String(company.description || '').trim();
  var __bits = [__name + ' — ' + t('fnp.tagline')];
  if (S.address) __bits.push(S.address);
  var __desc = __about.length >= 70 ? __about : (__bits.join(' · ') + '. ' + t('fnp.seo_tail'));
  if (__desc.length > 155) {
    __desc = __desc.slice(0, 155);
    var __cut = __desc.lastIndexOf(' ');
    if (__cut > 120) __desc = __desc.slice(0, __cut);
  }

  var __canon = (typeof canonicalCompanyUrl === 'function') ? canonicalCompanyUrl(company.slug)
    : ('https://' + company.slug + '.oscardevs.com/');
  var __noindex = (typeof noindex !== 'undefined' && noindex);
  var __wa = S.whatsapp ? String(S.whatsapp).replace(/[^0-9]/g, '') : '';
  var __phone = S.phone ? String(S.phone).replace(/[^0-9+]/g, '') : '';
  var __map = S.address ? ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(S.address)) : null;
  var __cur = S.currency || 'EGP';
  function __money(v){
    if (v == null) return null;
    var n = Number(v);
    if (!isFinite(n) || n <= 0) return null;
    return n.toLocaleString(lang === 'ar' ? 'ar-EG' : 'en-GB', { maximumFractionDigits: 0 });
  }
  // Grouped by category so a visitor scans "bedrooms" rather than 60 loose
  // pieces — which is how somebody actually shops for furniture.
  var __groups = {};
  items.forEach(function (p) {
    var k = (p.category && String(p.category).trim()) || '';
    (__groups[k] = __groups[k] || []).push(p);
  });
  var __cats = Object.keys(__groups);
%>
<% if (__noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __title %></title>
<meta name="description" content="<%= __desc %>" />
<%- include('partials/seo_meta', { title: __title, description: __desc, canonical: __canon, siteLogo: company.logo_url || '', siteAppName: __name, ogImage: company.logo_url || '', siteManifest: '/manifest.webmanifest' }) %>

<% if (!__noindex) { %>
<%# Structured data only on pages that are actually indexed — describing a page
    to a crawler that has been told not to index it is noise. %>
<script type="application/ld+json">
<%- jsonLd(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: __name,
  description: __desc,
  url: __canon,
}, __phone ? { telephone: __phone } : {},
   S.address ? { address: { '@type': 'PostalAddress', streetAddress: S.address, addressCountry: 'EG' } } : {},
   company.logo_url ? { image: company.logo_url } : {})) %>
</script>
<% } %>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans: ['Cairo','system-ui','sans-serif'] },
    colors: { brand: { 50:'#fbf6f0',100:'#f4e6d6',200:'#e8ccae',300:'#d9a06a',500:'#a86a32',600:'#8a5524',700:'#6d431d',900:'#3a230f' } }
  } } };
</script>
<style>body{font-family:'Cairo',sans-serif}</style>
</head>
<body class="bg-stone-50 text-stone-800">

<header class="bg-gradient-to-b from-brand-700 to-brand-900 text-white">
  <div class="max-w-4xl mx-auto px-4 py-12 text-center">
    <% if (company.logo_url) { %>
      <img src="<%= company.logo_url %>" alt="<%= __name %>" class="w-20 h-20 rounded-2xl object-cover mx-auto mb-4 bg-white" />
    <% } else { %>
      <div class="text-5xl mb-3">🪑</div>
    <% } %>
    <%# One h1 per page. %>
    <h1 class="text-2xl sm:text-3xl font-black mb-2"><%= __name %></h1>
    <p class="text-white/75 text-sm"><%= t('fnp.tagline') %></p>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8">

  <% if (__about) { %>
  <section class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-stone-900 mb-2"><%= t('fnp.about') %></h2>
    <p class="text-stone-600 text-sm leading-7 whitespace-pre-line"><%= __about %></p>
  </section>
  <% } %>

  <!-- ── الكتالوج ──────────────────────────────────────────────────── -->
  <% if (items.length) { %>
  <section class="mb-5">
    <h2 class="font-bold text-stone-900 mb-3"><%= t('fnp.catalogue') %></h2>
    <% __cats.forEach(function (cat) { %>
      <% if (cat) { %><h3 class="text-sm font-bold text-stone-500 mt-4 mb-2"><%= cat %></h3><% } %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% __groups[cat].forEach(function (p) { var price = __money(p.selling_price); %>
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <% if (p.image_path) { %>
            <%# lazy + explicit dimensions: a showroom page is mostly photos and
                a phone on 3G should still show the names while they load. %>
            <img src="<%= p.image_path %>" alt="<%= p.name %>" loading="lazy"
                 width="400" height="300" class="w-full h-40 object-cover bg-stone-100" />
          <% } else { %>
            <div class="w-full h-40 bg-stone-100 flex items-center justify-center text-3xl">🪑</div>
          <% } %>
          <div class="p-4">
            <div class="font-bold text-stone-900 text-sm mb-1"><%= p.name %></div>
            <% if (p.notes) { %><p class="text-xs text-stone-500 leading-6 mb-2"><%= p.notes %></p><% } %>
            <%# A price of zero is "not priced yet", not "free". Showing 0 would
                be a claim the showroom never made. %>
            <% if (price) { %>
              <div class="text-brand-700 font-black"><%= price %> <span class="text-xs font-normal"><%= __cur %></span></div>
            <% } else { %>
              <div class="text-xs text-stone-400"><%= t('fnp.ask_price') %></div>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
    <% }); %>
  </section>
  <% } %>

  <section class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-stone-900 mb-3"><%= t('fnp.contact') %></h2>
    <div class="grid gap-3 text-sm">
      <% if (S.phone) { %>
        <a href="tel:<%= __phone %>" class="flex items-center gap-2 text-stone-700 hover:text-brand-700">
          <span>📞</span><span dir="ltr"><%= S.phone %></span>
        </a>
      <% } %>
      <% if (__wa) { %>
        <a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-stone-700 hover:text-brand-700">
          <span>💬</span><span><%= t('fnp.whatsapp') %></span>
        </a>
      <% } %>
      <% if (S.address) { %>
        <a href="<%= __map %>" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-stone-700 hover:text-brand-700">
          <span>📍</span><span><%= S.address %></span>
        </a>
      <% } %>
      <% if (!S.phone && !__wa && !S.address) { %>
        <p class="text-stone-400"><%= t('fnp.no_contact') %></p>
      <% } %>
    </div>
  </section>

  <% if (__wa) { %>
  <a href="https://wa.me/<%= __wa %>?text=<%= encodeURIComponent(t('fnp.ask_msg')) %>"
     target="_blank" rel="noopener"
     class="block bg-brand-600 hover:bg-brand-700 text-white text-center font-bold rounded-2xl px-6 py-4">
    <%= t('fnp.ask') %>
  </a>
  <% } %>
</main>

<footer class="text-center text-xs text-stone-400 py-6">
  <a href="https://oscardevs.com" target="_blank" rel="noopener" class="hover:text-stone-600">OscarDevs</a>
</footer>

</body>
</html>
