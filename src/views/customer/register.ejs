<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,follow" />
  <title><%= t('common.register') %> — Oscardevs</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" />
  <style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800"><%= t('customer.create_account') %></h1>
      <p class="text-gray-500 text-sm mt-1"><%= t('customer.track_orders') %></p>
    </div>
    <div class="bg-white rounded-3xl shadow-xl p-8">
      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= t('cst.err.' + error) %></div>
      <% } %>
      <form method="POST" action="/customer/register" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.email') %> *</label>
          <input type="email" name="email" required value="<%= form.email || '' %>" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('customer.password_min') %> *</label>
          <input type="password" name="password" required minlength="6" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.full_name') %></label>
          <input type="text" name="full_name" value="<%= form.full_name || '' %>" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.phone') %></label>
          <input type="tel" name="phone" maxlength="30" value="<%= form.phone || '' %>" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.shipping_address') %></label>
          <textarea name="address" rows="3" placeholder="<%= t('customer.address_placeholder') %>" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"><%= form.address || '' %></textarea>
        </div>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition shadow"><%= t('common.register') %></button>
      </form>
      <p class="text-center text-sm text-gray-500 mt-4"><%= t('customer.have_account') %> <a href="/customer/login" class="text-blue-600 hover:underline"><%= t('customer.login_link') %></a></p>
    </div>
  </div>
</body>
</html>
