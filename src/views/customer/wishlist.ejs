<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title><%= t('cst.wl.title') %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" />
  <style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
<header class="bg-white shadow-sm">
  <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-bold text-gray-800">Oscardevs Ads</a>
    <div class="flex items-center gap-3 text-sm">
      <a href="/customer/orders" class="text-gray-500 hover:text-indigo-600 font-bold"><%= t('cst.nav.orders') %></a>
      <form method="POST" action="/customer/logout" class="inline">
        <button type="submit" class="text-red-500 hover:text-red-700"><%= t('common.logout') %></button>
      </form>
    </div>
  </div>
</header>

<main class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-6"><%= t('cst.wl.title') %></h1>

  <% if (!items.length) { %>
    <div class="bg-white rounded-2xl shadow-sm p-10 text-center text-gray-500">
      <p class="mb-2"><%= t('cst.wl.empty') %></p>
      <p class="text-sm"><%= t('cst.wl.empty_hint') %></p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% items.forEach(function(p){ var nm = pickContent(p, 'name'); %>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden group">
        <a href="/shop/<%= p.company_slug %>/product/<%= p.id %>">
          <div class="aspect-square bg-gray-100">
            <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= nm %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition" /><% } else { %><div class="w-full h-full flex items-center justify-center text-gray-300 text-xs"><%= t('cst.wl.image') %></div><% } %>
          </div>
        </a>
        <div class="p-3">
          <a href="/shop/<%= p.company_slug %>/product/<%= p.id %>" class="block font-bold text-sm text-gray-800 line-clamp-2 leading-snug hover:text-indigo-600"><%= nm %></a>
          <div class="text-xs text-gray-400 mt-0.5"><%= p.company_name %></div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-black text-emerald-600 text-sm"><%= Number(p.price).toLocaleString(LOC) %> <%= cur(p) %></span>
            <button type="button" class="wl-remove text-rose-500 text-sm" data-id="<%= p.id %>" title="<%= t('cst.wl.remove') %>">🗑️</button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  <% } %>
</main>

<script>
document.querySelectorAll('.wl-remove').forEach(function (b) {
  b.addEventListener('click', function () {
    fetch('/customer/wishlist/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ product_id: +b.dataset.id }) })
      .then(function (r) { return r.json(); }).then(function () { var card = b.closest('.group'); if (card) card.remove(); }).catch(function () {});
  });
});
</script>
</body>
</html>
