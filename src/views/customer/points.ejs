<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>نقاط الولاء</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script><style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
<header class="bg-white shadow-sm"><div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
  <a href="/" class="font-bold text-gray-800">Oscardevs Ads</a>
  <div class="flex items-center gap-3 text-sm">
    <a href="/customer/orders" class="text-gray-500 hover:text-indigo-600 font-bold">طلباتي</a>
    <a href="/customer/addresses" class="text-gray-500 hover:text-indigo-600 font-bold">عناويني</a>
    <form method="POST" action="/customer/logout" class="inline"><button class="text-red-500"><%= t('common.logout') %></button></form>
  </div>
</div></header>
<main class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-4">⭐ نقاط الولاء</h1>
  <div class="bg-gradient-to-l from-indigo-600 to-indigo-500 text-white rounded-2xl p-6 mb-6 text-center">
    <div class="text-4xl font-black"><%= Number(points).toLocaleString('ar-EG') %></div>
    <div class="text-sm opacity-90 mt-1">نقطة = <%= (Number(points)/100).toFixed(2) %> ج خصم</div>
    <div class="text-xs opacity-75 mt-2">كل 1 ج تشتريه = 1 نقطة · كل 100 نقطة = 1 ج خصم في الطلب الجاي</div>
  </div>
  <% if (orders.length) { %>
    <h2 class="font-bold text-gray-700 mb-3">الحركات</h2>
    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
      <% orders.forEach(function(o){ %>
      <div class="flex items-center gap-3 p-3 border-b border-gray-100 last:border-0 text-sm">
        <div class="flex-1">طلب #<%= o.id %> <span class="text-xs text-gray-400"><%= new Date(o.created_at).toLocaleDateString('ar-EG') %></span></div>
        <% if (o.points_earned > 0) { %><span class="text-emerald-600 font-bold">+<%= o.points_earned %></span><% } %>
        <% if (o.points_redeemed > 0) { %><span class="text-rose-500 font-bold">-<%= o.points_redeemed %></span><% } %>
      </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body></html>
