<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title><%= t('cst.pt.title') %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" /><style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
<header class="bg-white shadow-sm"><div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
  <a href="/" class="font-bold text-gray-800">Oscardevs Ads</a>
  <div class="flex items-center gap-3 text-sm">
    <a href="/customer/orders" class="text-gray-500 hover:text-indigo-600 font-bold"><%= t('cst.nav.orders') %></a>
    <a href="/customer/addresses" class="text-gray-500 hover:text-indigo-600 font-bold"><%= t('cst.nav.addresses') %></a>
    <form method="POST" action="/customer/logout" class="inline"><button class="text-red-500"><%= t('common.logout') %></button></form>
  </div>
</div></header>
<main class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-4"><%= t('cst.pt.title') %></h1>
  <div class="bg-gradient-to-l from-indigo-600 to-indigo-500 text-white rounded-2xl p-6 mb-6 text-center">
    <div class="text-4xl font-black"><%= Number(points).toLocaleString(LOC) %></div>
    <div class="text-sm opacity-90 mt-1"><%= t('cst.pt.worth').replace('%s', (Number(points)/100).toFixed(2) + ' ' + cur()) %></div>
    <div class="text-xs opacity-75 mt-2"><%= t('cst.pt.rule') %></div>
  </div>

  <!-- Wallet / gift-card credit (phase 31) -->
  <div class="bg-gradient-to-l from-emerald-600 to-emerald-500 text-white rounded-2xl p-6 mb-4 text-center">
    <div class="text-sm opacity-90"><%= t('cst.pt.wallet') %></div>
    <div class="text-4xl font-black mt-1"><%= Number(typeof wallet !== 'undefined' ? wallet : 0).toFixed(2) %> <span class="text-lg"><%= cur() %></span></div>
    <div class="text-xs opacity-75 mt-2"><%= t('cst.pt.wallet_hint') %></div>
  </div>
  <% if (typeof giftSaved !== 'undefined' && giftSaved) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 mb-4 text-sm"><%= t('cst.pt.gift_ok') %></div>
  <% } %>
  <% if (typeof giftError !== 'undefined' && giftError) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-4 text-sm"><%= t('cst.err.' + giftError) %></div>
  <% } %>
  <form method="POST" action="/customer/wallet/redeem" class="bg-white rounded-2xl shadow-sm p-4 mb-6 flex gap-2">
    <input name="code" required maxlength="24" placeholder="<%= t('cst.pt.gift_ph') %>" dir="ltr" class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm uppercase" />
    <button class="bg-emerald-600 text-white font-bold px-5 rounded-xl hover:bg-emerald-700 transition"><%= t('cst.pt.redeem') %></button>
  </form>
  <% if (orders.length) { %>
    <h2 class="font-bold text-gray-700 mb-3"><%= t('cst.pt.moves') %></h2>
    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
      <% orders.forEach(function(o){ %>
      <div class="flex items-center gap-3 p-3 border-b border-gray-100 last:border-0 text-sm">
        <div class="flex-1"><%= t('cst.pt.order') %> #<%= o.id %> <span class="text-xs text-gray-400"><%= new Date(o.created_at).toLocaleDateString(LOC) %></span></div>
        <% if (o.points_earned > 0) { %><span class="text-emerald-600 font-bold">+<%= o.points_earned %></span><% } %>
        <% if (o.points_redeemed > 0) { %><span class="text-rose-500 font-bold">-<%= o.points_redeemed %></span><% } %>
      </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body></html>
