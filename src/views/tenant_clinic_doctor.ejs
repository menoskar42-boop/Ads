<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var __cName = company.company_name || t('cp.clinic');
  var __dName = doctor.name;
  var __dTitle = (__dName + (doctor.specialty ? (' — ' + doctor.specialty) : '') + ' | ' + __cName).slice(0, 60);
  var __dDesc = (doctor.bio || (__dName + ' - ' + (doctor.specialty || '') + ' ' + t('cp.d_in') + ' ' + __cName)).trim().slice(0, 155);
  /* The canonical has no trailing slash, so `__base + 'doctor/'` used to
     produce `…oscardevs.comdoctor/ahmed` — a dead URL that was the canonical,
     the og:url and the JSON-LD url of EVERY doctor page. companyPageUrl joins
     it properly, in one place. */
  var __base = (typeof canonicalCompanyUrl === 'function') ? canonicalCompanyUrl(company.slug) : ('https://' + company.slug + '.oscardevs.com');
  var __canon = (typeof companyPageUrl === 'function')
    ? companyPageUrl(company.slug, 'doctor/' + doctor.slug)
    : (__base.replace(/\/+$/, '') + '/doctor/' + doctor.slug);
  var __pageNoindex = (typeof noindex !== 'undefined' && noindex);
  var __booking = !clinicSettings || clinicSettings.booking_enabled !== false;
  var __wa = clinicSettings && clinicSettings.whatsapp ? String(clinicSettings.whatsapp).replace(/[^0-9]/g, '') : '';
  function __money(v){ if(v==null) return null; var n=Number(v); if(!isFinite(n)) return null; return n.toLocaleString(lang==='ar'?'ar-EG':'en-US',{maximumFractionDigits:0}); }
%>
<% if (__pageNoindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __dTitle %></title>
<meta name="description" content="<%= __dDesc %>" />
<%- include('partials/seo_meta', { title: __dTitle, description: __dDesc, canonical: __canon, siteLogo: company.logo_url || '', siteAppName: __cName, ogImage: doctor.photo_url || company.logo_url || '' }) %>
<% if (!__pageNoindex) { %>
<script type="application/ld+json">
<%- jsonLd(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: __dName,
  url: __canon,
  description: __dDesc,
  medicalSpecialty: doctor.specialty || undefined,
  worksFor: { '@type': 'MedicalClinic', name: __cName, url: __base },
  areaServed: { '@type': 'Country', name: 'Egypt' }
}, doctor.photo_url ? { image: doctor.photo_url } : {})) %>
</script>
<script type="application/ld+json">
<%- jsonLd({ '@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
  { '@type':'ListItem','position':1,'name':__cName,'item':__base },
  { '@type':'ListItem','position':2,'name':__dName,'item':__canon }
] }) %>
</script>
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>:root{--brand-50:236 254 255;--brand-100:207 250 254;--brand-200:165 243 252;--brand-300:103 232 249;--brand-400:34 211 238;--brand-500:8 145 178;--brand-600:14 116 144;--brand-700:21 94 117;--brand-800:22 78 99;--brand-900:12 74 94;}</style>
<style>body{font-family:'Cairo',sans-serif}</style>
</head>
<body class="bg-slate-50 text-slate-800">

<header class="bg-white border-b border-slate-200">
  <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-extrabold text-slate-900">← <%= __cName %></a>
    <% if (__booking) { %><a href="#book" class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-full px-4 py-2 text-sm"><%= t('cp.d_book') %></a><% } %>
  </div>
</header>

<main class="max-w-3xl mx-auto px-4 py-8">
  <nav class="text-xs text-slate-400 mb-4"><a href="/" class="hover:text-brand-600"><%= __cName %></a> / <span class="text-slate-600"><%= __dName %></span></nav>

  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8">
    <div class="flex items-start gap-4">
      <% if (doctor.photo_url) { %><img src="<%= doctor.photo_url %>" alt="<%= __dName %>" class="w-24 h-24 rounded-2xl object-cover border border-slate-200" /><% } else { %>
      <div class="w-24 h-24 rounded-2xl bg-brand-50 text-brand-600 grid place-items-center text-4xl">👨‍⚕️</div><% } %>
      <div class="min-w-0">
        <h1 class="text-2xl font-black text-slate-900 leading-tight"><%= __dName %></h1>
        <p class="text-brand-600 font-bold mt-0.5"><%= doctor.title || '' %><%= doctor.specialty ? (' · ' + doctor.specialty) : '' %></p>
        <% if (doctor.fee != null) { %><p class="mt-2 text-sm text-slate-600"><%= t('cp.d_fee') %> <b class="text-slate-900"><%= __money(doctor.fee) %> <%= t('cur.egp') %></b></p><% } %>
        <% if (doctor.schedule) { %><p class="mt-1 text-sm text-slate-500">🕒 <%= doctor.schedule %></p><% } %>
      </div>
    </div>
    <% if (doctor.bio) { %><div class="mt-5 pt-5 border-t border-slate-100"><h2 class="font-bold text-slate-900 mb-2"><%= t('cp.d_about') %></h2><p class="text-slate-600 leading-relaxed"><%= doctor.bio %></p></div><% } %>
  </div>

  <% if (__booking) { %>
  <div id="book" class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 mt-6">
    <h2 class="text-xl font-extrabold text-slate-900 mb-1"><%= t('cp.d_book_with') %> <%= __dName %></h2>
    <p class="text-slate-500 text-sm mb-5"><%= t('cp.form_sub') %></p>
    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl p-4 text-sm font-semibold mb-3"><%= t('cp.sent') %></div>
    <% } %>
    <form method="POST" action="/book" class="grid gap-3">
      <input type="hidden" name="doctor_id" value="<%= doctor.id %>" />
      <input type="text" name="patient_name" required maxlength="80" placeholder="<%= t('cp.name') %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
      <input type="tel" name="patient_phone" required maxlength="20" placeholder="<%= t('cp.mobile') %>" dir="ltr" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
      <input type="datetime-local" name="slot_at" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300" />
      <textarea name="reason" maxlength="300" rows="2" placeholder="<%= t('cp.reason') %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-300"></textarea>
      <button type="submit" class="bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl py-3"><%= t('cp.confirm') %></button>
    </form>
    <% if (__wa) { %><a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener" class="mt-3 block text-center text-brand-600 font-bold text-sm"><%= t('cp.d_or_wa') %></a><% } %>
  </div>
  <% } %>
</main>

<footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-400">
  <%= t('cp.powered') %> <a href="https://oscardevs.com" class="text-brand-600 font-semibold">OscarDevs</a> — <%= t('cp.system') %>
</footer>
</body>
</html>
