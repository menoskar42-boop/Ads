<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<%- include('partials/ads_loader') %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var g = gymSettings || {};
  var gName = company.company_name;
  var accent = company.theme_color || '#E4FF1A';
  var tagline = g.tagline || 'ابنِ جسمك. اكسر حدودك.';
  var about = g.about || company.description || 'جيم متكامل بأحدث الأجهزة ومدرّبين معتمدين. ابدأ رحلتك النهاردة.';
  var cTitle = (gName + ' — جيم ولياقة').slice(0, 60);
  var cDesc = (about || tagline).toString().slice(0, 155);
  /* The domain is configuration, not a constant — a hardcoded one makes the
     canonical lie on every other host the site is served from. */
  var canon = (typeof canonicalCompanyUrl === 'function') ? canonicalCompanyUrl(company.slug)
    : ('https://' + company.slug + '.oscardevs.com');
  var days = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
  var wa = (g.whatsapp || '').replace(/[^0-9]/g,'');
  var brandInitial = (gName || 'G').trim().charAt(0);
%>
<% if (noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= cTitle %></title>
<meta name="description" content="<%= cDesc %>" />
<%- include('partials/seo_meta', { title: cTitle, description: cDesc, canonical: canon, siteAppName: gName, siteLogo: company.logo_url || '', ogImage: company.logo_url || '', siteManifest: '/manifest.webmanifest' }) %>
<% if (!noindex) { %>
<script type="application/ld+json">
<%- jsonLd(Object.assign({
  '@context':'https://schema.org','@type':['HealthClub','SportsActivityLocation'],
  name: gName, url: canon, description: cDesc, areaServed:{'@type':'Country',name:'Egypt'}
},
  company.logo_url ? { image: company.logo_url } : {},
  g.phone ? { telephone: g.phone } : {},
  g.address ? { address: { '@type':'PostalAddress', streetAddress: g.address, addressCountry:'EG' } } : {},
  g.hours ? { openingHours: g.hours } : {}
)) %>
</script>
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{ --bg:#0a0a0a; --panel:#121212; --panel2:#161616; --line:#242424; --ink:#fff; --mut:#9a9a9a; --acc:<%= accent %>; --acc-ink:#0a0a0a; }
  *{box-sizing:border-box} html,body{margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:'Cairo',system-ui,sans-serif;direction:rtl;-webkit-font-smoothing:antialiased}
  img{max-width:100%;display:block} a{color:inherit;text-decoration:none} a:hover{color:var(--acc)}
  ::selection{background:var(--acc);color:var(--acc-ink)}
  .site{overflow-x:hidden}
  .imgph{position:absolute;inset:0;background:radial-gradient(circle at 50% 38%, #1e1e1e, #0e0e0e);display:grid;place-items:center;color:#333}
  .imgph svg{width:38px;height:38px;opacity:.7}
  .wrap{max-width:1240px;margin:0 auto;padding:0 20px}
  .ey{display:inline-flex;align-items:center;gap:8px;font-weight:800;font-size:12px;letter-spacing:.14em;color:var(--acc);text-transform:uppercase}
  .ey::before{content:"";width:22px;height:2px;background:var(--acc)}
  .h2{font-weight:900;font-size:clamp(30px,6vw,58px);line-height:1.02;letter-spacing:-.01em;margin:14px 0 0}
  .lead{color:var(--mut);font-weight:500;font-size:clamp(15px,2.4vw,18px);line-height:1.7;max-width:56ch}
  .sec{padding:clamp(64px,9vw,120px) 0}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:inherit;font-weight:800;font-size:15px;border:0;cursor:pointer;border-radius:2px;padding:15px 26px;transition:transform .2s ease,background .2s ease,color .2s ease;line-height:1}
  .btn--acc{background:var(--acc);color:var(--acc-ink)} .btn--acc:hover{transform:translateY(-2px);color:var(--acc-ink)}
  .btn--ghost{background:transparent;color:var(--ink);border:1px solid #333} .btn--ghost:hover{border-color:var(--acc);color:var(--acc)}
  .btn--block{width:100%}
  .nav{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .3s ease,backdrop-filter .3s ease,border-color .3s ease;border-bottom:1px solid transparent}
  .nav--solid{background:rgba(10,10,10,.86);backdrop-filter:blur(14px);border-bottom-color:var(--line)}
  .nav__in{display:flex;align-items:center;justify-content:space-between;height:70px}
  .brand{display:flex;align-items:center;gap:11px;font-weight:900}
  .brand__mk{width:34px;height:34px;display:grid;place-items:center;background:var(--acc);color:var(--acc-ink);border-radius:3px;font-size:19px;font-weight:900;overflow:hidden}
  .brand__mk img{width:100%;height:100%;object-fit:cover}
  .brand__tx{font-size:19px;letter-spacing:.02em}
  .nav__links{display:none;align-items:center;gap:30px;font-weight:700;font-size:15px}
  .nav__links a{color:#d6d6d6;transition:color .2s} .nav__cta{display:none}
  .nav__burger{display:inline-flex;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:8px}
  .nav__burger span{width:24px;height:2px;background:var(--ink);display:block}
  .nav__menu{position:fixed;inset:0;background:var(--bg);z-index:49;display:flex;flex-direction:column;justify-content:center;gap:6px;padding:0 32px;transform:translateY(-100%);opacity:0;pointer-events:none;transition:transform .35s ease,opacity .3s ease}
  .nav__menu.open{transform:none;opacity:1;pointer-events:auto}
  .nav__menu a{font-size:26px;font-weight:800;padding:14px 0;border-bottom:1px solid var(--line)} .nav__menu .btn{margin-top:22px}
  .hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden}
  .hero__bg{position:absolute;inset:0;z-index:0}
  .hero__scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(0deg,rgba(10,10,10,.96) 4%,rgba(10,10,10,.5) 46%,rgba(10,10,10,.72) 100%)}
  .hero__scrim2{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(270deg,rgba(10,10,10,0) 55%,rgba(10,10,10,.85) 100%)}
  .hero__in{position:relative;z-index:2;width:100%;padding-bottom:clamp(48px,8vw,96px);padding-top:120px}
  .hero__badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:100px;padding:8px 16px;font-size:13px;font-weight:700;color:#e8e8e8;margin-bottom:22px}
  .hero h1{font-weight:900;font-size:clamp(42px,10vw,110px);line-height:.94;letter-spacing:-.02em;margin:0;max-width:16ch}
  .hero h1 em{font-style:normal;color:var(--acc)}
  .hero__sub{margin:22px 0 0;color:#cfcfcf;font-weight:500;font-size:clamp(16px,2.6vw,20px);line-height:1.6;max-width:48ch}
  .hero__btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
  .stats{background:var(--acc);color:var(--acc-ink)}
  .stats__grid{display:grid;grid-template-columns:repeat(2,1fr)}
  .stat{padding:30px 20px;text-align:center;border-inline-start:1px solid rgba(10,10,10,.14);border-top:1px solid rgba(10,10,10,.14)}
  .stat:nth-child(-n+2){border-top:0}
  .stat__n{font-weight:900;font-size:clamp(34px,7vw,54px);line-height:1} .stat__l{font-weight:700;font-size:13px;margin-top:6px}
  .fgrid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:44px}
  .fcard{background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:30px 26px;transition:border-color .25s,transform .25s,background .25s}
  .fcard:hover{border-color:var(--acc);transform:translateY(-4px)}
  .fcard__ic{width:52px;height:52px;display:grid;place-items:center;border:1px solid var(--line);border-radius:4px;color:var(--acc);margin-bottom:20px}
  .fcard h3{font-size:20px;font-weight:800;margin:0 0 8px} .fcard p{color:var(--mut);font-size:14.5px;line-height:1.7;margin:0}
  .pgrid{display:grid;grid-template-columns:1fr;gap:18px;margin-top:44px}
  .pcard{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:34px 28px;display:flex;flex-direction:column;position:relative}
  .pcard--hot{background:#0f0f0f;border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}
  .pcard__tag{position:absolute;top:-13px;inset-inline-start:28px;background:var(--acc);color:var(--acc-ink);font-weight:900;font-size:12px;letter-spacing:.06em;padding:6px 14px;border-radius:3px}
  .pcard__name{font-size:15px;font-weight:800;letter-spacing:.04em;color:var(--mut);text-transform:uppercase} .pcard--hot .pcard__name{color:var(--acc)}
  .pcard__price{display:flex;align-items:baseline;gap:8px;margin:16px 0 2px}
  .pcard__price b{font-size:clamp(40px,9vw,56px);font-weight:900;line-height:1} .pcard__price span{color:var(--mut);font-weight:700;font-size:15px}
  .pcard__dur{color:var(--mut);font-size:13.5px;font-weight:600;margin-bottom:22px}
  .pcard ul{list-style:none;padding:0;margin:0 0 28px;display:flex;flex-direction:column;gap:13px}
  .pcard li{display:flex;align-items:flex-start;gap:11px;font-size:14.5px;font-weight:600;color:#e2e2e2} .pcard li svg{flex:none;color:var(--acc);margin-top:2px}
  .pcard .btn{margin-top:auto}
  .cgrid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:44px}
  .ccard{background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden;transition:border-color .25s} .ccard:hover{border-color:#3a3a3a}
  .ccard__top{padding:24px 24px 20px}
  .ccard__row{display:flex;align-items:center;justify-content:space-between;gap:12px} .ccard h3{font-size:22px;font-weight:900;margin:0}
  .ccard__cap{font-size:12px;font-weight:800;color:var(--acc);background:rgba(228,255,26,.1);padding:5px 11px;border-radius:100px;white-space:nowrap}
  .ccard__meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:16px;color:var(--mut);font-size:14px;font-weight:600} .ccard__meta b{color:#e8e8e8;font-weight:700}
  .ccard details{border-top:1px solid var(--line)}
  .ccard summary{list-style:none;cursor:pointer;padding:16px 24px;font-weight:800;font-size:14.5px;display:flex;align-items:center;justify-content:space-between;color:var(--acc);user-select:none}
  .ccard summary::-webkit-details-marker{display:none} .ccard summary .chev{transition:transform .25s} .ccard details[open] summary .chev{transform:rotate(180deg)}
  .booking{padding:4px 24px 24px;display:grid;grid-template-columns:1fr;gap:10px}
  .booking input{width:100%;background:#0c0c0c;border:1px solid var(--line);border-radius:3px;padding:13px 14px;color:var(--ink);font-family:inherit;font-size:14px;font-weight:600}
  .booking input::placeholder{color:#6a6a6a} .booking input:focus{outline:none;border-color:var(--acc)} .booking .btn{margin-top:4px}
  .tgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:44px}
  .tcard{position:relative;border-radius:6px;overflow:hidden;background:var(--panel)}
  .tcard__img{position:relative;aspect-ratio:3/4} .tcard__img img{width:100%;height:100%;object-fit:cover}
  .tcard__grad{position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(0deg,rgba(10,10,10,.95) 6%,rgba(10,10,10,0) 55%)}
  .tcard__cap{position:absolute;z-index:3;bottom:0;inset-inline:0;padding:20px 18px}
  .tcard__cap .sp{color:var(--acc);font-size:11px;font-weight:800;letter-spacing:.06em} .tcard__cap h3{font-size:19px;font-weight:900;margin:5px 0 6px}
  .tcard__cap p{color:#c2c2c2;font-size:12.5px;font-weight:500;margin:0;line-height:1.5}
  .ba{display:grid;grid-template-columns:1fr;gap:20px;margin-top:44px}
  .bacard{background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden}
  .bacard__imgs{display:grid;grid-template-columns:1fr 1fr;gap:2px;position:relative}
  .bacard__slot{position:relative;aspect-ratio:1/1}
  .bacard__lbl{position:absolute;top:12px;inset-inline-start:12px;z-index:3;background:rgba(10,10,10,.75);backdrop-filter:blur(4px);color:#fff;font-size:11px;font-weight:800;padding:5px 11px;border-radius:3px} .bacard__lbl--a{color:var(--acc)}
  .bacard__body{padding:24px} .bacard__q{font-size:16px;font-weight:600;line-height:1.7;color:#eaeaea;margin:0 0 18px}
  .bacard__who{display:flex;align-items:center;gap:12px}
  .bacard__av{width:44px;height:44px;border-radius:50%;overflow:hidden;flex:none;position:relative}
  .bacard__who b{display:block;font-size:14.5px;font-weight:800} .bacard__who span{display:block;font-size:12.5px;color:var(--mut);font-weight:600;margin-top:2px}
  .stars{color:var(--acc);font-size:13px;letter-spacing:2px;margin-bottom:12px}
  .gal{display:grid;grid-template-columns:repeat(2,1fr);grid-auto-rows:150px;gap:10px;margin-top:44px}
  .gal>div{position:relative;overflow:hidden;border-radius:4px} .gal .g-tall{grid-row:span 2} .gal .g-wide{grid-column:span 2}
  .cta{position:relative;overflow:hidden;border-radius:8px;margin:0 20px}
  .cta__bg{position:absolute;inset:0;z-index:0}
  .cta__scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(10,10,10,.94),rgba(10,10,10,.6))}
  .cta__in{position:relative;z-index:2;padding:clamp(48px,8vw,96px) clamp(24px,5vw,72px)}
  .cta h2{font-weight:900;font-size:clamp(34px,7vw,68px);line-height:1;margin:14px 0 0;max-width:16ch}
  .cta__btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
  .cta__info{display:flex;flex-wrap:wrap;gap:26px;margin-top:34px;color:#cfcfcf;font-weight:600;font-size:14.5px}
  .cta__info div span{display:block;color:var(--mut);font-size:12px;font-weight:700;letter-spacing:.04em;margin-bottom:3px}
  .btn--wa{background:#25D366;color:#062a12} .btn--wa:hover{background:#2ee474;color:#062a12}
  .foot{border-top:1px solid var(--line);margin-top:clamp(64px,9vw,110px)}
  .foot__top{display:grid;grid-template-columns:1fr;gap:34px;padding:56px 0 40px}
  /* h3, not h4: the last heading before the footer is an h2, and h2 → h4
     skips a level. The size is set here, so the tag carries no visual weight. */
  .foot__col h3{font-size:13px;font-weight:800;letter-spacing:.06em;color:#fff;margin:0 0 16px;text-transform:uppercase}
  .foot__col a,.foot__col p{display:block;color:var(--mut);font-size:14px;font-weight:600;margin:0 0 11px;line-height:1.5} .foot__col a:hover{color:var(--acc)}
  .foot__bot{border-top:1px solid var(--line);padding:22px 0;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;color:var(--mut);font-size:13px;font-weight:600}
  .foot__bot .pw b{color:#fff} .foot__bot .pw b span{color:var(--acc)} .foot__member{color:#fff;font-weight:800} .foot__member:hover{color:var(--acc)}
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)} .reveal.in{opacity:1;transform:none}
  .msg{max-width:560px;margin:0 auto 24px;border-radius:6px;padding:12px 16px;font-size:14px;font-weight:700;text-align:center}
  .msg--ok{background:rgba(37,211,102,.14);border:1px solid #1f7a44;color:#7ee6a3} .msg--wait{background:rgba(228,255,26,.1);border:1px solid #7a7a1f;color:var(--acc)} .msg--err{background:rgba(255,60,60,.12);border:1px solid #7a2020;color:#ff9b9b}
  @media(min-width:720px){ .fgrid{grid-template-columns:repeat(2,1fr);gap:16px} .pgrid{grid-template-columns:repeat(3,1fr)} .stats__grid{grid-template-columns:repeat(4,1fr)} .stat{border-top:0} .stat:first-child{border-inline-start:0} .booking{grid-template-columns:1fr 1fr} .booking .btn{grid-column:1/-1} .ba{grid-template-columns:1fr 1fr} .tgrid{grid-template-columns:repeat(4,1fr)} .gal{grid-template-columns:repeat(4,1fr);grid-auto-rows:190px} .foot__top{grid-template-columns:2fr 1fr 1fr 1.4fr} }
  @media(min-width:960px){ .nav__links{display:flex} .nav__cta{display:inline-flex} .nav__burger{display:none} .fgrid{grid-template-columns:repeat(3,1fr)} }
</style>
</head>
<body>
<% var DUMBBELL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6.5 6.5l11 11M4 8V6a2 2 0 0 1 2-2h2M20 16v2a2 2 0 0 1-2 2h-2M2 12h2m16 0h2M7 5l-2 2 12 12 2-2z"/></svg>'; %>
<div class="site" dir="rtl" lang="ar">

  <nav class="nav">
    <div class="wrap nav__in">
      <a href="#top" class="brand" aria-label="الرئيسية">
        <span class="brand__mk"><% if (company.logo_url) { %><img src="<%= company.logo_url %>" alt="<%= gName %>" /><% } else { %><%= brandInitial %><% } %></span>
        <span class="brand__tx"><%= gName %></span>
      </a>
      <div class="nav__links">
        <% if (gymPlans.length) { %><a href="#pricing">الباقات</a><% } %>
        <% if (gymClasses.length) { %><a href="#classes">الكلاسات</a><% } %>
        <% if (gymTrainers.length) { %><a href="#trainers">المدرّبون</a><% } %>
        <a href="#contact">اتصل</a>
      </div>
      <a href="#<%= gymPlans.length ? 'pricing' : 'contact' %>" class="btn btn--acc nav__cta">اشترك الآن</a>
      <button class="nav__burger" aria-label="القائمة"><span></span><span></span><span></span></button>
    </div>
    <div class="nav__menu">
      <% if (gymPlans.length) { %><a href="#pricing">الباقات</a><% } %>
      <% if (gymClasses.length) { %><a href="#classes">الكلاسات</a><% } %>
      <% if (gymTrainers.length) { %><a href="#trainers">المدرّبون</a><% } %>
      <a href="#contact">اتصل بنا</a>
      <a href="#<%= gymPlans.length ? 'pricing' : 'contact' %>" class="btn btn--acc">اشترك الآن</a>
    </div>
  </nav>

  <!-- Hero -->
  <% var heroImg = g.hero_url || company.logo_url; var gallery = (typeof gymGallery !== 'undefined' && gymGallery.length) ? gymGallery.map(function(x){return x.url;}) : []; %>
  <header class="hero" id="top">
    <div class="hero__bg"><% if (heroImg) { %><img src="<%= heroImg %>" alt="<%= gName %>" style="width:100%;height:100%;object-fit:cover;<%= g.hero_url ? '' : 'filter:grayscale(.3) brightness(.6)' %>" /><% } else { %><div class="imgph"><%- DUMBBELL %></div><% } %></div>
    <div class="hero__scrim"></div>
    <div class="hero__scrim2"></div>
    <div class="wrap hero__in">
      <span class="hero__badge">✅ حجز أونلاين + متابعة اشتراك</span>
      <h1><%= tagline %></h1>
      <p class="hero__sub"><%= about %></p>
      <div class="hero__btns">
        <a href="#<%= gymPlans.length ? 'pricing' : 'contact' %>" class="btn btn--acc">اشترك الآن</a>
        <% if (gymClasses.length && g.booking_enabled !== false) { %><a href="#classes" class="btn btn--ghost">احجز حصتك</a><% } %>
      </div>
    </div>
  </header>

  <%
    /* Real numbers only.
     *
     * This strip used to print "12 مدرّب" and "40 كلاس" as `|| 12` fallbacks —
     * i.e. exactly when the gym had none — plus a flat "+500 عضو نشط" and
     * "24/7" that came from nowhere at all. Every empty gym advertised a staff,
     * a timetable and a membership it did not have. That is a fabricated claim
     * on a real business's page, and it is the same thing this site removed
     * from its own home page for AdSense.
     *
     * So a figure appears only when it is counted from this gym's own data, and
     * the strip disappears entirely when there is nothing true to say.
     */
    var __stats = [];
    if (gymTrainers.length) __stats.push([gymTrainers.length, 'مدرّب']);
    if (gymClasses.length) __stats.push([gymClasses.length, 'كلاس أسبوعياً']);
    if (gymPlans.length) __stats.push([gymPlans.length, 'باقة اشتراك']);
  %>
  <% if (__stats.length) { %>
  <!-- Stats — counted from this gym's own data, never filled in -->
  <section class="stats">
    <div class="wrap"><div class="stats__grid">
      <% __stats.forEach(function(st){ %>
      <div class="stat"><div class="stat__n"><%= st[0] %></div><div class="stat__l"><%= st[1] %></div></div>
      <% }); %>
    </div></div>
  </section>
  <% } %>

  <!-- Features -->
  <section class="sec" id="features">
    <div class="wrap">
      <div class="reveal"><span class="ey">ليه <%= gName %></span><h2 class="h2">كل اللي محتاجه عشان توصل لهدفك</h2></div>
      <div class="fgrid">
        <% [
          ['<path d="M6.5 6.5l11 11M4 8V6a2 2 0 0 1 2-2h2M20 16v2a2 2 0 0 1-2 2h-2M2 12h2m16 0h2M7 5l-2 2 12 12 2-2z"/>','أجهزة حديثة','أحدث أجهزة المقاومة والكارديو من ماركات عالمية، بصيانة دورية.'],
          ['<path d="M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>','مدرّبون معتمدون','فريق مدرّبين بشهادات دولية يبنولك برنامج تدريب مخصّص.'],
          ['<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4m8-4v4M9 14l2 2 4-4"/>','حجز أونلاين','احجز كلاسك من الموقع في ثواني، من غير طوابير ولا مكالمات.'],
          ['<path d="M4 12h2m12 0h2M6 8v8m12-8v8M9 6v12m6-12v12"/>','أوزان حرة','منطقة أوزان حرة كاملة: دمبل، باربل، وأقفاص قرفصاء.'],
          ['<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>','كلاسات متنوّعة','كروس فيت، بوكسينج، HIIT، ويوجا — جدول أسبوعي كامل.'],
          ['<path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/>','متابعة تقدّم','قياسات دورية ومتابعة لوزنك وأداءك خطوة بخطوة.']
        ].forEach(function(f){ %>
        <div class="fcard reveal">
          <div class="fcard__ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- f[0] %></svg></div>
          <h3><%= f[1] %></h3><p><%= f[2] %></p>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <% if (gymPlans.length) { %>
  <section class="sec" id="pricing" style="padding-top:0">
    <div class="wrap">
      <div class="reveal" style="text-align:center">
        <span class="ey" style="justify-content:center">الباقات</span>
        <h2 class="h2">اختار باقتك وابدأ</h2>
        <p class="lead" style="margin:14px auto 0">اشتراكات مرنة تناسب هدفك. كل الباقات تشمل دخول كامل للجيم.</p>
      </div>
      <div class="pgrid">
        <% gymPlans.forEach(function(p){ %>
        <div class="pcard reveal <%= p.is_popular ? 'pcard--hot' : '' %>">
          <% if (p.is_popular) { %><span class="pcard__tag">الأكثر طلباً</span><% } %>
          <div class="pcard__name"><%= p.name %></div>
          <div class="pcard__price"><b><%= Number(p.price).toFixed(0) %></b><span>ج</span></div>
          <div class="pcard__dur">صالحة <%= p.duration_days %> يوم</div>
          <ul>
            <% (p.features||'').split('\n').filter(Boolean).forEach(function(ft){ %>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-11"/></svg><%= ft %></li>
            <% }); %>
          </ul>
          <a href="#contact" class="btn <%= p.is_popular ? 'btn--acc' : 'btn--ghost' %> btn--block">اشترك</a>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Classes + booking -->
  <% if (gymClasses.length) { %>
  <section class="sec" id="classes" style="background:#0d0d0d">
    <div class="wrap">
      <div class="reveal">
        <span class="ey">الجدول الأسبوعي</span>
        <h2 class="h2">احجز مكانك في الكلاس</h2>
        <p class="lead" style="margin-top:14px">اختار الكلاس اللي يناسبك واحجز مكانك مباشرة. الأماكن محدودة والحجز بالأسبقية.</p>
      </div>
      <% if (typeof gymBookedStatus !== 'undefined' && gymBookedStatus === 'booked') { %><div class="msg msg--ok" style="margin-top:24px">✅ تم حجز مكانك — نشوفك في الكلاس!</div><% } %>
      <% if (typeof gymBookedStatus !== 'undefined' && gymBookedStatus === 'waitlist') { %><div class="msg msg--wait" style="margin-top:24px">الكلاس ممتلئ — اتحطّيت في قائمة الانتظار وهنبلّغك لو فضى مكان.</div><% } %>
      <% if (typeof gymBookError !== 'undefined' && gymBookError === 'bad') { %><div class="msg msg--err" style="margin-top:24px">تعذّر الحجز — تأكّد من الاسم والموبايل وحاول تاني.</div><% } %>
      <% if (typeof gymBookError !== 'undefined' && gymBookError === 'dup') { %><div class="msg msg--wait" style="margin-top:24px">الرقم ده حاجز في الكلاس ده بالفعل — مكانك محفوظ.</div><% } %>
      <% if (typeof gymBookError !== 'undefined' && gymBookError === 'closed') { %><div class="msg msg--err" style="margin-top:24px">الحجز أونلاين مقفول حالياً — كلّمنا وهنحجزلك.</div><% } %>
      <div class="cgrid">
        <% gymClasses.forEach(function(c){ %>
        <div class="ccard reveal">
          <div class="ccard__top">
            <div class="ccard__row"><h3><%= c.name %></h3><span class="ccard__cap"><%= c.capacity %> مكان</span></div>
            <div class="ccard__meta"><span>اليوم: <b><%= days[c.day_of_week] || '' %></b></span><% if (c.start_time) { %><span>الوقت: <b><%= c.start_time %></b></span><% } %><% if (c.trainer_name) { %><span>المدرّب: <b><%= c.trainer_name %></b></span><% } %></div>
          </div>
          <% if (g.booking_enabled !== false) { %>
          <details>
            <summary>احجز مكانك <span class="chev">▾</span></summary>
            <form class="booking" method="POST" action="/book-class">
              <input type="hidden" name="class_id" value="<%= c.id %>" />
              <input name="name" type="text" placeholder="الاسم بالكامل" required>
              <input name="phone" type="tel" placeholder="رقم الموبايل" required>
              <input name="code" type="text" placeholder="كود العضوية (اختياري)">
              <button type="submit" class="btn btn--acc">تأكيد الحجز</button>
            </form>
          </details>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Trainers -->
  <% if (gymTrainers.length) { %>
  <section class="sec" id="trainers">
    <div class="wrap">
      <div class="reveal"><span class="ey">الفريق</span><h2 class="h2">مدرّبون بيفرقوا معاك</h2></div>
      <div class="tgrid">
        <% gymTrainers.forEach(function(t){ %>
        <div class="tcard reveal">
          <div class="tcard__img"><% if (t.photo_url) { %><img src="<%= t.photo_url %>" alt="<%= t.name %>" /><% } else { %><div class="imgph"><%- DUMBBELL %></div><% } %><div class="tcard__grad"></div></div>
          <div class="tcard__cap"><% if (t.specialty) { %><div class="sp"><%= t.specialty %></div><% } %><h3><%= t.name %></h3><% if (t.bio) { %><p><%= t.bio %></p><% } %></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <%# The "before and after" section used to ship two invented members —
      named, star-rated, with quoted results — under the line "أعضاء حقيقيين
      حقّقوا نتايج فعلية". Invented testimonials on a real gym's page are a
      fabricated claim about real people's results, and the reviews that flagged
      it were right. It is removed rather than left as a placeholder: a
      placeholder testimonial is still a testimonial while it is on the page.
      When there is somewhere for a gym to enter its OWN before/after cases,
      this section comes back reading from that. %>


  <!-- Gallery -->
  <section class="sec" id="gallery">
    <div class="wrap">
      <div class="reveal"><span class="ey">جوّه الجيم</span><h2 class="h2">معرض الصور</h2></div>
      <div class="gal reveal">
        <% var galShapes = ['g-tall','','g-wide','','','g-wide','g-tall','','']; %>
        <% for (var gi = 0; gi < 9; gi++) { var cls = galShapes[gi]; var gimg = gallery[gi]; %>
        <div class="<%= cls %>"><% if (gimg) { %><img src="<%= gimg %>" alt="<%= gName %>" loading="lazy" style="width:100%;height:100%;object-fit:cover" /><% } else { %><div class="imgph"><%- DUMBBELL %></div><% } %></div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- CTA + contact -->
  <section id="contact" style="padding-bottom:0">
    <% var ctaImg = gallery[0] || g.hero_url; %>
    <div class="cta reveal">
      <div class="cta__bg"><% if (ctaImg) { %><img src="<%= ctaImg %>" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover" /><% } else { %><div class="imgph"><%- DUMBBELL %></div><% } %></div>
      <div class="cta__scrim"></div>
      <div class="cta__in">
        <span class="ey">يلا نبدأ</span>
        <h2>جاهز تبدأ رحلتك؟</h2>
        <div class="cta__btns">
          <% if (wa) { %><a href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent('حابب أعرف عن الاشتراك في ' + gName) %>" target="_blank" rel="nofollow noopener" class="btn btn--wa"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2m0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4"/></svg>واتساب</a><% } %>
          <% if (g.phone) { %><a href="tel:<%= g.phone %>" class="btn btn--acc">اتصل بنا</a><% } %>
        </div>
        <div class="cta__info">
          <% if (g.address) { %><div><span>العنوان</span><%= g.address %></div><% } %>
          <% if (g.hours) { %><div><span>المواعيد</span><%= g.hours %></div><% } %>
          <% if (g.phone) { %><div><span>الهاتف</span><span dir="ltr" style="color:#cfcfcf;font-size:14.5px"><%= g.phone %></span></div><% } %>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/payment_methods') %>
  <footer class="foot">
    <div class="wrap">
      <div class="foot__top">
        <div class="foot__col">
          <a href="#top" class="brand" style="margin-bottom:16px"><span class="brand__mk"><%= brandInitial %></span><span class="brand__tx"><%= gName %></span></a>
          <p style="max-width:34ch"><%= about.slice(0,120) %></p>
        </div>
        <div class="foot__col">
          <h3>روابط</h3>
          <% if (gymPlans.length) { %><a href="#pricing">الباقات</a><% } %>
          <% if (gymClasses.length) { %><a href="#classes">الكلاسات</a><% } %>
          <% if (gymTrainers.length) { %><a href="#trainers">المدرّبون</a><% } %>
          <a href="#gallery">المعرض</a>
        </div>
        <div class="foot__col">
          <h3>تواصل</h3>
          <% if (g.phone) { %><a href="tel:<%= g.phone %>" dir="ltr"><%= g.phone %></a><% } %>
          <% if (wa) { %><a href="https://wa.me/<%= wa %>" target="_blank" rel="nofollow noopener">واتساب</a><% } %>
        </div>
        <div class="foot__col">
          <h3>العنوان والمواعيد</h3>
          <% if (g.address) { %><p><%= g.address %></p><% } %>
          <% if (g.hours) { %><p><%= g.hours %></p><% } %>
          <a href="/checkin" class="foot__member">عضو حالي؟ سجّل حضورك ←</a>
        </div>
      </div>
      <div class="foot__bot">
        <span>© <%= new Date().getFullYear() %> <%= gName %> — جميع الحقوق محفوظة.</span>
        <span class="pw">مدعوم بواسطة <b>Oscar<span>Devs</span></b></span>
      </div>
    </div>
  </footer>

</div>

<script>
(function(){
  var nav=document.querySelector('.nav');
  if(nav){var onScroll=function(){nav.classList.toggle('nav--solid',window.scrollY>40);};window.addEventListener('scroll',onScroll,{passive:true});onScroll();}
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12,rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else { document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in');}); }
  var burger=document.querySelector('.nav__burger'),menu=document.querySelector('.nav__menu');
  if(burger&&menu){var close=function(){menu.classList.remove('open');document.body.style.overflow='';};
    burger.addEventListener('click',function(){var open=menu.classList.toggle('open');document.body.style.overflow=open?'hidden':'';});
    menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',close);});}
})();
</script>
</body>
</html>
