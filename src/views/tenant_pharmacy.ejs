<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var __phName = company.company_name || 'صيدلية';
  var __suffix = lang === 'en' ? 'Online Pharmacy' : 'صيدلية أونلاين';
  var __brand = ' | OscarDevs';
  var __phTitleBase = (__phName + ' — ' + __suffix);
  // Keep the whole <title> within ~60 chars (stored Bing rule).
  var __phTitle = (__phTitleBase.length + __brand.length) <= 60 ? (__phTitleBase + __brand) : __phTitleBase.slice(0, 60);
  var __phDesc = ((company.description || (__phName + ' — ' + __suffix)).trim()).slice(0, 155);
  var __isDemo = company.slug === 'pharmacy';
  var __online = pharmacySettings && pharmacySettings.online_store_enabled;
  var __showImages = !(pharmacySettings && pharmacySettings.show_images === false);
  var __wa = pharmacySettings && pharmacySettings.whatsapp ? String(pharmacySettings.whatsapp).replace(/[^0-9]/g, '') : '';
  var __otherLang = lang === 'ar' ? 'en' : 'ar';
  var __phCanon = (typeof canonicalCompanyUrl === 'function') ? canonicalCompanyUrl(company.slug) : ('https://' + company.slug + '.oscardevs.com/');
  var __pageNoindex = (typeof noindex !== 'undefined' && noindex);
  var __hasGeo = pharmacySettings && pharmacySettings.lat != null && pharmacySettings.lng != null;
  var __mapUrl = __hasGeo ? ('https://www.google.com/maps/search/?api=1&query=' + Number(pharmacySettings.lat) + ',' + Number(pharmacySettings.lng)) : null;
  // Opening hours for structured data + the "open now" badge (Egypt ≈ UTC+2).
  var __oh = null;
  var __isOpen = false;
  if (pharmacySettings) {
    if (pharmacySettings.is_night_shift) { __oh = 'Mo-Su 00:00-23:59'; __isOpen = true; }
    else if (pharmacySettings.open_hour != null && pharmacySettings.close_hour != null) {
      var __pad = function (n) { n = parseInt(n, 10); return (n < 10 ? '0' : '') + n + ':00'; };
      __oh = 'Mo-Su ' + __pad(pharmacySettings.open_hour) + '-' + __pad(pharmacySettings.close_hour);
      var __eHour = (new Date().getUTCHours() + 2) % 24;
      var __o = parseInt(pharmacySettings.open_hour, 10), __c = parseInt(pharmacySettings.close_hour, 10);
      __isOpen = (__o <= __c) ? (__eHour >= __o && __eHour < __c) : (__eHour >= __o || __eHour < __c);
    }
  }
  function __money(v) {
    if (v == null) return null;
    var n = Number(v); if (!isFinite(n)) return null;
    return n.toLocaleString(lang === 'ar' ? 'ar-EG' : 'en-US', { maximumFractionDigits: 2 });
  }
  var __hasBanners = typeof banners !== 'undefined' && banners && banners.length;
%>
<% if (__pageNoindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __phTitle %></title>
<meta name="description" content="<%= __phDesc %>" />
<%- include('partials/seo_meta', { title: __phTitle, description: __phDesc, canonical: __phCanon, siteLogo: company.logo_url || '', siteAppName: __phName, ogImage: company.logo_url || '', siteManifest: '/manifest.webmanifest' }) %>
<% if (!__pageNoindex) { %>
<%# GEO / local structured data — only on indexable pages. %>
<script type="application/ld+json">
<%- jsonLd(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'Pharmacy',
  name: __phName,
  url: __phCanon,
  description: __phDesc,
  areaServed: { '@type': 'Country', name: 'Egypt' }
},
  company.logo_url ? { image: company.logo_url } : {},
  __wa ? { telephone: '+' + __wa } : {},
  (pharmacySettings && pharmacySettings.address) ? { address: { '@type': 'PostalAddress', streetAddress: pharmacySettings.address, addressCountry: 'EG' } } : {},
  __hasGeo ? { geo: { '@type': 'GeoCoordinates', latitude: Number(pharmacySettings.lat), longitude: Number(pharmacySettings.lng) }, hasMap: __mapUrl } : {},
  __oh ? { openingHours: __oh } : {}
)) %>
</script>
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: { extend: {
      fontFamily: { sans: ['Cairo', 'system-ui', 'sans-serif'] },
      colors: {
        brand: { 50:'#eef8f5',100:'#d3ede6',200:'#a6dbce',300:'#71c2b1',400:'#3fa392',500:'#1f8a7b',600:'#137063',700:'#0f5a50',800:'#0e4841',900:'#0c3b36' },
        sand: { 50:'#faf8f4',100:'#f4f0e8',200:'#e9e2d5',300:'#d8cdb8' },
        ink: '#182a27',
        accent: '#e8734a',
      },
      boxShadow: {
        card: '0 1px 2px rgba(24,42,39,.04), 0 6px 20px -8px rgba(24,42,39,.10)',
        cardHover: '0 2px 4px rgba(24,42,39,.05), 0 14px 34px -10px rgba(24,42,39,.18)',
        lift: '0 10px 40px -12px rgba(24,42,39,.22)',
      },
      borderRadius: { xl2: '1.25rem' },
    } }
  }
</script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  html { scroll-behavior: smooth; }
  :root { --accent: #e8734a; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  /* Crystal / glossy buttons with a hover shine sweep + glow. */
  .crystal { position: relative; overflow: hidden; isolation: isolate; transition: box-shadow .35s ease, transform .2s ease, filter .35s ease; }
  .crystal::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,.38), rgba(255,255,255,.06) 42%, rgba(255,255,255,0) 60%); }
  .crystal::before { content: ''; position: absolute; top: -20%; left: -80%; width: 55%; height: 160%; pointer-events: none; transform: skewX(-22deg); background: linear-gradient(90deg, transparent, rgba(255,255,255,.65), transparent); transition: left .6s ease; }
  .crystal:hover::before, .crystal:focus-visible::before { left: 130%; }
  .crystal:hover, .crystal:focus-visible { filter: brightness(1.09) saturate(1.05); box-shadow: 0 10px 26px -8px var(--accent), inset 0 1px 0 rgba(255,255,255,.4); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) { .crystal::before { transition: none; } .crystal:hover { transform: none; } }
  :focus-visible { outline: 3px solid #1f8a7b; outline-offset: 2px; border-radius: 6px; }
  .ph-grid { background-image: radial-gradient(rgba(24,42,39,.10) 1px, transparent 1px); background-size: 14px 14px; }
  /* Clickability guard: keep every card an isolated, non-overlapping stacking
     context, and lift the "add" button above any decorative layer so real mouse
     clicks always land on it (fixes a reported z-index overlap on the add btn). */
  .med-card { position: relative; z-index: 0; }
  .med-card:hover, .med-card:focus-within { z-index: 1; }
  .ph-add { position: relative; z-index: 2; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation-duration: .001ms !important; transition-duration: .001ms !important; } }
</style>
</head>

<body class="bg-sand-50 text-ink antialiased">
<%
  /* Why an order was refused. It used to redirect here with ?err= and show
     nothing at all: the customer saw the page reload with a full cart and no
     explanation. */
  var __q = (typeof query !== 'undefined' && query) ? query : {};
  var __errMsg = null;
  if (__q.err === 'stock') {
    __errMsg = __q.item
      ? ('«' + __q.item + '» مابقاش متاح بالكمية اللي في سلتك'
         + (__q.left !== undefined ? (' — المتاح دلوقتي ' + __q.left) : '')
         + '. عدّل الكمية وجرّب تاني.')
      : 'واحد من الأصناف مابقاش متاح بالكمية اللي طلبتها. عدّل السلة وجرّب تاني.';
  }
%>
<% if (__errMsg) { %>
<div class="max-w-3xl mx-auto mt-3 px-4">
  <div class="rounded-2xl px-4 py-3 text-sm" style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;">
    <%= __errMsg %>
  </div>
</div>
<% } %>

<!-- ═══ HEADER ═══ -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-sand-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-center gap-3 py-3">
      <a href="/" class="flex items-center gap-3 min-w-0" aria-label="<%= __phName %>">
        <% if (company.logo_url) { %>
          <img src="<%= company.logo_url %>" alt="<%= __phName %>" class="h-11 w-11 shrink-0 rounded-2xl object-cover" />
        <% } else { %>
          <span class="grid place-items-center h-11 w-11 shrink-0 rounded-2xl bg-brand-500 text-white shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16"/><path d="M6 11v5a5 5 0 0 0 10 0v-5"/><path d="M11 6.5 13 4"/><path d="M9.5 8 15 2.5"/></svg>
          </span>
        <% } %>
        <span class="min-w-0">
          <h1 class="text-[17px] sm:text-lg font-extrabold leading-tight truncate"><%= __phName %></h1>
          <% if (company.description) { %><p class="text-[12px] text-brand-700/80 leading-tight truncate"><%= company.description %></p><% } %>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-2 ms-2">
        <% if (__isOpen) { %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 text-brand-700 px-3 py-1.5 text-[13px] font-semibold border border-brand-100">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75 animate-ping"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span></span>
          <%= t('pharmacy.open_now') %>
        </span>
        <% } %>
        <% if (pharmacySettings && pharmacySettings.is_night_shift) { %>
        <span role="status" title="<%= t('pharmacy.night_shift') %>" class="cursor-default select-none inline-flex items-center gap-1.5 rounded-full bg-indigo-50 text-indigo-700 px-3 py-1.5 text-[13px] font-semibold border border-indigo-100">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 1 1 8.5 4a6.5 6.5 0 0 0 11.5 11.5z"/></svg>
          <%= t('pharmacy.night_shift') %>
        </span>
        <% } %>
        <% if (__isDemo) { %><span class="inline-flex items-center rounded-full bg-sand-100 text-ink/60 px-3 py-1.5 text-[13px] font-semibold border border-sand-200"><%= t('pharmacy.demo_badge') %></span><% } %>
      </div>

      <div class="flex items-center gap-2 ms-auto">
        <a href="?lang=<%= __otherLang %>" class="inline-flex items-center gap-1.5 rounded-full border border-sand-200 bg-white hover:bg-sand-50 px-3 py-2 text-[13px] font-bold transition" aria-label="language">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
          <%= t('common.toggle_lang') %>
        </a>
        <% if (__wa) { %>
        <a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-brand-500 hover:bg-brand-600 active:bg-brand-700 text-white px-3.5 sm:px-4 py-2 text-[13px] sm:text-sm font-bold shadow-sm transition">
          <svg viewBox="0 0 24 24" class="h-4 w-4" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15h-.003a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.19 8.19 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24z"/></svg>
          <span class="hidden sm:inline"><%= t('pharmacy.whatsapp') %></span>
        </a>
        <% } %>
      </div>
    </div>

    <% if ((pharmacySettings && pharmacySettings.address) || __hasGeo) { %>
    <div class="flex items-center gap-3 pb-3 -mt-0.5">
      <a href="<%= __mapUrl || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(pharmacySettings.address || __phName)) %>" target="_blank" rel="noopener"
         class="inline-flex items-center gap-1.5 text-[13px] text-ink/70 hover:text-brand-600 transition min-w-0">
        <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="truncate"><%= (pharmacySettings && pharmacySettings.address) ? pharmacySettings.address : t('pharmacy.find_map') %></span>
      </a>
      <% if (__isOpen) { %>
      <span class="md:hidden inline-flex items-center gap-1.5 ms-auto rounded-full bg-brand-50 text-brand-700 px-2.5 py-1 text-[12px] font-semibold border border-brand-100 shrink-0">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span><%= t('pharmacy.open_now') %>
      </span>
      <% } %>
    </div>
    <% } %>
  </div>
</header>

<main class="mx-auto max-w-6xl px-4 sm:px-6">

  <!-- ═══ HERO CAROUSEL (admin-managed banner_slides) ═══ -->
  <% if (__hasBanners) { %>
  <section id="carousel" class="mt-4 sm:mt-6" aria-roledescription="carousel" aria-label="<%= __phName %>" tabindex="0">
    <div class="relative overflow-hidden rounded-2xl shadow-card bg-brand-800">
      <div id="carTrack" class="flex transition-transform duration-500 ease-out" aria-live="polite">
        <% banners.forEach(function(bn, bi){ %>
          <div class="carslide relative shrink-0 w-full aspect-[16/7] sm:aspect-[16/6]" role="group" aria-roledescription="slide">
            <% var __slide = '<img src="'+ bn.image_url +'" alt="'+ (bn.caption ? String(bn.caption).replace(/"/g,'&quot;') : __phName) +'" class="absolute inset-0 w-full h-full object-cover" loading="'+(bi===0?'eager':'lazy')+'" />'; %>
            <% if (bn.target_url) { %><a href="<%= safeUrl(bn.target_url) %>" class="block absolute inset-0"><%- __slide %></a><% } else { %><%- __slide %><% } %>
            <% if (bn.caption) { %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-8"><h2 class="text-white text-lg sm:text-2xl font-extrabold leading-snug drop-shadow"><%= bn.caption %></h2></div>
            <% } %>
          </div>
        <% }); %>
      </div>
      <button id="carPrev" type="button" class="carctrl absolute top-1/2 -translate-y-1/2 start-3 grid place-items-center h-10 w-10 rounded-full bg-white/90 hover:bg-white text-ink shadow-lift transition" aria-label="prev"><svg viewBox="0 0 24 24" class="h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button id="carNext" type="button" class="carctrl absolute top-1/2 -translate-y-1/2 end-3 grid place-items-center h-10 w-10 rounded-full bg-white/90 hover:bg-white text-ink shadow-lift transition" aria-label="next"><svg viewBox="0 0 24 24" class="h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      <div id="carDots" class="absolute bottom-3 inset-x-0 flex justify-center gap-2" role="tablist" aria-label="slides"></div>
    </div>
  </section>
  <% } %>

  <% if (!pharmacyItems || pharmacyItems.length === 0) { %>
    <!-- Empty stock -->
    <section class="mt-8 text-center py-16 rounded-2xl bg-white border border-dashed border-sand-300">
      <div class="mx-auto grid place-items-center h-16 w-16 rounded-2xl bg-brand-50 text-brand-400 mb-4"><svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M9 6h2"/></svg></div>
      <p class="font-bold"><%= t('pharmacy.no_stock') %></p>
      <% if (__wa) { %><a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 rounded-full bg-brand-500 hover:bg-brand-600 text-white px-4 py-2.5 text-sm font-bold transition"><%= t('pharmacy.whatsapp') %></a><% } %>
    </section>
  <% } else { %>

    <!-- ═══ SEARCH (instant, client-side) ═══ -->
    <section class="mt-6 sm:mt-8">
      <label for="search" class="sr-only"><%= t('pharmacy.meds_title') %></label>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-4 text-ink/40">
          <svg id="searchIcon" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <svg id="searchSpin" viewBox="0 0 24 24" class="h-5 w-5 hidden animate-spin text-brand-500" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity=".25"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
        </span>
        <input id="search" type="search" inputmode="search" autocomplete="off" placeholder="<%= t('pharmacy.search_placeholder') %>"
               class="w-full rounded-2xl border border-sand-200 bg-white ps-12 pe-4 py-4 text-base font-medium shadow-card placeholder:text-ink/35 focus:border-brand-400 focus:ring-4 focus:ring-brand-100 transition" />
      </div>
    </section>

    <!-- ═══ MEDICINES GRID ═══ -->
    <section id="meds" class="mt-6 sm:mt-8 scroll-mt-24">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-lg sm:text-xl font-extrabold"><%= t('pharmacy.meds_title') %></h2>
        <span id="resultCount" class="text-[13px] text-ink/55 font-semibold"><%= __money(pharmacyItems.length) %> <%= t('pharmacy.items_word') %></span>
      </div>

      <div id="medsGrid" class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        <% pharmacyItems.forEach(function(it){
             var avail = Number(it.available_qty) || 0;
             var minq = Number(it.min_qty) || 0;
             var state = avail <= 0 ? 'out' : (((minq > 0 && Number(it.qty) <= minq) || avail <= 5) ? 'low' : 'in');
             var price = __money(it.price);
             var primary = (lang === 'en' && it.name_en) ? it.name_en : it.name_ar;
             var secondary = (lang === 'en' && it.name_en) ? it.name_ar : it.name_en;
             var subline = [secondary, it.form].filter(Boolean).join(' · ');
             var initial = (primary || '؟').trim().charAt(0);
             var searchHay = [it.name_ar, it.name_en, it.scientific_name].filter(Boolean).join(' ');
             var badgeCls = state==='in' ? 'bg-brand-50 text-brand-700 border-brand-200' : (state==='low' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-red-50 text-red-700 border-red-200');
             var badgeDot = state==='in' ? 'bg-brand-500' : (state==='low' ? 'bg-amber-500' : 'bg-red-500');
             var badgeTxt = state==='in' ? t('pharmacy.available') : (state==='low' ? t('pharmacy.limited') : t('pharmacy.out'));
        %>
        <article class="med-card group flex flex-col rounded-xl2 bg-white border border-sand-200 shadow-card <%= state==='out' ? '' : 'hover:shadow-cardHover hover:-translate-y-0.5' %> transition-all duration-200 overflow-hidden"
                 data-hay="<%= searchHay.toLowerCase() %>">
          <% if (__showImages) { %>
          <div class="relative aspect-square <%= it.image_url ? 'bg-sand-100' : 'bg-brand-50' %> grid place-items-center p-4">
            <% if (it.image_url) { %>
              <img src="<%= it.image_url %>" alt="<%= primary %>" loading="lazy" class="absolute inset-0 w-full h-full object-contain p-4 <%= state==='out' ? 'opacity-50 grayscale' : '' %>" />
            <% } else { %>
              <div class="relative flex flex-col items-center justify-center">
                <div class="relative grid place-items-center h-16 w-16 rounded-2xl bg-white border border-brand-100 shadow-sm">
                  <svg viewBox="0 0 24 24" class="h-8 w-8 text-brand-300" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M9 6h2"/></svg>
                  <span class="absolute -bottom-2 -end-2 grid place-items-center h-7 w-7 rounded-full bg-brand-500 text-white text-sm font-extrabold"><%= initial %></span>
                </div>
                <p class="mt-3 text-[11px] font-semibold text-brand-700/60"><%= t('pharmacy.no_image') %></p>
              </div>
            <% } %>
            <span class="absolute top-2.5 start-2.5 inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-bold <%= badgeCls %>"><span class="h-1.5 w-1.5 rounded-full <%= badgeDot %>"></span><%= badgeTxt %></span>
          </div>
          <% } %>
          <div class="flex flex-col flex-1 p-3">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-bold text-[15px] leading-tight <%= state==='out' ? 'text-ink/70' : '' %>"><%= primary %></h3>
              <% if (!__showImages) { %><span class="shrink-0 inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-bold <%= badgeCls %>"><span class="h-1.5 w-1.5 rounded-full <%= badgeDot %>"></span><%= badgeTxt %></span><% } %>
            </div>
            <% if (subline) { %><p class="text-[12px] text-ink/50 leading-tight"><%= subline %></p><% } %>
            <% if (it.description) { %><p class="text-[12px] text-ink/55 leading-snug mt-1"><%= it.description %></p><% } %>
            <div class="mt-auto pt-3 flex items-end justify-between gap-2">
