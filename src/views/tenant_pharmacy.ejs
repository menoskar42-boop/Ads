              <% if (state === 'out') { %>
                <span class="inline-flex items-center rounded-full bg-sand-100 text-ink/40 border border-sand-200 px-3.5 py-2 text-[13px] font-bold"><%= t('pharmacy.out') %></span>
              <% } else if (__online) { %>
                <button type="button" class="ph-add crystal inline-flex items-center gap-1 rounded-full bg-accent hover:brightness-95 active:brightness-90 text-white px-3.5 py-2 text-[13px] font-bold shadow-sm transition"
                        data-id="<%= it.medicine_id %>" data-name="<%= primary %>" data-price="<%= Number(it.price) || 0 %>" data-max="<%= avail %>">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.4 12.4a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.3L22 7H6"/></svg>
                  <span class="ph-add-label"><%= t('pharmacy.cart.add') %></span>
                </button>
              <% } else if (__wa) { %>
                <a href="https://wa.me/<%= __wa %>?text=<%= encodeURIComponent(t('pharmacy.order_wa_msg') + ' ' + primary) %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded-full bg-brand-500 hover:bg-brand-600 text-white px-3.5 py-2 text-[13px] font-bold shadow-sm transition"><%= t('pharmacy.order_wa_btn') %></a>
              <% } else { %>
                <span class="text-xs text-ink/40"><%= t('pharmacy.order_from_pharmacy') %></span>
              <% } %>
            </div>
          </div>
        </article>
        <% }); %>
      </div>

      <!-- No search results (client-toggled) -->
      <div id="emptySearch" class="hidden text-center py-16">
        <div class="mx-auto grid place-items-center h-16 w-16 rounded-2xl bg-sand-100 text-ink/40 mb-4"><svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></div>
        <p class="font-bold text-[15px]"><%= t('pharmacy.no_results_generic') %></p>
        <p class="text-[13px] text-ink/50 mt-1"><%= t('pharmacy.try_another') %></p>
        <% if (__wa) { %><a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 rounded-full bg-brand-500 hover:bg-brand-600 text-white px-4 py-2.5 text-sm font-bold transition"><%= t('pharmacy.whatsapp') %></a><% } %>
      </div>
    </section>
  <% } %>

</main>

