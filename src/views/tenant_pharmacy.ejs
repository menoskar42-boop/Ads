<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var __phName = company.company_name || 'صيدلية';
  var __suffix = lang === 'en' ? 'Online Pharmacy' : 'صيدلية أونلاين';
  var __brand = ' | OscarDevs';
  var __phTitleBase = (__phName + ' — ' + __suffix);
  // Keep the whole <title> within ~60 chars (stored Bing rule): append the
  // brand suffix only when it still fits, otherwise show the title alone.
  var __phTitle = (__phTitleBase.length + __brand.length) <= 60 ? (__phTitleBase + __brand) : __phTitleBase.slice(0, 60);
  var __phDesc = ((company.description || (__phName + ' — ' + __suffix)).trim()).slice(0, 155);
  var __theme = company.theme_color || '#0e7c66';
  var __isDemo = company.slug === 'pharmacy';
  var __online = pharmacySettings && pharmacySettings.online_store_enabled;
  var __wa = pharmacySettings && pharmacySettings.whatsapp ? String(pharmacySettings.whatsapp).replace(/[^0-9]/g, '') : '';
  var __qs = currentSearch ? ('&q=' + encodeURIComponent(currentSearch)) : '';
  var __otherLang = lang === 'ar' ? 'en' : 'ar';
  var __phCanon = 'https://' + company.slug + '.oscardevs.com/';
  var __pageNoindex = (typeof noindex !== 'undefined' && noindex);
  // Local/GEO opening hours for structured data.
  var __oh = null;
  if (pharmacySettings) {
    if (pharmacySettings.is_night_shift) __oh = 'Mo-Su 00:00-23:59';
    else if (pharmacySettings.open_hour != null && pharmacySettings.close_hour != null) {
      var __pad = function (n) { n = parseInt(n, 10); return (n < 10 ? '0' : '') + n + ':00'; };
      __oh = 'Mo-Su ' + __pad(pharmacySettings.open_hour) + '-' + __pad(pharmacySettings.close_hour);
    }
  }
%>
<% if (__pageNoindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __phTitle %></title>
<meta name="description" content="<%= __phDesc %>" />
<%- include('partials/seo_meta', { title: __phTitle, description: __phDesc, canonical: __phCanon }) %>
<% if (!__pageNoindex) { %>
<%# GEO / local structured data — helps Google local pack, Maps and AI answer
    engines understand this is a real Egyptian pharmacy. Only on indexable pages. %>
<script type="application/ld+json">
<%- JSON.stringify(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'Pharmacy',
  name: __phName,
  url: __phCanon,
  description: __phDesc,
  areaServed: { '@type': 'Country', name: 'Egypt' }
},
  company.logo_url ? { image: company.logo_url } : {},
  __wa ? { telephone: '+' + __wa } : {},
  (pharmacySettings && pharmacySettings.address) ? { address: { '@type': 'PostalAddress', streetAddress: pharmacySettings.address, addressCountry: 'EG' } } : {},
  (pharmacySettings && pharmacySettings.lat != null && pharmacySettings.lng != null) ? { geo: { '@type': 'GeoCoordinates', latitude: Number(pharmacySettings.lat), longitude: Number(pharmacySettings.lng) }, hasMap: 'https://www.google.com/maps/search/?api=1&query=' + Number(pharmacySettings.lat) + ',' + Number(pharmacySettings.lng) } : {},
  __oh ? { openingHours: __oh } : {}
)) %>
</script>
<% } %>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  :root { --brand: <%= __theme %>; }
  .brand-bg { background: var(--brand); }
  .brand-text { color: var(--brand); }
  .brand-border { border-color: var(--brand); }
</style>
</head>
<body class="bg-gray-50 text-gray-800">

<!-- Header -->
<header class="brand-bg text-white">
  <div class="max-w-4xl mx-auto px-4 py-5">
    <div class="flex items-center gap-3">
      <% if (company.logo_url) { %>
        <img src="<%= company.logo_url %>" alt="<%= __phName %>" class="w-12 h-12 rounded-xl object-cover bg-white/20" />
      <% } else { %>
        <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-2xl">💊</div>
      <% } %>
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl font-extrabold leading-tight truncate"><%= __phName %></h1>
        <div class="flex items-center gap-2 mt-1 text-sm text-white/90 flex-wrap">
          <% if (__isDemo) { %><span class="bg-white/25 rounded-full px-2 py-0.5 text-xs font-bold"><%= t('pharmacy.demo_badge') %></span><% } %>
          <% if (pharmacySettings && pharmacySettings.is_night_shift) { %><span class="bg-white/25 rounded-full px-2 py-0.5 text-xs">🌙 <%= t('pharmacy.night_shift') %></span><% } %>
          <%
            var __hasGeo = pharmacySettings && pharmacySettings.lat != null && pharmacySettings.lng != null;
            var __mapUrl = __hasGeo ? ('https://www.google.com/maps/search/?api=1&query=' + Number(pharmacySettings.lat) + ',' + Number(pharmacySettings.lng)) : null;
          %>
          <% if (pharmacySettings && pharmacySettings.address) { %>
            <% if (__hasGeo) { %><a href="<%= __mapUrl %>" target="_blank" rel="noopener" class="underline">📍 <%= pharmacySettings.address %></a>
            <% } else { %><span>📍 <%= pharmacySettings.address %></span><% } %>
          <% } else if (__hasGeo) { %><a href="<%= __mapUrl %>" target="_blank" rel="noopener" class="underline">📍 <%= t('pharmacy.view_on_map') %></a><% } %>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a href="?lang=<%= __otherLang %><%= __qs %>"
           class="inline-flex items-center bg-white/20 hover:bg-white/30 rounded-lg px-3 py-2 text-sm font-bold"
           aria-label="language"><%= t('common.toggle_lang') %></a>
        <% if (__wa) { %>
          <a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener"
             class="hidden sm:inline-flex items-center gap-1 bg-white/20 hover:bg-white/30 rounded-xl px-3 py-2 text-sm font-bold">
            <%= t('pharmacy.whatsapp') %>
          </a>
        <% } %>
      </div>
    </div>
    <% if (company.description) { %>
      <p class="mt-3 text-white/90 text-sm leading-7"><%= company.description %></p>
    <% } %>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-6">

  <!-- Search -->
  <form method="get" class="mb-5">
    <% if (lang !== 'ar') { %><input type="hidden" name="lang" value="<%= lang %>" /><% } %>
    <div class="flex gap-2">
      <input name="q" value="<%= currentSearch || '' %>" placeholder="<%= t('pharmacy.search_placeholder') %>"
             class="flex-1 rounded-xl border-2 brand-border px-4 py-3 text-base outline-none bg-white" />
      <button type="submit" class="brand-bg text-white rounded-xl px-5 py-3 font-bold"><%= t('common.search') %></button>
    </div>
  </form>

  <% if (!pharmacyItems || pharmacyItems.length === 0) { %>
    <div class="text-center py-16 text-gray-500">
      <% if (currentSearch) { %>
        <%= t('pharmacy.no_results_for') %> «<%= currentSearch %>». <%= t('pharmacy.try_another') %>
      <% } else { %>
        <%= t('pharmacy.no_stock') %>
      <% } %>
    </div>
  <% } else { %>
    <div class="grid gap-3 sm:grid-cols-2">
      <% pharmacyItems.forEach(function(it){
           var avail = Number(it.available_qty) || 0;
           var state = avail <= 0 ? 'out' : (avail <= 5 ? 'low' : 'in');
           var price = it.price != null ? Number(it.price).toFixed(2) : null;
           var primary = (lang === 'en' && it.name_en) ? it.name_en : it.name_ar;
           var secondary = (lang === 'en' && it.name_en) ? it.name_ar : it.name_en;
      %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex flex-col">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <h2 class="font-extrabold text-gray-900 leading-tight"><%= primary %></h2>
              <% if (secondary) { %><p class="text-xs text-gray-400"><%= secondary %></p><% } %>
              <p class="text-xs text-gray-500 mt-1">
                <% if (it.form) { %><%= it.form %><% } %><% if (it.manufacturer) { %> · <%= it.manufacturer %><% } %>
              </p>
            </div>
            <% if (state === 'in') { %>
              <span class="shrink-0 text-xs font-bold text-green-700 bg-green-50 rounded-full px-2 py-1"><%= t('pharmacy.available') %></span>
            <% } else if (state === 'low') { %>
              <span class="shrink-0 text-xs font-bold text-amber-700 bg-amber-50 rounded-full px-2 py-1"><%= t('pharmacy.limited') %></span>
            <% } else { %>
              <span class="shrink-0 text-xs font-bold text-gray-500 bg-gray-100 rounded-full px-2 py-1"><%= t('pharmacy.out') %></span>
            <% } %>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <% if (price) { %><bdi class="brand-text font-extrabold text-lg"><%= price %> <%= t('pharmacy.currency') %></bdi><% } else { %><span></span><% } %>
            <% if (__online && state !== 'out') { %>
              <a href="/order?m=<%= it.medicine_id %><%= lang !== 'ar' ? '&lang=' + lang : '' %>"
                 class="brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold"><%= t('pharmacy.order') %></a>
            <% } else if (state === 'out') { %>
              <span class="text-xs text-gray-400"><%= t('pharmacy.ask_alternative') %></span>
            <% } else { %>
              <span class="text-xs text-gray-400"><%= t('pharmacy.order_from_pharmacy') %></span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- trust / footer -->
  <div class="mt-10 text-center text-sm text-gray-400">
    <% if (__online) { %>
      <p class="mb-1"><%= t('pharmacy.online_note') %></p>
    <% } %>
    <p><%= t('pharmacy.provided_by') %>
      <a href="https://oscardevs.com" target="_blank" rel="noopener" class="brand-text font-bold underline">OscarDevs</a>
    </p>
  </div>
</main>

</body>
</html>
