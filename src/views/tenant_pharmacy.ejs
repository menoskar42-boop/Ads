        <div><p class="font-bold text-sm"><%= t('pharmacy.working_hours') %></p><p class="text-[12px] text-ink/55"><% if (pharmacySettings.is_night_shift) { %><%= t('pharmacy.hours_24') %><% } else { %><span dir="ltr"><%= __oh.replace('Mo-Su ', '') %></span><% } %></p></div>
