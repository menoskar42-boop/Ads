  </div>
</footer>

<script>
/* Hero carousel — RTL-aware, autoplay, a11y */
(function () {
  var root = document.getElementById('carousel');
  if (!root) return;
  var track = document.getElementById('carTrack');
  var slides = Array.prototype.slice.call(document.querySelectorAll('.carslide'));
  var dotsWrap = document.getElementById('carDots');
  var prev = document.getElementById('carPrev');
  var next = document.getElementById('carNext');
  var N = slides.length;
  if (N === 0) { root.remove(); return; }
  if (N === 1) { prev.remove(); next.remove(); dotsWrap.remove(); return; }
  var i = 0, timer = null, paused = false, AUTO = 5500;
  slides.forEach(function (_, idx) {
    var b = document.createElement('button');
    b.type = 'button'; b.setAttribute('role', 'tab'); b.setAttribute('aria-label', 'slide ' + (idx + 1));
    b.className = 'h-2 rounded-full transition-all duration-300';
    b.addEventListener('click', function () { go(idx); restart(); });
    dotsWrap.appendChild(b);
  });
  var dots = Array.prototype.slice.call(dotsWrap.children);
  function render() {
    var rtl = document.documentElement.dir === 'rtl';
    track.style.transform = 'translateX(' + (i * 100 * (rtl ? 1 : -1)) + '%)';
    dots.forEach(function (d, idx) {
      var on = idx === i;
      d.classList.toggle('bg-white', on); d.classList.toggle('w-6', on);
      d.classList.toggle('bg-white/50', !on); d.classList.toggle('w-2', !on);
      d.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }
  function go(n) { i = (n + N) % N; render(); }
  function nextS() { go(i + 1); } function prevS() { go(i - 1); }
  function start() { if (!paused) timer = setInterval(nextS, AUTO); }
  function stop() { clearInterval(timer); }
  function restart() { stop(); start(); }
  next.addEventListener('click', function () { nextS(); restart(); });
  prev.addEventListener('click', function () { prevS(); restart(); });
  ['mouseenter', 'focusin'].forEach(function (e) { root.addEventListener(e, function () { paused = true; stop(); }); });
  ['mouseleave', 'focusout'].forEach(function (e) { root.addEventListener(e, function () { paused = false; restart(); }); });
  root.addEventListener('keydown', function (e) {
    var rtl = document.documentElement.dir === 'rtl';
    if (e.key === 'ArrowRight') { rtl ? nextS() : prevS(); restart(); }
    if (e.key === 'ArrowLeft') { rtl ? prevS() : nextS(); restart(); }
  });
  var x0 = null;
  track.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; stop(); }, { passive: true });
  track.addEventListener('touchend', function (e) {
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0, rtl = document.documentElement.dir === 'rtl';
    if (Math.abs(dx) > 40) { (rtl ? dx > 0 : dx < 0) ? nextS() : prevS(); }
    x0 = null; restart();
  }, { passive: true });
  render(); start();
})();

/* Instant client-side search over the rendered cards */
(function () {
  var input = document.getElementById('search');
  if (!input) return;
  var cards = Array.prototype.slice.call(document.querySelectorAll('.med-card'));
  var empty = document.getElementById('emptySearch');
  var grid = document.getElementById('medsGrid');
  var count = document.getElementById('resultCount');
  var icon = document.getElementById('searchIcon');
  var spin = document.getElementById('searchSpin');
  var unit = <%- jsonLd(t('pharmacy.items_word')) %>;
  var isAr = document.documentElement.lang === 'ar';
  var toAr = function (n) { return isAr ? String(n).replace(/\d/g, function (d) { return '٠١٢٣٤٥٦٧٨٩'[d]; }) : String(n); };
  var t = null;
  function filter() {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function (c) {
      var match = !q || (c.dataset.hay || '').indexOf(q) !== -1;
      c.classList.toggle('hidden', !match);
      if (match) shown++;
    });
    empty.classList.toggle('hidden', shown !== 0);
    grid.classList.toggle('hidden', shown === 0);
    count.textContent = toAr(shown) + ' ' + unit;
  }
  input.addEventListener('input', function () {
    icon.classList.add('hidden'); spin.classList.remove('hidden');
    clearTimeout(t);
    t = setTimeout(function () { spin.classList.add('hidden'); icon.classList.remove('hidden'); filter(); }, 220);
  });
})();
</script>

<% if (__online) { %>
<!-- ═══ CART (multi-medicine, one checkout) ═══ -->
<div id="phCartBar" class="fixed inset-x-0 bottom-0 z-40 hidden">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pb-4">
    <button id="phCartBtn" type="button" class="w-full crystal bg-accent text-white rounded-2xl shadow-lift px-5 py-3.5 font-extrabold flex items-center justify-between">
      <span class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.4 12.4a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.3L22 7H6"/></svg>
        <span id="phCartCount">0</span> · <%= t('pharmacy.cart.view') %>
      </span>
      <span id="phCartTotalBtn">0 <%= t('pharmacy.currency') %></span>
    </button>
  </div>
</div>

<div id="phDrawer" class="fixed inset-0 z-50 hidden">
  <div id="phDrawerOverlay" class="absolute inset-0 bg-black/50"></div>
  <div class="absolute inset-y-0 end-0 w-full sm:max-w-md bg-white shadow-2xl flex flex-col">
    <div class="flex items-center justify-between px-4 py-3 border-b border-sand-200">
      <h2 class="font-extrabold text-lg"><%= t('pharmacy.cart.title') %></h2>
      <button id="phDrawerClose" type="button" class="grid place-items-center h-9 w-9 rounded-full hover:bg-sand-100" aria-label="close"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <form id="phOrderForm" method="post" action="/order/cart" class="flex-1 flex flex-col min-h-0">
      <input type="hidden" name="cart" id="phCartField" />
      <% if (lang !== 'ar') { %><input type="hidden" name="lang" value="<%= lang %>" /><% } %>
      <div class="flex-1 overflow-y-auto no-scrollbar p-4 space-y-3">
        <div id="phCartLines" class="space-y-3"></div>
        <div id="phCartEmpty" class="text-center text-ink/40 py-10"><%= t('pharmacy.cart.empty') %></div>
        <div id="phCustFields" class="space-y-3 pt-2 hidden">
          <div><label class="block text-[13px] font-bold mb-1"><%= t('pharmacy.order.your_name') %></label><input name="customer_name" required maxlength="100" class="w-full rounded-xl border-2 border-sand-200 px-3.5 py-2.5 focus:border-brand-400 outline-none" /></div>
          <div><label class="block text-[13px] font-bold mb-1"><%= t('pharmacy.order.your_phone') %></label><input name="customer_phone" type="tel" dir="ltr" required maxlength="30" class="w-full rounded-xl border-2 border-sand-200 px-3.5 py-2.5 text-end focus:border-brand-400 outline-none" placeholder="01xxxxxxxxx" /></div>
          <div><label class="block text-[13px] font-bold mb-1"><%= t('pharmacy.order.your_address') %></label><textarea name="customer_address" rows="2" maxlength="300" class="w-full rounded-xl border-2 border-sand-200 px-3.5 py-2.5 resize-none focus:border-brand-400 outline-none"></textarea></div>
          <p class="text-xs text-ink/45">💵 <%= t('pharmacy.cart.cod') %></p>
        </div>
      </div>
      <div id="phCartFooter" class="border-t border-sand-200 p-4 space-y-2 hidden">
        <div class="flex justify-between text-sm"><span class="text-ink/55"><%= t('pharmacy.cart.subtotal') %></span><span id="phSumSub">0</span></div>
        <div id="phDeliveryRow" class="hidden justify-between text-sm"><span class="text-ink/55"><%= t('pharmacy.cart.delivery') %></span><span id="phSumDelivery">0</span></div>
        <div class="flex justify-between font-extrabold text-lg"><span><%= t('pharmacy.cart.total') %></span><span id="phSumTotal" class="text-brand-700">0</span></div>
        <% if (typeof payment !== 'undefined' && payment) { %><div class="pt-1"><%- include('partials/payment_methods', { payment: payment }) %></div><% } %>
        <button type="submit" class="w-full crystal bg-accent text-white rounded-2xl py-3.5 font-extrabold"><%= t('pharmacy.cart.confirm') %></button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var KEY = 'oscardevs_ph_cart_' + <%- jsonLd(company.slug) %>;
  var CKEY = 'oscardevs_ph_contact_' + <%- jsonLd(company.slug) %>;
  var CUR = <%- jsonLd(t('pharmacy.currency')) %>;
  var ADD = <%- jsonLd(t('pharmacy.cart.add')) %>;
  var ADDED = <%- jsonLd(t('pharmacy.cart.added')) %>;
  var MAXW = <%- jsonLd(t('pharmacy.cart.max_reached')) %>;
  var DELIVERY = <%- jsonLd(pharmacySettings && pharmacySettings.delivery_enabled && Number(pharmacySettings.delivery_fee) > 0 ? Number(pharmacySettings.delivery_fee) : 0) %>;
  var isAr = document.documentElement.lang === 'ar';

  var bar = document.getElementById('phCartBar');
  var countEl = document.getElementById('phCartCount');
  var totalBtn = document.getElementById('phCartTotalBtn');
  var drawer = document.getElementById('phDrawer');
  var lines = document.getElementById('phCartLines');
  var cartEmpty = document.getElementById('phCartEmpty');
  var custFields = document.getElementById('phCustFields');
  var footer = document.getElementById('phCartFooter');
  var form = document.getElementById('phOrderForm');
  var cartField = document.getElementById('phCartField');

  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
  function save(c) { localStorage.setItem(KEY, JSON.stringify(c)); }
  function fmt(n) { n = Math.round(n * 100) / 100; return isAr ? String(n).replace(/\d/g, function (d) { return '٠١٢٣٤٥٦٧٨٩'[d]; }) : String(n); }
  function money(n) { return fmt(n) + ' ' + CUR; }

  function totals() {
    var c = load(), count = 0, sub = 0;
    Object.keys(c).forEach(function (k) { count += c[k].q; sub += c[k].q * c[k].p; });
    var delivery = count > 0 ? DELIVERY : 0;
    return { count: count, sub: sub, delivery: delivery, total: sub + delivery };
  }
  function renderBar() {
    var t = totals();
    countEl.textContent = fmt(t.count);
    totalBtn.textContent = money(t.total);
    bar.classList.toggle('hidden', t.count === 0);
  }
  function renderDrawer() {
    var c = load(), t = totals();
    lines.innerHTML = '';
    var keys = Object.keys(c);
    cartEmpty.classList.toggle('hidden', keys.length !== 0);
    footer.classList.toggle('hidden', keys.length === 0);
    custFields.classList.toggle('hidden', keys.length === 0);
    keys.forEach(function (id) {
      var it = c[id];
      var row = document.createElement('div');
      row.className = 'flex items-center gap-2 bg-sand-50 rounded-xl p-2';
      row.innerHTML = '<div class="min-w-0 flex-1"><div class="font-bold text-sm truncate"></div><div class="text-xs text-brand-700 font-bold"></div></div>'
        + '<div class="flex items-center gap-1 bg-white rounded-full border border-sand-200 p-1">'
        + '<button type="button" data-m="' + id + '" class="grid place-items-center h-7 w-7 rounded-full hover:bg-sand-100">−</button>'
        + '<span class="w-6 text-center font-bold qv"></span>'
        + '<button type="button" data-p="' + id + '" class="grid place-items-center h-7 w-7 rounded-full hover:bg-sand-100">+</button></div>'
        + '<button type="button" data-r="' + id + '" class="text-red-500 px-1">🗑️</button>';
      row.querySelector('.font-bold.text-sm').textContent = it.n;
      row.querySelector('.text-brand-700').textContent = money(it.p * it.q);
      row.querySelector('.qv').textContent = fmt(it.q);
      lines.appendChild(row);
    });
    document.getElementById('phSumSub').textContent = money(t.sub);
    var dr = document.getElementById('phDeliveryRow');
    if (t.delivery > 0) { dr.classList.remove('hidden'); dr.classList.add('flex'); document.getElementById('phSumDelivery').textContent = money(t.delivery); }
    else { dr.classList.add('hidden'); dr.classList.remove('flex'); }
    document.getElementById('phSumTotal').textContent = money(t.total);
  }
  function openD() { renderDrawer(); drawer.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
  function closeD() { drawer.classList.add('hidden'); document.body.style.overflow = ''; }

  document.querySelectorAll('.ph-add').forEach(function (b) {
    b.addEventListener('click', function () {
      var c = load(), id = b.dataset.id, max = parseInt(b.dataset.max, 10) || 999;
      // The cap travels WITH the line. The + inside the drawer had no idea what
      // the available quantity was, so a customer could walk a cart past the
      // stock and only find out at checkout — where the server refused the whole
      // order.
      if (!c[id]) c[id] = { n: b.dataset.name, p: Number(b.dataset.price) || 0, q: 0, max: max };
      c[id].max = max;
      if (c[id].q >= max) { var lbl0 = b.querySelector('.ph-add-label'); if (lbl0) { lbl0.textContent = MAXW; setTimeout(function () { lbl0.textContent = ADD; }, 1200); } return; }
      c[id].q += 1; save(c); renderBar();
      var lbl = b.querySelector('.ph-add-label');
      if (lbl) { lbl.textContent = ADDED; setTimeout(function () { lbl.textContent = ADD; }, 700); }
    });
  });

  lines.addEventListener('click', function (e) {
    var c = load(), tg = e.target;
    if (tg.dataset.p) {
      var ln = c[tg.dataset.p];
      var cap = Number(ln.max) || 999;
      if (ln.q >= cap) {
        // Say why, on the button the customer just pressed.
        tg.textContent = '⤫'; tg.title = MAXW;
        setTimeout(function () { tg.textContent = '+'; }, 900);
        return;
      }
      ln.q += 1;
    }
    else if (tg.dataset.m) { c[tg.dataset.m].q -= 1; if (c[tg.dataset.m].q <= 0) delete c[tg.dataset.m]; }
    else if (tg.dataset.r) { delete c[tg.dataset.r]; }
    else return;
    save(c); renderBar(); renderDrawer();
  });

  document.getElementById('phCartBtn').addEventListener('click', openD);
  document.getElementById('phDrawerClose').addEventListener('click', closeD);
  document.getElementById('phDrawerOverlay').addEventListener('click', closeD);

  form.addEventListener('submit', function (e) {
    var c = load();
    var arr = Object.keys(c).map(function (id) { return { id: Number(id), q: c[id].q }; });
    if (!arr.length) { e.preventDefault(); return; }
    cartField.value = JSON.stringify(arr);
    try { localStorage.setItem(CKEY, JSON.stringify({ customer_name: form.customer_name.value, customer_phone: form.customer_phone.value, customer_address: form.customer_address.value })); } catch (x) {}
    try { localStorage.removeItem(KEY); } catch (x) {}
  });

  try {
    var saved = JSON.parse(localStorage.getItem(CKEY) || 'null');
    if (saved) { ['customer_name', 'customer_phone', 'customer_address'].forEach(function (k) { if (form[k] && saved[k]) form[k].value = saved[k]; }); }
  } catch (x) {}

  renderBar();
})();
</script>
<% } %>
</body>
</html>
