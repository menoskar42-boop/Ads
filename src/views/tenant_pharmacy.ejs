<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var __phName = company.company_name || 'صيدلية';
  var __phTitle = (__phName + ' — صيدلية أونلاين').slice(0, 60);
  var __phDesc = ((company.description || ('اطلب أدويتك من ' + __phName + ' أونلاين مع توافر لحظي وتوصيل.')).trim()).slice(0, 155);
  var __theme = company.theme_color || '#0e7c66';
  var __isDemo = company.slug === 'pharmacy';
  var __online = pharmacySettings && pharmacySettings.online_store_enabled;
  var __wa = pharmacySettings && pharmacySettings.whatsapp ? String(pharmacySettings.whatsapp).replace(/[^0-9]/g, '') : '';
%>
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __phTitle %> | OscarDevs</title>
<meta name="description" content="<%= __phDesc %>" />
<%- include('partials/seo_meta', { title: __phTitle, description: __phDesc }) %>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  :root { --brand: <%= __theme %>; }
  .brand-bg { background: var(--brand); }
  .brand-text { color: var(--brand); }
  .brand-border { border-color: var(--brand); }
</style>
</head>
<body class="bg-gray-50 text-gray-800">

<!-- Header -->
<header class="brand-bg text-white">
  <div class="max-w-4xl mx-auto px-4 py-5">
    <div class="flex items-center gap-3">
      <% if (company.logo_url) { %>
        <img src="<%= company.logo_url %>" alt="<%= __phName %>" class="w-12 h-12 rounded-xl object-cover bg-white/20" />
      <% } else { %>
        <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-2xl">💊</div>
      <% } %>
      <div class="flex-1">
        <h1 class="text-2xl font-extrabold leading-tight"><%= __phName %></h1>
        <div class="flex items-center gap-2 mt-1 text-sm text-white/90 flex-wrap">
          <% if (__isDemo) { %><span class="bg-white/25 rounded-full px-2 py-0.5 text-xs font-bold">نموذج تجريبي</span><% } %>
          <% if (pharmacySettings && pharmacySettings.is_night_shift) { %><span class="bg-white/25 rounded-full px-2 py-0.5 text-xs">🌙 خدمة ليلية</span><% } %>
          <% if (pharmacySettings && pharmacySettings.address) { %><span>📍 <%= pharmacySettings.address %></span><% } %>
        </div>
      </div>
      <% if (__wa) { %>
        <a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener"
           class="hidden sm:inline-flex items-center gap-1 bg-white/20 hover:bg-white/30 rounded-xl px-3 py-2 text-sm font-bold">
          واتساب
        </a>
      <% } %>
    </div>
    <% if (company.description) { %>
      <p class="mt-3 text-white/90 text-sm leading-7"><%= company.description %></p>
    <% } %>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-6">

  <!-- Search -->
  <form method="get" class="mb-5">
    <div class="flex gap-2">
      <input name="q" value="<%= currentSearch || '' %>" placeholder="ابحث باسم الدواء أو الباركود…"
             class="flex-1 rounded-xl border-2 brand-border px-4 py-3 text-base outline-none bg-white" />
      <button type="submit" class="brand-bg text-white rounded-xl px-5 py-3 font-bold">بحث</button>
    </div>
  </form>

  <% if (!pharmacyItems || pharmacyItems.length === 0) { %>
    <div class="text-center py-16 text-gray-500">
      <% if (currentSearch) { %>
        مفيش نتائج لـ «<%= currentSearch %>». جرّب اسم تاني أو اسأل الصيدلية.
      <% } else { %>
        لسه مفيش أدوية مضافة في المخزون.
      <% } %>
    </div>
  <% } else { %>
    <div class="grid gap-3 sm:grid-cols-2">
      <% pharmacyItems.forEach(function(it){
           var avail = Number(it.available_qty) || 0;
           var state = avail <= 0 ? 'out' : (avail <= 5 ? 'low' : 'in');
           var price = it.price != null ? Number(it.price).toFixed(2) : null;
      %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex flex-col">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h2 class="font-extrabold text-gray-900 leading-tight"><%= it.name_ar %></h2>
              <% if (it.name_en) { %><p class="text-xs text-gray-400"><%= it.name_en %></p><% } %>
              <p class="text-xs text-gray-500 mt-1">
                <% if (it.form) { %><%= it.form %><% } %><% if (it.manufacturer) { %> · <%= it.manufacturer %><% } %>
              </p>
            </div>
            <% if (state === 'in') { %>
              <span class="shrink-0 text-xs font-bold text-green-700 bg-green-50 rounded-full px-2 py-1">متوفّر</span>
            <% } else if (state === 'low') { %>
              <span class="shrink-0 text-xs font-bold text-amber-700 bg-amber-50 rounded-full px-2 py-1">كمية محدودة</span>
            <% } else { %>
              <span class="shrink-0 text-xs font-bold text-gray-500 bg-gray-100 rounded-full px-2 py-1">غير متوفّر</span>
            <% } %>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <% if (price) { %><span class="brand-text font-extrabold text-lg"><%= price %> ج.م</span><% } else { %><span></span><% } %>
            <% if (__online && __wa && state !== 'out') {
                 var msg = encodeURIComponent('السلام عليكم، أريد طلب: ' + it.name_ar + (price ? (' (' + price + ' ج.م)') : ''));
            %>
              <a href="https://wa.me/<%= __wa %>?text=<%= msg %>" target="_blank" rel="noopener"
                 class="brand-bg text-white rounded-lg px-4 py-2 text-sm font-bold">اطلب</a>
            <% } else if (state === 'out') { %>
              <span class="text-xs text-gray-400">اسأل عن البديل</span>
            <% } else { %>
              <span class="text-xs text-gray-400">اطلب من الصيدلية</span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- trust / footer -->
  <div class="mt-10 text-center text-sm text-gray-400">
    <% if (__online) { %>
      <p class="mb-1">الطلب أونلاين متاح — يوصلك أو تستلمه من الصيدلية.</p>
    <% } %>
    <p>مدعوم بنظام إدارة الصيدليات من
      <a href="https://oscardevs.com" target="_blank" rel="noopener" class="brand-text font-bold underline">OscarDevs</a>
    </p>
  </div>
</main>

</body>
</html>
