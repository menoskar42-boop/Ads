<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  var S = (typeof nutritionSettings !== 'undefined' && nutritionSettings) || {};
  var __name = S.practice_name || company.company_name || t('ntp.practice');
  var __brand = ' | OscarDevs';
  // Held under 60 characters, the limit the project records after the Bing
  // audit: a title that gets truncated in results is a title nobody chose.
  var __base = __name + ' — ' + t('ntp.tagline');
  var __title = (__base.length + __brand.length) <= 60 ? (__base + __brand)
    : (__base.length <= 60 ? __base : __base.slice(0, 60));

  // A practice that wrote two words about itself would otherwise ship a thin
  // description. Below ~70 characters we compose one from facts they actually
  // entered rather than shipping the stub.
  var __about = String(S.about || company.description || '').trim();
  var __bits = [__name + ' — ' + t('ntp.tagline')];
  if (S.address) __bits.push(S.address);
  var __desc = __about.length >= 70 ? __about : (__bits.join(' · ') + '. ' + t('ntp.seo_tail'));
  if (__desc.length > 155) {
    __desc = __desc.slice(0, 155);
    var __cut = __desc.lastIndexOf(' ');
    if (__cut > 120) __desc = __desc.slice(0, __cut);
  }

  var __canon = (typeof canonicalCompanyUrl === 'function') ? canonicalCompanyUrl(company.slug)
    : ('https://' + company.slug + '.oscardevs.com/');
  var __noindex = (typeof noindex !== 'undefined' && noindex);
  var __wa = S.whatsapp ? String(S.whatsapp).replace(/[^0-9]/g, '') : '';
  var __phone = S.phone ? String(S.phone).replace(/[^0-9+]/g, '') : '';
  var __map = S.address ? ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(S.address)) : null;
  var __booking = S.booking_enabled !== false;
%>
<% if (__noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
<title><%= __title %></title>
<meta name="description" content="<%= __desc %>" />
<%- include('partials/seo_meta', { title: __title, description: __desc, canonical: __canon, siteLogo: company.logo_url || '', siteAppName: __name, ogImage: company.logo_url || '', siteManifest: '/manifest.webmanifest' }) %>

<% if (!__noindex) { %>
<%# Structured data only on pages that are actually indexed. Describing a page
    to a search engine that has been told not to index it is noise. %>
<script type="application/ld+json">
<%- jsonLd(Object.assign({
  '@context': 'https://schema.org',
  '@type': 'Dietitian',
  name: __name,
  description: __desc,
  url: __canon,
}, __phone ? { telephone: __phone } : {},
   S.address ? { address: { '@type': 'PostalAddress', streetAddress: S.address, addressCountry: 'EG' } } : {},
   S.hours ? { openingHours: S.hours } : {},
   company.logo_url ? { image: company.logo_url } : {})) %>
</script>
<% } %>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>:root{--brand-50:240 253 244;--brand-100:220 252 231;--brand-200:187 247 208;--brand-500:34 197 94;--brand-600:22 163 74;--brand-700:21 128 61;--brand-900:20 83 45;}</style>
<style>body{font-family:'Cairo',sans-serif}</style>
</head>
<body class="bg-slate-50 text-slate-800">

<header class="bg-gradient-to-b from-brand-600 to-brand-700 text-white">
  <div class="max-w-3xl mx-auto px-4 py-12 text-center">
    <% if (company.logo_url) { %>
      <img src="<%= company.logo_url %>" alt="<%= __name %>" class="w-20 h-20 rounded-2xl object-cover mx-auto mb-4 bg-white" />
    <% } else { %>
      <div class="text-5xl mb-3">🥗</div>
    <% } %>
    <%# One h1 per page — the rule the project records after the Bing audit. %>
    <h1 class="text-2xl sm:text-3xl font-black mb-2"><%= __name %></h1>
    <p class="text-white/80 text-sm"><%= t('ntp.tagline') %></p>
  </div>
</header>

<main class="max-w-3xl mx-auto px-4 py-8">

  <% if (__about) { %>
  <section class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-slate-900 mb-2"><%= t('ntp.about') %></h2>
    <p class="text-slate-600 text-sm leading-7 whitespace-pre-line"><%= __about %></p>
  </section>
  <% } %>

  <%# الخدمات: سطر لكل خدمة، بكلام الأخصائي. القسم مابيظهرش لو مكتبش حاجة —
      نص من عندنا هنا كان هيبقى حشو معروض باسمه. %>
  <% var __services = String(S.services || '').split(/\r?\n/).map(function(x){ return x.trim(); }).filter(Boolean).slice(0, 12); %>
  <% if (__services.length) { %>
  <section class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-slate-900 mb-3"><%= t('ntp.services') %></h2>
    <ul class="grid gap-2 text-sm text-slate-600">
      <% __services.forEach(function(x){ %>
        <li class="flex gap-2 leading-7"><span class="text-brand-600">•</span><span><%= x %></span></li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <section class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-slate-900 mb-3"><%= t('ntp.contact') %></h2>
    <div class="grid gap-3 text-sm">
      <% if (S.phone) { %>
        <a href="tel:<%= __phone %>" class="flex items-center gap-2 text-slate-700 hover:text-brand-700">
          <span>📞</span><span dir="ltr"><%= S.phone %></span>
        </a>
      <% } %>
      <% if (__wa) { %>
        <a href="https://wa.me/<%= __wa %>" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-slate-700 hover:text-brand-700">
          <span>💬</span><span><%= t('ntp.whatsapp') %></span>
        </a>
      <% } %>
      <% if (S.address) { %>
        <a href="<%= __map %>" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-slate-700 hover:text-brand-700">
          <span>📍</span><span><%= S.address %></span>
        </a>
      <% } %>
      <% if (S.hours) { %>
        <div class="flex items-center gap-2 text-slate-700"><span>🕒</span><span><%= S.hours %></span></div>
      <% } %>
      <% if (!S.phone && !__wa && !S.address && !S.hours) { %>
        <p class="text-slate-400"><%= t('ntp.no_contact') %></p>
      <% } %>
    </div>
  </section>

  <%# ── الحجز بتقويم (البند ٨٤) ────────────────────────────────────────
      الزرار اللي كان بيفتح واتساب مابقاش هو الطريقة الوحيدة: فيه خانات
      حقيقية محسوبة من مواعيد العيادة ناقص اللي اتحجز. الخانة المحجوزة
      بتتعرض «محجوز» مش بتختفي — عشان الزائر يشوف إن اليوم شغّال. %>
  <% var __days = (typeof nutritionDays !== 'undefined' && nutritionDays) || []; %>
  <% if (__booking && __days.length) { %>
  <section id="book" class="bg-white rounded-2xl shadow-sm p-6 mb-5">
    <h2 class="font-bold text-slate-900 mb-1"><%= t('ntp.book') %></h2>
    <p class="text-xs text-slate-500 mb-3"><%= t('ntp.book_hint') %></p>

    <% if (typeof req !== 'undefined' && req && req.query && req.query.sent) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-2 mb-3 text-sm"><%= t('ntp.book_sent') %></div>
    <% } %>
    <% var __err = (typeof req !== 'undefined' && req && req.query && req.query.error) ? String(req.query.error) : null; %>
    <% if (__err) { %>
      <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-2 mb-3 text-sm">
        <%= __err === 'taken' ? t('ntp.book_taken') : __err === 'closed' ? t('ntp.book_closed') : t('ntp.book_bad') %>
      </div>
    <% } %>

    <form method="POST" action="/nutrition/book" class="grid gap-3">
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="text-xs font-bold text-slate-600"><%= t('ntp.book_name') %>
          <input name="patient_name" required maxlength="80" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        </label>
        <label class="text-xs font-bold text-slate-600"><%= t('ntp.book_phone') %>
          <input name="patient_phone" required maxlength="20" dir="ltr" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
        </label>
      </div>
      <label class="text-xs font-bold text-slate-600"><%= t('ntp.book_day') %>
        <select name="day" id="ntDay" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm bg-white">
          <% __days.forEach(function(d, i){ %>
            <option value="<%= d.ymd %>" <%= i === 0 ? 'selected' : '' %>><%= d.ymd %></option>
          <% }); %>
        </select>
      </label>
      <div>
        <div class="text-xs font-bold text-slate-600 mb-1"><%= t('ntp.book_time') %></div>
        <div id="ntSlots" class="flex flex-wrap gap-2"></div>
        <input type="hidden" name="time" id="ntTime" required />
      </div>
      <label class="text-xs font-bold text-slate-600"><%= t('ntp.book_note') %>
        <input name="note" maxlength="300" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 text-sm" />
      </label>
      <button class="bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl px-6 py-3"><%= t('ntp.book_send') %></button>
    </form>
    <script>
      (function () {
        var DAYS = <%- jsonLd(__days.map(function(d){ return { ymd: d.ymd, slots: d.slots }; })) %>;
        var sel = document.getElementById('ntDay'), box = document.getElementById('ntSlots'), field = document.getElementById('ntTime');
        function draw() {
          var day = DAYS.filter(function (d) { return d.ymd === sel.value; })[0];
          box.innerHTML = ''; field.value = '';
          (day ? day.slots : []).forEach(function (s) {
            var b = document.createElement('button');
            b.type = 'button'; b.textContent = s.time;
            b.disabled = !!s.taken;
            b.className = 'text-sm font-bold rounded-xl px-3 py-2 border ' + (s.taken
              ? 'border-slate-200 text-slate-300 line-through cursor-not-allowed'
              : 'border-slate-200 text-slate-700 hover:border-brand-500');
            b.onclick = function () {
              field.value = s.time;
              Array.prototype.forEach.call(box.children, function (c) { c.classList.remove('bg-brand-600', 'text-white'); });
              b.classList.add('bg-brand-600', 'text-white');
            };
            box.appendChild(b);
          });
        }
        sel.addEventListener('change', draw); draw();
      })();
    </script>
  </section>
  <% } else if (__booking && __wa) { %>
  <%# مفيش مواعيد متظبّطة: الواتساب لسه أحسن من مفيش حاجة، ومكتوب إنه واتساب. %>
  <a href="https://wa.me/<%= __wa %>?text=<%= encodeURIComponent(t('ntp.book_msg')) %>"
     target="_blank" rel="noopener"
     class="block bg-brand-600 hover:bg-brand-700 text-white text-center font-bold rounded-2xl px-6 py-4 mb-5">
    <%= t('ntp.book_wa') %>
  </a>
  <% } %>

  <%# The patient portal link. A practice's own patients arrive here looking for
      it, and hiding it behind a URL they have to be told twice is how a login
      page goes unused. %>
  <a href="/portal" class="block bg-white rounded-2xl shadow-sm p-5 text-center hover:bg-brand-50 mb-5">
    <div class="text-2xl mb-1">🔐</div>
    <div class="font-bold text-slate-900 text-sm"><%= t('ntp.portal') %></div>
    <div class="text-xs text-slate-500 mt-1"><%= t('ntp.portal_hint') %></div>
  </a>

  <p class="text-[11px] text-slate-400 text-center leading-6"><%= t('ntp.disclaimer') %></p>
  <%- include('partials/payment_methods') %>
</main>

<footer class="text-center text-xs text-slate-400 py-6">
  <a href="https://oscardevs.com" target="_blank" rel="noopener" class="hover:text-slate-600">OscarDevs</a>
</footer>

</body>
</html>
