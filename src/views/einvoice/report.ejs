<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG',{maximumFractionDigits:2}); }
  function d(v){ try{ return v? new Date(v).toLocaleDateString('ar-EG',{day:'numeric',month:'short',year:'numeric'}) : '—'; }catch(e){ return '—'; } }
%>
<div class="flex items-center justify-between mb-2 flex-wrap gap-2">
  <h1 class="font-black text-xl">فواتير لسه ما وصلتش المصلحة</h1>
  <div class="flex gap-1 text-xs">
    <% [7,30,90,365].forEach(function(n){ %>
      <a href="/einvoice/report?days=<%= n %>" class="px-3 py-1.5 rounded-lg <%= days===n ? 'bg-slate-800 text-white font-bold' : 'bg-white border border-slate-200' %>"><%= n %> يوم</a>
    <% }) %>
  </div>
</div>
<p class="text-slate-500 text-sm mb-5">دي الصفحة اللي بتمنعك تتفاجئ آخر الشهر. كل سطر هنا فاتورة اتعملت وما اتبعتتش، ومكتوب جنبها السبب.</p>

<% if (!rows.length) { %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-8 text-center">
    <div class="text-3xl mb-2">✓</div>
    <p class="text-emerald-800 font-bold">كل الفواتير في الفترة دي وصلت المصلحة.</p>
  </div>
<% } else { %>
  <div class="space-y-2">
    <% rows.forEach(function(r){ %>
      <div class="bg-white rounded-2xl border border-slate-200 p-4 text-sm flex items-start justify-between gap-3 flex-wrap">
        <div class="min-w-[12rem]">
          <div class="font-bold"><%= r.internal_id || ('#' + r.id) %></div>
          <div class="text-slate-500 text-xs"><%= (KINDS[r.source_kind] && KINDS[r.source_kind].label) || r.source_kind %> · <%= d(r.issued_at || r.created_at) %></div>
          <% if (r.error_message) { %>
            <div class="mt-2 text-xs text-rose-700 leading-relaxed"><%= r.error_message %></div>
          <% } %>
        </div>
        <div class="text-end">
          <div class="font-black"><bdi><%= money(r.total_amount) %></bdi></div>
          <a href="/einvoice/documents?status=<%= r.status %>" class="text-xs text-slate-500 underline">افتح</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('foot') %>
