<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <% var displayCompanyName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <% var pName = pickContent(product, 'name', company.content_i18n) || product.name; %>
  <% var pDesc = pickContent(product, 'description', company.content_i18n) || product.description || ''; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% var __sep = ' — '; %>
  <% var __pTitle = pName + (((pName.length + __sep.length + displayCompanyName.length) <= 60) ? (__sep + displayCompanyName) : ''); %>
  <title><%= __pTitle %></title>
  <meta name="description" content="<%= pDesc.slice(0,150) %>" />
  <% var productUrl = siteOrigin + '/shop/' + company.slug + '/product/' + product.id; %>
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
  <link rel="canonical" href="<%= productUrl %>" />
  <meta property="og:type" content="product" />
  <meta property="og:title" content="<%= __pTitle %>" />
  <meta property="og:description" content="<%= pDesc.slice(0,150) %>" />
  <% if (product.image_url) { %><meta property="og:image" content="<%= product.image_url %>" /><% } %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": pName,
    "image": [product.image_url].filter(Boolean),
    "description": pDesc || pName,
    "offers": {
      "@type": "Offer",
      "price": Number(product.price).toFixed(2),
      "priceCurrency": company.currency || 'EGP',
      "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "url": productUrl
    }
  }) %>
  </script>
  <%
    // Breadcrumb: Store → Product. We deliberately skip a category level because
    // the ?category filtered view is noindex — pointing a breadcrumb at a
    // non-indexable URL weakens the structured-data hierarchy.
    var crumbs = [{ "@type": "ListItem", "position": 1, "name": displayCompanyName, "item": canonicalCompanyUrl(company.slug) }];
    crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": pName, "item": productUrl });
  %>
  <script type="application/ld+json">
  <%- JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs }) %>
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-btn { background-color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<header class="bg-white shadow-sm sticky top-0 z-20">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="<%= canonicalCompanyUrl(company.slug) %>" class="flex items-center gap-2 font-bold text-gray-800">← <%= displayCompanyName %></a>
    <div class="flex items-center gap-2">
      <a href="?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" class="text-xs font-bold text-gray-500 border border-gray-200 rounded-lg px-2 py-1"><%= t('common.toggle_lang') %></a>
      <a href="/shop/<%= company.slug %>/cart" class="relative flex items-center gap-2 brand-btn text-white text-sm font-semibold px-4 py-2 rounded-xl">
        <%= t('public.cart') %>
        <% if (cartCount > 0) { %>
          <span class="bg-white text-xs brand-text font-bold rounded-full px-2 py-0.5"><%= cartCount %></span>
        <% } %>
      </a>
    </div>
  </div>
</header>

<div class="max-w-5xl mx-auto px-4 mt-4"><%- include('../partials/ad_unit', { slot: ads.slots.productTop }) %></div>

<main class="max-w-5xl mx-auto px-4 py-8">
  <div class="grid md:grid-cols-2 gap-8 bg-white rounded-2xl shadow p-6">

    <!-- Gallery -->
    <div>
      <% const allImages = []; if (product.image_url) allImages.push({ url: product.image_url }); gallery.forEach(g => allImages.push({ url: g.image_url })); %>
      <% if (allImages.length === 0) { %>
        <div class="w-full aspect-square bg-gray-100 rounded-2xl flex items-center justify-center text-gray-300"><%= t('common.image') %></div>
      <% } else { %>
        <img id="mainImage" src="<%= allImages[0].url %>" alt="<%= pName %>" fetchpriority="high" decoding="async" class="w-full aspect-square object-cover rounded-2xl mb-3" />
        <% if (allImages.length > 1) { %>
          <div class="grid grid-cols-5 gap-2">
            <% allImages.forEach(img => { %>
              <img src="<%= img.url %>" alt="<%= pName %> — صورة إضافية" loading="lazy" decoding="async" class="w-full aspect-square object-cover rounded-lg cursor-pointer hover:opacity-80 transition border-2 border-transparent hover:border-gray-300" onclick="document.getElementById('mainImage').src=this.src" />
            <% }) %>
          </div>
        <% } %>
      <% } %>

      <% if (product.video_url) { %>
        <video src="<%= product.video_url %>" controls preload="metadata" playsinline
          class="w-full rounded-2xl mt-3 bg-black" aria-label="<%= pName %> — فيديو">
        </video>
      <% } %>
    </div>

    <!-- Details -->
    <div class="flex flex-col">
      <% if (product.category_name) { %>
        <p class="text-xs text-gray-400 uppercase font-semibold mb-1"><%= product.category_name %></p>
      <% } %>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-3"><%= pName %></h1>
      <div class="text-3xl font-black brand-text mb-4"><%= Number(product.price).toFixed(2) %> <%= company.currency || 'EGP' %><% if (product.sale_type === 'weight') { %> <span class="text-base font-bold text-gray-400">/ <%= product.weight_unit || 'كجم' %></span><% } %></div>

      <% if (product.stock > 0) { %>
        <p class="text-sm text-green-600 font-semibold mb-4">✓ <%= t('public.in_stock') %> (<%= product.stock %>)</p>
      <% } else { %>
        <p class="text-sm text-red-600 font-semibold mb-4">✗ <%= t('public.out_of_stock') %></p>
      <% } %>

      <% if (pDesc) { %>
        <p class="text-sm text-gray-600 mb-6 whitespace-pre-wrap leading-relaxed"><%= pDesc %></p>
      <% } %>

      <% var sizeList = (product.sale_type === 'size' && product.sizes) ? product.sizes.split(',').map(function(s){return s.trim();}).filter(Boolean) : []; %>
      <% if (product.stock > 0) { %>
        <form method="POST" action="/shop/<%= company.slug %>/cart/add" class="mt-auto">
          <input type="hidden" name="product_id" value="<%= product.id %>" />
          <% if (sizeList.length) { %>
            <div class="mb-4">
              <div class="text-sm font-semibold text-gray-600 mb-2">اختر المقاس</div>
              <div class="flex flex-wrap gap-2">
                <% sizeList.forEach(function(sz, i){ %>
                  <label class="cursor-pointer">
                    <input type="radio" name="size" value="<%= sz %>" <%= i===0 ? 'checked' : '' %> class="peer sr-only" required />
                    <span class="inline-block border border-gray-300 rounded-xl px-4 py-2 text-sm font-semibold text-gray-700 peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition"><%= sz %></span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% } %>
          <div class="flex items-center gap-3">
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>"
              class="w-20 border border-gray-200 rounded-xl px-3 py-2.5 text-center text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
            <% if (product.sale_type === 'weight') { %><span class="text-sm text-gray-500"><%= product.weight_unit || 'كجم' %></span><% } %>
            <button type="submit" class="brand-btn text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow flex-1">
              <%= t('public.add_to_cart') %>
            </button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</main>

<div class="max-w-5xl mx-auto px-4 mb-6"><div class="bg-white rounded-2xl shadow p-4 text-center overflow-hidden"><%- include('../partials/ad_unit', { slot: ads.slots.productMid }) %></div></div>

<div class="max-w-5xl mx-auto px-4 mb-6"><%- include('../partials/ad_unit', { slot: ads.slots.productBottom }) %></div>

<footer class="bg-gray-900 text-gray-400 py-6 text-center text-sm">
  <p>&copy; <%= new Date().getFullYear() %> <%= displayCompanyName %></p>
</footer>

</body>
</html>
