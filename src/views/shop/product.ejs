<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <% var displayCompanyName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <% var pName = pickContent(product, 'name', company.content_i18n) || product.name; %>
  <% var pDesc = pickContent(product, 'description', company.content_i18n) || product.description || ''; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% var __sep = ' — '; %>
  <% var __pTitle = pName + (((pName.length + __sep.length + displayCompanyName.length) <= 60) ? (__sep + displayCompanyName) : ''); %>
  <title><%= __pTitle %></title>
  <meta name="description" content="<%= pDesc.slice(0,150) %>" />
  <% var productUrl = siteOrigin + '/shop/' + company.slug + '/product/' + product.id; %>
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,follow" /><% } %>
  <%# Shared social/app metadata stack (canonical, og, twitter, favicons, GA) —
      the product's own <title>, meta description and Product JSON-LD stay below. %>
  <%- include('../partials/seo_meta', {
    title: __pTitle,
    description: pDesc.slice(0,160),
    canonical: productUrl,
    ogType: 'product',
    ogImage: (product.image_url || ''),
    siteLogo: (company.logo_url || ''),
    siteAppName: displayCompanyName
  }) %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": pName,
    "image": [product.image_url].filter(Boolean),
    "description": pDesc || pName,
    "offers": {
      "@type": "Offer",
      "price": Number(product.price).toFixed(2),
      "priceCurrency": company.currency || 'EGP',
      "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "url": productUrl
    },
    "aggregateRating": (Number(product.review_count) > 0) ? {
      "@type": "AggregateRating",
      "ratingValue": Number(product.avg_rating).toFixed(1),
      "reviewCount": Number(product.review_count),
      "bestRating": 5, "worstRating": 1
    } : undefined,
    "review": (typeof reviews !== 'undefined' && reviews.length) ? reviews.slice(0, 5).map(function (r) {
      return {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": r.rating, "bestRating": 5, "worstRating": 1 },
        "author": { "@type": "Person", "name": r.author },
        "reviewBody": r.body || undefined,
        "name": r.title || undefined
      };
    }) : undefined
  }) %>
  </script>
  <%
    // Breadcrumb: Store → Product. We deliberately skip a category level because
    // the ?category filtered view is noindex — pointing a breadcrumb at a
    // non-indexable URL weakens the structured-data hierarchy.
    var crumbs = [{ "@type": "ListItem", "position": 1, "name": displayCompanyName, "item": canonicalCompanyUrl(company.slug) }];
    crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": pName, "item": productUrl });
  %>
  <script type="application/ld+json">
  <%- JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs }) %>
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-btn { background-color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<header class="bg-white shadow-sm sticky top-0 z-20">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="<%= canonicalCompanyUrl(company.slug) %>" class="flex items-center gap-2 font-bold text-gray-800">← <%= displayCompanyName %></a>
    <div class="flex items-center gap-2">
      <a href="?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" class="text-xs font-bold text-gray-500 border border-gray-200 rounded-lg px-2 py-1"><%= t('common.toggle_lang') %></a>
      <a href="/shop/<%= company.slug %>/cart" class="relative flex items-center gap-2 brand-btn text-white text-sm font-semibold px-4 py-2 rounded-xl">
        <%= t('public.cart') %>
        <% if (cartCount > 0) { %>
          <span class="bg-white text-xs brand-text font-bold rounded-full px-2 py-0.5"><%= cartCount %></span>
        <% } %>
      </a>
    </div>
  </div>
</header>
<% var __on = function(k){ return typeof feat === 'undefined' || feat[k] !== false; }; %>

<div class="max-w-5xl mx-auto px-4 mt-4"><%- include('../partials/ad_unit', { slot: ads.slots.productTop }) %></div>

<main class="max-w-5xl mx-auto px-4 py-8">
  <div class="grid md:grid-cols-2 gap-8 bg-white rounded-2xl shadow p-6">

    <!-- Gallery -->
    <div>
      <% const allImages = []; if (product.image_url) allImages.push({ url: product.image_url }); gallery.forEach(g => allImages.push({ url: g.image_url })); %>
      <% if (allImages.length === 0) { %>
        <div class="w-full aspect-square bg-gray-100 rounded-2xl flex items-center justify-center text-gray-300"><%= t('common.image') %></div>
      <% } else { %>
        <img id="mainImage" src="<%= allImages[0].url %>" alt="<%= pName %>" fetchpriority="high" decoding="async" class="w-full aspect-square object-cover rounded-2xl mb-3 <%= __on('zoom') ? 'cursor-zoom-in' : '' %>" <%= __on('zoom') ? 'onclick=odvOpenZoom()' : '' %> <%= __on('zoom') ? 'title=اضغط للتكبير' : '' %> />
        <% if (allImages.length > 1) { %>
          <div class="grid grid-cols-5 gap-2" id="thumbRow">
            <% allImages.forEach((img, i) => { %>
              <img src="<%= img.url %>" alt="<%= pName %> — صورة <%= i + 1 %>" data-idx="<%= i %>" loading="lazy" decoding="async" class="w-full aspect-square object-cover rounded-lg cursor-pointer hover:opacity-80 transition border-2 <%= i === 0 ? 'border-gray-800' : 'border-transparent' %> hover:border-gray-300" onclick="odvSetImg(<%= i %>)" />
            <% }) %>
          </div>
        <% } %>

        <!-- Zoom lightbox (phase 3): fullscreen, click-to-zoom, prev/next, swipe, keyboard -->
        <div id="odvLightbox" class="fixed inset-0 z-[100] bg-black/90 hidden items-center justify-center" onclick="odvCloseZoom(event)">
          <button type="button" class="absolute top-4 end-4 text-white/90 text-3xl leading-none w-10 h-10" aria-label="إغلاق" onclick="odvCloseZoom()">✕</button>
          <% if (allImages.length > 1) { %>
            <button type="button" class="absolute start-3 top-1/2 -translate-y-1/2 text-white/90 text-5xl leading-none w-12 h-12" aria-label="السابق" onclick="event.stopPropagation();odvNav(-1)">‹</button>
            <button type="button" class="absolute end-3 top-1/2 -translate-y-1/2 text-white/90 text-5xl leading-none w-12 h-12" aria-label="التالي" onclick="event.stopPropagation();odvNav(1)">›</button>
          <% } %>
          <img id="odvLightboxImg" alt="<%= pName %>" class="max-w-[92vw] max-h-[88vh] object-contain transition-transform duration-200" style="cursor:zoom-in" onclick="event.stopPropagation();odvToggleZoom()" />
        </div>
        <script>
        (function () {
          var imgs = <%- JSON.stringify(allImages.map(function (a) { return a.url; })) %>;
          var cur = 0, zoomed = false;
          function thumbs() { return document.querySelectorAll('#thumbRow [data-idx]'); }
          window.odvSetImg = function (i) {
            cur = i; var m = document.getElementById('mainImage'); if (m) m.src = imgs[i];
            thumbs().forEach(function (t) { var on = +t.dataset.idx === i; t.classList.toggle('border-gray-800', on); t.classList.toggle('border-transparent', !on); });
          };
          window.odvOpenZoom = function () {
            if (!imgs.length) return;
            var lb = document.getElementById('odvLightbox'), im = document.getElementById('odvLightboxImg');
            im.src = imgs[cur]; im.style.transform = 'scale(1)'; im.style.cursor = 'zoom-in'; zoomed = false;
            lb.classList.remove('hidden'); lb.classList.add('flex'); document.body.style.overflow = 'hidden';
          };
          window.odvCloseZoom = function (e) {
            if (e && e.target && e.target.id === 'odvLightboxImg') return; // don't close when tapping the image
            var lb = document.getElementById('odvLightbox'); lb.classList.add('hidden'); lb.classList.remove('flex'); document.body.style.overflow = '';
          };
          window.odvToggleZoom = function () {
            var im = document.getElementById('odvLightboxImg'); zoomed = !zoomed;
            im.style.transform = zoomed ? 'scale(2)' : 'scale(1)'; im.style.cursor = zoomed ? 'zoom-out' : 'zoom-in';
          };
          window.odvNav = function (d) {
            cur = (cur + d + imgs.length) % imgs.length;
            var im = document.getElementById('odvLightboxImg'); im.src = imgs[cur]; im.style.transform = 'scale(1)'; zoomed = false; odvSetImg(cur);
          };
          document.addEventListener('keydown', function (e) {
            var lb = document.getElementById('odvLightbox'); if (!lb || lb.classList.contains('hidden')) return;
            if (e.key === 'Escape') odvCloseZoom(); else if (e.key === 'ArrowRight') odvNav(1); else if (e.key === 'ArrowLeft') odvNav(-1);
          });
          var lbEl = document.getElementById('odvLightbox'), sx = 0;
          if (lbEl && imgs.length > 1) {
            lbEl.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
            lbEl.addEventListener('touchend', function (e) { var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) odvNav(dx < 0 ? 1 : -1); });
          }
        })();
        </script>
      <% } %>

      <% if (product.video_url) { %>
        <video src="<%= product.video_url %>" controls preload="metadata" playsinline
          class="w-full rounded-2xl mt-3 bg-black" aria-label="<%= pName %> — فيديو">
        </video>
      <% } %>
    </div>

    <!-- Details -->
    <div class="flex flex-col">
      <% if (product.category_name) { %>
        <p class="text-xs text-gray-400 uppercase font-semibold mb-1"><%= product.category_name %></p>
      <% } %>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-3"><%= pName %></h1>
      <% var __deal = (typeof deal !== 'undefined') ? deal : null; var __basePrice = Number(product.price); var __dealPrice = __deal ? +(__basePrice * (1 - __deal.discount_pct/100)).toFixed(2) : __basePrice; %>
      <div class="mb-4">
        <div class="text-3xl font-black brand-text" data-base="<%= __dealPrice %>">
          <% if (__deal) { %><span class="text-lg text-gray-400 line-through font-bold me-2"><%= __basePrice.toFixed(2) %></span><% } %>
          <span id="pPriceVal"><%= __dealPrice.toFixed(2) %></span> <%= company.currency || 'EGP' %><% if (product.sale_type === 'weight') { %> <span class="text-base font-bold text-gray-400">/ <%= product.weight_unit || 'كجم' %></span><% } %>
          <% if (__deal) { %><span class="text-sm bg-rose-100 text-rose-600 rounded-lg px-2 py-1 ms-1 font-bold">-<%= __deal.discount_pct %>%</span><% } %>
        </div>
        <% if (__deal && __deal.ends_at) { %>
        <div class="mt-2 inline-flex items-center gap-1.5 bg-gray-900 text-white text-xs font-bold rounded-lg px-3 py-1.5">⏳ ينتهي العرض خلال <span id="dealCountdown" data-ends="<%= new Date(__deal.ends_at).toISOString() %>">—</span></div>
        <script>
        (function(){
          var el=document.getElementById('dealCountdown'); if(!el) return;
          var ends=new Date(el.dataset.ends).getTime();
          function tick(){ var d=ends-Date.now(); if(d<=0){ el.textContent='انتهى'; return; }
            var h=Math.floor(d/3.6e6), m=Math.floor(d%3.6e6/6e4), s=Math.floor(d%6e4/1000);
            var dd=Math.floor(h/24); el.textContent=(dd>0?dd+'ي ':'')+(h%24)+'س '+m+'د '+s+'ث'; }
          tick(); setInterval(tick,1000);
        })();
        </script>
        <% } %>
      </div>

      <% if (product.stock > 0) { %>
        <p class="text-sm text-green-600 font-semibold mb-4">✓ <%= t('public.in_stock') %> (<%= product.stock %>)</p>
      <% } else { %>
        <p class="text-sm text-red-600 font-semibold mb-4">✗ <%= t('public.out_of_stock') %></p>
      <% } %>

      <% if (pDesc) { %>
        <p class="text-sm text-gray-600 mb-6 whitespace-pre-wrap leading-relaxed"><%= pDesc %></p>
      <% } %>

      <% var sizeList = (product.sale_type === 'size' && product.sizes) ? product.sizes.split(',').map(function(s){return s.trim();}).filter(Boolean) : []; %>
      <% if (product.stock > 0) { %>
        <form method="POST" action="/shop/<%= company.slug %>/cart/add" class="mt-auto" id="addForm">
          <input type="hidden" name="product_id" value="<%= product.id %>" />
          <% if (typeof variants !== 'undefined' && variants.length) { %>
            <input type="hidden" name="variant_id" id="variantInput" value="" />
            <div class="mb-4">
              <div class="text-sm font-semibold text-gray-600 mb-2">اختر الخيار</div>
              <div class="flex flex-wrap gap-2" id="variantRow">
                <% variants.forEach(function(v){ %>
                  <button type="button" class="variant-opt inline-block border border-gray-300 rounded-xl px-4 py-2 text-sm font-semibold text-gray-700 hover:border-gray-500 disabled:opacity-40 disabled:cursor-not-allowed transition"
                    data-id="<%= v.id %>" data-delta="<%= Number(v.price_delta) %>" data-stock="<%= v.stock %>" data-image="<%= v.image_url || '' %>" <%= v.stock <= 0 ? 'disabled' : '' %>><%= v.label %><%= v.stock <= 0 ? ' (نفد)' : '' %></button>
                <% }); %>
              </div>
              <p id="variantHint" class="text-xs text-amber-600 mt-2">اختر خيار قبل الإضافة للسلة.</p>
            </div>
          <% } %>
          <% if (sizeList.length) { %>
            <div class="mb-4">
              <div class="text-sm font-semibold text-gray-600 mb-2">اختر المقاس</div>
              <div class="flex flex-wrap gap-2">
                <% sizeList.forEach(function(sz, i){ %>
                  <label class="cursor-pointer">
                    <input type="radio" name="size" value="<%= sz %>" <%= i===0 ? 'checked' : '' %> class="peer sr-only" required />
                    <span class="inline-block border border-gray-300 rounded-xl px-4 py-2 text-sm font-semibold text-gray-700 peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition"><%= sz %></span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% } %>
          <div class="flex items-center gap-3">
            <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>"
              class="w-20 border border-gray-200 rounded-xl px-3 py-2.5 text-center text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
            <% if (product.sale_type === 'weight') { %><span class="text-sm text-gray-500"><%= product.weight_unit || 'كجم' %></span><% } %>
            <button type="submit" id="addBtn" class="brand-btn text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition shadow flex-1">
              <%= t('public.add_to_cart') %>
            </button>
          </div>
          <button type="submit" name="buy_now" value="1" class="w-full mt-2 bg-amber-500 text-white font-bold px-6 py-3 rounded-xl hover:bg-amber-600 transition shadow">⚡ اشترِ الآن</button>
        </form>
        <% if (__on('whatsapp_order') && company.whatsapp_number) { %>
        <a href="https://wa.me/<%= company.whatsapp_number %>?text=<%= encodeURIComponent('السلام عليكم، حابب أطلب: ' + pName + ' — السعر: ' + Number(product.price).toFixed(2) + ' ' + (company.currency || 'ج')) %>"
           target="_blank" rel="nofollow noopener"
           class="w-full mt-2 flex items-center justify-center gap-2 bg-green-600 text-white font-bold px-6 py-3 rounded-xl hover:bg-green-700 transition shadow">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.02c-.24.68-1.42 1.31-1.95 1.36-.53.05-1.02.24-3.43-.72-2.9-1.15-4.76-4.12-4.9-4.31-.14-.19-1.17-1.56-1.17-2.97 0-1.41.74-2.11 1-2.4.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 2 .88 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.38-.42.51-.14.14-.28.29-.12.57.16.28.72 1.18 1.54 1.91 1.06.94 1.95 1.24 2.23 1.38.28.14.44.12.6-.07.17-.19.69-.8.87-1.08.18-.28.36-.23.61-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.33.07.12.07.68-.17 1.36z"/></svg>
          اطلب على واتساب
        </a>
        <% } %>
        <% if (__on('subscriptions') && product.subscribable) {
             var __subPct = Number(product.sub_discount_pct || 0);
             var __subUnit = (Number(product.price) * (1 - __subPct/100)).toFixed(2);
        %>
        <form method="POST" action="/shop/<%= company.slug %>/subscribe" class="w-full mt-2">
          <input type="hidden" name="product_id" value="<%= product.id %>" />
          <input type="hidden" name="quantity" value="1" />
          <button type="submit" class="w-full flex items-center justify-center gap-2 bg-indigo-600 text-white font-bold px-6 py-3 rounded-xl hover:bg-indigo-700 transition shadow">
            🔁 اشترك — يوصلك كل <%= Number(product.sub_interval_days) || 30 %> يوم<% if (__subPct > 0) { %> (وفّر <%= __subPct %>% · <%= __subUnit %> <%= company.currency || 'ج' %>)<% } %>
          </button>
        </form>
        <% } %>
        <% if (typeof variants !== 'undefined' && variants.length) { %>
        <script>
        (function () {
          var row = document.getElementById('variantRow'); if (!row) return;
          var input = document.getElementById('variantInput'), addBtn = document.getElementById('addBtn');
          var priceVal = document.getElementById('pPriceVal'), qty = document.querySelector('#addForm input[name=quantity]');
          var hint = document.getElementById('variantHint');
          var priceWrap = priceVal ? priceVal.parentElement : null;
          var base = priceWrap ? Number(priceWrap.getAttribute('data-base')) || 0 : 0;
          function lock(v) { if (addBtn) { addBtn.disabled = v; addBtn.style.opacity = v ? '.5' : ''; addBtn.style.cursor = v ? 'not-allowed' : ''; } }
          lock(true); // require a choice first
          row.querySelectorAll('.variant-opt').forEach(function (b) {
            b.addEventListener('click', function () {
              if (b.disabled) return;
              row.querySelectorAll('.variant-opt').forEach(function (o) { o.classList.remove('bg-gray-900', 'text-white', 'border-gray-900'); });
              b.classList.add('bg-gray-900', 'text-white', 'border-gray-900');
              input.value = b.dataset.id;
              if (priceVal) priceVal.textContent = (base + Number(b.dataset.delta || 0)).toFixed(2);
              var st = parseInt(b.dataset.stock, 10) || 0;
              if (qty) { qty.max = st; if (+qty.value > st) qty.value = st || 1; }
              if (b.dataset.image && window.odvSetImg) { /* variant image handled below */ }
              if (b.dataset.image) { var m = document.getElementById('mainImage'); if (m) m.src = b.dataset.image; }
              if (hint) hint.style.display = 'none';
              lock(false);
            });
          });
        })();
        </script>
        <% } %>
      <% } else { %>
        <!-- Out of stock → notify me when back (phase 18) -->
        <div class="mt-auto bg-gray-50 border border-gray-200 rounded-2xl p-4">
          <% if (typeof notified !== 'undefined' && notified) { %>
            <div class="text-emerald-600 text-sm font-bold">تمام! هنبلّغك على الإيميل أول ما المنتج يتوفّر ✅</div>
          <% } else { %>
            <div class="text-sm font-semibold text-gray-700 mb-2">المنتج نفد — عايز نبلّغك أول ما يرجع؟</div>
            <form method="post" action="/shop/<%= company.slug %>/product/<%= product.id %>/notify-stock" class="flex gap-2">
              <input type="email" name="email" required placeholder="إيميلك" dir="ltr" class="flex-1 border border-gray-200 rounded-xl px-3 py-2.5 text-sm" />
              <button class="bg-gray-800 text-white font-bold rounded-xl px-4 py-2.5 text-sm whitespace-nowrap">أبلغني</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Reviews (phase 4) -->
  <% if (__on('reviews')) { %>
  <%
    var __rc = Number(product.review_count) || 0;
    var __avg = Number(product.avg_rating) || 0;
    function starRow(n){ var s=''; for(var i=1;i<=5;i++){ s += (i <= Math.round(n)) ? '★' : '☆'; } return s; }
  %>
  <section id="reviews" class="mt-8 border-t border-gray-100 pt-6">
    <h2 class="text-xl font-extrabold text-gray-900 mb-4">تقييمات العملاء</h2>

    <% if (reviewSent) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 mb-4 text-sm">شكراً! تم نشر تقييمك ✅</div>
    <% } %>

    <div class="grid sm:grid-cols-3 gap-6 mb-6">
      <div class="text-center sm:text-start">
        <div class="text-4xl font-black text-gray-900"><%= __rc ? __avg.toFixed(1) : '—' %></div>
        <div class="text-amber-400 text-lg leading-none mt-1"><%= starRow(__avg) %></div>
        <div class="text-xs text-gray-500 mt-1"><%= __rc %> تقييم</div>
      </div>
      <div class="sm:col-span-2 space-y-1.5">
        <% for (var s = 5; s >= 1; s--) { var n = (reviewBreakdown && reviewBreakdown[s]) || 0; var pct = __rc ? Math.round(n / __rc * 100) : 0; %>
          <div class="flex items-center gap-2 text-xs text-gray-500">
            <span class="w-8">‏<%= s %> ★</span>
            <div class="flex-1 h-2 rounded-full bg-gray-100 overflow-hidden"><div class="h-full bg-amber-400" style="width:<%= pct %>%"></div></div>
            <span class="w-8 text-end"><%= n %></span>
          </div>
        <% } %>
      </div>
    </div>

    <% if (canReview) { %>
      <form method="post" action="/shop/<%= company.slug %>/product/<%= product.id %>/review" class="bg-gray-50 border border-gray-200 rounded-2xl p-4 mb-6">
        <div class="font-bold text-gray-800 text-sm mb-2">اكتب تقييمك (إنت اشتريت المنتج ده ✓)</div>
        <div class="mb-2" id="starPick" dir="ltr" style="font-size:26px;color:#f59e0b;cursor:pointer;user-select:none;display:inline-flex;gap:2px">
          <% for (var i = 1; i <= 5; i++) { %><span data-v="<%= i %>">☆</span><% } %>
        </div>
        <input type="hidden" name="rating" id="ratingInput" value="0" required />
        <input name="title" maxlength="120" placeholder="عنوان (اختياري)" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm mb-2" />
        <textarea name="body" rows="3" maxlength="1500" placeholder="رأيك في المنتج…" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm mb-2"></textarea>
        <button class="bg-indigo-700 text-white font-bold rounded-xl px-6 py-2 text-sm hover:bg-indigo-800">نشر التقييم</button>
      </form>
      <script>
      (function(){
        var wrap=document.getElementById('starPick'), input=document.getElementById('ratingInput'), cur=0;
        if(!wrap) return;
        var stars=wrap.querySelectorAll('[data-v]');
        function paint(v){ stars.forEach(function(s){ s.textContent = (+s.dataset.v <= v) ? '★' : '☆'; }); }
        stars.forEach(function(s){
          s.addEventListener('mouseenter', function(){ paint(+s.dataset.v); });
          s.addEventListener('click', function(){ cur=+s.dataset.v; input.value=cur; paint(cur); });
        });
        wrap.addEventListener('mouseleave', function(){ paint(cur); });
      })();
      </script>
    <% } %>

    <% if (!reviews.length) { %>
      <p class="text-gray-400 text-sm">لسه مفيش تقييمات — كن أول من يقيّم بعد الشراء.</p>
    <% } else { %>
      <div class="space-y-4">
        <% reviews.forEach(function(r){ %>
          <div class="border-b border-gray-100 pb-4 last:border-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-amber-400 text-sm leading-none"><%= starRow(r.rating) %></span>
              <span class="font-bold text-gray-800 text-sm"><%= r.author %></span>
              <% if (r.verified) { %><span class="text-[10px] bg-emerald-50 text-emerald-600 rounded px-1.5 py-0.5">شراء موثّق</span><% } %>
            </div>
            <% if (r.title) { %><div class="font-semibold text-gray-800 text-sm"><%= r.title %></div><% } %>
            <% if (r.body) { %><div class="text-sm text-gray-600 mt-0.5 whitespace-pre-line"><%= r.body %></div><% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </section>
  <% } %>

  <!-- Q&A (phase 17) -->
  <% if (__on('qa')) { %>
  <section id="qa" class="mt-8 border-t border-gray-100 pt-6">
    <h2 class="text-xl font-extrabold text-gray-900 mb-4">أسئلة وأجوبة</h2>
    <% if (typeof asked !== 'undefined' && asked) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 mb-4 text-sm">اتبعت سؤالك — هيتم الرد قريباً ✅</div><% } %>
    <form method="post" action="/shop/<%= company.slug %>/product/<%= product.id %>/question" class="bg-gray-50 border border-gray-200 rounded-2xl p-4 mb-5 grid gap-2">
      <% if (!customerId) { %><input name="author_name" maxlength="60" placeholder="اسمك (اختياري)" class="border border-gray-200 rounded-xl px-3 py-2 text-sm" /><% } %>
      <textarea name="question" rows="2" required maxlength="500" placeholder="اسأل عن المنتج…" class="border border-gray-200 rounded-xl px-3 py-2 text-sm"></textarea>
      <button class="bg-indigo-700 text-white font-bold rounded-xl px-6 py-2 text-sm w-fit">اسأل</button>
    </form>
    <% if (!questions.length) { %>
      <p class="text-gray-400 text-sm">لسه مفيش أسئلة — اسأل أول سؤال.</p>
    <% } else { %>
      <div class="space-y-4">
        <% questions.forEach(function(q){ %>
        <div class="border-b border-gray-100 pb-3 last:border-0">
          <div class="text-sm font-bold text-gray-800">❓ <%= q.question %></div>
          <div class="text-xs text-gray-400"><%= q.author_name || 'زائر' %></div>
          <% if (q.answer) { %><div class="mt-1.5 bg-gray-50 rounded-xl px-3 py-2 text-sm text-gray-700"><span class="text-emerald-600 font-bold">↳ رد البائع:</span> <%= q.answer %></div><% } %>
        </div>
        <% }); %>
      </div>
    <% } %>
  </section>
  <% } %>

  <!-- Recommendations (phase 5) -->
  <% if (__on('recommendations') && typeof recommended !== 'undefined' && recommended.length) { %>
  <section class="mt-8 border-t border-gray-100 pt-6">
    <h2 class="text-xl font-extrabold text-gray-900 mb-4">قد يعجبك أيضاً</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <% recommended.forEach(function(r){ %>
        <a href="/shop/<%= company.slug %>/product/<%= r.id %>" class="block group">
          <div class="aspect-square rounded-xl overflow-hidden bg-gray-100 mb-1.5">
            <% if (r.image) { %><img src="<%= r.image %>" alt="<%= r.name %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition" /><% } else { %><div class="w-full h-full flex items-center justify-center text-gray-300 text-xs">صورة</div><% } %>
          </div>
          <div class="text-xs font-semibold text-gray-800 line-clamp-2 leading-snug"><%= r.name %></div>
          <div class="text-xs font-bold text-emerald-600 mt-0.5"><%= Number(r.price).toLocaleString('ar-EG') %> ج</div>
        </a>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Recently viewed (phase 7) — client-side, last 10 products in this browser -->
  <% if (__on('recently_viewed')) { %>
  <section id="recentViewed" class="mt-8 border-t border-gray-100 pt-6" hidden>
    <h2 class="text-xl font-extrabold text-gray-900 mb-4">شوهدت مؤخراً</h2>
    <div id="recentGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3"></div>
  </section>
  <script>
  (function () {
    var KEY = 'odv_recent';
    var cur = { id: <%= product.id %>, name: <%- JSON.stringify(pName) %>, price: <%= Number(product.price) || 0 %>, image: <%- JSON.stringify(product.image_url || '') %>, url: <%- JSON.stringify('/shop/' + company.slug + '/product/' + product.id) %> };
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    var list = []; try { list = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
    var others = list.filter(function (x) { return x && x.id !== cur.id; }).slice(0, 10);
    if (others.length) {
      document.getElementById('recentGrid').innerHTML = others.map(function (r) {
        var img = r.image ? '<img src="' + esc(r.image) + '" loading="lazy" class="w-full h-full object-cover">' : '<div class="w-full h-full flex items-center justify-center text-gray-300 text-xs">صورة</div>';
        return '<a href="' + esc(r.url) + '" class="block group"><div class="aspect-square rounded-xl overflow-hidden bg-gray-100 mb-1.5">' + img + '</div><div class="text-xs font-semibold text-gray-800 line-clamp-2 leading-snug">' + esc(r.name) + '</div><div class="text-xs font-bold text-emerald-600 mt-0.5">' + Number(r.price).toLocaleString('ar-EG') + ' ج</div></a>';
      }).join('');
      document.getElementById('recentViewed').hidden = false;
    }
    // Record the current product at the front (dedup, cap 10).
    var next = [cur].concat(list.filter(function (x) { return x && x.id !== cur.id; })).slice(0, 10);
    try { localStorage.setItem(KEY, JSON.stringify(next)); } catch (e) {}
  })();
  </script>
  <% } %>
</main>

<div class="max-w-5xl mx-auto px-4 mb-6"><div class="bg-white rounded-2xl shadow p-4 text-center overflow-hidden"><%- include('../partials/ad_unit', { slot: ads.slots.productMid }) %></div></div>

<div class="max-w-5xl mx-auto px-4 mb-6"><%- include('../partials/ad_unit', { slot: ads.slots.productBottom }) %></div>

<footer class="bg-gray-900 text-gray-400 py-6 text-center text-sm">
  <p>&copy; <%= new Date().getFullYear() %> <%= displayCompanyName %></p>
</footer>

</body>
</html>
