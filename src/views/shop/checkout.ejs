<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <% var displayCompanyName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <% var _cur = company.currency || 'ج'; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,follow" />
  <title><%= t('public.checkout') %> — <%= displayCompanyName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tw.css" />
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-btn { background-color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
<%- include('../partials/merchant_pixels', { company: company }) %>
<script>
  odvTrack('InitiateCheckout', {
    value: <%= Number(orderSubtotal) %>,
    quantity: <%= (orderLines || []).reduce(function(a,b){ return a + Number(b.quantity || 1); }, 0) || 1 %>
  });
</script>

<header class="bg-white shadow-sm">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/shop/<%= company.slug %>/cart" class="flex items-center gap-2 font-bold text-gray-800">← <%= t('public.cart') %></a>
    <div class="flex items-center gap-2">
      <a href="?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" class="text-xs font-bold text-gray-500 border border-gray-200 rounded-lg px-2 py-1"><%= t('common.toggle_lang') %></a>
      <% if (!customerId) { %>
        <a href="/customer/login" class="text-sm brand-text hover:underline"><%= t('common.login') %></a>
      <% } %>
    </div>
  </div>
</header>

<main class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-2"><%= t('public.checkout') %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= t('public.cod_explainer') %></p>

  <% if (errorCode) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= t('checkout.err.' + errorCode) %></div>
  <% } %>

  <form method="POST" action="/shop/<%= company.slug %>/checkout" class="bg-white rounded-2xl shadow p-6 space-y-5">
    <%# One order per rendered page: the server refuses a second submit carrying
        the same token, so a double tap lands on the order that already exists
        instead of placing another one. %>
    <input type="hidden" name="idem_token" value="<%= idemToken %>" />
    <% if (typeof savedAddresses !== 'undefined' && savedAddresses.length) { %>
    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5">📍 <%= t('sf.co.saved_addr') %></label>
      <select id="savedAddrPick" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white">
        <option value="">— <%= t('sf.co.new_addr') %> —</option>
        <% savedAddresses.forEach(function(a){ %>
          <option value="<%= a.id %>"
            data-name="<%= a.recipient_name || '' %>" data-phone="<%= a.phone || '' %>" data-gov="<%= a.governorate || '' %>"
            data-addr="<%= [a.governorate,a.city,a.street,a.apartment].filter(Boolean).join('، ') %>"><%= (a.label||t('sf.co.addr')) + ' — ' + [a.governorate,a.city].filter(Boolean).join('، ') %></option>
        <% }); %>
      </select>
      <script>
      (function(){ var s=document.getElementById('savedAddrPick'); if(!s) return; s.addEventListener('change',function(){
        var o=s.options[s.selectedIndex]; if(!o.value) return;
        var f=s.closest('form');
        if(f.customer_name && o.dataset.name) f.customer_name.value=o.dataset.name;
        if(f.customer_phone && o.dataset.phone) f.customer_phone.value=o.dataset.phone;
        if(f.shipping_address && o.dataset.addr) f.shipping_address.value=o.dataset.addr;
        if(f.shipping_zone && o.dataset.gov){ for(var i=0;i<f.shipping_zone.options.length;i++){ if(f.shipping_zone.options[i].value===o.dataset.gov){ f.shipping_zone.selectedIndex=i; break; } } }
      }); })();
      </script>
    </div>
    <% } %>
    <% if (typeof shippingZones !== 'undefined' && shippingZones.length) { %>
    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('sf.co.gov') %> *</label>
      <select name="shipping_zone" id="shipZoneSel" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-200">
        <option value=""><%= t('sf.co.gov_pick') %></option>
        <% shippingZones.forEach(function(z){ %>
          <option value="<%= z.governorate %>" data-cost="<%= Number(z.cost)||0 %>" data-free-over="<%= z.free_over ? Number(z.free_over) : '' %>"><%= z.governorate %> — <%= Number(z.cost)===0 ? t('sf.co.free_ship') : (Number(z.cost)+' '+_cur) %><%= z.free_over ? (' (' + t('sf.co.free_over') + ' '+Number(z.free_over)+' '+_cur+')') : '' %><%= z.eta_days ? (' · '+z.eta_days) : '' %></option>
        <% }); %>
      </select>
    </div>
    <% } %>
    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('sf.co.coupon') %></label>
      <input type="text" name="coupon_code" maxlength="40" placeholder="<%= t('sf.co.coupon_ph') %>" dir="ltr"
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </div>
    <%# الولاء (البند ٩١): كل رقم هنا من إعداد المتجر — «كل ١٠٠ نقطة = ١ ج»
        كانت مكتوبة في القالب، فالتاجر اللي بيغيّر معدّله كان العميل بيقراله
        رقم تاني عن اللي هيتحسب فعلاً. %>
    <% var _lp = (typeof loyaltyCfg !== 'undefined' && loyaltyCfg) ? loyaltyCfg : { enabled: true, redeemPer: 100, maxPercent: 100 };
       var _lpc = (company.currency || 'ج'); %>
    <% if (_lp.enabled && typeof customerPoints !== 'undefined' && customerPoints >= _lp.redeemPer) { %>
    <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3">
      <label class="block text-sm font-semibold text-indigo-700 mb-1.5">⭐ <%= t('sf.co.points_have') %> <%= customerPoints %> <%= t('sf.co.points_word') %> (= <%= (customerPoints/_lp.redeemPer).toFixed(2) %> <%= _lpc %>)</label>
      <div class="flex items-center gap-2">
        <input type="number" name="redeem_points" min="0" max="<%= customerPoints %>" step="<%= _lp.redeemPer %>" placeholder="<%= t('sf.co.points_ph') %>" class="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm" />
        <span class="text-xs text-gray-500"><%= t('sf.co.points_rate') %> <%= _lp.redeemPer %> <%= t('sf.co.points_word') %> = 1 <%= _lpc %></span>
      </div>
      <% if (_lp.maxPercent < 100) { %>
        <p class="text-[11px] text-gray-500 mt-1"><%= t('sf.co.points_max') %>: <%= _lp.maxPercent %>٪ <%= t('sf.co.points_of') %></p>
      <% } %>
    </div>
    <% } %>
    <% if (typeof customerWallet !== 'undefined' && customerWallet > 0) { %>
    <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
      <label class="flex items-center gap-2 text-sm font-semibold text-emerald-700 cursor-pointer">
        <input type="checkbox" name="use_wallet" value="1" class="w-4 h-4" />
        <%= t('sf.co.use_wallet') %> (<%= Number(customerWallet).toFixed(2) %> <%= _cur %>)
      </label>
      <p class="text-xs text-gray-500 mt-1"><%= t('sf.co.wallet_hint') %></p>
    </div>
    <% } %>
    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('sf.co.pay_method') %></label>
      <div class="flex flex-wrap gap-2">
        <label class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 py-2 text-sm cursor-pointer"><input type="radio" name="payment_method" value="cod" checked /> <%= t('sf.co.cod') %></label>
        <label class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 py-2 text-sm cursor-pointer"><input type="radio" name="payment_method" value="wallet" /> <%= t('sf.co.wallet_vf') %></label>
        <label class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 py-2 text-sm cursor-pointer"><input type="radio" name="payment_method" value="instapay" /> InstaPay</label>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.full_name') %> *</label>
        <input type="text" name="customer_name" required value="<%= prefill.full_name || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.phone') %> *</label>
        <input type="tel" name="customer_phone" required maxlength="30" value="<%= prefill.phone || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.email') %></label>
      <input type="email" name="customer_email" value="<%= prefill.email || '' %>"
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.shipping_address') %> *</label>
      <textarea name="shipping_address" rows="3" required
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"><%= prefill.address || '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.notes') %></label>
      <textarea name="notes" rows="2"
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"></textarea>
    </div>

    <% if (!customerId) { %>
      <div class="border-t pt-4">
        <label class="flex items-center gap-2 cursor-pointer mb-2">
          <input type="checkbox" name="register_account" id="register_account"
            onchange="document.getElementById('pwd_field').classList.toggle('hidden', !this.checked)"
            class="w-4 h-4 rounded text-blue-600" />
          <span class="text-sm font-semibold text-gray-700"><%= t('public.create_account_optional') %></span>
        </label>
        <div id="pwd_field" class="hidden">
          <label class="block text-xs font-semibold text-gray-500 mb-1"><%= t('customer.password_min') %></label>
          <input type="password" name="password" minlength="6"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
      </div>
    <% } %>

    <div class="border-t pt-4">
      <%- include('../partials/payment_methods', { payment: payment }) %>
    </div>

    <!-- Order summary — lets the customer review the total before confirming -->
    <% if (typeof orderLines !== 'undefined' && orderLines.length) { var __cur = (company.currency || 'ج'); %>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4">
      <div class="font-bold text-gray-800 text-sm mb-3"><%= t('sf.co.summary') %></div>
      <div class="space-y-1.5 text-sm">
        <% orderLines.forEach(function(l){ %>
        <div class="flex items-center justify-between gap-2 text-gray-600">
          <span class="truncate"><%= l.name %><%= l.size ? (' (' + l.size + ')') : '' %> × <%= l.qty %></span>
          <span class="shrink-0 font-semibold"><%= Number(l.lineTotal).toFixed(2) %> <%= __cur %></span>
        </div>
        <% }); %>
      </div>
      <div class="border-t border-gray-200 mt-3 pt-3 space-y-1.5 text-sm">
        <div class="flex items-center justify-between text-gray-600"><span><%= t('sf.co.subtotal') %></span><span id="sumSubtotal" class="font-semibold"><%= Number(orderSubtotal).toFixed(2) %> <%= __cur %></span></div>
        <div class="flex items-center justify-between text-gray-600"><span><%= t('sf.co.shipping') %></span><span id="sumShipping"><%= t('sf.co.after_gov') %></span></div>
        <div class="flex items-center justify-between text-base font-black text-gray-900 pt-1"><span><%= t('sf.co.total') %></span><span id="sumTotal"><%= Number(orderSubtotal).toFixed(2) %> <%= __cur %></span></div>
      </div>
      <p class="text-[11px] text-gray-400 mt-2"><%= t('sf.co.note') %></p>
    </div>
    <script>
    (function(){
      var sub = <%= Number(orderSubtotal) %>, cur = <%- jsonLd(company.currency || 'ج') %>;
      var sel = document.getElementById('shipZoneSel');
      var shipEl = document.getElementById('sumShipping'), totEl = document.getElementById('sumTotal');
      function fmt(n){ return (Math.round(n*100)/100).toFixed(2) + ' ' + cur; }
      function recalc(){
        var ship = 0, known = false;
        if (sel && sel.value){
          var o = sel.options[sel.selectedIndex];
          var cost = parseFloat(o.getAttribute('data-cost')) || 0;
          var freeOver = parseFloat(o.getAttribute('data-free-over'));
          ship = (!isNaN(freeOver) && freeOver > 0 && sub >= freeOver) ? 0 : cost;
          known = true;
        } else if (!sel) { known = true; }
        if (shipEl) shipEl.textContent = known ? (ship === 0 ? <%- jsonLd(t('sf.co.free')) %> : fmt(ship)) : <%- jsonLd(t('sf.co.after_gov')) %>;
        if (totEl) totEl.textContent = fmt(sub + (known ? ship : 0));
      }
      if (sel) sel.addEventListener('change', recalc);
      recalc();
    })();
    </script>
    <% } %>

    <button type="submit" class="brand-btn text-white font-bold w-full py-3 rounded-xl hover:opacity-90 transition shadow">
      <%= t('public.place_order') %>
    </button>
  </form>
</main>

</body>
</html>
