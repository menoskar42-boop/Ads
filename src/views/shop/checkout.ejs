<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <% var displayCompanyName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('public.checkout') %> — <%= displayCompanyName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-btn { background-color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<header class="bg-white shadow-sm">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/shop/<%= company.slug %>/cart" class="flex items-center gap-2 font-bold text-gray-800">← <%= t('public.cart') %></a>
    <div class="flex items-center gap-2">
      <a href="?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" class="text-xs font-bold text-gray-500 border border-gray-200 rounded-lg px-2 py-1"><%= t('common.toggle_lang') %></a>
      <% if (!customerId) { %>
        <a href="/customer/login" class="text-sm brand-text hover:underline"><%= t('common.login') %></a>
      <% } %>
    </div>
  </div>
</header>

<main class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-2"><%= t('public.checkout') %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= t('public.cod_explainer') %></p>

  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= error %></div>
  <% } %>

  <form method="POST" action="/shop/<%= company.slug %>/checkout" class="bg-white rounded-2xl shadow p-6 space-y-5">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.full_name') %> *</label>
        <input type="text" name="customer_name" required value="<%= prefill.full_name || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.phone') %> *</label>
        <input type="tel" name="customer_phone" required maxlength="30" value="<%= prefill.phone || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.email') %></label>
      <input type="email" name="customer_email" value="<%= prefill.email || '' %>"
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.shipping_address') %> *</label>
      <textarea name="shipping_address" rows="3" required
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"><%= prefill.address || '' %></textarea>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-600 mb-1.5"><%= t('common.notes') %></label>
      <textarea name="notes" rows="2"
        class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"></textarea>
    </div>

    <% if (!customerId) { %>
      <div class="border-t pt-4">
        <label class="flex items-center gap-2 cursor-pointer mb-2">
          <input type="checkbox" name="register_account" id="register_account"
            onchange="document.getElementById('pwd_field').classList.toggle('hidden', !this.checked)"
            class="w-4 h-4 rounded text-blue-600" />
          <span class="text-sm font-semibold text-gray-700"><%= t('public.create_account_optional') %></span>
        </label>
        <div id="pwd_field" class="hidden">
          <label class="block text-xs font-semibold text-gray-500 mb-1"><%= t('customer.password_min') %></label>
          <input type="password" name="password" minlength="6"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
      </div>
    <% } %>

    <button type="submit" class="brand-btn text-white font-bold w-full py-3 rounded-xl hover:opacity-90 transition shadow">
      <%= t('public.place_order') %>
    </button>
  </form>
</main>

</body>
</html>
