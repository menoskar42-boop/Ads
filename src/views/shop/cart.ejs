<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cart — <%= company.company_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
    .brand-btn { background-color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<header class="bg-white shadow-sm">
  <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/view/<%= company.slug %>" class="flex items-center gap-2 font-bold text-gray-800">← <%= company.company_name %></a>
    <% if (customerId) { %>
      <a href="/customer/orders" class="text-sm text-gray-500 hover:text-gray-700">My Orders</a>
    <% } else { %>
      <a href="/customer/login" class="text-sm text-gray-500 hover:text-gray-700">Customer Login</a>
    <% } %>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Your Cart</h1>

  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm"><%= error %></div>
  <% } %>

  <% if (!lines.length) { %>
    <div class="bg-white rounded-2xl shadow p-10 text-center text-gray-400">
      <p class="font-semibold mb-2">Your cart is empty.</p>
      <a href="/view/<%= company.slug %>" class="inline-block brand-btn text-white px-6 py-2 rounded-xl text-sm font-semibold">Continue shopping</a>
    </div>
  <% } else { %>
    <form method="POST" action="/shop/<%= company.slug %>/cart/update" class="bg-white rounded-2xl shadow overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
          <tr>
            <th class="px-4 py-3 text-left">Product</th>
            <th class="px-4 py-3 text-right">Price</th>
            <th class="px-4 py-3 text-center">Qty</th>
            <th class="px-4 py-3 text-right">Subtotal</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% lines.forEach(l => { %>
            <tr>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <% if (l.image_url) { %>
                    <img src="<%= l.image_url %>" alt="<%= l.name %>" class="w-12 h-12 rounded-lg object-cover" />
                  <% } %>
                  <span class="font-semibold text-gray-700"><%= l.name %></span>
                </div>
              </td>
              <td class="px-4 py-3 text-right font-mono"><%= Number(l.price).toFixed(2) %></td>
              <td class="px-4 py-3 text-center">
                <input type="number" name="qty_<%= l.id %>" value="<%= l.quantity %>" min="0" max="<%= l.stock %>"
                  class="w-16 border border-gray-200 rounded-lg px-2 py-1 text-center text-sm" />
              </td>
              <td class="px-4 py-3 text-right font-mono"><%= l.lineTotal.toFixed(2) %></td>
              <td class="px-4 py-3 text-right">
                <form method="POST" action="/shop/<%= company.slug %>/cart/remove/<%= l.id %>" class="inline">
                  <button type="submit" class="text-xs text-red-600 hover:text-red-800">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr class="font-bold bg-gray-50">
            <td colspan="3" class="px-4 py-3 text-right text-gray-700">Total</td>
            <td class="px-4 py-3 text-right font-mono brand-text"><%= total.toFixed(2) %> <%= company.currency || 'EGP' %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
      <div class="p-4 flex items-center justify-between gap-3 flex-wrap border-t">
        <button type="submit" class="text-sm px-4 py-2 rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 transition">Update quantities</button>
        <a href="/shop/<%= company.slug %>/checkout" class="brand-btn text-white text-sm font-bold px-6 py-2 rounded-xl hover:opacity-90 transition shadow">
          Proceed to checkout →
        </a>
      </div>
    </form>
  <% } %>
</main>

</body>
</html>
