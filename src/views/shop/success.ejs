<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<%- include('../partials/ads_loader') %>
  <% var displayCompanyName = pickContent(company, 'company_name', company.content_i18n) || company.company_name; %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,follow" />
  <title><%= t('public.order_received') %> — <%= displayCompanyName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Cairo', sans-serif; }
    :root { --brand: <%= company.theme_color %>; }
    .brand-bg { background-color: var(--brand); }
    .brand-text { color: var(--brand); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4 py-10">
  <div class="max-w-2xl w-full bg-white rounded-3xl shadow-xl p-8 text-center">
    <div class="w-16 h-16 brand-bg rounded-full mx-auto flex items-center justify-center text-white mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h1 class="text-2xl font-bold text-gray-800 mb-2"><%= t('public.order_received') %></h1>
    <p class="text-gray-500 mb-6"><%= t('public.order_number') %> <span class="font-mono brand-text">#<%= order.id %></span> &mdash; <%= displayCompanyName %>. <%= t('public.we_will_contact_you') %></p>

    <div class="text-start bg-gray-50 rounded-2xl p-5 space-y-3 mb-6">
      <div class="flex gap-3 text-sm"><span class="text-gray-400 w-24"><%= t('common.full_name') %></span><span class="font-semibold"><%= order.customer_name %></span></div>
      <div class="flex gap-3 text-sm"><span class="text-gray-400 w-24"><%= t('common.phone') %></span><span class="font-mono"><%= order.customer_phone %></span></div>
      <div class="flex gap-3 text-sm"><span class="text-gray-400 w-24"><%= t('common.shipping_address') %></span><span class="whitespace-pre-wrap"><%= order.shipping_address %></span></div>
    </div>

    <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm min-w-[360px]">
      <thead class="text-gray-400 text-xs uppercase border-b">
        <tr><th class="px-3 py-2 text-start"><%= t('common.name') %></th><th class="px-3 py-2 text-center"><%= t('public.qty') %></th><th class="px-3 py-2 text-end"><%= t('public.subtotal') %></th></tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% items.forEach(it => { %>
          <tr><td class="px-3 py-2 text-start"><%= it.product_name %></td><td class="px-3 py-2 text-center"><%= it.quantity %></td><td class="px-3 py-2 text-end font-mono"><%= (Number(it.unit_price) * it.quantity).toFixed(2) %></td></tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="font-bold border-t"><td class="px-3 py-2 text-start"><%= t('public.total') %></td><td></td><td class="px-3 py-2 text-end brand-text font-mono text-lg"><%= Number(order.total_amount).toFixed(2) %> <%= company.currency || 'EGP' %></td></tr>
      </tfoot>
    </table>
    </div>

    <% if (typeof canPayOnline !== 'undefined' && canPayOnline) { %>
      <a href="/shop/<%= company.slug %>/pay/<%= order.id %>" class="block w-full text-center bg-emerald-600 text-white font-extrabold px-6 py-3 rounded-xl hover:bg-emerald-700 transition mb-3">💳 <%= t('acct.pay.pay_online') %></a>
    <% } %>

    <a href="<%= canonicalCompanyUrl(company.slug) %>" class="inline-block brand-bg text-white font-semibold px-6 py-3 rounded-xl hover:opacity-90 transition">
      <%= t('public.continue_shopping') %>
    </a>
  </div>
</body>
</html>
