<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oscardevs Ads – Smart Advertising Platform</title>
  <meta name="description" content="Oscardevs Ads is a multi-tenant SaaS advertising platform that gives every business its own branded landing page." />
  <meta property="og:title" content="Oscardevs Ads – Smart Advertising Platform" />
  <meta property="og:description" content="Oscardevs Ads is a multi-tenant SaaS advertising platform that gives every business its own branded landing page." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

  <!-- Header -->
  <header class="bg-white shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg">O</div>
        <span class="text-xl font-bold text-blue-600">Oscardevs Ads</span>
      </div>
      <nav class="hidden md:flex gap-6 text-sm font-medium text-gray-600">
        <a href="#features" class="hover:text-blue-600 transition">Features</a>
        <a href="#how" class="hover:text-blue-600 transition">How It Works</a>
        <a href="#contact" class="hover:text-blue-600 transition">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-600 to-indigo-700 text-white py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold mb-4 leading-tight">
        Oscardevs Ads
      </h1>
      <p class="text-2xl md:text-3xl font-bold text-white mb-5 tracking-wide" dir="rtl">
        احصل على صفحتك الإعلانية المجانية
      </p>
      <p class="text-lg md:text-xl text-blue-100 mb-10 max-w-2xl mx-auto">
        Oscardevs Ads gives every business a personalized, branded advertising landing page — powered by multi-tenant technology with zero setup hassle.
      </p>
      <a href="#how" class="inline-block bg-white text-blue-700 font-semibold px-8 py-4 rounded-full shadow-lg hover:shadow-xl transition hover:-translate-y-0.5">
        Learn How It Works
      </a>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-14">Everything You Need to Advertise</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl shadow p-8 text-center">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Custom Subdomains</h3>
          <p class="text-gray-500">Each company gets its own subdomain (e.g., <code class="bg-gray-100 px-1 rounded text-sm">petra.oscardevsads.replit.app</code>) with a fully branded page.</p>
        </div>
        <div class="bg-white rounded-2xl shadow p-8 text-center">
          <div class="w-14 h-14 bg-indigo-100 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Flexible Ad Slots</h3>
          <p class="text-gray-500">Place banners at the top, sidebar, or footer of your page to maximize visibility and engagement.</p>
        </div>
        <div class="bg-white rounded-2xl shadow p-8 text-center">
          <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Multi-Tenant & Secure</h3>
          <p class="text-gray-500">Complete data isolation between tenants. Each company's content and ads are kept fully separate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how" class="bg-gray-100 py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-14">How It Works</h2>
      <div class="space-y-8">
        <div class="flex gap-6 items-start bg-white rounded-2xl shadow p-6">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">1</div>
          <div>
            <h3 class="text-lg font-semibold mb-1">Register Your Company</h3>
            <p class="text-gray-500">We add your company to the platform with a unique slug that becomes your subdomain.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start bg-white rounded-2xl shadow p-6">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">2</div>
          <div>
            <h3 class="text-lg font-semibold mb-1">Upload Your Ads</h3>
            <p class="text-gray-500">Provide banner images for the top, sidebar, and footer positions on your landing page.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start bg-white rounded-2xl shadow p-6">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">3</div>
          <div>
            <h3 class="text-lg font-semibold mb-1">Share Your Link</h3>
            <p class="text-gray-500">Your branded page is live instantly at <code class="bg-gray-100 px-1 rounded text-sm">yourslug.oscardevsads.replit.app</code> — share it with your audience.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Links -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">See It In Action</h2>
      <p class="text-gray-500 mb-10">Try our demo tenant pages live:</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="<%= canonicalCompanyUrl('petra') %>" class="bg-orange-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-orange-700 transition">
          Petra Company →
        </a>
        <a href="<%= canonicalCompanyUrl('delta') %>" class="bg-blue-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-blue-700 transition">
          Delta Company →
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="bg-gradient-to-br from-blue-600 to-indigo-700 text-white py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
        <p class="text-blue-100">Send us a message — we'll get back to you to set up your branded ad page.</p>
      </div>
      <% if (typeof sent !== 'undefined' && sent) { %>
        <div class="bg-white/15 border border-white/30 text-white rounded-2xl px-5 py-4 mb-5 text-sm text-center">
          ✓ Your message was sent. We'll be in touch soon.
        </div>
      <% } %>
      <% if (typeof contactError !== 'undefined' && contactError) { %>
        <div class="bg-red-500/30 border border-red-300 text-white rounded-2xl px-5 py-4 mb-5 text-sm text-center">
          <%= contactError %>
        </div>
      <% } %>
      <form method="POST" action="/contact" class="bg-white rounded-3xl shadow-xl p-6 sm:p-8 space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <input type="text" name="sender_name" placeholder="Your Name" required class="text-gray-800 border border-gray-200 rounded-xl px-4 py-3 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-300" />
          <input type="email" name="sender_email" placeholder="Your Email" class="text-gray-800 border border-gray-200 rounded-xl px-4 py-3 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
        <input type="tel" name="sender_phone" placeholder="Your Phone (optional)" maxlength="30" class="text-gray-800 border border-gray-200 rounded-xl px-4 py-3 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-300" />
        <textarea name="message" rows="4" placeholder="Your message..." required maxlength="5000" class="text-gray-800 border border-gray-200 rounded-xl px-4 py-3 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-300"></textarea>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-xl transition shadow w-full sm:w-auto">
          Send Message
        </button>
      </form>
      <p class="text-center text-sm text-blue-100 mt-6">
        Or email us directly at <a href="mailto:hello@oscardevs.com" class="underline hover:text-white">hello@oscardevs.com</a>
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-8 px-4 text-center text-sm">
    <p>&copy; <%= new Date().getFullYear() %> Oscardevs Ads. All rights reserved.</p>
  </footer>

</body>
</html>
