<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,follow" />
<%
  var __theme = company.theme_color || '#0e7c66';
%>
<title><%= t('pharmacy.order.title') %> — <%= company.company_name %></title>
<link rel="canonical" href="<%= canonical %>" />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>* { font-family: 'Cairo', sans-serif; } :root{--brand:<%= __theme %>} .brand-bg{background:var(--brand)} .brand-text{color:var(--brand)} .brand-border{border-color:var(--brand)}
  .fld{border:2px solid var(--brand);border-radius:12px;padding:12px 14px;width:100%;outline:none;font-size:1rem;background:#fff}
  .qbtn{width:52px;height:52px;border:2px solid var(--brand);color:var(--brand);border-radius:12px;font-size:1.6rem;font-weight:800;background:#fff;line-height:1;cursor:pointer;flex:0 0 auto}
  .qbtn:active{transform:scale(.95)}</style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen">
<header class="brand-bg text-white">
  <div class="max-w-md mx-auto px-4 py-4 font-extrabold text-lg">💊 <%= company.company_name %></div>
</header>

<main class="max-w-md mx-auto px-4 py-8">
  <% if (done && order) { %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
      <div class="text-5xl mb-3">✅</div>
      <h1 class="text-2xl font-extrabold mb-2"><%= t('pharmacy.order.success') %></h1>
      <p class="text-gray-600 mb-4"><%= t('pharmacy.order.success_msg') %></p>
      <div class="bg-gray-50 rounded-xl p-3 text-sm text-gray-700 mb-5">
        <%= t('pharmacy.orders.order') %> #<%= order.id %> · <%= order.name %> × <%= order.qty %>
        · <span class="brand-text font-bold"><%= Number(order.total).toFixed(2) %> <%= t('pharmacy.currency') %></span>
      </div>
      <% if (order.token) { %>
        <a href="/order/track/<%= order.token %><%= lang !== 'ar' ? '?lang=' + lang : '' %>" class="brand-bg text-white font-bold rounded-xl px-6 py-3 inline-block w-full mb-2"><%= t('pharmacy.track.link') %></a>
      <% } %>
      <a href="/" class="text-sm text-gray-500 underline inline-block"><%= t('pharmacy.order.back') %></a>
    </div>
  <% } else { %>
    <h1 class="text-2xl font-extrabold mb-1"><%= t('pharmacy.order.title') %></h1>
    <% var _ip = (lang==='en' && item.name_en) ? item.name_en : item.name_ar; var _is = (lang==='en' && item.name_en) ? item.name_ar : item.name_en; %>
    <p class="text-gray-600 mb-5"><b><bdi><%= _ip %></bdi></b><% if (_is) { %> — <bdi><%= _is %></bdi><% } %>
      <% if (item.price!=null) { %> · <bdi class="brand-text font-bold"><%= Number(item.price).toFixed(2) %> <%= t('pharmacy.currency') %></bdi><% } %></p>

    <% if (typeof error !== 'undefined' && error) { %><div class="mb-4 bg-red-50 text-red-600 rounded-xl px-4 py-2 text-sm font-bold"><%= t('pharmacy.order.error') %></div><% } %>

    <form method="post" action="/order" class="space-y-3">
      <input type="hidden" name="medicine_id" value="<%= item.medicine_id %>" />
      <% if (lang !== 'ar') { %><input type="hidden" name="lang" value="<%= lang %>" /><% } %>
      <div>
        <label class="text-sm font-bold block mb-1"><%= t('pharmacy.order.quantity') %></label>
        <div class="flex items-center gap-2">
          <button type="button" id="qMinus" class="qbtn" aria-label="-">−</button>
          <input id="qInput" name="qty" type="number" min="1" max="<%= item.available %>" value="1"
                 class="fld text-center" style="flex:1;font-size:1.2rem;font-weight:700" />
          <button type="button" id="qPlus" class="qbtn" aria-label="+">+</button>
        </div>
      </div>
      <div>
        <label class="text-sm font-bold block mb-1"><%= t('pharmacy.order.your_name') %></label>
        <input name="customer_name" required class="fld" />
      </div>
      <div>
        <label class="text-sm font-bold block mb-1"><%= t('pharmacy.order.your_phone') %></label>
        <input name="customer_phone" required dir="ltr" class="fld" />
      </div>
      <div>
        <label class="text-sm font-bold block mb-1"><%= t('pharmacy.order.your_address') %></label>
        <input name="customer_address" class="fld" />
      </div>
      <button class="brand-bg text-white font-extrabold rounded-xl px-6 py-3 w-full text-lg"><%= t('pharmacy.order.place') %></button>
      <a href="/" class="block text-center text-sm text-gray-500 underline mt-2"><%= t('pharmacy.order.back') %></a>
    </form>
    <script>
    (function(){
      var inp=document.getElementById('qInput'); if(!inp) return;
      var max=<%= Number(item.available)||1 %>;
      function clamp(v){ v=parseInt(v,10)||1; if(v<1)v=1; if(v>max)v=max; return v; }
      document.getElementById('qMinus').onclick=function(){ inp.value=clamp((parseInt(inp.value,10)||1)-1); };
      document.getElementById('qPlus').onclick=function(){ inp.value=clamp((parseInt(inp.value,10)||1)+1); };
      inp.addEventListener('change',function(){ inp.value=clamp(inp.value); });
    })();
    </script>
  <% } %>
      <%- include('partials/payment_methods') %>
</main>
</body>
</html>
