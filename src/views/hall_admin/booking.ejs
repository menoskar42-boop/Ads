<%- include('head') %>
<%
  function money(v){ return Number(v||0).toLocaleString('ar-EG',{maximumFractionDigits:2}); }
  function d(v){ try{ return v? new Date(v).toLocaleDateString('ar-EG',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) : '—'; }catch(e){ return '—'; } }
  var SLOT={evening:'المسا',afternoon:'بعد الضهر',full:'اليوم كله'};
  var ST={held:'مؤقت',confirmed:'مؤكّد',done:'تمّت',cancelled:'ملغي'};
%>
<a href="/hall/bookings" class="text-sm text-slate-500">← رجوع</a>
<div class="bg-white rounded-2xl border border-rose-100 p-5 mt-3 mb-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <div class="text-xs text-slate-500 font-bold"><%= B.bookingCode(booking.id) %></div>
      <h1 class="font-black text-2xl"><%= booking.customer_name %></h1>
      <p class="text-slate-600 text-sm mt-1"><%= d(booking.event_date) %> · <%= SLOT[booking.slot] %>
        <% if (booking.venue_name) { %> · <%= booking.venue_name %><% } %>
        <% if (booking.package_name) { %> · باقة <%= booking.package_name %><% } %></p>
      <% if (booking.phone) { %><p class="text-sm mt-1" dir="ltr"><%= booking.phone %></p><% } %>
    </div>
    <span class="text-xs font-bold px-3 py-1 rounded-full <%= booking.status==='held'?'bg-amber-50 text-amber-700':'bg-emerald-50 text-emerald-700' %>"><%= ST[booking.status] %></span>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 space-y-5">
    <%# The headcount is the margin, so it gets its own box with its history —
        "we agreed 300" three weeks before a wedding is not settled from memory. %>
    <section class="bg-white rounded-2xl border border-rose-100 p-5">
      <h2 class="font-black mb-3">👥 عدد المدعوين</h2>
      <form method="post" action="/hall/bookings/<%= booking.id %>/guests" class="flex gap-2 items-end text-sm">
        <label class="flex-1"><span class="text-xs font-bold text-slate-500">العدد الحالي</span>
          <input name="guests" type="number" min="0" dir="ltr" value="<%= booking.guests %>"
            class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
        <input name="note" placeholder="سبب التغيير" class="flex-1 border border-rose-100 rounded-xl px-3 py-2" />
        <button class="bg-brand-700 text-white font-bold rounded-xl px-4 py-2">حفظ</button>
      </form>
      <% if (changes.length) { %>
        <div class="mt-4 pt-3 border-t border-rose-50 text-xs text-slate-500 space-y-1">
          <% changes.forEach(function(c){ %>
            <div><%= c.old_guests %> ← <b><%= c.new_guests %></b><% if (c.note) { %> — <%= c.note %><% } %></div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="bg-white rounded-2xl border border-rose-100 p-5">
      <h2 class="font-black mb-3">➕ إضافات</h2>
      <% if (!extras.length) { %><p class="text-slate-400 text-sm">مفيش إضافات.</p><% } else { %>
        <table class="w-full text-sm mb-3">
          <tbody><% extras.forEach(function(e){ %>
            <tr class="border-b border-rose-50">
              <td class="py-1.5"><%= e.name %></td>
              <td class="py-1.5 text-slate-500 text-center"><%= Number(e.qty) %>×</td>
              <td class="py-1.5 text-end font-semibold"><bdi><%= money(Number(e.qty)*Number(e.unit_price)) %></bdi></td>
            </tr><% }) %></tbody>
        </table>
      <% } %>
      <form method="post" action="/hall/bookings/<%= booking.id %>/extras" class="grid sm:grid-cols-4 gap-2 text-sm">
        <input name="name" required placeholder="الإضافة" class="border border-rose-100 rounded-xl px-3 py-2 sm:col-span-2" />
        <input name="qty" type="number" step="0.01" min="0" value="1" dir="ltr" class="border border-rose-100 rounded-xl px-3 py-2" />
        <input name="unit_price" type="number" step="0.01" min="0" dir="ltr" placeholder="السعر" class="border border-rose-100 rounded-xl px-3 py-2" />
        <div class="sm:col-span-4"><button class="bg-brand-700 text-white font-bold rounded-xl px-4 py-2">إضافة</button></div>
      </form>
    </section>

    <% if (flags.has('payments')) { %>
    <section class="bg-white rounded-2xl border border-rose-100 p-5">
      <h2 class="font-black mb-3">📆 الأقساط</h2>
      <% if (!installments.length) { %>
        <p class="text-slate-400 text-sm mb-3">مفيش خطة أقساط.</p>
        <% if (suggested.length) { %>
          <div class="bg-rose-50/60 rounded-xl p-3 text-sm mb-3">
            <div class="font-bold text-brand-800 mb-1">خطة مقترحة (كلها قبل يوم المناسبة):</div>
            <% suggested.forEach(function(s){ %>
              <div class="text-xs">— <bdi><%= money(s.amount) %></bdi> يوم <%= s.due_on %></div>
            <% }) %>
          </div>
          <form method="post" action="/hall/bookings/<%= booking.id %>/plan" class="flex gap-2 items-center text-sm">
            <input name="count" type="number" min="1" max="12" value="3" dir="ltr" class="w-20 border border-rose-100 rounded-xl px-3 py-2" />
            <button class="bg-brand-700 text-white font-bold rounded-xl px-4 py-2">اعتمد الخطة</button>
          </form>
        <% } %>
      <% } else { %>
        <table class="w-full text-sm">
          <tbody><% installments.forEach(function(i){ %>
            <tr class="border-b border-rose-50">
              <td class="py-1.5"><%= String(i.due_on).slice(0,10) %></td>
              <td class="py-1.5 text-end font-semibold"><bdi><%= money(i.amount) %></bdi></td>
              <td class="py-1.5 text-end text-xs <%= i.paid_at?'text-emerald-700':'text-slate-400' %>"><%= i.paid_at?'اتدفع':'لسه' %></td>
            </tr><% }) %></tbody>
        </table>
      <% } %>
    </section>
    <% } %>
  </div>

  <aside class="space-y-5">
    <section class="bg-white rounded-2xl border border-rose-100 p-5 text-sm">
      <h2 class="font-black mb-3">💵 الحساب</h2>
      <dl class="space-y-1.5">
        <div class="flex justify-between"><dt class="text-slate-500">الأساسي</dt><dd><bdi><%= money(totals.base) %></bdi></dd></div>
        <div class="flex justify-between"><dt class="text-slate-500"><%= totals.guests %> فرد × <%= money(totals.perHead) %></dt><dd><bdi><%= money(totals.headTotal) %></bdi></dd></div>
        <% if (totals.extrasTotal) { %><div class="flex justify-between"><dt class="text-slate-500">إضافات</dt><dd><bdi><%= money(totals.extrasTotal) %></bdi></dd></div><% } %>
        <% if (totals.discount) { %><div class="flex justify-between"><dt class="text-slate-500">خصم</dt><dd class="text-rose-600">−<bdi><%= money(totals.discount) %></bdi></dd></div><% } %>
        <div class="flex justify-between border-t border-rose-100 pt-2 font-black text-base"><dt>الإجمالي</dt><dd><bdi><%= money(totals.total) %></bdi></dd></div>
        <div class="flex justify-between"><dt class="text-slate-500">المدفوع</dt><dd class="text-emerald-700"><bdi><%= money(totals.paid) %></bdi></dd></div>
        <div class="flex justify-between font-bold"><dt>المتبقّي</dt><dd class="<%= totals.due>0?'text-rose-600':'text-emerald-700' %>"><bdi><%= money(totals.due) %></bdi></dd></div>
      </dl>
      <% if (deposit > 0 && totals.paid < deposit) { %>
        <div class="mt-3 bg-amber-50 border border-amber-200 text-amber-900 rounded-xl px-3 py-2 text-xs">
          العربون المقترح: <b><bdi><%= money(deposit) %></bdi></b>
        </div>
      <% } %>
      <% if (flags.has('payments')) { %>
      <form method="post" action="/hall/bookings/<%= booking.id %>/pay" class="mt-4 flex gap-2">
        <input name="amount" type="number" step="0.01" min="0" dir="ltr" placeholder="المبلغ" class="flex-1 border border-rose-100 rounded-xl px-3 py-2 min-w-0" />
        <button class="bg-emerald-600 text-white font-bold rounded-xl px-4 py-2 whitespace-nowrap">تسجيل</button>
      </form>
      <% } %>
    </section>

    <section class="bg-white rounded-2xl border border-rose-100 p-5">
      <h2 class="font-black mb-3">الحالة</h2>
      <form method="post" action="/hall/bookings/<%= booking.id %>/status" class="flex gap-2">
        <select name="status" class="flex-1 border border-rose-100 rounded-xl px-3 py-2 text-sm">
          <% B.STATUSES.forEach(function(s){ %>
            <option value="<%= s %>" <%= booking.status===s?'selected':'' %>><%= ST[s] %></option>
          <% }) %>
        </select>
        <button class="bg-slate-200 font-bold rounded-xl px-4 py-2 text-sm">حفظ</button>
      </form>
      <p class="text-xs text-slate-400 mt-2">الإلغاء بيفضّي اليوم فوراً لحجز تاني.</p>
    </section>
  </aside>
</div>
<%- include('foot') %>
