<%- include('head') %>
<% function money(v){ return Number(v||0).toLocaleString('ar-EG',{maximumFractionDigits:2}); } %>
<h1 class="font-black text-xl mb-4">الباقات</h1>
<% if (!rows.length) { %>
  <div class="bg-white rounded-2xl border border-rose-100 p-8 text-center text-slate-500">مفيش باقات لسه.</div>
<% } else { %>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <% rows.forEach(function(p){ %>
      <div class="bg-white rounded-2xl border border-rose-100 p-5">
        <div class="font-black text-lg"><%= p.name %></div>
        <% if (p.description) { %><p class="text-slate-500 text-sm mt-1"><%= p.description %></p><% } %>
        <div class="mt-3 text-sm">
          <div>الأساسي: <b><bdi><%= money(p.base_price) %></bdi></b></div>
          <div>للفرد: <b><bdi><%= money(p.price_per_head) %></bdi></b></div>
          <% if (p.min_guests) { %><div class="text-xs text-slate-500 mt-1">أقل عدد: <%= p.min_guests %></div><% } %>
        </div>
        <% if (p.includes) { %><p class="text-xs text-slate-600 mt-3 whitespace-pre-line"><%= p.includes %></p><% } %>
      </div>
    <% }) %>
  </div>
<% } %>
<h2 class="font-black text-lg mt-8 mb-3">باقة جديدة</h2>
<form method="post" action="/hall/packages" class="bg-white rounded-2xl border border-rose-100 p-5 grid sm:grid-cols-2 gap-3 text-sm">
  <input name="name" required placeholder="اسم الباقة *" class="border border-rose-100 rounded-xl px-3 py-2" />
  <input name="description" placeholder="وصف قصير" class="border border-rose-100 rounded-xl px-3 py-2" />
  <input name="base_price" type="number" step="0.01" min="0" dir="ltr" placeholder="السعر الأساسي" class="border border-rose-100 rounded-xl px-3 py-2" />
  <input name="price_per_head" type="number" step="0.01" min="0" dir="ltr" placeholder="سعر الفرد" class="border border-rose-100 rounded-xl px-3 py-2" />
  <input name="min_guests" type="number" min="0" dir="ltr" placeholder="أقل عدد" class="border border-rose-100 rounded-xl px-3 py-2" />
  <textarea name="includes" rows="3" placeholder="اللي داخل في الباقة" class="border border-rose-100 rounded-xl px-3 py-2 sm:col-span-2"></textarea>
  <div class="sm:col-span-2"><button class="bg-brand-700 text-white font-bold rounded-xl px-6 py-2.5">حفظ</button></div>
</form>
<%- include('foot') %>
