<%- include('head') %>
<h1 class="font-black text-xl mb-4">الإعدادات</h1>
<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-2.5 text-sm font-bold mb-4">تم الحفظ ✓</div><% } %>
<form method="post" action="/hall/settings" class="space-y-5">
  <section class="bg-white rounded-2xl border border-rose-100 p-5">
    <h2 class="font-black mb-3">بيانات القاعة</h2>
    <div class="grid sm:grid-cols-2 gap-3 text-sm">
      <input name="business_name" value="<%= settings.business_name || '' %>" placeholder="اسم القاعة" class="border border-rose-100 rounded-xl px-3 py-2" />
      <input name="phone" dir="ltr" value="<%= settings.phone || '' %>" placeholder="التليفون" class="border border-rose-100 rounded-xl px-3 py-2" />
      <input name="whatsapp" dir="ltr" value="<%= settings.whatsapp || '' %>" placeholder="واتساب" class="border border-rose-100 rounded-xl px-3 py-2" />
      <input name="address" value="<%= settings.address || '' %>" placeholder="العنوان" class="border border-rose-100 rounded-xl px-3 py-2" />
      <textarea name="about" rows="3" placeholder="نبذة عن القاعة" class="border border-rose-100 rounded-xl px-3 py-2 sm:col-span-2"><%= settings.about || '' %></textarea>
      <input name="map_url" dir="ltr" value="<%= settings.map_url || '' %>" placeholder="رابط الخريطة" class="border border-rose-100 rounded-xl px-3 py-2" />
      <input name="video_url" dir="ltr" value="<%= settings.video_url || '' %>" placeholder="رابط فيديو/جولة" class="border border-rose-100 rounded-xl px-3 py-2" />
      <label class="block"><span class="text-xs font-bold text-slate-500">أقل عدد</span>
        <input name="capacity_min" type="number" min="0" dir="ltr" value="<%= settings.capacity_min || '' %>" class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
      <label class="block"><span class="text-xs font-bold text-slate-500">أقصى عدد</span>
        <input name="capacity_max" type="number" min="0" dir="ltr" value="<%= settings.capacity_max || '' %>" class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
      <label class="block"><span class="text-xs font-bold text-slate-500">السعر الأساسي</span>
        <input name="base_price" type="number" step="0.01" min="0" dir="ltr" value="<%= Number(settings.base_price || 0) %>" class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
      <label class="block"><span class="text-xs font-bold text-slate-500">سعر الفرد</span>
        <input name="price_per_head" type="number" step="0.01" min="0" dir="ltr" value="<%= Number(settings.price_per_head || 0) %>" class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
      <label class="block"><span class="text-xs font-bold text-slate-500">نسبة العربون %</span>
        <input name="deposit_percent" type="number" step="0.01" min="0" max="100" dir="ltr" value="<%= Number(settings.deposit_percent || 25) %>" class="w-full border border-rose-100 rounded-xl px-3 py-2 mt-1" /></label>
    </div>
  </section>
  <section class="bg-white rounded-2xl border border-rose-100 p-5">
    <h2 class="font-black mb-3">الأقسام</h2>
    <div class="grid sm:grid-cols-2 gap-2 text-sm">
      <% FLAGS.forEach(function(f){ %>
        <label class="flex items-start gap-3 p-3 rounded-xl border border-rose-50 <%= f.core?'bg-rose-50/40':'' %>">
          <input type="checkbox" name="flags" value="<%= f.key %>" class="mt-1" <%= flags.has(f.key)?'checked':'' %> <%= f.core?'disabled checked':'' %> />
          <span><span class="font-bold"><%= f.icon %> <%= f.label %></span>
            <span class="block text-xs text-slate-500 mt-0.5"><%= f.desc %></span>
            <% if (f.core) { %><span class="block text-[10px] text-slate-400 mt-0.5">أساسي — مش بيتقفل</span><% } %></span>
        </label>
      <% }) %>
    </div>
  </section>
  <button class="bg-brand-700 text-white font-bold rounded-xl px-8 py-3">حفظ</button>
</form>
<%- include('foot') %>
