<%
  /* The merchant's own tracking pixels — Meta, TikTok, GA4 — plus one function
     that sends a real e-commerce event to all three at once.

     What was here before: the pixels loaded on the storefront only, and fired
     PageView only. So a merchant could pay for ads, get sales, and have no
     way to know which ad produced them — Meta and TikTok both optimise on
     Purchase, and neither ever received one. The product page, the page most
     worth retargeting from, carried no pixel at all.

     Usage: include this partial with { company: company } at the top of the
     body, then call odvTrack('AddToCart', { id, name, value, currency,
     quantity }) anywhere after it.

     Event names are the platform's own, mapped per platform:
       ViewContent · AddToCart · InitiateCheckout · Purchase · Contact
     Currency comes from the store, not a hardcoded EGP.

     Nothing loads for a merchant who entered no IDs, and odvTrack stays
     defined either way so a caller never has to check. */
  var __cur = (company && company.currency) || 'EGP';
  var __fb = company && company.fb_pixel_id;
  var __tt = company && company.tiktok_pixel_id;
  var __ga = company && company.ga4_id;
  /* الموافقة (البند ٨٩): 'ask' معناها مايتحمّلش سكربت لحد ما الزائر يوافق.
     الافتراضي 'off' عشان المتاجر الشغّالة مايتغيّرش سلوكها في الصمت.
     ⚠️ ده عن بيكسلات التاجر بس — إعلانات أدسنس ليها آليتها عند جوجل. */
  var __consent = (company && company.consent_mode) === 'ask' ? 'ask' : 'off';
  var __store = company && (company.slug || company.id) ? String(company.slug || company.id) : 'store';
%>
<script>
(function () {
  var CONSENT = <%- jsonLd(__consent) %>;
  var KEY = 'odv_consent_' + <%- jsonLd(__store) %>;
  var IDS = { fb: <%- jsonLd(__fb || '') %>, tt: <%- jsonLd(__tt || '') %>, ga: <%- jsonLd(__ga || '') %> };

  // اللودرات زي ما هي — بس بقت بتتنده لما يبقى مسموح، مش وقت رسم الصفحة.
  function loadFb(id){ !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',id);fbq('track','PageView'); }
  function loadTt(id){ !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.load=function(e){var n="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=n;ttq._t=ttq._t||{};ttq._t[e]=+new Date;var o=d.createElement("script");o.type="text/javascript";o.async=!0;o.src=n+"?sdkid="+e;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};ttq.load(id);ttq.page()}(window,document,'ttq'); }
  function loadGa(id){
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ window.dataLayer.push(arguments); };
    gtag('js', new Date()); gtag('config', id);
  }
  function loadAll(){
    if (window.__odvPixelsLoaded) return;
    window.__odvPixelsLoaded = true;
    try { if (IDS.fb) loadFb(IDS.fb); } catch (e) {}
    try { if (IDS.tt) loadTt(IDS.tt); } catch (e) {}
    try { if (IDS.ga) loadGa(IDS.ga); } catch (e) {}
  }

  function stored(){ try { return localStorage.getItem(KEY); } catch (e) { return null; } }

  if (CONSENT !== 'ask') loadAll();
  else if (stored() === 'yes') loadAll();
  else if (stored() !== 'no') {
    // شريط تحت، مش طبقة فوق الصفحة: الطبقة بتغطّي محتوى (وإعلانات)، والزائر
    // اللي مايردّش لازم يفضل قادر يستعمل المتجر.
    document.addEventListener('DOMContentLoaded', function () {
      var bar = document.createElement('div');
      bar.setAttribute('dir', 'rtl');
      bar.style.cssText = 'position:fixed;inset-inline:0;bottom:0;z-index:9998;background:#111827;color:#e5e7eb;'
        + 'font:13px/1.7 system-ui,sans-serif;padding:12px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center';
      bar.innerHTML = '<span>المتجر بيستخدم أدوات قياس (فيسبوك/تيك توك/جوجل) عشان يعرف إعلاناته بتوصل لمين. توافق؟</span>';
      var yes = document.createElement('button');
      yes.textContent = 'موافق';
      yes.style.cssText = 'background:#22c55e;color:#052e16;border:0;border-radius:8px;padding:6px 14px;font-weight:700;cursor:pointer';
      var no = document.createElement('button');
      no.textContent = 'لأ';
      no.style.cssText = 'background:transparent;color:#e5e7eb;border:1px solid #4b5563;border-radius:8px;padding:6px 14px;cursor:pointer';
      // الرفض بيتخزّن زي الموافقة — الزائر اللي قال لأ مايتسألش كل صفحة.
      function answer(v){ try { localStorage.setItem(KEY, v); } catch (e) {} bar.remove(); if (v === 'yes') loadAll(); }
      yes.onclick = function(){ answer('yes'); };
      no.onclick = function(){ answer('no'); };
      bar.appendChild(yes); bar.appendChild(no);
      document.body.appendChild(bar);
    });
  }
})();
</script>
<script>
(function () {
  var CUR = <%- jsonLd(__cur) %>;
  // GA4 uses its own names for the same four moments.
  var GA = { ViewContent: 'view_item', AddToCart: 'add_to_cart',
             InitiateCheckout: 'begin_checkout', Purchase: 'purchase',
             Contact: 'generate_lead' };
  // TikTok's spelling differs again.
  var TT = { ViewContent: 'ViewContent', AddToCart: 'AddToCart',
             InitiateCheckout: 'InitiateCheckout', Purchase: 'CompletePayment',
             Contact: 'Contact' };

  window.odvTrack = function (event, d) {
    d = d || {};
    var value = Number(d.value || 0);
    var cur = d.currency || CUR;
    var id = d.id == null ? '' : String(d.id);
    var qty = Number(d.quantity || 1);
    /* رقم الحدث — البند ٨٩.
     *
     * نفس عملية الشراء بتتبعت من المتصفح ومن السيرفر (Conversion API). لو
     * الاتنين مابعتوش **نفس الرقم**، ميتا بتحسبهم عمليتين، والتاجر بيفتكر
     * إن الإعلان بيجيب ضعف اللي بيجيبه ويزوّد الميزانية على رقم مش حقيقي.
     * الرقم مشتق من رقم الطلب فإعادة تحميل الصفحة مابتعملش حدث تالت. */
    var evId = d.eventId ? String(d.eventId) : null;
    try {
      if (window.fbq) {
        fbq('track', event, {
          content_ids: id ? [id] : undefined,
          content_name: d.name,
          content_type: 'product',
          value: value || undefined,
          currency: cur,
          num_items: event === 'Purchase' ? qty : undefined,
        }, evId ? { eventID: evId } : undefined);
      }
    } catch (e) {}
    try {
      if (window.ttq && TT[event]) {
        ttq.track(TT[event], {
          contents: id ? [{ content_id: id, content_name: d.name, quantity: qty, price: d.price }] : undefined,
          value: value || undefined,
          currency: cur,
        }, evId ? { event_id: evId } : undefined);
      }
    } catch (e) {}
    try {
      if (window.gtag && GA[event]) {
        gtag('event', GA[event], {
          currency: cur,
          value: value || undefined,
          transaction_id: d.orderId || undefined,
          items: id ? [{ item_id: id, item_name: d.name, price: d.price, quantity: qty }] : undefined,
        });
      }
    } catch (e) {}
  };

  /* ── لوحة «اختبار التتبّع» (البند ٨٩) ─────────────────────────────────
   *
   * التاجر بيلزق رقم البيكسل وبيستنى. لو الرقم غلط، أو مانع الإعلانات في
   * متصفحه شايل السكربت، مفيش حاجة على الشاشة بتقول كده — الصفحة شغّالة عادي
   * والأحداث مش بتوصل.
   *
   * اللوحة دي بتفتح بـ`?odv_test=1` بس (لينك من لوحة التاجر)، وبتقول **بالظبط
   * اللي إحنا قادرين نشوفه**: هل السكربت اتحمّل في المتصفح ده. مابتدّعيش إن
   * المنصّة استلمت الحدث — ده بيتشاف من Test Events عندهم، واللوحة بتقول ده
   * صراحةً بدل ما تدّي طمأنينة مالهاش أساس.
   *
   * وتلات حالات مش اتنين: «مش متظبّط» (مفيش رقم أصلاً) غير «مااتحملش» (فيه
   * رقم والسكربت مش موجود) غير «اتحمّل». */
  if (/(?:^|[?&])odv_test=1(?:&|$)/.test(location.search)) {
    var CONF = { fb: <%- jsonLd(!!__fb) %>, tt: <%- jsonLd(!!__tt) %>, ga: <%- jsonLd(!!__ga) %> };
    setTimeout(function () {
      var box = document.createElement('div');
      box.setAttribute('dir', 'rtl');
      box.style.cssText = 'position:fixed;inset-inline-end:12px;bottom:12px;z-index:99999;background:#0f172a;color:#e2e8f0;'
        + 'font:13px/1.7 system-ui,sans-serif;padding:14px 16px;border-radius:14px;max-width:330px;box-shadow:0 10px 30px rgba(0,0,0,.35)';
      function row(name, configured, loaded) {
        var state = !configured ? ['مش متظبّط', '#94a3b8']
          : loaded ? ['اتحمّل في المتصفح', '#4ade80']
          : ['مااتحمّلش — الرقم غلط أو فيه مانع إعلانات', '#fbbf24'];
        return '<div style="display:flex;gap:8px;justify-content:space-between"><span>' + name
          + '</span><span style="color:' + state[1] + '">' + state[0] + '</span></div>';
      }
      box.innerHTML = '<div style="font-weight:700;margin-bottom:6px">اختبار التتبّع</div>'
        + row('Facebook Pixel', CONF.fb, !!window.fbq)
        + row('TikTok Pixel', CONF.tt, !!window.ttq)
        + row('Google Analytics 4', CONF.ga, !!window.gtag)
        + '<div style="margin-top:8px;color:#94a3b8;font-size:11.5px">'
        + 'بعتنا حدث تجريبي (ViewContent). اللوحة دي بتقول إن السكربت اتحمّل عندك بس — '
        + 'إن المنصّة استلمته بيتشاف من Test Events في فيسبوك أو Debugger في تيك توك.'
        + '</div>';
      document.body.appendChild(box);
      // حدث حقيقي عشان يبان في أدوات المنصّة — بقيمة صفر ومن غير رقم منتج
      // عشان مايتحسبش شراء ولا يبوّظ أرقام التاجر.
      window.odvTrack('ViewContent', { name: 'odv-test', value: 0 });
    }, 1200);
  }

  // A WhatsApp click is the checkout of every page that does not have a cart —
  // a clinic, a hall, a workshop. It was never counted anywhere.
  document.addEventListener('click', function (ev) {
    var a = ev.target && ev.target.closest && ev.target.closest('a[href*="wa.me/"], a[href*="api.whatsapp.com"]');
    if (a) window.odvTrack('Contact', { name: 'whatsapp' });
  }, true);
})();
</script>
