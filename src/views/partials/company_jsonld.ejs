<%
  var __sameAs = [
    company.social_facebook, company.social_instagram, company.social_linkedin,
    company.social_twitter, company.social_tiktok, company.social_youtube,
    company.social_threads, company.social_website
  ].filter(Boolean);
  var __orgType = company.page_type === 'shop' ? 'Store' : 'Organization';
%>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "<%= __orgType %>",
  "name": <%- JSON.stringify(company.company_name) %>,
  "url": "<%= siteOrigin %>/view/<%= company.slug %>",
  <% if (company.logo_url) { %>"logo": <%- JSON.stringify(company.logo_url.indexOf('http') === 0 ? company.logo_url : (siteOrigin + company.logo_url)) %>,<% } %>
  <% if (company.description) { %>"description": <%- JSON.stringify(company.description) %>,<% } %>
  <% if (company.contact_email) { %>"email": <%- JSON.stringify(company.contact_email) %>,<% } %>
  <% if (company.contact_phone) { %>"telephone": <%- JSON.stringify(company.contact_phone) %>,<% } %>
  <% if (company.contact_address) { %>"address": { "@type": "PostalAddress", "streetAddress": <%- JSON.stringify(company.contact_address) %> },<% } %>
  "sameAs": <%- JSON.stringify(__sameAs) %>
}
</script>
