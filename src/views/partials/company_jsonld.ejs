<%
  var __sameAs = [
    company.social_facebook, company.social_instagram, company.social_linkedin,
    company.social_twitter, company.social_tiktok, company.social_youtube,
    company.social_threads, company.social_website
  ].filter(Boolean);
  var __orgType = company.page_type === 'shop' ? 'Store' : 'Organization';
%>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "<%= __orgType %>",
  "name": <%- jsonLd(company.company_name) %>,
  "url": <%- jsonLd(typeof canonicalCompanyUrl === 'function' ? canonicalCompanyUrl(company.slug) : (siteOrigin + '/view/' + company.slug)) %>,
  <% if (company.logo_url) { %>"logo": <%- jsonLd(company.logo_url.indexOf('http') === 0 ? company.logo_url : (siteOrigin + company.logo_url)) %>,<% } %>
  <% if (company.description) { %>"description": <%- jsonLd(company.description) %>,<% } %>
  <% if (company.contact_email) { %>"email": <%- jsonLd(company.contact_email) %>,<% } %>
  <% if (company.contact_phone) { %>"telephone": <%- jsonLd(company.contact_phone) %>,<% } %>
  <% if (company.contact_address) { %>"address": { "@type": "PostalAddress", "streetAddress": <%- jsonLd(company.contact_address) %> },<% } %>
  "sameAs": <%- jsonLd(__sameAs) %>
}
</script>
