<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# A named person's health record. noindex and no ads, without exception. %>
<meta name="robots" content="noindex,nofollow" />
<title><%= title %> — <%= practice.company_name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans: ['Cairo','system-ui','sans-serif'] },
    colors: { brand: { 50:'#f0fdf4',100:'#dcfce7',200:'#bbf7d0',400:'#4ade80',500:'#22c55e',600:'#16a34a',700:'#15803d',900:'#14532d' } }
  } } };
</script>
<style>body{font-family:'Cairo',sans-serif} input{font-size:16px !important}</style>
</head>
<body class="bg-slate-50 text-slate-800 pb-20">
<header class="bg-brand-600 text-white">
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center gap-3">
    <span class="font-black text-base truncate">🥗 <%= practice.company_name %></span>
    <% if (typeof showNav === 'undefined' || showNav) { %>
    <form method="post" action="/portal/logout" class="ms-auto">
      <button class="text-xs bg-white/15 hover:bg-white/25 rounded-lg px-3 py-1.5"><%= t('common.logout') %></button>
    </form>
    <% } %>
  </div>
</header>
<main class="max-w-2xl mx-auto px-4 py-5">
