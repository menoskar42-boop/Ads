<%- include('head', { title: t('np.pw.title') }) %>

<a href="/portal" class="text-slate-400 hover:text-slate-600 text-sm">← <%= t('np.pw.back') %></a>

<div class="bg-white rounded-2xl shadow-sm p-6 mt-3">
  <h1 class="text-xl font-black text-slate-900 mb-1"><%= t('np.pw.title') %></h1>
  <p class="text-slate-500 text-sm mb-5"><%= t('np.pw.sub') %></p>

  <% if (saved) { %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('np.pw.saved') %></div>
  <% } %>
  <% if (err) { %>
    <div class="bg-red-50 border border-red-200 rounded-xl px-4 py-2.5 mb-4 text-sm text-red-800"><%= t('np.pw.err_' + err) %></div>
  <% } %>

  <form method="post" action="/portal/password" class="grid gap-3">
    <label class="text-xs font-bold text-slate-600"><%= t('np.pw.current') %>
      <input name="current" type="password" required autocomplete="current-password"
             class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" />
    </label>
    <label class="text-xs font-bold text-slate-600"><%= t('np.pw.new') %>
      <input name="password" type="password" required minlength="8" maxlength="200" autocomplete="new-password"
             class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" />
    </label>
    <label class="text-xs font-bold text-slate-600"><%= t('np.pw.confirm') %>
      <input name="confirm" type="password" required minlength="8" maxlength="200" autocomplete="new-password"
             class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" />
    </label>
    <button class="bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl px-6 py-2.5 text-sm mt-1"><%= t('np.pw.go') %></button>
  </form>

  <p class="text-xs text-slate-400 mt-5"><%= t('np.pw.forgot') %></p>
</div>

</main></body></html>
