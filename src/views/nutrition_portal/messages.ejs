<%- include('head', { title: t('np.msg.title') }) %>
<% function fmtT(v){ if(!v) return ''; try { return new Date(v).toLocaleString(LOC,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); } catch(e){ return ''; } } %>

<div class="flex items-center gap-3 mb-3">
  <a href="/portal" class="text-slate-400 hover:text-slate-600 text-sm">← <%= t('np.today.title') %></a>
  <h1 class="text-lg font-black text-slate-900"><%= t('np.msg.title') %></h1>
</div>

<%# دي مش شات. الجملة دي جزء من الميزة مش تحذير مركون في الفوتر: اللي بيكتب
    الساعة ٢ بالليل لازم يعرف إن محدش قاعد على الشاشة. %>
<div class="bg-amber-50 border border-amber-200 rounded-2xl px-4 py-3 mb-3">
  <p class="text-sm font-bold text-amber-900 mb-0.5">⚠️ <%= t('np.msg.not_urgent') %></p>
  <p class="text-xs text-amber-800"><%= replyNote ? replyNote : t('np.msg.reply_default') %></p>
</div>

<% if (sent) { %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-3 text-sm text-emerald-800"><%= t('np.msg.sent_ok') %></div>
<% } %>
<% if (err) { %>
  <div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-3 text-sm text-red-800"><%= t('np.msg.err.' + err) %></div>
<% } %>

<div class="grid gap-2 mb-4">
  <% if (!thread.length) { %>
    <div class="bg-white rounded-2xl shadow-sm p-6 text-center text-slate-400 text-sm"><%= t('np.msg.none') %></div>
  <% } %>
  <% thread.forEach(function(m){ %>
  <div class="flex <%= m.mine ? 'justify-end' : 'justify-start' %>">
    <div class="max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm <%= m.mine ? 'bg-brand-600 text-white' : 'bg-white text-slate-800' %>">
      <% if (!m.mine) { %>
        <div class="text-[11px] font-bold <%= m.mine ? 'text-white/70' : 'text-brand-700' %> mb-0.5">
          <%= m.author ? m.author : t('np.msg.from_practice') %>
        </div>
      <% } %>
      <p class="text-sm whitespace-pre-line"><%= m.body %></p>
      <div class="text-[10px] mt-1 <%= m.mine ? 'text-white/70' : 'text-slate-400' %>">
        <%= fmtT(m.at) %>
        <%# «اتقرت» بتظهر لما العيادة تفتح الخيط فعلاً — مش على مجرد الوصول. %>
        <% if (m.state) { %> · <%= t('np.msg.st.' + m.state) %><% } %>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<% if (waiting !== null && waiting >= 0) { %>
  <p class="text-xs text-slate-400 mb-3"><%= t('np.msg.waiting').replace('{h}', waiting) %></p>
<% } %>

<form method="post" action="/portal/messages" class="bg-white rounded-2xl shadow-sm p-4">
  <label class="text-xs font-bold text-slate-600 block mb-1"><%= t('np.msg.write') %></label>
  <textarea name="body" rows="3" required maxlength="<%= maxLen %>"
            class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"></textarea>
  <button class="mt-2 w-full bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl px-4 py-2.5 text-sm"><%= t('np.msg.send') %></button>
</form>

</main></body></html>
