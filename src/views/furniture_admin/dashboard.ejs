<%- include('head', { title: t('fn2.nav.dashboard'), tab: 'dashboard' }) %>

<h1 class="text-2xl font-black text-stone-900 mb-1"><%= t('fn2.dash.hi') %></h1>
<p class="text-stone-500 mb-6"><%= t('fn2.dash.sub') %></p>

<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  // A card whose section is switched off would report a figure the showroom
  // cannot open, so it is simply not drawn.
  var CARDS = [
    { key:'sales',     icon:'🛒', label:'fn2.card.sales',     value: d.period.invoiced,        tone:'text-stone-900' },
    { key:'sales',     icon:'⏳', label:'fn2.card.due',       value: d.owedByCustomers,        tone:'text-amber-700' },
    { key:'inventory', icon:'📦', label:'fn2.card.low_stock', value: d.stock.lowCount, plain:true, tone: d.stock.lowCount ? 'text-amber-700' : 'text-stone-900' },
    { key:'purchases', icon:'🧾', label:'fn2.card.suppliers', value: d.owedToSuppliers,        tone:'text-amber-700' },
    { key:'delivery',  icon:'🚚', label:'fn2.card.late_delivery', value: d.lateDeliveries, plain:true, tone: d.lateDeliveries ? 'text-red-700' : 'text-stone-900' },
  ].filter(function(c){ return flags.has(c.key); });
%>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
  <% CARDS.forEach(function(c){ %>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-stone-500 mb-1"><%= c.icon %> <%= t(c.label) %></div>
    <div class="text-2xl font-extrabold <%= c.tone %>"><%= c.plain ? c.value : money(c.value) %></div>
  </div>
  <% }); %>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-stone-500 mb-1">💵 <%= t('fn2.rp.cash') %></div>
    <div class="text-2xl font-extrabold <%= d.cash.balance < 0 ? 'text-red-700' : 'text-emerald-700' %>"><%= money(d.cash.balance) %></div>
  </div>
  <% if (flags.has('inventory')) { %>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-stone-500 mb-1">🪵 <%= t('fn2.rp.stock_value') %></div>
    <div class="text-2xl font-extrabold text-stone-900"><%= money(d.stock.value) %></div>
  </div>
  <% } %>
  <% if (flags.has('purchases')) { %>
  <div class="bg-white rounded-2xl shadow-sm p-4">
    <div class="text-xs text-stone-500 mb-1">📬 <%= t('fn2.rp.open_orders') %></div>
    <div class="text-2xl font-extrabold text-stone-900"><%= d.openOrders %></div>
  </div>
  <% } %>
  <div class="bg-stone-900 rounded-2xl shadow-sm p-4 text-white">
    <div class="text-xs text-white/70 mb-1"><%= t('fn2.rp.difference') %> · <%= t('fn2.rp.this_month') %></div>
    <div class="text-2xl font-extrabold <%= d.period.difference < 0 ? 'text-red-300' : '' %>"><%= money(d.period.difference) %></div>
  </div>
</div>

<div class="bg-white rounded-2xl shadow-sm p-5">
  <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.dash.enabled') %></h2>
  <% if (!furnitureNav.length) { %>
    <p class="text-sm text-stone-500"><%= t('fn2.dash.none_on') %></p>
  <% } else { %>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <% furnitureNav.forEach(function(f){ %>
    <a href="<%= f.path %>" class="flex items-start gap-3 border border-stone-200 rounded-2xl p-4 hover:border-brand-300 transition">
      <span class="text-2xl shrink-0"><%= f.icon %></span>
      <span class="min-w-0">
        <span class="block font-bold text-stone-900 text-sm"><%= f.label %></span>
        <span class="block text-xs text-stone-500 leading-snug"><%= f.desc %></span>
      </span>
    </a>
    <% }); %>
  </div>
  <% } %>
  <p class="text-xs text-stone-400 mt-4">
    <%= t('fn2.dash.toggle_hint') %>
    <a href="/furniture/settings" class="text-brand-600 font-semibold hover:underline"><%= t('fn2.nav.settings') %></a>
  </p>
</div>

</main></body></html>
