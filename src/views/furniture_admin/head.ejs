<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= title %> — <%= company.company_name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { darkMode: 'class', theme: { extend: {
    fontFamily: { sans: ['Cairo','system-ui','sans-serif'] },
    // Warm wood tones, so the workshop's system does not look like the clinic's.
    colors: { brand: { 50:'#fbf6f0',100:'#f4e6d6',200:'#e8ccae',300:'#d9a06a',400:'#c17f3f',500:'#a86a32',600:'#8a5524',700:'#6d431d',800:'#523216',900:'#3a230f' } }
  } } };
</script>
<style>
  body{font-family:'Cairo',sans-serif}

  /* Wide tables become labelled cards on a phone — a workshop owner checks
     stock from the floor, not from a desk, and sideways scrolling hides the
     column that matters. Add class="rt" and give each <td> a data-l. */
  @media (max-width: 639px) {
    table.rt, table.rt tbody, table.rt tr, table.rt td { display: block; width: 100%; }
    table.rt thead { display: none; }
    table.rt tr {
      background: #fff; border: 1px solid #e7e0d8; border-radius: 1rem;
      padding: .5rem .75rem; margin-bottom: .6rem;
    }
    table.rt td {
      display: flex; align-items: center; gap: .5rem;
      padding: .35rem 0 !important; border: 0 !important; text-align: start !important;
    }
    table.rt td::before {
      content: attr(data-l); flex: 0 0 40%;
      color: #6d5c4a; font-size: .7rem; font-weight: 700;
    }
    table.rt td:not([data-l])::before { content: none; }
    table.rt td:not([data-l]) { justify-content: flex-end; }
    input, select, textarea { font-size: 16px !important; }
    button, .btn { min-height: 40px; }
  }
</style>
</head>
<body class="bg-stone-50 text-stone-800 pb-16 sm:pb-0">
<%
  var __tab = typeof tab !== 'undefined' ? tab : '';
  function __cls(k){ return 'px-3 py-1.5 rounded-lg ' + (__tab===k ? 'bg-white/25 font-bold' : 'hover:bg-white/15'); }
  // Only features whose flag is on. The route guard reads the same set, so a
  // hidden tab is also a closed URL rather than one you can still type.
  var __nav = (typeof furnitureNav !== 'undefined' ? furnitureNav : []);
%>

<header class="bg-brand-600 text-white">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3 flex-wrap">
    <a href="/furniture" class="font-black text-lg flex items-center gap-2">
      🪑 <span class="truncate max-w-[45vw] sm:max-w-none"><%= company.company_name %></span>
    </a>

    <nav class="hidden sm:flex items-center gap-1 text-sm ms-auto">
      <a href="/furniture" class="<%= __cls('dashboard') %>"><%= t('fn2.nav.dashboard') %></a>
      <% __nav.forEach(function(f){ %>
        <a href="<%= f.path %>" class="<%= __cls(f.key) %>"><%= f.label %></a>
      <% }); %>
      <a href="/furniture/settings" class="<%= __cls('settings') %>"><%= t('fn2.nav.settings') %></a>
    </nav>

    <% var __alerts = (typeof alertCount !== 'undefined' ? Number(alertCount) || 0 : 0); %>
    <% if (__alerts) { %>
      <a href="/furniture/alerts" class="relative text-lg leading-none px-1" title="<%= t('fn2.flag.alerts') %>">🔔<span
        class="absolute -top-1 -end-1 bg-red-500 text-white text-[10px] font-bold rounded-full px-1.5 leading-4"><%= __alerts > 99 ? '99+' : __alerts %></span></a>
    <% } %>

    <%- include('../partials/merchant_chips') %>
    <form method="post" action="/company/logout" class="ms-auto sm:ms-0">
      <button class="text-xs bg-white/15 hover:bg-white/25 rounded-lg px-3 py-1.5"><%= t('common.logout') %></button>
    </form>
  </div>
</header>

<%# The branch switch sits above every page, not inside one, because it
    changes what every page means. `back` returns the user where they were:
    a filter that dumps you on the dashboard is a filter nobody uses twice. %>
<% var __branches = (typeof branches !== 'undefined' ? branches : []);
   var __branch = (typeof branch !== 'undefined' ? branch : null); %>
<% if (__branches.length) { %>
<div class="bg-brand-50 border-b border-brand-100 no-print">
  <form method="post" action="/furniture/branches/switch" class="max-w-6xl mx-auto px-4 py-2 flex items-center gap-2 text-xs">
    <span class="text-brand-800 font-bold">🏬 <%= t('fn2.br.viewing') %></span>
    <input type="hidden" name="back" value="<%= (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/furniture' %>" />
    <select name="branch" onchange="this.form.submit()" class="border border-brand-200 rounded-lg px-2 py-1 bg-white">
      <option value="" <%= __branch == null ? 'selected' : '' %>><%= t('fn2.br.all') %></option>
      <% __branches.forEach(function(b){ %>
        <option value="<%= b.id %>" <%= __branch === b.id ? 'selected' : '' %>><%= b.name %></option>
      <% }); %>
      <option value="none" <%= __branch === 'none' ? 'selected' : '' %>><%= t('fn2.br.unassigned') %></option>
    </select>
    <noscript><button class="bg-brand-600 text-white rounded-lg px-3 py-1 font-bold"><%= t('fn2.hr.show') %></button></noscript>
  </form>
</div>
<% } %>

<!-- Phone: the sections as a scrolling strip rather than a hidden menu, so
     nothing needs hunting for one-handed on a workshop floor. -->
<nav class="sm:hidden bg-brand-700 text-white/90 overflow-x-auto">
  <div class="flex gap-1 px-3 py-2 text-xs whitespace-nowrap">
    <a href="/furniture" class="<%= __cls('dashboard') %>"><%= t('fn2.nav.dashboard') %></a>
    <% __nav.forEach(function(f){ %>
      <a href="<%= f.path %>" class="<%= __cls(f.key) %>"><%= f.icon %> <%= f.label %></a>
    <% }); %>
    <a href="/furniture/settings" class="<%= __cls('settings') %>"><%= t('fn2.nav.settings') %></a>
  </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-6">
