<%- include('head', { title: t('fn2.flag.branches'), tab: 'branches' }) %>
<% var KIND = { showroom: t('fn2.br.k.showroom'), workshop: t('fn2.br.k.workshop'), store: t('fn2.br.k.store') }; %>

<h1 class="text-2xl font-black text-stone-900 mb-1">🏬 <%= t('fn2.flag.branches') %></h1>
<p class="text-stone-500 mb-3 text-sm"><%= t('fn2.br.sub') %></p>

<%# The line has to be stated, not discovered. An owner who thinks stock is
    per-branch will spend a week wondering where the transfer screen is. %>
<p class="text-xs text-stone-600 bg-stone-100 border border-stone-200 rounded-2xl px-4 py-2.5 mb-5"><%= t('fn2.br.rule') %></p>

<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('fn2.m.saved') %></div><% } %>
<% if (err) { %><div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-red-800"><%= t('fn2.m.required') %></div><% } %>

<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.br.new') %></h2>
  <form method="post" action="/furniture/branches" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
    <label class="text-xs font-bold text-stone-600"><%= t('fn2.f.name') %>
      <input name="name" maxlength="120" required class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
    </label>
    <label class="text-xs font-bold text-stone-600"><%= t('fn2.br.kind') %>
      <select name="kind" class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm bg-white">
        <% kinds.forEach(function(k){ %><option value="<%= k %>"><%= KIND[k] %></option><% }); %>
      </select>
    </label>
    <label class="text-xs font-bold text-stone-600"><%= t('fn2.f.address') %>
      <input name="address" maxlength="200" class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
    </label>
    <label class="text-xs font-bold text-stone-600"><%= t('fn2.f.phone') %>
      <input name="phone" maxlength="30" class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
    </label>
    <button class="bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl px-6 py-2 text-sm justify-self-start"><%= t('fn2.m.add') %></button>
  </form>
</div>

<% if (!branches.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-sm text-stone-500"><%= t('fn2.br.empty') %></div>
<% } else { %>
<div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-5">
  <div class="divide-y divide-stone-100">
    <% branches.forEach(function(b){ %>
    <div class="px-5 py-3 flex flex-wrap items-center gap-3 text-sm <%= b.is_active ? '' : 'opacity-50' %>">
      <span class="font-bold text-stone-900"><%= b.name %></span>
      <span class="text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded-full"><%= KIND[b.kind] || b.kind %></span>
      <% if (b.address) { %><span class="text-xs text-stone-400">📍 <%= b.address %></span><% } %>
      <% if (b.phone) { %><span class="text-xs text-stone-400" dir="ltr">📞 <%= b.phone %></span><% } %>
      <form method="post" action="/furniture/branches/<%= b.id %>/archive" class="ms-auto">
        <input type="hidden" name="restore" value="<%= b.is_active ? '0' : '1' %>" />
        <button class="text-xs font-semibold <%= b.is_active ? 'text-stone-400 hover:text-red-600' : 'text-emerald-700' %>">
          <%= b.is_active ? t('fn2.m.archive') : t('fn2.m.restore') %>
        </button>
      </form>
    </div>
    <% }); %>
  </div>
</div>

<%# Named explicitly so nobody has to guess which numbers the switch moves. %>
<div class="bg-white rounded-2xl shadow-sm p-5">
  <h2 class="font-bold text-stone-800 mb-2 text-sm"><%= t('fn2.br.scoped_title') %></h2>
  <div class="flex flex-wrap gap-1.5 text-xs mb-3">
    <% scoped.forEach(function(tb){ %>
      <span class="bg-brand-50 text-brand-700 rounded-lg px-2 py-1 font-mono"><%= tb.replace('furniture_','') %></span>
    <% }); %>
  </div>
  <p class="text-xs text-stone-400"><%= t('fn2.br.shared_note') %></p>
</div>
<% } %>

</main></body></html>
