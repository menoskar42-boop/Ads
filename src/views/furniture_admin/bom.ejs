<%- include('head', { title: t('fn2.flag.bom'), tab: 'bom' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
%>

<h1 class="text-2xl font-black text-stone-900 mb-1">🪚 <%= t('fn2.flag.bom') %></h1>
<p class="text-stone-500 mb-2 text-sm"><%= t('fn2.bom.sub') %></p>
<%# Said once, at the top, and again on every product: material cost is not
    total cost. A workshop reading this as profit would price at a loss. %>
<p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-2xl px-4 py-2.5 mb-5"><%= t('fn2.bom.not_profit') %></p>

<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('fn2.m.saved') %></div><% } %>

<% if (!products.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-sm text-stone-500"><%= t('fn2.sa.no_products') %></div>
<% } else { %>
<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm rt">
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.sa.product') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.bom.components') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.bom.material_cost') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.f.selling_price') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.bom.margin') %></th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% products.forEach(function(p){ %>
        <tr class="<%= p.margin < 0 ? 'bg-red-50/50' : '' %>">
          <td class="px-4 py-2 font-semibold text-stone-800" data-l="<%= t('fn2.sa.product') %>">
            <a href="/furniture/bom/<%= p.id %>" class="text-brand-700 hover:underline"><%= p.name %></a>
            <% if (p.category) { %><span class="text-xs text-stone-400"> · <%= p.category %></span><% } %>
          </td>
          <td class="px-4 py-2" data-l="<%= t('fn2.bom.components') %>">
            <% if (p.component_count) { %>
              <%= p.component_count %>
              <% if (p.unknown_count) { %>
                <span class="text-[10px] font-bold bg-red-100 text-red-700 rounded px-1.5 py-0.5 ms-1"><%= t('fn2.bom.unknown_badge') %></span>
              <% } %>
            <% } else { %>
              <span class="text-xs text-stone-400"><%= t('fn2.bom.none') %></span>
            <% } %>
          </td>
          <td class="px-4 py-2" data-l="<%= t('fn2.bom.material_cost') %>">
            <%= money(p.cost) %>
            <%# Say which number this is. A typed estimate and a computed cost
                look identical in a column and mean very different things. %>
            <span class="text-[10px] text-stone-400"><%= p.costed ? t('fn2.bom.computed') : t('fn2.bom.estimated') %></span>
          </td>
          <td class="px-4 py-2" data-l="<%= t('fn2.f.selling_price') %>"><%= money(p.price) %></td>
          <td class="px-4 py-2 font-bold <%= p.margin < 0 ? 'text-red-700' : 'text-emerald-700' %>" data-l="<%= t('fn2.bom.margin') %>">
            <%= money(p.margin) %><% if (p.percent != null) { %> <span class="text-xs font-normal">(<%= p.percent %>%)</span><% } %>
          </td>
          <td class="px-4 py-2">
            <a href="/furniture/bom/<%= p.id %>" class="text-xs px-2.5 py-1 rounded-lg border border-stone-200 hover:bg-stone-50"><%= t('fn2.bom.edit') %></a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

</main></body></html>
