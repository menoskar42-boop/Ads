<%- include('head', { title: t('fn2.sa.one') + ' #' + sale.id, tab: 'sales' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  function fmtD(v){ if(!v) return '—'; try { return new Date(v).toLocaleDateString(LOC,{year:'numeric',month:'short',day:'numeric'}); } catch(e){ return '—'; } }
  var SB = { open:'bg-amber-100 text-amber-800', paid:'bg-emerald-100 text-emerald-800', cancelled:'bg-red-50 text-red-600' };
  var ML = { cash:t('pm.cash'), card:t('pm.card'), transfer:t('pm.transfer') };
  var live = sale.status !== 'cancelled';
%>

<div class="flex items-center gap-3 mb-1 flex-wrap">
  <a href="/furniture/sales" class="text-stone-400 hover:text-stone-600 text-sm">← <%= t('fn2.flag.sales') %></a>
  <h1 class="text-2xl font-black text-stone-900"><%= t('fn2.sa.one') %> #<%= sale.id %></h1>
  <span class="text-xs font-semibold px-2 py-1 rounded-full <%= SB[sale.status] %>"><%= t('fn2.sa.st.' + sale.status) %></span>
  <button onclick="window.print()" class="no-print ms-auto text-xs bg-stone-100 hover:bg-stone-200 rounded-xl px-4 py-2 font-bold"><%= t('iv.print') %></button>
</div>
<p class="text-stone-500 mb-5 text-sm">
  <% if (sale.customer_id) { %>
    <a href="/furniture/sales/statement/<%= sale.customer_id %>" class="text-brand-700 hover:underline"><%= sale.customer_name %></a>
  <% } else { %><%= t('iv.no_patient') %><% } %>
  · <%= fmtD(sale.sale_date) %>
</p>

<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('fn2.m.saved') %></div><% } %>
<% if (err) { %><div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-red-800"><%= t('fn2.sa.err.' + err) %></div><% } %>

<style>
  @media print {
    header, nav, .no-print, form { display: none !important; }
    body { background: #fff !important; }
    main { max-width: 100% !important; padding: 0 !important; }
  }
</style>

<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <div class="overflow-x-auto">
    <table class="w-full text-sm rt">
      <thead class="text-xs text-stone-500 border-b border-stone-100">
        <tr>
          <th class="text-start py-2 font-medium"><%= t('iv.c.item') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.qty') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.price') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.total') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-50">
        <% items.forEach(function(it){ %>
        <tr>
          <%# اسم الخيار متسجّل على السطر نفسه، فحتى لو الخيار اتشال من
              الكتالوج الفاتورة تفضل تقول اتباع إيه. %>
          <td class="py-2.5" data-l="<%= t('iv.c.item') %>"><%= it.product_name || '—' %><% if (it.variant_name) { %>
            <span class="text-xs text-stone-500">— <%= it.variant_name %></span><% } %></td>
          <td class="py-2.5" data-l="<%= t('iv.c.qty') %>"><%= it.qty %></td>
          <td class="py-2.5" data-l="<%= t('iv.c.price') %>"><%= money(it.unit_price) %></td>
          <td class="py-2.5 font-bold" data-l="<%= t('iv.c.total') %>"><%= money(it.total) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 pt-3 border-t border-stone-100 space-y-1 text-sm max-w-sm ms-auto">
    <div class="flex justify-between text-stone-500"><span><%= t('iv.subtotal') %></span><span><%= money(sale.subtotal) %> <%= t('cur.egp') %></span></div>
    <%# The tax line only appears when the showroom actually charges tax. %>
    <% if (Number(sale.tax) > 0) { %>
      <div class="flex justify-between text-stone-500"><span><%= t('fn2.set.tax') %></span><span><%= money(sale.tax) %> <%= t('cur.egp') %></span></div>
    <% } %>
    <div class="flex justify-between font-black text-stone-900 text-base"><span><%= t('iv.grand_total') %></span><span><%= money(sale.total) %> <%= t('cur.egp') %></span></div>
    <div class="flex justify-between text-emerald-700"><span><%= t('iv.paid') %></span><span><%= money(sale.paid) %> <%= t('cur.egp') %></span></div>
    <% if (due > 0) { %>
      <div class="flex justify-between text-amber-700 font-bold"><span><%= t('iv.due') %></span><span><%= money(due) %> <%= t('cur.egp') %></span></div>
    <% } else if (Number(sale.paid) > Number(sale.total)) { %>
      <%# Paid more than the invoice: that is credit on the account, and saying
          so beats showing a zero the showroom cannot explain to the customer. %>
      <div class="flex justify-between text-emerald-700 font-bold">
        <span><%= t('fn2.sa.credit') %></span><span><%= money(Number(sale.paid) - Number(sale.total)) %> <%= t('cur.egp') %></span>
      </div>
    <% } %>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-5">
  <% if (live) { %>
  <div class="bg-white rounded-2xl shadow-sm p-5 no-print">
    <h2 class="font-bold text-stone-800 mb-1"><%= t('fn2.sa.take_payment') %></h2>
    <p class="text-xs text-stone-500 mb-3"><%= t('fn2.sa.pay_hint') %></p>
    <form method="post" action="/furniture/sales/pay" class="flex flex-wrap gap-2 items-end">
      <input type="hidden" name="sale_id" value="<%= sale.id %>" />
      <input type="hidden" name="customer_id" value="<%= sale.customer_id || '' %>" />
      <label class="text-xs font-bold text-stone-600 flex-1 min-w-[110px]"><%= t('fn2.po.pay_amount') %>
        <input name="amount" type="number" min="0" <%- 'step="0.01"' %> value="<%= due > 0 ? due : '' %>"
               class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
      </label>
      <label class="text-xs font-bold text-stone-600"><%= t('fn2.sa.method') %>
        <select name="method" class="mt-1 border border-stone-200 rounded-xl px-3 py-2 text-sm bg-white">
          <option value="cash"><%= t('pm.cash') %></option>
          <option value="card"><%= t('pm.card') %></option>
          <option value="transfer"><%= t('pm.transfer') %></option>
        </select>
      </label>
      <label class="text-xs font-bold text-stone-600"><%= t('fn2.po.pay_date') %>
        <input name="pay_date" type="date" class="mt-1 border border-stone-200 rounded-xl px-3 py-2 text-sm" />
      </label>
      <button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-5 py-2 text-sm"><%= t('fn2.po.pay') %></button>
    </form>
  </div>
  <% } %>

  <div class="bg-white rounded-2xl shadow-sm p-5">
    <h2 class="font-bold text-stone-800 mb-3"><%= t('iv.payments_log') %></h2>
    <% if (!payments.length) { %>
      <p class="text-sm text-stone-500"><%= t('fn2.po.no_payments') %></p>
    <% } else { %>
    <div class="divide-y divide-stone-100 text-sm">
      <% payments.forEach(function(p){ %>
      <div class="flex items-center gap-2 py-2">
        <span class="text-stone-500 text-xs"><%= fmtD(p.pay_date) %></span>
        <span class="text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded-full"><%= ML[p.method] || p.method %></span>
        <% if (p.note) { %><span class="text-stone-400 text-xs truncate"><%= p.note %></span><% } %>
        <span class="font-bold text-stone-800 ms-auto"><%= money(p.amount) %> <%= t('cur.egp') %></span>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

<%# ── لينك متابعة الطلب ─────────────────────────────────────────────────
    مابيتولدش لوحده: التاجر هو اللي بيقرّر يدّي العميل لينك. وبمجرد ما
    يتعمل بيفضل هو هو، فاللينك اللي راح على الواتس مايبطّلش يشتغل. %>
<div class="bg-white rounded-2xl shadow-sm p-5 mb-5 no-print">
  <h2 class="font-bold text-stone-800 mb-2"><%= t('fn2.tk.title') %></h2>
  <% if (!trackUrl) { %>
    <p class="text-sm text-stone-500 mb-3"><%= t('fn2.tk.hint') %></p>
    <form method="post" action="/furniture/sales/<%= sale.id %>/track">
      <button class="text-xs font-bold px-3 py-1.5 rounded-xl bg-stone-800 text-white"><%= t('fn2.tk.make') %></button>
    </form>
  <% } else { %>
    <input value="<%= trackUrl %>" readonly dir="ltr" onclick="this.select()"
           class="w-full border border-stone-200 rounded-xl px-3 py-2 text-xs bg-stone-50" />
    <%# واتساب بضغطة من التاجر — مفيش إرسال تلقائي، والجملة بتقول كده. %>
    <% if (sale.customer_phone) { %>
      <a href="https://wa.me/<%= String(sale.customer_phone).replace(/[^0-9]/g, '') %>?text=<%= encodeURIComponent(t('fn2.tk.wa_text') + ' ' + trackUrl) %>"
         target="_blank" rel="noopener"
         class="inline-block mt-2 text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700"><%= t('fn2.tk.wa') %></a>
    <% } %>
    <p class="text-[11px] text-stone-400 mt-2"><%= t('fn2.tk.note') %></p>
  <% } %>
</div>

<% if (deliveries && deliveries.length) { %>
<div class="bg-white rounded-2xl shadow-sm p-5 mt-5">
  <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.flag.delivery') %></h2>
  <div class="divide-y divide-stone-100 text-sm">
    <% deliveries.forEach(function(j){ %>
    <div class="flex flex-wrap items-center gap-2 py-2">
      <span><%= j.kind === 'install' ? '🔧' : '🚚' %></span>
      <span class="text-stone-800"><%= t('fn2.dl.k.' + j.kind) %></span>
      <span class="text-xs text-stone-400"><%= fmtD(j.scheduled_date) %></span>
      <% if (j.crew) { %><span class="text-xs text-stone-400">👷 <%= j.crew %></span><% } %>
      <span class="ms-auto text-xs font-semibold px-2 py-0.5 rounded-full
        <%= j.status === 'done' ? 'bg-emerald-100 text-emerald-800' : (j.status === 'failed' ? 'bg-red-100 text-red-800' : 'bg-stone-100 text-stone-700') %>">
        <%= t('fn2.dl.st.' + j.status) %>
      </span>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<% if (warranties && warranties.length) { %>
<div class="bg-white rounded-2xl shadow-sm p-5 mt-5">
  <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.flag.warranty') %></h2>
  <div class="divide-y divide-stone-100 text-sm">
    <% warranties.forEach(function(w){ %>
    <div class="flex flex-wrap items-center gap-2 py-2">
      <span>🛡️</span>
      <span class="text-stone-800"><%= w.product_name || '—' %></span>
      <span class="text-xs text-stone-400"><%= w.months %> <%= t('fn2.wr.months') %></span>
      <span class="ms-auto text-xs text-stone-500">
        <%= w.expiresOn ? t('fn2.wr.expires') + ' ' + fmtD(w.expiresOn) : t('fn2.wr.st.' + w.state) %>
      </span>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<% if (live) { %>
<form method="post" action="/furniture/sales/<%= sale.id %>/cancel" class="mt-5 no-print"
      onsubmit="return confirm(<%= JSON.stringify(t('fn2.sa.cancel_confirm')) %>)">
  <button class="text-sm text-red-600 hover:text-red-700 font-semibold"><%= t('fn2.sa.cancel') %></button>
</form>
<% } %>

</main></body></html>
