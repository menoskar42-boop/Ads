<%- include('head', { title: t('fn2.flag.activity'), tab: 'activity' }) %>
<%
  function fmtT(v){
    if(!v) return '—';
    try { return new Date(v).toLocaleString(LOC, {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}); }
    catch(e){ return '—'; }
  }
  // An action the code logs but this build has no wording for still has to read
  // as something. The raw key beats an empty cell — it says what happened.
  function actionLabel(a){ var k = 'fn2.act.a.' + a; var v = t(k); return v === k ? a : v; }
  function entityLabel(e){ if(!e) return '—'; var k = 'fn2.act.e.' + e; var v = t(k); return v === k ? e : v; }
  var TONE = {
    'sale.cancel':'text-red-700', 'purchase.cancel':'text-red-700',
    'master.delete':'text-red-700', 'expense.delete':'text-red-700',
    'delivery.status':'text-blue-700', 'payroll.run':'text-amber-700',
    'return.create':'text-amber-700', 'refund.pay':'text-amber-700',
  };
  function q(extra){
    var p = [];
    if (entity) p.push('entity=' + entity);
    if (extra != null) p.push('offset=' + extra);
    return p.length ? '?' + p.join('&') : '';
  }
%>

<h1 class="text-2xl font-black text-stone-900 mb-1">🕵️ <%= t('fn2.flag.activity') %></h1>
<p class="text-stone-500 mb-4 text-sm"><%= t('fn2.act.sub') %></p>
<p class="text-xs text-stone-500 bg-stone-100 border border-stone-200 rounded-2xl px-4 py-2.5 mb-5"><%= t('fn2.act.readonly') %></p>

<div class="flex gap-1.5 mb-4 text-xs flex-wrap">
  <a href="/furniture/activity" class="px-3 py-1.5 rounded-lg <%= !entity ? 'bg-stone-800 text-white font-bold' : 'bg-white border border-stone-200' %>"><%= t('iv.all') %></a>
  <% entities.forEach(function(e){ %>
    <a href="/furniture/activity?entity=<%= e %>" class="px-3 py-1.5 rounded-lg <%= entity === e ? 'bg-stone-800 text-white font-bold' : 'bg-white border border-stone-200' %>"><%= entityLabel(e) %></a>
  <% }); %>
</div>

<% if (!rows.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-sm text-stone-500"><%= t('fn2.act.empty') %></div>
<% } else { %>
<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm rt">
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.act.when') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.act.who') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.act.what') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.act.detail') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% rows.forEach(function(r){ %>
        <tr>
          <td class="px-4 py-2 text-xs text-stone-500 whitespace-nowrap" data-l="<%= t('fn2.act.when') %>"><%= fmtT(r.created_at) %></td>
          <td class="px-4 py-2 font-semibold text-stone-800" data-l="<%= t('fn2.act.who') %>"><%= r.actor %></td>
          <td class="px-4 py-2 <%= TONE[r.action] || 'text-stone-700' %>" data-l="<%= t('fn2.act.what') %>"><%= actionLabel(r.action) %></td>
          <td class="px-4 py-2 text-xs text-stone-500" data-l="<%= t('fn2.act.detail') %>"><%= r.detail || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex gap-2 mt-4 text-sm">
  <% if (offset > 0) { %>
    <a href="/furniture/activity<%= q(Math.max(0, offset - limit)) %>" class="px-4 py-2 rounded-xl bg-white border border-stone-200 font-semibold"><%= t('fn2.act.newer') %></a>
  <% } %>
  <%# The link only appears when a row past this page actually exists — see
      the extra row `recent()` fetches. A dead "more" button is a small lie. %>
  <% if (more) { %>
    <a href="/furniture/activity<%= q(offset + limit) %>" class="px-4 py-2 rounded-xl bg-white border border-stone-200 font-semibold ms-auto"><%= t('fn2.act.older') %></a>
  <% } %>
</div>
<% } %>

</main></body></html>
