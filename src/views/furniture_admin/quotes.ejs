<%- include('head', { title: t('fn2.flag.quotes'), tab: 'quotes' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  function fmtD(v){ if(!v) return '—'; try { return new Date(v).toLocaleDateString(LOC,{year:'numeric',month:'short',day:'numeric'}); } catch(e){ return '—'; } }
  var QB = { draft:'bg-stone-100 text-stone-700', sent:'bg-sky-100 text-sky-800',
             expired:'bg-amber-100 text-amber-800', accepted:'bg-emerald-100 text-emerald-800',
             rejected:'bg-red-50 text-red-600 line-through' };
  var LB = { new:'bg-sky-100 text-sky-800', quoted:'bg-amber-100 text-amber-800',
             won:'bg-emerald-100 text-emerald-800', lost:'bg-stone-100 text-stone-500' };
%>

<h1 class="text-2xl font-black text-stone-900 mb-1">📝 <%= t('fn2.flag.quotes') %></h1>
<p class="text-stone-500 mb-5 text-sm"><%= t('fn2.q.sub') %></p>

<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('fn2.m.saved') %></div><% } %>
<% if (err) { %><div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-red-800"><%= t('fn2.q.err.' + err) %></div><% } %>

<div class="grid lg:grid-cols-2 gap-5">

  <!-- ── اللي سأل ─────────────────────────────────────────────── -->
  <div>
    <div class="bg-white rounded-2xl shadow-sm p-5 mb-4">
      <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.q.lead_new') %></h2>
      <form method="post" action="/furniture/quotes/leads" class="grid sm:grid-cols-2 gap-3">
        <input name="name" maxlength="120" required placeholder="<%= t('fn2.q.name') %>"
               class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
        <input name="phone" maxlength="30" dir="ltr" placeholder="<%= t('fn2.q.phone') %>"
               class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
        <select name="source" class="border border-stone-200 rounded-xl px-3 py-2 text-sm">
          <% sources.forEach(function(sr){ %><option value="<%= sr %>"><%= t('fn2.q.src.' + sr) %></option><% }); %>
        </select>
        <input name="interest" maxlength="200" placeholder="<%= t('fn2.q.interest') %>"
               class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
        <button class="bg-stone-800 text-white font-bold rounded-xl px-5 py-2 text-sm sm:col-span-2"><%= t('fn2.q.lead_add') %></button>
      </form>
    </div>

    <% if (!leads.length) { %>
      <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-stone-400 text-sm"><%= t('fn2.q.no_leads') %></div>
    <% } %>
    <% leads.forEach(function(l){ %>
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-2">
        <div class="flex items-center justify-between gap-2">
          <div>
            <div class="font-bold text-stone-800"><%= l.name %></div>
            <div class="text-xs text-stone-400" dir="ltr"><%= l.phone || '' %></div>
            <% if (l.interest) { %><div class="text-xs text-stone-500 mt-0.5"><%= l.interest %></div><% } %>
          </div>
          <span class="text-xs rounded-full px-2 py-0.5 <%= LB[l.status] || 'bg-stone-100' %>"><%= t('fn2.q.lead.' + l.status) %></span>
        </div>
        <form method="post" action="/furniture/quotes/leads/<%= l.id %>/status" class="flex gap-2 mt-2">
          <select name="status" class="border border-stone-200 rounded-lg px-2 py-1 text-xs">
            <% leadStatuses.forEach(function(st){ %><option value="<%= st %>" <%= l.status===st?'selected':'' %>><%= t('fn2.q.lead.' + st) %></option><% }); %>
          </select>
          <button class="text-xs font-bold text-stone-500 hover:text-stone-800"><%= t('fn2.q.update') %></button>
        </form>
      </div>
    <% }); %>
  </div>

  <!-- ── عروض الأسعار ─────────────────────────────────────────── -->
  <div>
    <div class="bg-white rounded-2xl shadow-sm p-5 mb-4">
      <h2 class="font-bold text-stone-800 mb-3"><%= t('fn2.q.new') %></h2>
      <% if (!products.length) { %>
        <p class="text-sm text-stone-500"><%= t('fn2.sa.no_products') %></p>
      <% } else { %>
      <form method="post" action="/furniture/quotes" class="grid gap-3">
        <div class="grid sm:grid-cols-3 gap-3">
          <select name="lead_id" class="border border-stone-200 rounded-xl px-3 py-2 text-sm">
            <option value=""><%= t('fn2.q.pick_lead') %></option>
            <% leads.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %>
          </select>
          <select name="customer_id" class="border border-stone-200 rounded-xl px-3 py-2 text-sm">
            <option value=""><%= t('fn2.q.pick_customer') %></option>
            <% customers.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
          </select>
          <label class="text-xs font-bold text-stone-600"><%= t('fn2.q.valid_until') %>
            <input type="date" name="valid_until" value="<%= defaultValid %>"
                   class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
          </label>
        </div>

        <% for (var i = 0; i < 3; i++) { %>
        <div class="grid sm:grid-cols-4 gap-2">
          <select name="product_id" class="border border-stone-200 rounded-xl px-3 py-2 text-sm">
            <option value=""><%= t('fn2.q.line_product') %></option>
            <% products.forEach(function(p){ %><option value="<%= p.id %>" data-price="<%= p.selling_price %>"><%= p.name %></option><% }); %>
          </select>
          <input name="line_name" maxlength="120" placeholder="<%= t('fn2.q.line_name') %>"
                 class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
          <input name="qty" inputmode="decimal" placeholder="<%= t('fn2.q.qty') %>"
                 class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
          <input name="unit_price" inputmode="decimal" placeholder="<%= t('fn2.q.price') %>"
                 class="border border-stone-200 rounded-xl px-3 py-2 text-sm" />
        </div>
        <% } %>

        <p class="text-xs text-stone-400"><%= t('fn2.q.tax_note').replace('%s', taxPercent) %></p>
        <button class="bg-stone-800 text-white font-bold rounded-xl px-6 py-2.5 text-sm w-fit"><%= t('fn2.q.send') %></button>
      </form>
      <% } %>
    </div>

    <% if (!quotes.length) { %>
      <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-stone-400 text-sm"><%= t('fn2.q.no_quotes') %></div>
    <% } %>
    <% quotes.forEach(function(q){ var st = q.state.state; %>
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-2">
        <div class="flex items-center justify-between gap-2 mb-1">
          <div class="font-bold text-stone-800">#<%= q.id %> · <%= q.lead_name || '—' %></div>
          <span class="text-xs rounded-full px-2 py-0.5 <%= QB[st] || 'bg-stone-100' %>">
            <%= t('fn2.q.state.' + st) %><% if (st === 'sent' && q.state.daysLeft != null) { %> · <%= t('fn2.q.days').replace('%s', q.state.daysLeft) %><% } %>
          </span>
        </div>
        <div class="text-sm text-stone-600"><%= money(q.total) %> <%= cur(company) %></div>
        <div class="text-xs text-stone-400"><%= fmtD(q.quote_date) %><%= q.valid_until ? (' → ' + fmtD(q.valid_until)) : '' %></div>

        <div class="flex gap-2 mt-2">
          <% if (st === 'sent' || st === 'draft') { %>
            <form method="post" action="/furniture/quotes/<%= q.id %>/accept">
              <button class="text-xs bg-emerald-600 text-white font-bold rounded-lg px-3 py-1.5"><%= t('fn2.q.accept') %></button>
            </form>
            <form method="post" action="/furniture/quotes/<%= q.id %>/reject">
              <button class="text-xs text-stone-500 hover:text-red-600 font-bold px-2"><%= t('fn2.q.reject') %></button>
            </form>
          <% } else if (st === 'accepted' && q.sale_id) { %>
            <a href="/furniture/sales/<%= q.sale_id %>" class="text-xs font-bold text-stone-600 underline"><%= t('fn2.q.see_invoice') %> #<%= q.sale_id %></a>
          <% } else if (st === 'expired') { %>
            <span class="text-xs text-stone-400"><%= t('fn2.q.expired_hint') %></span>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

</main></body></html>
