<%- include('head', { title: t('fn2.rt.one') + ' #' + ret.id, tab: 'returns' }) %>
<%
  function money(v){ return Number(v||0).toLocaleString(LOC, {maximumFractionDigits:2}); }
  function fmtD(v){ if(!v) return '—'; try { return new Date(v).toLocaleDateString(LOC,{year:'numeric',month:'short',day:'numeric'}); } catch(e){ return '—'; } }
%>

<div class="flex items-center gap-3 mb-1 flex-wrap">
  <a href="/furniture/returns" class="text-stone-400 hover:text-stone-600 text-sm">← <%= t('fn2.flag.returns') %></a>
  <h1 class="text-2xl font-black text-stone-900"><%= t('fn2.rt.one') %> #<%= ret.id %></h1>
  <button onclick="window.print()" class="no-print ms-auto text-xs bg-stone-100 hover:bg-stone-200 rounded-xl px-4 py-2 font-bold"><%= t('iv.print') %></button>
</div>
<p class="text-stone-500 mb-5 text-sm">
  <% if (ret.customer_id) { %>
    <a href="/furniture/sales/statement/<%= ret.customer_id %>" class="text-brand-700 hover:underline"><%= ret.customer_name %></a>
  <% } else { %><%= t('iv.no_patient') %><% } %>
  · <%= fmtD(ret.return_date) %>
  <% if (ret.sale_id) { %>
    · <a href="/furniture/sales/<%= ret.sale_id %>" class="text-brand-700 hover:underline"><%= t('fn2.rt.against') %> #<%= ret.sale_id %></a>
  <% } %>
</p>

<% if (saved) { %><div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-emerald-800"><%= t('fn2.m.saved') %></div><% } %>
<% if (err) { %><div class="bg-red-50 border border-red-200 rounded-2xl px-4 py-2.5 mb-4 text-sm text-red-800"><%= t('fn2.rt.err.' + err) %></div><% } %>

<style>
  @media print {
    header, nav, .no-print, form { display: none !important; }
    body { background: #fff !important; }
    main { max-width: 100% !important; padding: 0 !important; }
  }
</style>

<div class="bg-white rounded-2xl shadow-sm p-5 mb-5">
  <div class="overflow-x-auto">
    <table class="w-full text-sm rt">
      <thead class="text-xs text-stone-500 border-b border-stone-100">
        <tr>
          <th class="text-start py-2 font-medium"><%= t('iv.c.item') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.qty') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.price') %></th>
          <th class="text-start py-2 font-medium"><%= t('iv.c.total') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-50">
        <% items.forEach(function(it){ %>
        <tr>
          <td class="py-2.5" data-l="<%= t('iv.c.item') %>"><%= it.product_name || '—' %></td>
          <td class="py-2.5" data-l="<%= t('iv.c.qty') %>"><%= it.qty %></td>
          <td class="py-2.5" data-l="<%= t('iv.c.price') %>"><%= money(it.unit_price) %></td>
          <td class="py-2.5 font-bold" data-l="<%= t('iv.c.total') %>"><%= money(it.total) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 pt-3 border-t border-stone-100 space-y-1 text-sm max-w-sm ms-auto">
    <div class="flex justify-between font-black text-stone-900 text-base"><span><%= t('fn2.rt.credit') %></span><span><%= money(ret.total) %> <%= t('cur.egp') %></span></div>
    <div class="flex justify-between text-emerald-700"><span><%= t('fn2.rt.refunded') %></span><span><%= money(ret.refunded) %> <%= t('cur.egp') %></span></div>
    <% if (outstanding > 0) { %>
      <div class="flex justify-between text-amber-700 font-bold"><span><%= t('fn2.rt.outstanding') %></span><span><%= money(outstanding) %> <%= t('cur.egp') %></span></div>
    <% } %>
  </div>
  <% if (ret.reason || ret.note) { %>
    <p class="mt-3 text-xs text-stone-500"><%= [ret.reason, ret.note].filter(Boolean).join(' · ') %></p>
  <% } %>
</div>

<% if (outstanding > 0) { %>
<div class="bg-white rounded-2xl shadow-sm p-5 no-print">
  <h2 class="font-bold text-stone-800 mb-1"><%= t('fn2.rt.pay_out') %></h2>
  <p class="text-xs text-stone-500 mb-3"><%= t('fn2.rt.pay_out_hint') %></p>
  <form method="post" action="/furniture/returns/<%= ret.id %>/refund" class="flex flex-wrap gap-2 items-end">
    <label class="text-xs font-bold text-stone-600 flex-1 min-w-[110px]"><%= t('fn2.po.pay_amount') %>
      <input name="amount" type="number" min="0" max="<%= outstanding %>" <%- 'step="0.01"' %> value="<%= outstanding %>"
             class="mt-1 w-full border border-stone-200 rounded-xl px-3 py-2 text-sm" />
    </label>
    <button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-5 py-2 text-sm"><%= t('fn2.rt.pay_out') %></button>
  </form>
</div>
<% } else { %>
  <p class="text-sm text-stone-500"><%= t('fn2.rt.fully_refunded') %></p>
<% } %>

</main></body></html>
