<%- include('head', { title: t('fn2.flag.warranty'), tab: 'warranty' }) %>
<%
  function fmtD(v){ if(!v) return '—'; try { return new Date(v).toLocaleDateString(LOC,{year:'numeric',month:'short',day:'numeric'}); } catch(e){ return '—'; } }
  var ST = {
    active: 'bg-emerald-100 text-emerald-800', expiring: 'bg-amber-100 text-amber-800',
    expired: 'bg-stone-200 text-stone-600', not_started: 'bg-blue-100 text-blue-800',
    none: 'bg-stone-100 text-stone-500'
  };
%>

<h1 class="text-2xl font-black text-stone-900 mb-1">🛡️ <%= t('fn2.flag.warranty') %></h1>
<p class="text-stone-500 mb-3 text-sm"><%= t('fn2.wr.sub') %></p>
<p class="text-xs text-stone-600 bg-stone-100 border border-stone-200 rounded-2xl px-4 py-2.5 mb-5"><%= t('fn2.wr.rule') %></p>

<div class="flex gap-1.5 mb-4 text-xs flex-wrap">
  <% views.forEach(function(v){ %>
    <a href="/furniture/warranty?view=<%= v %>"
       class="px-3 py-1.5 rounded-lg <%= view === v ? 'bg-stone-800 text-white font-bold' : 'bg-white border border-stone-200' %>">
      <%= v === 'all' ? t('iv.all') : t('fn2.wr.st.' + v) %><% if (tally[v]) { %> <span class="opacity-60"><%= tally[v] %></span><% } %>
    </a>
  <% }); %>
</div>

<% if (!rows.length) { %>
  <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-sm text-stone-500"><%= total ? t('fn2.wr.none_in_view') : t('fn2.wr.empty') %></div>
<% } else { %>
<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm rt">
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.sa.product') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.sa.customer') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.wr.months') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.wr.starts') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('fn2.wr.expires') %></th>
          <th class="text-start px-4 py-2 font-semibold"><%= t('common.status') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% rows.forEach(function(w){ %>
        <tr>
          <td class="px-4 py-2 font-semibold text-stone-800" data-l="<%= t('fn2.sa.product') %>">
            <%= w.product_name || '—' %>
            <% if (w.sale_id) { %><a href="/furniture/sales/<%= w.sale_id %>" class="text-xs text-brand-700 hover:underline ms-1">#<%= w.sale_id %></a><% } %>
          </td>
          <td class="px-4 py-2" data-l="<%= t('fn2.sa.customer') %>"><%= w.customer_name || '—' %></td>
          <td class="px-4 py-2 text-stone-600" data-l="<%= t('fn2.wr.months') %>"><%= w.months %></td>
          <td class="px-4 py-2 text-stone-600" data-l="<%= t('fn2.wr.starts') %>">
            <% if (w.starts_on) { %><%= fmtD(w.starts_on) %><% } else { %>
              <%# No delivery yet, so no start date to show. The form is the only
                  way to begin the clock for a piece collected from the showroom. %>
              <form method="post" action="/furniture/warranty/<%= w.id %>/start" class="flex gap-1 items-center">
                <input type="date" name="starts_on" class="border border-stone-200 rounded-xl px-2 py-1 text-xs" />
                <button class="text-xs font-bold px-2 py-1 rounded-xl bg-brand-50 text-brand-700 hover:bg-brand-100"><%= t('fn2.wr.start_now') %></button>
              </form>
            <% } %>
          </td>
          <td class="px-4 py-2 <%= w.state === 'expiring' ? 'text-amber-700 font-bold' : 'text-stone-600' %>" data-l="<%= t('fn2.wr.expires') %>">
            <%= w.expiresOn ? fmtD(w.expiresOn) : '—' %>
            <% if (w.state === 'expiring') { %><span class="text-xs">· <%= w.daysLeft %> <%= t('fn2.wr.days_left') %></span><% } %>
          </td>
          <td class="px-4 py-2" data-l="<%= t('common.status') %>">
            <span class="text-xs font-semibold px-2 py-1 rounded-full <%= ST[w.state] %>"><%= t('fn2.wr.st.' + w.state) %></span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

</main></body></html>
