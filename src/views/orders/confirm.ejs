<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<%
  var __theme = company.theme_color || '#e8734a';
  var __cur = t('pharmacy.currency');
  function __money(v){ var n=Number(v); if(!isFinite(n)) return '0'; return n.toLocaleString(lang==='ar'?'ar-EG':'en-US',{maximumFractionDigits:2}); }
  var __sub = (items||[]).reduce(function(s,it){ return s + Number(it.price)*Number(it.quantity); }, 0);
%>
<title><%= t('orders.order_placed') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>
  * { font-family: 'Cairo', sans-serif; }
  :root{ --accent: <%= __theme %>; } .accent-bg{background:var(--accent)} .accent-text{color:var(--accent)} body{background:#faf8f4;color:#182a27}
  .stars { display:inline-flex; flex-direction:row-reverse; }
  .stars input { display:none; }
  .stars label { color:#d1d5db; font-size:2rem; cursor:pointer; padding:0 2px; }
  .stars label:hover, .stars label:hover ~ label, .stars input:checked ~ label { color:#f59e0b; }
</style>
</head>
<body class="antialiased">
<main class="max-w-md mx-auto px-4 py-10">
  <div class="text-center mb-6">
    <div class="mx-auto grid place-items-center h-16 w-16 rounded-full bg-green-100 text-green-600 mb-3 text-3xl">✓</div>
    <h1 class="text-2xl font-extrabold"><%= t('orders.order_placed') %></h1>
    <p class="text-sm text-gray-500 mt-1"><%= t('orders.thanks') %></p>
    <p class="mt-2 text-sm"><%= t('orders.order_number') %>: <span class="font-extrabold accent-text">#<%= order.id %></span></p>
  </div>

  <% if (order.payment_status === 'paid') { %>
    <div class="mb-5 bg-emerald-50 text-emerald-700 rounded-xl px-4 py-2 text-sm font-bold text-center">✅ <%= t('acct.pay.thanks') %></div>
  <% } else if (typeof canPayOnline !== 'undefined' && canPayOnline) { %>
    <a href="<%= payUrl %>" class="block w-full text-center accent-bg text-white font-extrabold px-6 py-3 rounded-2xl mb-5">💳 <%= t('acct.pay.pay_online') %></a>
  <% } %>

  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
    <% (items||[]).forEach(function(it){ %>
      <div class="flex items-center justify-between py-1.5 text-sm border-b border-gray-50 last:border-0">
        <span><%= it.name_snapshot %> × <%= __money(it.quantity) %></span>
        <span class="font-bold"><bdi><%= __money(Number(it.price)*Number(it.quantity)) %> <%= __cur %></bdi></span>
      </div>
    <% }); %>
    <div class="mt-3 pt-3 border-t border-gray-100 space-y-1 text-sm">
      <div class="flex justify-between text-gray-500"><span><%= t('orders.subtotal') %></span><span><bdi><%= __money(__sub) %> <%= __cur %></bdi></span></div>
      <% if (Number(order.delivery_fee) > 0) { %><div class="flex justify-between text-gray-500"><span><%= t('orders.delivery') %></span><span><bdi><%= __money(order.delivery_fee) %> <%= __cur %></bdi></span></div><% } %>
      <div class="flex justify-between font-extrabold text-lg"><span><%= t('orders.total') %></span><span class="accent-text"><bdi><%= __money(order.total) %> <%= __cur %></bdi></span></div>
    </div>
    <p class="mt-3 text-xs text-gray-400">💵 <%= t('orders.cod') %></p>
  </div>

  <%
    var __flow = ['pending', 'accepted', 'preparing', 'out_for_delivery', 'delivered'];
    var __rank = __flow.indexOf(order.status);
    var __bad = (order.status === 'rejected' || order.status === 'cancelled');
  %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mt-4">
    <h2 class="font-bold mb-3"><%= t('orders.track_title') %></h2>
    <% if (__bad) { %>
      <p class="text-red-600 font-bold"><%= t('orders.status.' + order.status) %></p>
    <% } else { %>
      <ol class="space-y-3">
        <% __flow.forEach(function(s, i){ var done = i <= __rank; %>
          <li class="flex items-center gap-3">
            <span class="grid place-items-center h-6 w-6 rounded-full text-xs <%= done ? 'accent-bg text-white' : 'bg-gray-100 text-gray-400' %>"><%= done ? '✓' : (i + 1) %></span>
            <span class="text-sm <%= done ? 'font-bold' : 'text-gray-400' %>"><%= t('orders.status.' + s) %></span>
          </li>
        <% }); %>
      </ol>
    <% } %>
  </div>

  <% if (order.status === 'delivered' && !reviewed) { %>
    <form method="post" action="/order/food/<%= order.track_token %>/review" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mt-4 text-center">
      <h2 class="font-bold mb-2"><%= t('orders.rate_order') %></h2>
      <div class="stars mb-3" dir="ltr">
        <% for (var s = 5; s >= 1; s--) { %>
          <input type="radio" name="rating" id="star<%= s %>" value="<%= s %>" required />
          <label for="star<%= s %>">★</label>
        <% } %>
      </div>
      <input name="comment" placeholder="<%= t('orders.comment') %>" class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm mb-3" />
      <button type="submit" class="w-full accent-bg text-white rounded-2xl py-2.5 font-bold"><%= t('orders.submit_review') %></button>
    </form>
  <% } else if (reviewed) { %>
    <div class="bg-green-50 text-green-700 rounded-2xl p-4 mt-4 text-center font-bold"><%= t('orders.review_thanks') %></div>
  <% } %>

  <a href="/" class="mt-6 block text-center accent-bg text-white rounded-2xl py-3 font-extrabold"><%= t('orders.back_menu') %></a>
</main>

<script>
  // Order was created successfully — clear the local cart.
  try { localStorage.removeItem('oscardevs_food_cart_' + <%- JSON.stringify(company.slug) %>); } catch (e) {}
  // Attach this order's tracking token to the most recent device-local history entry.
  try {
    var __hk = 'oscardevs_food_history_' + <%- JSON.stringify(company.slug) %>;
    var __h = JSON.parse(localStorage.getItem(__hk) || '[]');
    if (__h.length && !__h[0].token) { __h[0].token = <%- JSON.stringify(order.track_token) %>; __h[0].orderId = <%= order.id %>; localStorage.setItem(__hk, JSON.stringify(__h)); }
  } catch (e) {}
  // Live status: reload when the pharmacy/merchant advances the order.
  (function () {
    var token = <%- JSON.stringify(order.track_token) %>, cur = <%- JSON.stringify(order.status) %>;
    setInterval(function () {
      fetch('/order/food/' + token + '/status').then(function (r) { return r.json(); }).then(function (d) {
        if (d && d.ok && d.status !== cur) location.reload();
      }).catch(function () {});
    }, 15000);
  })();
</script>
</body>
</html>
