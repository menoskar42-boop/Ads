<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<%# No AdSense loader here. The application form is a form — under the word
    count AdSense expects on a monetised page — and leaving the loader in
    would let Auto Ads place a unit on it from the account settings, with no
    change to this repository. Owner's decision (2026-08-06): apply the
    AdSense rules. %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# One variable each, used by <title>, <meta description> and seo_meta.
    Writing the strings out three times is how #14 and #18 in
    docs/SEO_MISTAKES_LOG.md happened twice already: somebody edits one copy,
    Google reads a different title from the one the social card shows, and the
    <meta description> stops matching og:description.

    Measured with python3 (wc -m miscounts Arabic in some locales):
    title 56 chars (limit 60), description 150 (target 150–160).

    Both name the verticals rather than saying "and more": the old pair listed four
    types, so a visitor arriving from the workshop or hall card found a page
    that never used the word they searched for. %>
<%
  var __title = 'موقع لنشاطك: متجر، صيدلية، عيادة، ورشة، قاعة | OscarDevs';
  var __desc  = '١٢ نوع موقع من OscarDevs: متجر، صيدلية، مطاعم، عيادة، تغذية، جيم، موبيليا، ورش سيارات، قاعات أفراح، حضانات، تقسيط، وبورتفوليو. تسجيل ذاتي وتفعيل سريع.';
%>
<title><%= __title %></title>
<meta name="description" content="<%= __desc %>" />
<%- include('../partials/seo_meta', { title: __title, description: __desc, ogImage: siteOrigin + '/og-default.png' }) %>
<%# The FAQ answers live here, in one array, and are rendered BOTH into the
    JSON-LD below and into the visible section further down. They used to be two
    hand-kept copies of the same four answers, which is a structured-data
    mismatch waiting to happen — Google requires the markup to describe content
    actually on the page, and the two copies drift the moment one is edited.
    This one already had: the types answer named six verticals while the form's
    dropdown offered twelve. %>
<%
  var __faq = [
    ['هل إنشاء الصفحة مجاني؟',
     'تقديم الطلب مجاني، والاشتراك مجاني بالكامل أول ٦ شهور. بعد كده تختار: اشتراك شهري أو شراء كامل — الأسعار كلها معروضة على الصفحة الرئيسية. ومميزات المساعد الذكي للمطاعم إضافة اختيارية منفصلة.'],
    ['إمتى تشتغل صفحتي بعد الطلب؟',
     'بعد مراجعة فريقنا للطلب وتفعيل الحساب، تقدر تدخل لوحة التحكم وتبدأ إضافة محتواك فوراً، وتشتغل صفحتك على رابطك الخاص.'],
    ['أنهي أنواع المواقع اللي أقدر أطلبها؟',
     'اتناشر نوع: متجر إلكتروني، بورتفوليو، صيدلية أونلاين، مطاعم وسوبر ماركت (طلبات)، عيادة، عيادة تغذية، جيم، معرض أو ورشة موبيليا، ورشة سيارات، قاعة أفراح ومناسبات، حضانة أو مركز دروس، وبيع بالتقسيط.'],
    ['الرابط بتاعي هيكون شكله إيه؟',
     'رابطك هيكون سب دومين خاص بيك على الشكل ده: your-name.oscardevs.com — بتختار الاسم المختصر وقت الطلب، بحروف إنجليزية صغيرة وأرقام و«-» فقط.'],
  ];
%>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    <% __faq.forEach(function(q, i){ %>
    { "@type": "Question", "name": <%- jsonLd(q[0]) %>, "acceptedAnswer": { "@type": "Answer", "text": <%- jsonLd(q[1]) %> } }<%= i < __faq.length - 1 ? ',' : '' %>
    <% }) %>
  ]
}
</script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">

<header class="bg-white shadow-sm">
  <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/ar/" class="text-xl font-extrabold text-indigo-700">OscarDevs</a>
    <a href="/ar/" class="text-sm text-gray-500 hover:text-indigo-700">← الرئيسية</a>
  </div>
</header>

<main class="max-w-3xl mx-auto px-4 py-10">
  <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'الرئيسية', href: '/' }, { label: 'قدّم طلب' } ] }) %>
  <div class="bg-white rounded-2xl shadow p-6 sm:p-10">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2">قدّم طلب إنشاء صفحتك</h1>
    <p class="text-gray-500 text-sm mb-2">اختَر نوع صفحتك من <strong>١٢ نوع</strong> — متجر إلكتروني، بورتفوليو، صيدلية، مطاعم وطلبات، عيادة، عيادة تغذية، جيم، موبيليا، <strong>ورشة سيارات</strong>، <strong>قاعة أفراح</strong>، <strong>حضانة</strong>، أو <strong>بيع بالتقسيط</strong> — واملأ بياناتك بدقّة. بعد موافقة فريقنا هتدخل لوحة تحكم صفحتك مباشرة.</p>
    <p class="text-gray-400 text-xs mb-8">تقديم الطلب مجاني، والاشتراك مجاني أول ٦ شهور. بعدها تختار اشتراك شهري أو شراء كامل — الأسعار على الصفحة الرئيسية.</p>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-6"><%= error %></div>
    <% } %>

    <form method="POST" action="/apply" class="space-y-5">
      <%# Honeypot: hidden from people, irresistible to bots. A filled value or a
          submission faster than a human can type means the request is dropped —
          silently, so the bot never learns to avoid it. The same pair /contact
          already uses. %>
      <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
        <label>لا تملأ هذا الحقل<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="ft" value="<%= Date.now() %>" />

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">الاسم الكامل *</label>
          <input type="text" name="full_name" value="<%= values.full_name || '' %>" required maxlength="100"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">البريد الإلكتروني *</label>
          <input type="email" name="email" value="<%= values.email || '' %>" required maxlength="150"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">رقم الهاتف / واتساب *</label>
          <input type="tel" name="phone" value="<%= values.phone || '' %>" required maxlength="30"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">الدولة</label>
          <select name="country"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-300">
            <%- include('../partials/countries_options', { selected: values.country || 'مصر' }) %>
          </select>
        </div>
      </div>

      <hr class="border-gray-100" />

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">اسم النشاط/الموقع *</label>
          <input type="text" name="business_name" value="<%= values.business_name || '' %>" required maxlength="100"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">نوع الموقع *</label>
          <select name="business_type" required class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-300">
            <option value="">-- اختر --</option>
            <option value="shop" <%= values.business_type === 'shop' ? 'selected' : '' %>>متجر إلكتروني</option>
            <option value="portfolio" <%= values.business_type === 'portfolio' ? 'selected' : '' %>>بورتفوليو</option>
            <option value="pharmacy" <%= values.business_type === 'pharmacy' ? 'selected' : '' %>>صيدلية أونلاين</option>
            <option value="orders" <%= values.business_type === 'orders' ? 'selected' : '' %>>مطاعم / سوبر ماركت (طلبات)</option>
            <option value="clinic" <%= values.business_type === 'clinic' ? 'selected' : '' %>>عيادة / إدارة عيادات</option>
            <option value="gym" <%= values.business_type === 'gym' ? 'selected' : '' %>>جيم / صالة رياضية</option>
            <option value="furniture" <%= values.business_type === 'furniture' ? 'selected' : '' %>>معرض / ورشة موبيليا</option>
            <option value="nutrition" <%= values.business_type === 'nutrition' ? 'selected' : '' %>>عيادة تغذية</option>
            <option value="workshop" <%= values.business_type === 'workshop' ? 'selected' : '' %>>ورشة سيارات</option>
            <option value="hall" <%= values.business_type === 'hall' ? 'selected' : '' %>>قاعة أفراح ومناسبات</option>
            <option value="nursery" <%= values.business_type === 'nursery' ? 'selected' : '' %>>حضانة / مركز دروس</option>
            <option value="installments" <%= values.business_type === 'installments' ? 'selected' : '' %>>بيع بالتقسيط (قسّطلي)</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">الاسم المختصر للرابط *</label>
        <%# It said "/view/" — a path that exists but 301s to the subdomain. The
            canonical everywhere in this codebase is <slug>.oscardevs.com
            (docs/SEO_MISTAKES_LOG.md #1), the activation email quotes that
            form, and it is what the customer will type and hand out. Showing
            them the redirecting path was telling them their address is
            something it is not. %>
        <div class="flex" dir="ltr">
          <input type="text" name="preferred_slug" id="slugInput" value="<%= values.preferred_slug || '' %>" required maxlength="40" pattern="[a-z0-9][a-z0-9-]{0,38}[a-z0-9]?"
            class="flex-1 border border-gray-200 rounded-l-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
          <span class="inline-flex items-center px-3 rounded-r-xl bg-gray-100 text-gray-500 text-sm border border-r-0 border-gray-200">.oscardevs.com</span>
        </div>
        <p class="text-xs text-gray-400 mt-1">حروف إنجليزية صغيرة وأرقام و"-" فقط. رابطك هيبقى مثلاً <code dir="ltr">my-store.oscardevs.com</code></p>
        <p id="slugStatus" class="text-xs mt-1 font-semibold" style="display:none"></p>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">وصف نشاطك</label>
        <textarea name="description" rows="4" maxlength="1000" placeholder="اشرح بإيجاز عن نشاطك ومنتجاتك/خدماتك"
          class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 resize-none"><%= values.description || '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">
          كود دعوة من صديق <span class="font-normal text-gray-400">(اختياري)</span>
        </label>
        <input type="text" name="referral_code" maxlength="12" dir="ltr" placeholder="ABC123"
          value="<%= values.referral_code || '' %>"
          class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        <p class="text-xs text-emerald-600 mt-1">لو حد من عملائنا دعاك، اكتب كوده وتاخد <strong>شهرين مجاناً إضافيين</strong> — وهو كمان.</p>
      </div>

      <hr class="border-gray-100" />

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">كلمة المرور (هتدخل بها بعد الموافقة) *</label>
        <input type="password" name="password" required minlength="8" maxlength="100"
          class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" />
        <p class="text-xs text-gray-400 mt-1">8 أحرف على الأقل. تُخزّن مشفّرة (bcrypt) ولا يمكن لأحد رؤيتها.</p>
      </div>

      <div class="space-y-2 pt-2 border-t border-gray-100">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="accept_terms" required class="mt-1 w-5 h-5" />
          <span class="text-sm text-gray-700">قرأت ووافقت على <a href="/terms" target="_blank" class="text-indigo-700 font-semibold underline">الشروط والأحكام</a> (الإصدار <%= termsVersion %>).</span>
        </label>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="accept_privacy" required class="mt-1 w-5 h-5" />
          <span class="text-sm text-gray-700">قرأت ووافقت على <a href="/privacy" target="_blank" class="text-indigo-700 font-semibold underline">سياسة الخصوصية</a>.</span>
        </label>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="accept_truth" required class="mt-1 w-5 h-5" />
          <span class="text-sm text-gray-700">أُقرّ بأن كل البيانات المقدّمة صحيحة، وأنني المسؤول قانونياً عن المحتوى الذي أرفعه، وأن المنصّة لها حق رفض/تعليق/إنهاء الخدمة في أي وقت دون التزام بسبب.</span>
        </label>
      </div>

      <div class="pt-3">
        <button type="submit" id="submitBtn" class="w-full sm:w-auto bg-indigo-700 text-white font-bold px-8 py-3 rounded-xl hover:bg-indigo-800 transition shadow">
          إرسال الطلب
        </button>
      </div>
    </form>
  </div>

  <!-- Unique, indexable content (SEO): the form alone was too thin for Google to index. -->
  <section class="mt-8 bg-white rounded-2xl shadow p-6 sm:p-10">
    <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 mb-4">أنواع الصفحات اللي تقدر تطلبها</h2>
    <%# All twelve, in the same order as the dropdown above. Six of them —
        موبيليا، تغذية، ورش سيارات، قاعات، حضانات، تقسيط — were shipped and
        linked from the home page but were not named anywhere on this page, so a
        visitor who clicked the workshop card landed here and read six
        paragraphs, none of them about workshops. %>
    <div class="grid sm:grid-cols-2 gap-4 text-sm text-gray-600 leading-7">
      <p><strong class="text-gray-900">متجر إلكتروني:</strong> متجر كامل بسلة شراء، إدارة منتجات وأقسام، كوبونات خصم، وتتبّع طلبات — جاهز تبيع بيه أونلاين.</p>
      <p><strong class="text-gray-900">بورتفوليو:</strong> صفحة أعمال احترافية تعرض خدماتك ومشاريعك ووسائل تواصلك في تصميم نظيف وسريع.</p>
      <p><strong class="text-gray-900">صيدلية أونلاين:</strong> كتالوج أدوية ومنتجات، سلة طلب، وإدارة مخزون — مع صفحة لتتبّع الطلب.</p>
      <p><strong class="text-gray-900">مطاعم / سوبر ماركت (طلبات):</strong> منيو رقمي وطلب أونلاين، مع مساعد ذكي اختياري يستقبل الطلب بالمحادثة.</p>
      <p><strong class="text-gray-900">عيادة / إدارة عيادات:</strong> حجز مواعيد، ملفات المرضى، وإدارة الأطباء والخدمات من لوحة واحدة.</p>
      <p><strong class="text-gray-900">عيادة تغذية:</strong> ملفات المتابعة والقياسات، وخطط الأكل، وحجز جلسات المتابعة لكل عميل.</p>
      <p><strong class="text-gray-900">جيم / صالة رياضية:</strong> اشتراكات، حجز حصص، ومتابعة الأعضاء والحضور.</p>
      <p><strong class="text-gray-900">معرض / ورشة موبيليا:</strong> معرض قطع بالمقاسات والخامات، طلبات تفصيل، ومتابعة التنفيذ خطوة بخطوة.</p>
      <p><strong class="text-gray-900">ورشة سيارات:</strong> استقبال السيارات وأوامر الشغل، قطع الغيار والعمالة، وسجل صيانة لكل عربية.</p>
      <p><strong class="text-gray-900">قاعة أفراح ومناسبات:</strong> تقويم حجوزات بالتواريخ المتاحة، باقات وأسعار، وعربون وتأكيد الحجز.</p>
      <p><strong class="text-gray-900">حضانة / مركز دروس:</strong> تسجيل الأطفال أو الطلبة، المجموعات والمواعيد، والحضور والمصروفات.</p>
      <p><strong class="text-gray-900">بيع بالتقسيط (قسّطلي):</strong> عقود تقسيط بجدول أقساط، متابعة التحصيل، وتنبيه بالمتأخرات.</p>
    </div>

    <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-8 mb-4">إزاي بيشتغل؟</h2>
    <ol class="list-decimal pr-5 space-y-2 text-sm text-gray-600 leading-7">
      <li>قدّم الطلب من الفورم فوق، واختَر نوع صفحتك والاسم المختصر للرابط.</li>
      <li>فريقنا يراجع طلبك ويفعّل حسابك.</li>
      <li>تدخل لوحة التحكم وتضيف محتواك بنفسك (منتجات، خدمات، أو منيو).</li>
      <li>صفحتك تشتغل على رابطك الخاص، جاهزة لعملائك.</li>
    </ol>

    <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-8 mb-4">أسئلة شائعة</h2>
    <%# Rendered from the same __faq array as the JSON-LD above, so the markup
        can never describe an answer the page does not show. %>
    <div class="space-y-4 text-sm">
      <% __faq.forEach(function(q){ %>
      <div>
        <h3 class="font-bold text-gray-900 mb-1"><%= q[0] %></h3>
        <p class="text-gray-600 leading-7"><%= q[1] %></p>
      </div>
      <% }) %>
    </div>
  </section>
</main>

<script>
(function () {
  var input = document.getElementById('slugInput');
  var status = document.getElementById('slugStatus');
  var submit = document.getElementById('submitBtn');
  if (!input || !status) return;
  var timer = null;

  function show(text, color) {
    status.textContent = text;
    status.style.display = '';
    status.style.color = color;
  }

  function check() {
    var slug = (input.value || '').trim().toLowerCase();
    if (!slug) { status.style.display = 'none'; if (submit) submit.disabled = false; return; }
    show('جارٍ التحقق...', '#9ca3af');
    fetch('/apply/check-slug?slug=' + encodeURIComponent(slug), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (res.available) {
          show('✓ الاسم متاح', '#16a34a');
          if (submit) submit.disabled = false;
        } else if (res.reason === 'invalid') {
          show('✗ صيغة غير صالحة (حروف إنجليزية صغيرة وأرقام و"-" فقط)', '#dc2626');
          if (submit) submit.disabled = true;
        } else if (res.reason === 'taken') {
          show('✗ الاسم محجوز بالفعل — اختر اسماً آخر', '#dc2626');
          if (submit) submit.disabled = true;
        } else {
          status.style.display = 'none';
          if (submit) submit.disabled = false;
        }
      })
      .catch(function () { status.style.display = 'none'; if (submit) submit.disabled = false; });
  }

  input.addEventListener('input', function () {
    if (timer) clearTimeout(timer);
    timer = setTimeout(check, 450);
  });
  if (input.value.trim()) check();
})();
</script>

</body>
</html>
