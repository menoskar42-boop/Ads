<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('acct.nav.costs') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; } .fld{border:1px solid #d1d5db;border-radius:8px;padding:6px 8px;background:#fff;font-size:.85rem;width:100%}</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'costs' }) %>
<%
  var __isPharm = company.page_type === 'pharmacy';
  var __cur = company.currency || 'EGP';
%>
<main class="max-w-4xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓ <%= t('acct.saved') %></div><% } %>
  <div class="flex items-baseline justify-between mb-3 flex-wrap gap-2">
    <h1 class="text-lg font-extrabold text-emerald-800"><%= t('acct.costs.title') %></h1>
    <% if (settings.markup_enabled) { %><span class="text-xs text-gray-500"><%= t('acct.costs.markup_hint') %> <b><%= Number(settings.markup_percent) %>%</b></span>
    <% } else { %><a href="/accounting/settings" class="text-xs text-emerald-700 underline"><%= t('acct.costs.markup_setup') %></a><% } %>
  </div>

  <% if (!items.length) { %>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-10 text-center text-gray-400"><%= t('acct.costs.none') %></div>
  <% } else { %>
    <p class="text-xs text-gray-500 mb-3"><%= t('acct.costs.desc') %></p>
    <div class="space-y-2">
      <% items.forEach(function(it){ %>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-3">
          <div class="font-bold text-sm mb-2 truncate"><%= it.name %></div>
          <form method="post" action="/accounting/costs/<%= it.id %>/save" class="grid gap-2 items-end <%= __isPharm ? 'sm:grid-cols-4' : 'sm:grid-cols-3' %>">
            <div><span class="text-[11px] text-gray-500 block mb-0.5"><%= t('acct.costs.cost') %> (<%= __cur %>)</span><input name="cost" type="number" step="0.01" min="0" value="<%= Number(it.cost||0) %>" class="fld" /></div>
            <div><span class="text-[11px] text-gray-500 block mb-0.5"><%= t('acct.costs.price') %> (<%= __cur %>)</span><input name="price" type="number" step="0.01" min="0" value="<%= Number(it.price||0) %>" class="fld" /></div>
            <% if (__isPharm) { %><div><span class="text-[11px] text-gray-500 block mb-0.5"><%= t('acct.costs.free_samples') %></span><input name="free" type="number" min="0" value="<%= Number(it.free||0) %>" class="fld" /></div><% } %>
            <div class="flex gap-2">
              <button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg px-3 py-1.5 text-sm flex-1"><%= t('acct.save') %></button>
              <% if (settings.markup_enabled) { %><button formaction="/accounting/costs/<%= it.id %>/markup" class="bg-gray-800 text-white rounded-lg px-3 py-1.5 text-xs" title="<%= t('acct.costs.apply_markup') %>">×<%= Number(settings.markup_percent) %>%</button><% } %>
            </div>
          </form>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body>
</html>
