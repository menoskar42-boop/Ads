<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('acct.title') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>* { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'report' }) %>
<%
  var __cur = currency;
  function m(v){ var n=Number(v)||0; return n.toLocaleString(lang==='ar'?'ar-EG':'en-US',{maximumFractionDigits:2}); }
  var net = Number(report.netProfit)||0;
%>
<main class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
    <h1 class="text-xl font-extrabold text-emerald-800">📊 <%= t('acct.report.title') %></h1>
    <span class="text-sm text-gray-500"><%= t('acct.report.this_month') %></span>
  </div>

  <!-- Headline: net profit -->
  <div class="rounded-2xl p-6 mb-5 text-white shadow-sm <%= net >= 0 ? 'bg-emerald-600' : 'bg-red-600' %>">
    <div class="text-sm opacity-90 mb-1"><%= t('acct.report.net_profit') %></div>
    <div class="text-4xl font-extrabold"><bdi><%= m(net) %> <span class="text-lg opacity-80"><%= __cur %></span></bdi></div>
  </div>

  <!-- Key tiles -->
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-5">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
      <div class="text-xs text-gray-500 mb-1"><%= t('acct.report.revenue') %></div>
      <div class="text-xl font-extrabold text-gray-800"><%= m(report.revenue) %> <span class="text-xs text-gray-400"><%= __cur %></span></div>
      <div class="text-[11px] text-gray-400 mt-0.5"><%= m(report.orders) %> <%= t('acct.report.orders') %></div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
      <div class="text-xs text-gray-500 mb-1"><%= t('acct.report.cogs') %></div>
      <div class="text-xl font-extrabold text-gray-800"><%= m(report.cogsNet) %> <span class="text-xs text-gray-400"><%= __cur %></span></div>
      <% if (Number(report.freeSampleCredit) > 0) { %><div class="text-[11px] text-emerald-600 mt-0.5">− <%= m(report.freeSampleCredit) %> <%= t('acct.report.free_credit') %></div><% } %>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
      <div class="text-xs text-gray-500 mb-1"><%= t('acct.report.gross_profit') %></div>
      <div class="text-xl font-extrabold text-emerald-700"><%= m(report.grossProfit) %> <span class="text-xs text-gray-400"><%= __cur %></span></div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
      <div class="text-xs text-gray-500 mb-1"><%= t('acct.report.expenses') %> + <%= t('acct.report.commissions') %></div>
      <div class="text-xl font-extrabold text-red-600"><%= m(Number(report.expenses)+Number(report.commissions)) %> <span class="text-xs text-gray-400"><%= __cur %></span></div>
    </div>
  </div>

  <!-- Breakdown -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 mb-5">
    <h2 class="font-bold text-gray-700 mb-3"><%= t('acct.report.breakdown') %></h2>
    <div class="text-sm divide-y divide-gray-100">
      <div class="flex justify-between py-2"><span class="text-gray-600"><%= t('acct.report.revenue') %></span><span class="font-bold text-emerald-700">+ <%= m(report.revenue) %></span></div>
      <div class="flex justify-between py-2"><span class="text-gray-600"><%= t('acct.report.cogs') %></span><span class="font-bold text-red-600">− <%= m(report.cogsNet) %></span></div>
      <% if (Number(report.freeSampleCredit) > 0) { %><div class="flex justify-between py-2"><span class="text-gray-500 ps-4"><%= t('acct.report.free_credit_line') %></span><span class="text-emerald-600">+ <%= m(report.freeSampleCredit) %></span></div><% } %>
      <div class="flex justify-between py-2"><span class="text-gray-600"><%= t('acct.report.expenses') %></span><span class="font-bold text-red-600">− <%= m(report.expenses) %></span></div>
      <div class="flex justify-between py-2"><span class="text-gray-600"><%= t('acct.report.commissions') %></span><span class="font-bold text-red-600">− <%= m(report.commissions) %></span></div>
      <% if (settings.tax_enabled) { %>
      <div class="flex justify-between py-2"><span class="text-gray-600"><%= t('acct.report.tax') %> (<%= m(settings.tax_rate) %>% <%= settings.tax_base === 'sales' ? t('acct.settings.on_sales') : t('acct.settings.on_profit') %>)</span><span class="font-bold text-red-600">− <%= m(report.tax) %></span></div>
      <% } %>
      <div class="flex justify-between py-3 text-base"><span class="font-extrabold"><%= t('acct.report.net_profit') %></span><span class="font-extrabold <%= net>=0?'text-emerald-700':'text-red-600' %>"><%= m(net) %> <%= __cur %></span></div>
    </div>
  </div>

  <!-- Commission detail -->
  <% if (report.staffLines && report.staffLines.length) { %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
    <h2 class="font-bold text-gray-700 mb-3"><%= t('acct.report.commissions') %></h2>
    <ul class="text-sm divide-y divide-gray-100">
      <% report.staffLines.forEach(function(s){ %>
        <li class="flex justify-between py-2"><span><%= s.name %> <span class="text-xs text-gray-400">(<%= t('acct.role.' + s.role) %>)</span></span><span class="font-bold"><%= m(s.amount) %> <%= __cur %></span></li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <p class="text-xs text-gray-400 mt-4"><%= t('acct.report.note') %></p>
</main>
</body>
</html>
