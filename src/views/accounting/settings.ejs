<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('acct.nav.settings') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<style>* { font-family: 'Cairo', sans-serif; } .fld{border:1px solid #d1d5db;border-radius:10px;padding:9px 11px;width:100%;background:#fff}</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'settings' }) %>
<main class="max-w-2xl mx-auto px-4 py-6">
  <% if (saved) { %><div class="mb-4 bg-green-50 text-green-700 rounded-xl px-4 py-2 text-sm font-bold">✓ <%= t('acct.saved') %></div><% } %>
  <form method="post" action="/accounting/settings" class="space-y-5">

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <h2 class="font-bold text-emerald-800 mb-1"><%= t('acct.settings.tax_title') %></h2>
      <p class="text-xs text-gray-500 mb-3"><%= t('acct.settings.tax_desc') %></p>
      <label class="flex items-center gap-2 mb-3 cursor-pointer">
        <input type="checkbox" name="tax_enabled" value="1" <%= settings.tax_enabled ? 'checked' : '' %> class="h-5 w-5 accent-emerald-600" />
        <span class="font-bold text-sm"><%= t('acct.settings.tax_enable') %></span>
      </label>
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <span class="text-xs text-gray-500 block mb-1"><%= t('acct.settings.tax_base') %></span>
          <select name="tax_base" class="fld">
            <option value="profit" <%= settings.tax_base==='profit'?'selected':'' %>><%= t('acct.settings.on_profit') %></option>
            <option value="sales" <%= settings.tax_base==='sales'?'selected':'' %>><%= t('acct.settings.on_sales') %></option>
          </select>
        </div>
        <div>
          <span class="text-xs text-gray-500 block mb-1"><%= t('acct.settings.tax_rate') %> (%)</span>
          <input name="tax_rate" type="number" step="0.01" min="0" value="<%= Number(settings.tax_rate||14) %>" class="fld" />
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <h2 class="font-bold text-emerald-800 mb-1"><%= t('acct.settings.markup_title') %></h2>
      <p class="text-xs text-gray-500 mb-3"><%= t('acct.settings.markup_desc') %></p>
      <label class="flex items-center gap-2 mb-3 cursor-pointer">
        <input type="checkbox" name="markup_enabled" value="1" <%= settings.markup_enabled ? 'checked' : '' %> class="h-5 w-5 accent-emerald-600" />
        <span class="font-bold text-sm"><%= t('acct.settings.markup_enable') %></span>
      </label>
      <div>
        <span class="text-xs text-gray-500 block mb-1"><%= t('acct.settings.markup_percent') %> (%)</span>
        <input name="markup_percent" type="number" step="0.01" min="0" value="<%= Number(settings.markup_percent||30) %>" class="fld sm:w-40" />
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
      <h2 class="font-bold text-emerald-800 mb-1"><%= t('acct.settings.delivery_title') %></h2>
      <p class="text-xs text-gray-500 mb-3"><%= t('acct.settings.delivery_desc') %></p>
      <label class="flex items-center gap-2 mb-3 cursor-pointer">
        <input type="checkbox" name="delivery_enabled" value="1" <%= settings.delivery_enabled ? 'checked' : '' %> class="h-5 w-5 accent-emerald-600" />
        <span class="font-bold text-sm"><%= t('acct.settings.delivery_enable') %></span>
      </label>
      <div>
        <span class="text-xs text-gray-500 block mb-1"><%= t('acct.settings.delivery_fee') %></span>
        <input name="delivery_fee" type="number" step="0.01" min="0" value="<%= Number(settings.delivery_fee||0) %>" class="fld sm:w-40" />
      </div>
    </div>

    <button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-8 py-3 w-full sm:w-auto"><%= t('acct.save') %></button>
  </form>
</main>
</body>
</html>
