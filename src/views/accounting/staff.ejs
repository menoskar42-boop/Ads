<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title><%= t('acct.nav.staff') %> — <%= company.company_name %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>* { font-family: 'Cairo', sans-serif; } .fld{border:1px solid #d1d5db;border-radius:10px;padding:9px 11px;width:100%;background:#fff;font-size:.9rem}</style>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('nav', { active: 'staff' }) %>
<%
  function m(v){ var n=Number(v)||0; return n.toLocaleString(lang==='ar'?'ar-EG':'en-US',{maximumFractionDigits:2}); }
  function ctypeLabel(c){ return t('acct.ctype.' + c); }
%>
<main class="max-w-3xl mx-auto px-4 py-6">
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 mb-5">
    <h2 class="font-bold text-emerald-800 mb-1"><%= t('acct.staff.add') %></h2>
    <p class="text-xs text-gray-500 mb-3"><%= t('acct.staff.desc') %></p>
    <form method="post" action="/accounting/staff/add" class="grid gap-3 sm:grid-cols-2">
      <div><span class="text-xs text-gray-500 block mb-1"><%= t('acct.staff.name') %></span><input name="name" required class="fld" /></div>
      <div><span class="text-xs text-gray-500 block mb-1"><%= t('acct.staff.role') %></span>
        <select name="role" class="fld">
          <% ['delivery','chef','receptionist','cashier','other'].forEach(function(r){ %><option value="<%= r %>"><%= t('acct.role.' + r) %></option><% }); %>
        </select>
      </div>
      <div><span class="text-xs text-gray-500 block mb-1"><%= t('acct.staff.commission_type') %></span>
        <select name="commission_type" class="fld">
          <% ['none','per_order','percent_sales','fixed_monthly'].forEach(function(c){ %><option value="<%= c %>"><%= t('acct.ctype.' + c) %></option><% }); %>
        </select>
      </div>
      <div><span class="text-xs text-gray-500 block mb-1"><%= t('acct.staff.commission_value') %></span><input name="commission_value" type="number" step="0.01" min="0" value="0" class="fld" /></div>
      <div class="sm:col-span-2"><button class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl px-6 py-2.5 w-full sm:w-auto">+ <%= t('acct.staff.add') %></button></div>
    </form>
  </div>

  <% if (!staff.length) { %>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-10 text-center text-gray-400"><%= t('acct.staff.none') %></div>
  <% } else { %>
    <div class="space-y-2">
      <% staff.forEach(function(s){ %>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-3 flex items-center justify-between gap-3 <%= s.is_active ? '' : 'opacity-60' %>">
          <div class="min-w-0">
            <div class="font-bold text-sm truncate"><%= s.name %> <span class="text-xs font-normal text-gray-400">· <%= t('acct.role.' + s.role) %></span></div>
            <div class="text-xs text-gray-400"><%= ctypeLabel(s.commission_type) %><% if (s.commission_type !== 'none') { %>: <%= m(s.commission_value) %><% } %></div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <form method="post" action="/accounting/staff/<%= s.id %>/toggle"><button class="text-xs font-bold rounded-lg px-3 py-1.5 <%= s.is_active ? 'bg-gray-100 text-gray-600' : 'bg-emerald-50 text-emerald-700' %>"><%= s.is_active ? t('acct.staff.pause') : t('acct.staff.activate') %></button></form>
            <form method="post" action="/accounting/staff/<%= s.id %>/delete"><button class="text-red-500 text-sm" data-confirm="<%= t('common.tap_confirm') %>">🗑️</button></form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</main>
</body>
</html>
