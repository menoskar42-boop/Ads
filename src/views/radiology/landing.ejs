<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  // This is the PUBLIC marketing landing (the authenticated app pages under
  // _layout_top.ejs stay noindex). It is showcased in /our-work, so it should be
  // discoverable and share well. The gated dashboard/upload/study pages are a
  // separate layout and remain noindex.
  /* ⚠️ كان `siteOrigin + '/radiology'` — من غير prefix اللغة.
   *
   * فبعد تقسيم اللغة، الصفحة النهائية `/ar/radiology` كانت بتعلن كانونيكال
   * على `/radiology` — **وده بيتحوّل ٣٠١ عليها هي نفسها**. يعني الصفحة
   * بتقول عن نفسها إن نسختها الأصلية عنوان بيرجّعك لها.
   *
   * `publicUrl` بتحط الـprefix الصح من اللغة الحالية. مسكها تقرير سيو
   * خارجي بعد النشر. */
  var __rurl = (typeof publicUrl !== 'undefined')
    ? publicUrl('/radiology')
    : ((typeof siteOrigin !== 'undefined' ? siteOrigin : 'https://oscardevs.com') + '/ar/radiology');
  var __rdesc = 'OncoScan: أداة دعم قرار للأشعة (CT/MRI) بالذكاء الاصطناعي — رفع دراسات DICOM، عرضها في المتصفح، وتقرير منظّم ثنائي اللغة. أداة غير تشخيصية، القرار للطبيب.';
%>
<meta name="robots" content="index,follow" />
<title>OncoScan — دعم قرار الأشعة (CT/MRI) بالذكاء الاصطناعي</title>
<meta name="description" content="<%= __rdesc %>" />
<link rel="canonical" href="<%= __rurl %>" />
<meta property="og:type" content="website" />
<meta property="og:title" content="OncoScan — دعم قرار الأشعة بالذكاء الاصطناعي" />
<meta property="og:description" content="<%= __rdesc %>" />
<meta property="og:url" content="<%= __rurl %>" />
<meta property="og:image" content="<%= (typeof siteOrigin !== 'undefined' ? siteOrigin : 'https://oscardevs.com') %>/og-default.png" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json">
<%- jsonLd({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "OncoScan",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "description": __rdesc,
  "url": __rurl,
  "inLanguage": "ar",
  "isAccessibleForFree": true,
  "provider": { "@type": "Organization", "name": "OscarDevs", "url": (typeof siteOrigin !== 'undefined' ? siteOrigin : 'https://oscardevs.com') }
}) %>
</script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/tw.css" />
<style>*{font-family:'Cairo',sans-serif}body{background:#0b1220;color:#e5edf7}.accent-bg{background:#0ea5e9;color:#04121f}.card{background:#111a2e;border:1px solid #1e2a44}</style>
</head>
<body class="min-h-screen">
<div class="max-w-3xl mx-auto px-4 py-16 text-center">
  <div class="text-6xl mb-4">🩻</div>
  <h1 class="text-4xl sm:text-5xl font-black mb-3">OncoScan</h1>
  <p class="text-lg text-slate-300 mb-2">دعم قرار للأشعة (CT / MRI) بالذكاء الاصطناعي — رفع DICOM، عرض، وتقرير منظّم ثنائي اللغة.</p>
  <p class="text-sm text-slate-400 mb-8">Bilingual AI decision support over CT/MRI DICOM studies.</p>

  <div class="bg-amber-500/10 border border-amber-500/30 text-amber-200 rounded-xl p-4 text-sm mb-8">
    ⚠️ <strong>أداة دعم قرار غير تشخيصية.</strong> النتائج مسودّات تحتاج مراجعة الطبيب، والقرار والمسؤولية النهائية للطبيب المعالج. لا تُستخدم كتشخيص نهائي.
  </div>

  <div class="grid sm:grid-cols-3 gap-3 mb-10 text-right">
    <div class="card rounded-2xl p-4"><div class="text-2xl mb-1">📤</div><div class="font-bold text-sm">رفع DICOM</div><div class="text-xs text-slate-400 mt-1">دراسات CT/MRI بأمان، لكل طبيب حسابه.</div></div>
    <div class="card rounded-2xl p-4"><div class="text-2xl mb-1">🖥️</div><div class="font-bold text-sm">عارض في المتصفح</div><div class="text-xs text-slate-400 mt-1">windowing + تنقّل شرائح بدون تحميل على السيرفر.</div></div>
    <div class="card rounded-2xl p-4"><div class="text-2xl mb-1">🔬</div><div class="font-bold text-sm">تقرير AI منظّم</div><div class="text-xs text-slate-400 mt-1">Findings/Impression ثنائي اللغة + شات أسئلة.</div></div>
  </div>

  <div class="flex justify-center gap-3">
    <a href="/radiology/login" class="accent-bg font-bold px-6 py-3 rounded-xl">تسجيل دخول الأطباء</a>
    <a href="/radiology/register" class="border border-slate-600 font-bold px-6 py-3 rounded-xl hover:bg-slate-800">حساب جديد</a>
  </div>
  <p class="text-xs text-slate-500 mt-10">مدعوم بواسطة <a href="https://oscardevs.com" class="text-sky-400">OscarDevs</a></p>
</div>
</body>
</html>
