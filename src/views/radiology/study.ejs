<% var pageTitle = (study.description || ('دراسة #' + study.id)); %>
<%- include('_layout_top') %>
  <a href="/radiology/dashboard" class="text-xs text-slate-500 hover:text-white">← كل الدراسات</a>
  <div class="flex items-start justify-between gap-3 mt-2 mb-5 flex-wrap">
    <div>
      <h1 class="text-2xl font-black"><%= study.description || ('دراسة #' + study.id) %></h1>
      <div class="text-sm text-slate-400 mt-1">
        <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-300"><%= study.modality %></span>
        · <%= study.num_slices %> شريحة
        <% if (study.patient_ref) { %> · <span dir="ltr"><%= study.patient_ref %></span><% } %>
        · <%= new Date(study.created_at).toLocaleDateString('ar-EG') %>
      </div>
      <%
        /* How the slices were ordered. The radiologist has to be told this,
           not left to notice: an "upload" ordering means the sequence is
           whatever the file picker produced, which is not anatomical. */
        var __ord = {
          position: ['bg-emerald-500/15 text-emerald-300', 'الترتيب: موضع الشريحة في الجسم (ImagePositionPatient)'],
          instance: ['bg-emerald-500/15 text-emerald-300', 'الترتيب: رقم الشريحة من الجهاز (InstanceNumber)'],
          upload:   ['bg-amber-500/15 text-amber-300', '⚠️ الترتيب: ترتيب رفع الملفات — الملفات مافيهاش موضع ولا رقم شريحة، فالتسلسل ده مش تشريحي'],
        }[study.slice_order] || null;
      %>
      <% if (__ord) { %>
      <div class="text-xs mt-2"><span class="px-2 py-1 rounded-lg <%= __ord[0] %>"><%= __ord[1] %></span></div>
      <% } %>
      <%# الضغط اتسجّل ساعة الرفع. الطبيب يعرف من دلوقتي إن العارض مش هيفكّ
          الصور دي — بدل ما يستنى تحميل الشرايح عشان يلاقيها كلها رسالة خطأ. %>
      <% if (study.compression) { %>
      <div class="text-xs mt-2"><span class="px-2 py-1 rounded-lg bg-amber-500/15 text-amber-300">
        ⚠️ الصور مضغوطة (<span dir="ltr"><%= study.compression %></span>) — العارض المدمج بيفكّ غير المضغوط بس، فالشرايح مش هتتعرض هنا. التقرير بالـAI كمان محتاج صور متعروضة.
      </span></div>
      <% } %>
      <% if (study.skipped_files) { %>
      <div class="text-xs mt-2"><span class="px-2 py-1 rounded-lg bg-slate-500/15 text-slate-300">
        ملفات مش DICOM اتشالت وقت الرفع: <span dir="ltr"><%= study.skipped_files %></span>
      </span></div>
      <% } %>
    </div>
    <form method="POST" action="/radiology/study/<%= study.id %>/delete" onsubmit="return confirm('حذف الدراسة وكل شرائحها؟')">
      <button class="text-xs border border-rose-500/40 text-rose-400 rounded-lg px-3 py-1.5 hover:bg-rose-500/10">حذف الدراسة</button>
    </form>
  </div>

  <% if (study.clinical_context) { %>
  <div class="card rounded-2xl p-4 mb-4">
    <div class="text-xs font-bold text-slate-400 mb-1">السياق الإكلينيكي</div>
    <p class="text-sm text-slate-200 whitespace-pre-line"><%= study.clinical_context %></p>
  </div>
  <% } %>

  <!-- In-browser DICOM viewer (phase 2) -->
  <% if (study.num_slices > 0) { %>
  <style>
    .rad-preset{background:#0b1424;border:1px solid #24324f;color:#cbd5e1;font-size:12px;font-weight:700;border-radius:8px;padding:5px 10px;cursor:pointer}
    .rad-preset:hover{border-color:#0ea5e9;color:#38bdf8}
    .rad-ctrl{background:#0b1424;border:1px solid #24324f;color:#cbd5e1;border-radius:8px;width:34px;height:34px;font-weight:800;cursor:pointer}
    .rad-canvas-wrap{background:#000;border-radius:12px;overflow:hidden;display:grid;place-items:center;aspect-ratio:1/1;position:relative}
    .rad-canvas-wrap canvas{max-width:100%;max-height:100%;image-rendering:pixelated;transform-origin:center;cursor:crosshair}
    .rad-preset.rad-on{border-color:#0ea5e9;color:#38bdf8;background:#0e2036}
    .rad-thumb{width:56px;height:56px;border-radius:6px;border:1px solid #24324f;cursor:pointer;background:#000}
    .rad-thumb:hover{border-color:#0ea5e9}
    .rad-strip{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}
  </style>
  <div class="card rounded-2xl p-4 mb-4" id="radViewer">
    <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
      <div class="text-sm font-bold">العارض <span class="text-xs text-slate-500" data-label></span></div>
      <div class="text-xs text-slate-400" data-wl></div>
    </div>
    <div class="rad-canvas-wrap mb-3">
      <canvas data-canvas></canvas>
      <div class="absolute text-xs text-slate-400 bg-black/60 px-3 py-1 rounded" data-msg style="display:none"></div>
    </div>
    <div class="flex items-center gap-2 mb-3">
      <button class="rad-ctrl" data-prev>‹</button>
      <input type="range" min="0" value="0" class="flex-1" data-slider />
      <button class="rad-ctrl" data-next>›</button>
      <button class="rad-ctrl" data-zout>−</button>
      <button class="rad-ctrl" data-zin>+</button>
    </div>
    <div class="flex flex-wrap gap-1.5 items-center" data-presets></div>
    <%# القياس والمصغّرات (البند ٨٨). المسافة بتتحسب من PixelSpacing، واللي
        مافيهوش مقياس بكسل بيتقال إن الرقم بالبكسل — مش بيتحوّل لمليمتر. %>
    <div class="flex items-center gap-2 mt-2 flex-wrap">
      <button class="rad-preset" data-measure-btn>📏 قياس مسافة</button>
      <span class="text-[11px] text-slate-400" data-measure-out></span>
    </div>
    <div class="rad-strip mt-3" data-thumbs></div>
    <p class="text-[11px] text-slate-500 mt-2">اسحب على الصورة لضبط الإضاءة (يمين/شمال = العرض، فوق/تحت = المركز). العرض والفكّ في متصفحك — مفيش تحميل على السيرفر.</p>
  </div>
  <script src="/js/rad-viewer.js"></script>
  <% } %>

  <!-- AI report (phase 3) -->
  <div class="card rounded-2xl p-5 mb-4">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
      <h2 class="font-bold text-sm">🔬 تقرير الذكاء الاصطناعي</h2>
      <% if (study.num_slices > 0) { %>
      <div class="flex items-center gap-2">
        <input id="radFocus" placeholder="تركيز التقرير (اختياري)" class="fld rounded-lg px-3 py-1.5 text-xs" />
        <button id="radGenBtn" class="accent-bg font-bold text-sm px-4 py-2 rounded-lg">🚀 توليد تقرير</button>
      </div>
      <% } %>
    </div>
    <%# حدّ التحليل اليومي، معروض قبل الضغط. «مش قادرين نتأكد» حالة تالتة
        بتتقال بصوتها — لا «تمام» ولا «خلص». %>
    <% if (typeof money !== 'undefined' && money) { %>
      <div class="text-[11px] mb-2 <%= money.ok ? 'text-slate-500' : 'text-amber-300' %>">
        <% if (money.spent === null) { %>
          ⚠️ مش قادرين نقرا مصروف النهاردة على التحليل — التوليد موقوف لحد ما نقدر.
        <% } else if (!money.ok) { %>
          ⚠️ وصلت لحدّ التحليل اليومي (<span dir="ltr"><%= money.cap %>$</span>). التقارير القديمة كلها لسه متاحة.
        <% } else { %>
          حدّ التحليل اليومي: <span dir="ltr"><%= money.spent %>$ / <%= money.cap %>$</span>
        <% } %>
      </div>
    <% } %>
    <div id="radReportOut" class="text-sm text-slate-200 whitespace-pre-line" style="display:none"></div>
    <div id="radReportMsg" class="text-xs text-slate-400" style="display:none"></div>
  </div>

  <!-- Study chat (phase 4) -->
  <% if (study.num_slices > 0) { %>
  <div class="card rounded-2xl p-5 mb-4">
    <h2 class="font-bold text-sm mb-1">💬 اسأل عن الدراسة</h2>
    <p class="text-[11px] text-slate-500 mb-3">بيجاوب من الشريحة اللي شايفها دلوقتي + التقرير — إجابة دعم قرار غير تشخيصية.</p>
    <div id="radChatLog" class="space-y-2 mb-3 max-h-72 overflow-y-auto"></div>
    <form id="radChatForm" class="flex gap-2">
      <input id="radChatInput" placeholder="اكتب سؤالك…" class="fld rounded-xl px-3 py-2 text-sm flex-1" autocomplete="off" />
      <button class="accent-bg font-bold px-4 rounded-xl text-sm">إرسال</button>
    </form>
  </div>
  <% } %>

  <% if (study.num_slices > 0) { %>
  <script>
  (function(){
    var viewer = OncoViewer({ studyId: <%= study.id %>, count: <%= study.num_slices %>, root: document.getElementById('radViewer') });
    var btn = document.getElementById('radGenBtn'), out = document.getElementById('radReportOut'), msg = document.getElementById('radReportMsg');
    btn && btn.addEventListener('click', function(){
      btn.disabled = true; btn.textContent = 'بجهّز الصور…'; out.style.display='none';
      msg.style.display=''; msg.textContent = 'بحمّل ورندر الشرائح الممثّلة…';
      viewer.capture(12).then(function(images){
        if(!images.length){ throw new Error('مفيش صور صالحة للتحليل (يمكن الدراسة مضغوطة).'); }
        msg.textContent = 'بحلّل بالذكاء الاصطناعي… (ممكن تاخد لحظات)';
        btn.textContent = 'بحلّل…';
        return fetch('/radiology/study/<%= study.id %>/report', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ images: images, focus: (document.getElementById('radFocus').value||'') })
        }).then(function(r){ return r.json().then(function(d){ return {ok:r.ok, d:d}; }); });
      }).then(function(res){
        if(!res.ok || !res.d.ok){ throw new Error((res.d && res.d.error) || 'تعذّر توليد التقرير.'); }
        msg.style.display='none'; out.style.display=''; out.textContent = res.d.report;
      }).catch(function(e){
        msg.textContent = '⚠️ ' + (e.message || 'حصل خطأ.');
      }).then(function(){ btn.disabled=false; btn.textContent='🚀 توليد تقرير'; });
    });

    // --- Study chat ---
    var chatLog = document.getElementById('radChatLog'), chatForm = document.getElementById('radChatForm'),
        chatInput = document.getElementById('radChatInput'), history = [];
    function addMsg(role, text){
      var d = document.createElement('div');
      d.className = 'text-sm rounded-xl px-3 py-2 ' + (role==='user' ? 'bg-sky-500/10 border border-sky-500/20 text-sky-100' : 'bg-[#0b1424] border border-[#24324f] text-slate-200 whitespace-pre-line');
      d.textContent = text; chatLog.appendChild(d); chatLog.scrollTop = chatLog.scrollHeight; return d;
    }
    chatForm && chatForm.addEventListener('submit', function(ev){
      ev.preventDefault();
      var q = (chatInput.value||'').trim(); if(!q) return;
      chatInput.value=''; addMsg('user', q); history.push({role:'user', content:q});
      var thinking = addMsg('assistant', '…');
      fetch('/radiology/study/<%= study.id %>/chat', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ question:q, history:history.slice(-6), images: viewer.captureCurrent() })
      }).then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
        .then(function(res){
          var a = (res.ok && res.d.ok) ? res.d.answer : ('⚠️ ' + ((res.d && res.d.error) || 'حصل خطأ.'));
          thinking.textContent = a;
          if(res.ok && res.d.ok) history.push({role:'assistant', content:a});
        }).catch(function(){ thinking.textContent = '⚠️ حصل خطأ، حاول تاني.'; });
    });
  })();
  </script>
  <% } %>

  <div class="card rounded-2xl p-5">
    <h2 class="font-bold text-sm mb-3">التقارير</h2>
    <% if (!reports.length) { %>
      <p class="text-sm text-slate-500 text-center py-4">مفيش تقارير بعد.</p>
    <% } else { %>
      <div class="space-y-3">
        <% reports.forEach(function(r){ var done = !!r.approved_at; %>
        <div class="border rounded-xl p-3 <%= done ? 'border-emerald-500/40' : 'border-amber-500/40' %>">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded-full <%= done ? 'bg-emerald-500/15 text-emerald-300' : 'bg-amber-500/15 text-amber-300' %>">
              <%= done ? 'تقرير معتمَد' : '⚠️ مسودة AI — غير معتمَدة' %>
            </span>
            <span class="text-xs text-slate-400"><%= r.model_name || 'AI' %> · <%= new Date(r.created_at).toLocaleString('ar-EG') %></span>
          </div>

          <% if (done) { %>
            <div class="text-xs text-emerald-300/80 mb-2">
              اعتمدها <%= r.approved_by || 'الطبيب' %> · <%= new Date(r.approved_at).toLocaleString('ar-EG') %>
            </div>
            <p class="text-sm text-slate-200 whitespace-pre-line"><%= r.final_text || r.report_text %></p>
            <% if (r.final_text) { %>
            <details class="mt-3">
              <summary class="text-xs text-slate-500 cursor-pointer">مسودة الـAI الأصلية</summary>
              <p class="text-xs text-slate-400 whitespace-pre-line mt-2"><%= r.report_text %></p>
            </details>
            <% } %>
          <% } else { %>
            <p class="text-xs text-amber-300/80 mb-2">
              دي مسودة من نموذج ذكاء اصطناعي. <b>مش تقرير طبي</b> لحد ما طبيب يراجعها ويعتمدها.
            </p>
            <p class="text-sm text-slate-200 whitespace-pre-line"><%= r.report_text %></p>
            <form method="POST" action="/radiology/report/<%= r.id %>/approve" class="mt-3"
                  onsubmit="return confirm('هتعتمد التقرير ده باسمك. بعد الاعتماد مش هينفع يتغيّر.')">
              <textarea name="final_text" rows="4" maxlength="20000"
                class="w-full bg-[#0b1220] border border-[#1e2a44] rounded-xl p-2 text-sm text-slate-200"
                placeholder="صيغتك النهائية (اختياري — سيبها فاضية لو موافق على نص المسودة زي ما هو)"></textarea>
              <button class="mt-2 text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg px-3 py-1.5">
                راجعتها وأعتمدها
              </button>
            </form>
          <% } %>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>
<%- include('_layout_bottom') %>
