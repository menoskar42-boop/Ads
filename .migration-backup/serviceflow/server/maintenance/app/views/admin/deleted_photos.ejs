<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-trash me-2"></i><%= title %></h4>
  <a href="/boxes" class="btn btn-outline-secondary btn-sm">العودة للبوكسات</a>
</div>

<form method="get" action="/admin/deleted-photos" class="card card-body mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-sm-4 col-lg-3">
      <label class="form-label" for="deletedFrom">من</label>
      <input class="form-control" id="deletedFrom" type="date" name="from" value="<%= filters.from %>">
    </div>
    <div class="col-sm-4 col-lg-3">
      <label class="form-label" for="deletedTo">إلى</label>
      <input class="form-control" id="deletedTo" type="date" name="to" value="<%= filters.to %>">
    </div>
    <div class="col-sm-4 col-lg-3">
      <label class="form-label" for="deletedType">النوع</label>
      <select class="form-select" id="deletedType" name="type">
        <option value="">الكل</option>
        <option value="before" <%= filters.type === 'before' ? 'selected' : '' %>>قبل الصيانة</option>
        <option value="after" <%= filters.type === 'after' ? 'selected' : '' %>>بعد الصيانة</option>
      </select>
    </div>
    <div class="col-sm-12 col-lg-3 d-flex gap-2">
      <button class="btn btn-primary" type="submit">تصفية</button>
      <a href="/admin/deleted-photos" class="btn btn-outline-secondary">مسح الفلاتر</a>
    </div>
  </div>
</form>

<div class="small text-muted mb-2">يعرض أحدث 200 صورة أو فيديو.</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>المعاينة</th>
            <th>السنترال / الكابينة / البوكس</th>
            <th>النوع</th>
            <th>رفعها</th>
            <th>حذفها</th>
            <th>إجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% photos.forEach(p => { %>
          <tr>
            <td style="min-width:120px">
              <% if (p.media_type === 'video') { %>
                <video controls preload="metadata" style="max-width:120px;max-height:90px">
                  <source src="/uploads/<%= encodeURIComponent(p.filename) %>" type="video/mp4">
                </video>
              <% } else { %>
                <a href="/uploads/<%= encodeURIComponent(p.filename) %>" target="_blank" rel="noopener">
                  <img src="/uploads/<%= encodeURIComponent(p.filename) %>" alt="صورة محذوفة" loading="lazy" style="max-width:120px;max-height:90px;object-fit:contain">
                </a>
              <% } %>
            </td>
            <td>
              <% if (p.box_number != null) { %>
                <%= p.exchange_name || '—' %> /
                <bdi dir="ltr"><%= p.cabinet_number || '—' %></bdi> /
                <bdi dir="ltr"><%= p.box_number %></bdi>
              <% } else { %><span class="text-muted">البوكس لم يعد موجودًا</span><% } %>
            </td>
            <td>
              <%= p.photo_type === 'before' ? 'قبل الصيانة' : 'بعد الصيانة' %>
              <div class="small text-muted"><%= p.media_type === 'video' ? 'فيديو' : 'صورة' %></div>
            </td>
            <td>
              <%= p.uploader_name || p.uploader_username || (p.uploaded_by ? `مستخدم ${p.uploaded_by}` : '—') %>
              <div class="small text-muted"><%= p.uploaded_at ? new Date(p.uploaded_at).toLocaleString('ar-EG') : '—' %></div>
            </td>
            <td>
              <%= p.deleted_by_name || '—' %>
              <div class="small text-muted"><%= p.deleted_by_role || '—' %> · <%= p.deleted_at ? new Date(p.deleted_at).toLocaleString('ar-EG') : '—' %></div>
            </td>
            <td style="min-width:190px">
              <form method="post" action="/admin/deleted-photos/<%= p.id %>/restore" class="d-inline">
                <button class="btn btn-sm btn-success mb-1" type="submit"><i class="bi bi-arrow-counterclockwise"></i> استرجاع</button>
              </form>
              <form method="post" action="/admin/deleted-photos/<%= p.id %>/purge" class="d-inline">
                <button class="btn btn-sm btn-outline-danger mb-1" type="submit" onclick="return confirm('حذف نهائى؟ مش هتترجع تانى')"><i class="bi bi-trash"></i> حذف نهائى</button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!photos.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">مفيش صور محذوفة مطابقة للفلاتر.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
