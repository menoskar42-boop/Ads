{
  "expo": {
    "name": "Oscar Messaging",
    "slug": "oscar-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oscar-messenger",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A101B",
    "ios": {
      "bundleIdentifier": "com.oscardevs.oscarmessaging",
      "supportsTablet": false
    },
    "android": {
      "package": "com.oscardevs.oscarmessaging",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A101B"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يشارك Oscar Messaging موقعك الحالي مرة واحدة فقط بعد ضغطك على زر إرسال الموقع."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يستخدم Oscar Messaging الميكروفون لتسجيل رسالة صوتية بعد ضغطك على زر التسجيل.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/oscar-messenger/"
    }
  }
}
