<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/logo.svg" type="image/svg+xml">
  <title><%= (typeof title !== 'undefined' && title) ? title : site.site_name %></title>
  <meta name="description" content="<%= metaDescription || (site.site_description || '').slice(0, 160) %>">
  <meta name="robots" content="<%= noindex ? 'noindex,follow' : 'index,follow' %>">
  <% const _canon = (typeof canonicalPath === 'undefined') ? '' : canonicalPath; %>
  <% if (_canon !== null) { %><link rel="canonical" href="<%= baseUrl %><%= _canon %>"><% } %>
  <meta property="og:type" content="<%= (typeof ogType !== 'undefined' && ogType) ? ogType : 'website' %>">
  <meta property="og:title" content="<%= (typeof title !== 'undefined' && title) ? title : site.site_name %>">
  <meta property="og:description" content="<%= (site.site_description || '').slice(0, 160) %>">
  <meta property="og:url" content="<%= baseUrl %><%= _canon || '' %>">
  <meta property="og:image" content="<%= (typeof ogImage !== 'undefined' && ogImage) ? ogImage : (site.logo_url || baseUrl + '/logo.svg') %>">
  <meta property="og:site_name" content="<%= site.site_name %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/styles.css">
  <% (structuredData || []).forEach((item) => { %><script type="application/ld+json"><%- jsonLd(item) %></script><% }) %>
</head>
<body>
  <header class="topbar">
    <div class="wrap nav">
      <a href="/" class="brand"><% if (site.logo_url) { %><img src="<%= site.logo_url %>" alt=""><% } %><span><%= site.site_name %></span></a>
      <nav>
        <a href="/">الرئيسية</a>
        <a href="/affiliate-disclosure">الإفصاح</a>
        <a href="/about">عن Deals</a>
        <a href="/search">بحث</a>
      </nav>
      <form action="/search" method="get" class="search"><input name="q" placeholder="ابحث عن منتج"><button aria-label="بحث">⌕</button></form>
    </div>
  </header>
  <main class="wrap">