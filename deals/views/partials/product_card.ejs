<article class="product-card">
  <a href="/product/<%= encodeURIComponent(p.slug) %>" class="product-image"><% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.image_alt || p.title %>" loading="lazy"><% } else { %><span>لا توجد صورة رسمية متاحة</span><% } %></a>
  <div class="product-body"><% if (p.category_name) { %><small class="category"><%= p.category_name %></small><% } %><h3><a href="/product/<%= encodeURIComponent(p.slug) %>"><%= p.title %></a></h3><p><%= p.short_description || '' %></p><% if (p.show_price) { %><strong class="price"><%= Number(p.current_price).toFixed(2) %> <%= p.currency || 'EGP' %></strong><% } else if (p.source === 'AMAZON_API') { %><small class="muted">السعر غير مؤكد حاليًا — تحقق من Amazon</small><% } %><% if (p.show_availability) { %><small class="muted availability"><%= p.availability %></small><% } %><% if (p.source === 'AMAZON_API' && !p.dynamic_data_fresh) { %><small class="muted">بيانات Amazon تحتاج تحديثًا</small><% } %><a class="button small" href="<%= p.affiliate_url %>" target="_blank" rel="sponsored noopener noreferrer">شاهد على Amazon ↗</a></div>
</article>