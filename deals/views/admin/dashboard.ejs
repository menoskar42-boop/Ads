<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body class="admin-body"><div class="admin-wrap"><% const syncInfo = (typeof sync !== 'undefined' && sync) ? sync : { config: { configured: false, missing: [] }, products: { amazon_total: 0, amazon_fresh: 0, amazon_failed: 0 }, lastRun: null }; %>
<header class="admin-header"><div><span class="eyebrow">DEALS ADMIN</span><h1>إدارة Deals</h1></div><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost">خروج</button></form></header>
<section class="admin-grid">
  <div class="panel"><h2>إعدادات الموقع</h2><form method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>اسم الموقع<input name="site_name" value="<%= site.site_name %>"></label><label>الوصف<textarea name="site_description"><%= site.site_description %></textarea></label><label>اللون<input name="theme_color" value="<%= site.theme_color %>"></label><label>رابط الشعار<input name="logo_url" value="<%= site.logo_url || '' %>"></label><button class="button">حفظ</button></form></div>
  <div class="panel"><h2>التصنيفات</h2><form method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" required placeholder="اسم التصنيف"><input name="slug" placeholder="slug اختياري"><textarea name="description" placeholder="وصف مختصر"></textarea><button class="button">إضافة تصنيف</button></form><ul class="admin-list"><% categories.forEach(c => { %><li><span><%= c.name %></span><form method="post" action="/admin/categories/<%= c.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">حذف</button></form></li><% }) %></ul></div>
</section>
<section class="panel"><h2>مزامنة Amazon</h2><p class="muted">تحدّث المنتجات المرتبطة بـ ASIN من Creators API فقط. لا تُعرض الأسعار أو التوافر بعد مرور 24 ساعة على آخر تحديث صالح.</p><% if (!syncInfo.config.configured) { %><div class="alert">المصدر الرسمي غير مهيأ بعد. أضف الأسرار المطلوبة عبر Replit Secrets، ولن تظهر قيمها هنا: <%= syncInfo.config.missing.join('، ') %>.</div><% } else { %><div class="muted">الحساب مهيأ للسوق <bdi><%= syncInfo.config.marketplace %></bdi> والوسم <bdi><%= syncInfo.config.partnerTag %></bdi>.</div><% } %><div class="admin-row"><span>المنتجات: <bdi><%= syncInfo.products.amazon_total %></bdi> · حديثة: <bdi><%= syncInfo.products.amazon_fresh %></bdi> · فاشلة: <bdi><%= syncInfo.products.amazon_failed %></bdi></span><% if (syncInfo.lastRun) { %><small>آخر تشغيل: <%= syncStatusLabel(syncInfo.lastRun.status) %> · <%= new Date(syncInfo.lastRun.started_at).toLocaleString('ar-EG') %> · نجاح <%= syncInfo.lastRun.success_count %> / فشل <%= syncInfo.lastRun.failure_count %></small><% if (syncInfo.lastRun.error_summary) { %><small class="muted"><%= syncInfo.lastRun.error_summary %></small><% } %><% } %></div><form method="post" action="/admin/amazon-sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" <%= syncInfo.config.configured ? '' : 'disabled' %>>إعادة المحاولة الآن</button></form></section>
<section class="panel"><h2>إضافة منتج يدوي</h2><p class="muted">المسار اليدوي يظل متاحًا للمنتجات غير المرتبطة بـAmazon. رابط Affiliate يجب أن يكون رابطًا أنشأته من لوحة البرنامج.</p><form method="post" action="/admin/products" enctype="multipart/form-data" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>اسم المنتج *<input name="title" required></label><label>Slug<input name="slug"></label><label>المصدر<select name="source"><option value="MANUAL">Manual</option><% const amazonProvider = providers.find(p => p.id === 'AMAZON_API'); %><option value="AMAZON_API" <%= amazonProvider && amazonProvider.enabled ? '' : 'disabled' %>>Amazon Creators API <%= amazonProvider && amazonProvider.enabled ? '' : '— يحتاج أسرار' %></option><option disabled>AliExpress — Coming soon</option><option disabled>Alibaba — Coming soon</option><option disabled>eBay — Coming soon</option><option disabled>Noon — Coming soon</option></select></label><label>التصنيف<select name="category_id"><option value="">بدون</option><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>السعر<input name="current_price" type="number" min="0" step="0.01"></label><label>العملة<input name="currency" value="EGP"></label><label>العلامة التجارية<input name="brand"></label><label>ASIN / External ID<input name="external_id"></label><label class="full">عنوان SEO<input name="seo_title" maxlength="60" placeholder="عنوان واضح وفريد"></label><label class="full">وصف Meta عربي<textarea name="meta_description" maxlength="160" placeholder="150–160 حرفًا، بدون نسخ من Amazon"></textarea></label><label class="full">وصف قصير<textarea name="short_description"></textarea></label><label class="full">الوصف الكامل<textarea name="full_description"></textarea></label><label>صورة<input name="image_file" type="file" accept="image/*"></label><label>رابط صورة<input name="image_url" type="url"></label><label>النص البديل للصورة<input name="image_alt" maxlength="180"></label><label>Amazon URL<input name="amazon_product_url" type="url"></label><label>Affiliate URL *<input name="affiliate_url" type="url" required></label><label>التوافر<input name="availability" placeholder="متاح / تحقق من المتجر"></label><div class="checks"><label><input type="checkbox" name="is_featured"> مميز</label><label><input type="checkbox" name="is_published"> منشور</label></div><button class="button full">حفظ المنتج</button></form></section>
<section class="panel"><h2>المنتجات الحالية</h2><div class="admin-table"><% products.forEach(p => { %><div class="admin-row"><div><strong><%= p.title %></strong><small><%= p.category_name || 'بدون تصنيف' %> · <%= p.source %></small></div><span><%= p.is_published ? 'منشور' : 'مسودة' %></span><a class="ghost" href="/admin/products/<%= p.id %>/edit">تعديل</a><form method="post" action="/admin/products/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost"><%= p.is_published ? 'إخفاء' : 'نشر' %></button></form><form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('حذف المنتج؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">حذف</button></form></div><% }) %></div></section>
<section class="panel"><h2>أدلة الشراء والمقالات</h2><form method="post" action="/admin/articles" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>العنوان<input name="title" required></label><label>Slug<input name="slug"></label><label class="full">المقدمة<textarea name="excerpt"></textarea></label><label class="full">المحتوى<textarea name="body" required></textarea></label><label><input type="checkbox" name="is_published"> نشر</label><button class="button">حفظ المقال</button></form><div class="admin-table"><% articles.forEach(a => { %><div class="admin-row"><strong><%= a.title %></strong><span><%= a.is_published ? 'منشور' : 'مسودة' %></span><form method="post" action="/admin/articles/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">حذف</button></form></div><% }) %></div></section>
</div></body></html>