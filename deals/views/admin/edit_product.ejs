<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body class="admin-body"><div class="admin-wrap"><header class="admin-header"><div><span class="eyebrow">DEALS ADMIN</span><h1>تعديل المنتج</h1></div><a href="/admin" class="ghost">العودة للإدارة</a></header><section class="panel"><form method="post" action="/admin/products/<%= product.id %>/edit" enctype="multipart/form-data" class="form-grid"><label>اسم المنتج *<input name="title" required value="<%= product.title %>"></label><label>Slug<input name="slug" value="<%= product.slug %>"></label><label>التصنيف<select name="category_id"><option value="">بدون</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= String(product.category_id||'')===String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label><label>السعر<input name="current_price" type="number" min="0" step="0.01" value="<%= product.current_price || '' %>"></label><label>العملة<input name="currency" value="<%= product.currency || 'EGP' %>"></label><label>العلامة التجارية<input name="brand" value="<%= product.brand || '' %>"></label><label class="full">وصف قصير<textarea name="short_description"><%= product.short_description || '' %></textarea></label><label class="full">الوصف الكامل<textarea name="full_description"><%= product.full_description || '' %></textarea></label><label>صورة جديدة<input name="image_file" type="file" accept="image/*"></label><label>رابط الصورة<input name="image_url" value="<%= product.image_url || '' %>"></label><label>Amazon URL<input name="amazon_product_url" value="<%= product.amazon_product_url || '' %>"></label><label>Affiliate URL *<input name="affiliate_url" required value="<%= product.affiliate_url || '' %>"></label><label>التوافر<input name="availability" value="<%= product.availability || '' %>"></label><div class="checks"><label><input type="checkbox" name="is_featured" <%= product.is_featured ? 'checked' : '' %>> مميز</label><label><input type="checkbox" name="is_published" <%= product.is_published ? 'checked' : '' %>> منشور</label></div><button class="button full">حفظ التعديلات</button></form></section></div></body></html>