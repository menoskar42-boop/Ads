<%# `title` مش بيتبعت من رُوت الأخطاء، و EJS بترمي ReferenceError على أي
    متغيّر مش موجود — يعني كل 404 كان بيتحوّل 500، والـ 500 handler نفسه
    بيرندر نفس القالب فيرمي تاني. الحارس بيمنع رجوع الغلطة دي. %>
<%- include('partials/header', {
      canonicalPath: null,
      title: (typeof title !== 'undefined' && title) ? title : (status === 404 ? 'الصفحة غير موجودة — Deals' : 'تعذّر إتمام الطلب — Deals'),
      metaDescription: 'الصفحة المطلوبة غير متاحة على Deals.',
      noindex: true,
    }) %>
<div class="empty"><strong><%= status %></strong><h1><%= message %></h1><a class="button" href="/">العودة للرئيسية</a></div>
<%- include('partials/footer') %>
