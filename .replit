modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["rsync", "glib", "nss", "nspr", "atk", "at-spi2-atk", "at-spi2-core", "cups", "dbus", "libdrm", "gtk3", "pango", "cairo", "libxkbcommon", "mesa", "libgbm", "expat", "alsa-lib", "nghttp2", "libGL", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst", "xorg.libXScrnSaver", "postgresql_17"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=false npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5011
externalPort = 3000

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install --include=dev && (cd mybible && npm install --include=dev && npm run build) && (cd serviceflow && npm install --include=dev && npm run build)"]
run = ["sh", "-c", "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=true npm start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.production]
MYBIBLE_MAINTENANCE_MODE = "false"
MYBIBLE_SESSION_SECRET_SHA256 = "db416deb92e6797b1bb1a87b99456df44714f51880f9f7c9c38b0dc63d50743d"
MYBIBLE_VAPID_PUBLIC_KEY_SHA256 = "2f267592ee69f6eded91d68225704bd57ec916c13974c3a123f69a08a742ba8b"
MYBIBLE_DATABASE_TARGET = "ads-supabase"
# ⛔ **رجعت "5" — وريبليت كان على حق.**
#
# رفعتها لـ12 ورفعت بتاعة أوسكار ديفز لـ20، واللوج رد عليّ:
#   error: (EMAXCONNSESSION) max clients reached in session mode
# وده pooler سوبابيز نفسه بيرفض الاتصالات — mybible بقى مش قادر يوصل
# للقاعدة أصلاً. سقف session mode أقل بكتير من الستين اللي افترضتها،
# و8+5=13 اللي ريبليت حطّها كانت مظبوطة على السقف ده مش رقم عشوائي.
#
# الزحمة بتتحل بتقليل الاستعلامات (تجميع الطلبات في group-cache.ts)
# مش بزيادة الاتصالات — الاتصالات مورد مقفول من برّه.
MYBIBLE_PG_POOL_MAX = "5"
# ⛔ **رجعت "8"** لنفس السبب اللي فوق: 20+12 كسرت سقف session mode في
# سوبابيز وmybible اترفضت اتصالاته. 8+5=13 هو اللي بيشتغل.
PG_POOL_MAX = "8"

# مسار الجذر بتاع Service Flow. بيتقرا في مكانين لازم يتطابقوا:
#   · وقت البناء  → serviceflow/vite.config.ts (كل الملفات بتتطلب من تحته)
#   · وقت التشغيل → src/lib/host_gateway.js (البوّاب بيشيله قبل ما يمرّر)
# ليه أصلاً: كل نطاق فرعي على oscardevs.com بيعدّي على Cloudflare Worker
# وبياكل من كوتته المشتركة مع متاجر العملاء. الأبكس مستثنى من الـWorker،
# فـ oscardevs.com/serviceflow بيكلّف صفر. الحارس: check-serviceflow-path.
SF_BASE_PATH = "/serviceflow/"
