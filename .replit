modules = ["nodejs-20", "postgresql-16", "python-base-3.13"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
# rsync + the system libraries Chromium (Playwright server browser) needs. Node
# comes from `modules` above, so these only ADD shared libs (Replit puts them on
# LD_LIBRARY_PATH); they don't touch the Node/Postgres runtime.
packages = ["rsync", "glib", "nss", "nspr", "atk", "at-spi2-atk", "at-spi2-core", "cups", "dbus", "libdrm", "gtk3", "pango", "cairo", "libxkbcommon", "mesa", "libgbm", "expat", "alsa-lib", "nghttp2", "libGL", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst", "xorg.libXScrnSaver"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=false npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5100
externalPort = 4200

[[ports]]
localPort = 5101
externalPort = 5000

[[ports]]
localPort = 5551
externalPort = 3003

[[ports]]
localPort = 5555
externalPort = 3002

[[ports]]
localPort = 8976
externalPort = 3000
exposeLocalhost = true

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install --include=dev && (cd mybible && npm install --include=dev && npm run build)"]
run = ["sh", "-c", "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=true npm start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
