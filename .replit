modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["rsync", "glib", "nss", "nspr", "atk", "at-spi2-atk", "at-spi2-core", "cups", "dbus", "libdrm", "gtk3", "pango", "cairo", "libxkbcommon", "mesa", "libgbm", "expat", "alsa-lib", "nghttp2", "libGL", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst", "xorg.libXScrnSaver", "postgresql_17"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "MYBIBLE_DATABASE_TARGET=ads-supabase MYBIBLE_SESSION_SECRET_SHA256=db416deb92e6797b1bb1a87b99456df44714f51880f9f7c9c38b0dc63d50743d MYBIBLE_VAPID_PUBLIC_KEY_SHA256=2f267592ee69f6eded91d68225704bd57ec916c13974c3a123f69a08a742ba8b DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=false npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5003
externalPort = 3002

[[ports]]
localPort = 5011
externalPort = 3000

[[ports]]
localPort = 5503
externalPort = 3003

# ⚠️ SF_BASE_PATH متكتوب صراحةً في أمر البناء **وأمر التشغيل** مش في
# [userenv]: النصّين لازم يشوفوه، والبناء مش مضمون إنه بيشوف userenv.
#   · البناء  → vite بيحط المسار في كل رابط ملف
#   · التشغيل → البوّاب بيشيل المسار قبل ما يمرّر الطلب
# لو واحد شافه والتاني لأ، الصفحة بتفتح وتطلب ملفاتها من مكان البوّاب مش
# شايله = شاشة بيضا من غير رسالة خطأ. الحارس: check-serviceflow-path.
[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install --include=dev && (cd mybible && npm install --include=dev && npm run build) && (cd serviceflow && npm install --include=dev && SF_BASE_PATH=/serviceflow/ npm run build)"]
run = ["sh", "-c", "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=true SF_BASE_PATH=/serviceflow/ npm start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.production]
MYBIBLE_MAINTENANCE_MODE = "false"
MYBIBLE_SESSION_SECRET_SHA256 = "db416deb92e6797b1bb1a87b99456df44714f51880f9f7c9c38b0dc63d50743d"
MYBIBLE_VAPID_PUBLIC_KEY_SHA256 = "2f267592ee69f6eded91d68225704bd57ec916c13974c3a123f69a08a742ba8b"
MYBIBLE_DATABASE_TARGET = "ads-supabase"
# ⛔ **الميزانية موزّعة على كل العمليات التي قد تستخدم Session Pooler.**
#
# الإنتاج كان يستهلك 8 للتطبيق الرئيسي + 5 لـMyBible + 2 لـService Flow
# = 15 بالضبط، فكان أي اتصال عابر أثناء الإقلاع أو الزحام يسبب:
#   error: (EMAXCONNSESSION) max clients reached in session mode
#
# نترك هامشًا حقيقيًا: 4 للتطبيق الرئيسي + 4 لـMyBible + 1 لـService Flow
# = 9، مع إبقاء مساحة لاتصالات الجلسات والإقلاع والنسخ الاحتياطي.
MYBIBLE_PG_POOL_MAX = "4"
PG_POOL_MAX = "4"
SERVICEFLOW_CURRENT_PG_POOL_MAX = "1"

[userenv.shared]
PG_POOL_MAX = "4"
SERVICEFLOW_CURRENT_PG_POOL_MAX = "1"

