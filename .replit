modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["rsync", "glib", "nss", "nspr", "atk", "at-spi2-atk", "at-spi2-core", "cups", "dbus", "libdrm", "gtk3", "pango", "cairo", "libxkbcommon", "mesa", "libgbm", "expat", "alsa-lib", "nghttp2", "libGL", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst", "xorg.libXScrnSaver", "postgresql_17"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=false npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5011
externalPort = 3000

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install --include=dev && (cd mybible && npm install --include=dev && npm run build) && (cd serviceflow && npm install --include=dev && npm run build)"]
run = ["sh", "-c", "DEALS_UPSTREAM=http://127.0.0.1:5002 DEALS_COOKIE_SECURE=true npm start"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.production]
MYBIBLE_MAINTENANCE_MODE = "false"
MYBIBLE_SESSION_SECRET_SHA256 = "db416deb92e6797b1bb1a87b99456df44714f51880f9f7c9c38b0dc63d50743d"
MYBIBLE_VAPID_PUBLIC_KEY_SHA256 = "2f267592ee69f6eded91d68225704bd57ec916c13974c3a123f69a08a742ba8b"
MYBIBLE_DATABASE_TARGET = "ads-supabase"
# حوض اتصالات mybible. كان "5" وده قليل خطير: صفحة المجموعة لوحدها بتطلق
# ٣١ نداء، ودرس مار مرقس فيه ٧٠٠ عضو ممكن يفتحوا في نفس الدقيقة. القياس من
# /api/health بيقول إن المشكلة دلوقتي مش الطابور (waiting=0) لكن زمن الرحلة
# لسوبابيز (~١٠٤ مللي) — فالرقم ده احتياطي للزحمة مش علاج للبطء.
# لو ظهر waiting > 0 في /api/health زوّده تاني.
MYBIBLE_PG_POOL_MAX = "12"
# حوض أوسكار ديفز (الاتناشر نظام + المتاجر + الحجوزات + الحسابات). كان "8"
# وده أقل من الافتراضي المكتوب في src/lib/shared_pool.js (20). المجموع مع
# mybible بقى ٣٢ اتصال، وده تحت حد سوبابيز براحة ومعاه فسحة للنسخ الاحتياطي
# ولمحرّر SQL في لوحة سوبابيز.
PG_POOL_MAX = "20"
